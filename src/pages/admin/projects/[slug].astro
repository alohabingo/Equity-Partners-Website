    .cardhead .n { background: #f2f5f9; color: #5c6f88; border-radius: 999px; padding: 0.1rem 0.45rem; font-size: 0.66rem; font-weight: 800; }
    .cardhead + .rows, .cardhead + .group { margin-top: 0.5rem; }

    @media (max-width: 1080px) {
      .ov { grid-template-columns: minmax(0, 1fr); }
    }
    /* Four metric cards now share the page with a 348px rail, so they run out of
       room sooner than they used to. */
    @media (max-width: 1240px) {
      .ov .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    /* Same sliding-thumb switcher as Projects / Opportunities on the Portfolio
       page and the Team / Partners one. The thumb is positioned by script rather
       than by CSS because only the browser knows how wide each label ends up. */
    .seg {
      position: relative; display: inline-flex;
      background: #ffffff; border: 1px solid #d5deea; border-radius: 999px;
      padding: 0.3rem; box-shadow: 0 6px 18px rgba(15, 26, 42, 0.06);
      /* Deliberately no flex-wrap: the thumb is placed with offsetLeft, which
         only describes one row. Four short labels always fit. */
      isolation: isolate;
    }
    .seg-thumb {
      position: absolute; top: 0.3rem; bottom: 0.3rem; left: 0; width: 0;
      border-radius: 999px; background: linear-gradient(180deg, #16283e 0%, #0f2036 100%);
      box-shadow: 0 6px 16px rgba(15, 26, 42, 0.28); z-index: -1;
      transition: transform 420ms cubic-bezier(0.32, 1.3, 0.44, 1), width 420ms cubic-bezier(0.32, 1.3, 0.44, 1);
    }
    .seg-thumb.no-anim { transition: none; }
    /* Named, so the browser can morph THIS element from its old position to its
