---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Cookie Policy | Equity Partners</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --navy: #0f1a2a;
        --navy-soft: #1f2f46;
        --slate: #5f7087;
        --slate-light: #8da0b9;
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --line: #dbe3ee;
        --accent: #8293ae;
        --max-width: 1120px;
        --header-offset: 6.1rem;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--navy-soft);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.55;
      }
      h1, h2, h3, p, ul { margin: 0; }
      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .legal-hero {
        margin-top: var(--header-offset);
        padding: 4rem 0 2rem;
        background: linear-gradient(180deg, #f4f6fa, #edf1f7);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.85rem;
      }
      h1 {
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1.08;
        letter-spacing: 0.02em;
        color: var(--navy);
        max-width: 18ch;
      }
      .legal-hero p {
        margin-top: 1rem;
        max-width: 50rem;
        color: var(--slate);
        font-size: 1rem;
        line-height: 1.65;
      }
      .legal-content {
        padding: 4rem 0;
      }
      .legal-shell {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 2rem;
      }
      .legal-block + .legal-block {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
      }
      .legal-block h2 {
        font-size: clamp(1.55rem, 3vw, 2.45rem);
        line-height: 1.12;
        color: var(--navy);
      }
      .legal-block p,
      .legal-block li {
        margin-top: 0.85rem;
        color: var(--slate);
        font-size: 0.98rem;
        line-height: 1.7;
      }
      .legal-block ul { padding-left: 1.1rem; }
      .legal-meta {
        color: var(--slate-light);
        font-size: 0.86rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
      .legal-contact-button {
        margin-top: 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #d8e3f2;
        color: #132238;
        text-decoration: none;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(216, 227, 242, 0.96);
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease;
      }
      .legal-contact-button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-1px);
      }

      @media (max-width: 980px) {
        .legal-shell { padding: 1.35rem; }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader menuToggleId="mobile-menu-toggle-cookies" offsetFirstSection={false} />

    <section class="legal-hero">
      <div class="container">
        <p class="eyebrow">Cookies</p>
        <h1>How Equity Partners uses cookies and similar technologies.</h1>
        <p>
          This Cookie Policy explains how Equity Partners uses cookies and similar technologies when you visit our website,
          why we use them, and what choices you have regarding their use.
        </p>
      </div>
    </section>

    <section class="legal-content">
      <div class="container">
        <div class="legal-shell">
          <div class="legal-block">
            <p class="legal-meta">Last updated: March 31, 2026</p>
          </div>

          <div class="legal-block">
            <h2>What are cookies?</h2>
            <p>
              Cookies are small data files placed on your computer or mobile device when you visit a website. Cookies are
              widely used to make websites work, improve performance, and provide reporting information.
            </p>
          </div>

          <div class="legal-block">
            <h2>Why we use cookies</h2>
            <p>
              We use first-party and third-party cookies for several reasons. Some cookies are required for technical
              reasons so the website can function properly, while others help us understand usage, improve performance, and
              enhance user experience.
            </p>
          </div>

          <div class="legal-block">
            <h2>Types of cookies we may use</h2>
            <ul>
              <li>Strictly necessary cookies needed for the core operation of the site.</li>
              <li>Performance and analytics cookies that help us understand how the site is used.</li>
              <li>Functionality cookies that remember your preferences and improve your experience.</li>
            </ul>
          </div>

          <div class="legal-block">
            <h2>Your choices</h2>
            <p>
              You have the right to decide whether to accept or reject cookies. You can do this through any cookie banner
              or preference tool we may provide, or by adjusting your browser settings directly.
            </p>
            <p>
              Most browsers allow you to block or delete cookies. The exact method varies by browser and version.
            </p>
          </div>

          <div class="legal-block">
            <h2>Changes to this policy</h2>
            <p>
              We may update this Cookie Policy from time to time to reflect changes in our practices, technologies, or legal
              requirements. Please review this page periodically to stay informed.
            </p>
          </div>

          <div class="legal-block">
            <h2>Contact us</h2>
            <p>
              If you have questions about our use of cookies or similar technologies, please contact
              <strong> info@equitypartnersandorra.com</strong>.
            </p>
            <a class="legal-contact-button" href="/contact">Contact Us</a>
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />

    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>
  </body>
</html>
