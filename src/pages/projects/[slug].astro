---
import InnerSiteHeader from "../../components/InnerSiteHeader.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../../lib/i18n";
import { getPageTitle } from "../../i18n/ui";
import { projects, getProjectBySlug, statusColour } from "../../data/projects";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  const locales = ["en", "es", "ca"];
  return projects.flatMap((project) =>
    locales.map((locale) => ({
      params: { slug: project.slug },
      props: { project, locale },
    }))
  );
};

const { project, locale: propLocale } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) ?? propLocale ?? "en";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{getPageTitle(project.name, locale)}</title>
    <meta name="description" content={project.tagline} />
    <link rel="icon" type="image/png" href="/EP favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --navy: #0f1a2a;
        --green: #53b27f;
        --green-dark: #3f9568;
        --line: #dce3ee;
        --text: #172235;
        --muted: #5a667a;
        --font: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: #ffffff;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
      }

      /* ── Hero ── */
      .project-hero {
        position: relative;
        background: var(--navy);
        padding: 0;
        overflow: hidden;
        min-height: 520px;
        display: flex;
        flex-direction: column;
      }

      .project-hero-image {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .project-hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .project-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(15, 26, 42, 0.55) 0%,
          rgba(15, 26, 42, 0.72) 60%,
          rgba(15, 26, 42, 0.92) 100%
        );
        z-index: 1;
      }

      .project-hero-content {
        position: relative;
        z-index: 2;
        margin-top: auto;
        padding: 9rem 0 3.5rem;
      }

      .project-hero-meta {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .project-hero-eyebrow {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--green);
      }

      .project-hero-status {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: #ffffff;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        line-height: 1;
      }

      .project-hero h1 {
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 0.8rem;
        line-height: 1.08;
        letter-spacing: -0.01em;
        max-width: 720px;
      }

      .project-hero-tagline {
        font-size: 1rem;
        color: rgba(214, 224, 240, 0.8);
        margin: 0;
        max-width: 600px;
        line-height: 1.65;
      }

      /* ── Key Metrics Strip ── */
      .project-metrics-strip {
        background: #f2f5fa;
        border-bottom: 1px solid var(--line);
        padding: 1.6rem 0;
      }

      .project-metrics-inner {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
      }

      .project-metric-item {
        flex: 1;
        min-width: 130px;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0.4rem 1.6rem 0.4rem 0;
        border-right: 1px solid var(--line);
      }

      .project-metric-item:last-child {
        border-right: none;
        padding-right: 0;
        padding-left: 1.6rem;
      }

      .project-metric-item:first-child {
        padding-left: 0;
      }

      .project-metric-value {
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--navy);
        line-height: 1;
      }

      .project-metric-value.is-green {
        color: var(--green);
      }

      .project-metric-label {
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ── Breadcrumb ── */
      .project-breadcrumb {
        padding: 1.2rem 0;
        border-bottom: 1px solid var(--line);
      }

      .project-breadcrumb-inner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        color: var(--muted);
      }

      .project-breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 180ms ease;
      }

      .project-breadcrumb a:hover {
        color: var(--green);
      }

      .project-breadcrumb-sep {
        color: var(--line);
      }

      .project-breadcrumb-current {
        color: var(--text);
        font-weight: 600;
      }

      /* ── Main layout ── */
      .project-body {
        padding: 4rem 0 6rem;
      }

      .project-body-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 3rem;
        align-items: start;
      }

      /* ── Left column ── */
      .project-section {
        margin-bottom: 3rem;
      }

      .project-section:last-child {
        margin-bottom: 0;
      }

      .project-section-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--green);
        margin: 0 0 0.8rem;
      }

      .project-section h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 1rem;
        line-height: 1.25;
      }

      .project-section p {
        font-size: 0.93rem;
        color: var(--muted);
        line-height: 1.75;
        margin: 0 0 1rem;
      }

      .project-section p:last-child {
        margin-bottom: 0;
      }

      /* ── Highlights ── */
      .project-highlights {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .project-highlights li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.88rem;
        color: var(--text);
        line-height: 1.5;
      }

      .project-highlights li::before {
        content: "";
        display: block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--green);
        flex-shrink: 0;
        margin-top: 0.45em;
      }

      /* ── Milestones ── */
      .project-milestones {
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
      }

      .project-milestone {
        display: flex;
        gap: 1.2rem;
        align-items: flex-start;
        padding-bottom: 1.6rem;
        position: relative;
      }

      .project-milestone:last-child {
        padding-bottom: 0;
      }

      .project-milestone-track {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        width: 20px;
      }

      .project-milestone-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--line);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        z-index: 1;
        transition: border-color 200ms, background 200ms;
      }

      .project-milestone-dot.is-done {
        background: var(--green);
        border-color: var(--green);
      }

      .project-milestone-dot.is-done svg {
        display: block;
      }

      .project-milestone-dot svg {
        display: none;
        width: 10px;
        height: 10px;
        stroke: #fff;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .project-milestone-line {
        flex: 1;
        width: 2px;
        background: var(--line);
        margin-top: 2px;
      }

      .project-milestone:last-child .project-milestone-line {
        display: none;
      }

      .project-milestone-content {
        padding-top: 0.1rem;
        flex: 1;
      }

      .project-milestone-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--navy);
        margin: 0 0 0.15rem;
      }

      .project-milestone-label.is-done {
        color: var(--muted);
        text-decoration: line-through;
        text-decoration-color: rgba(90, 102, 122, 0.4);
      }

      .project-milestone-date {
        font-size: 0.72rem;
        color: var(--muted);
        font-weight: 500;
      }

      /* ── Gallery ── */
      .project-gallery {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
      }

      .project-gallery img {
        width: 100%;
        aspect-ratio: 4/3;
        object-fit: cover;
        border-radius: 0.7rem;
        display: block;
      }

      .project-gallery img:first-child {
        grid-column: 1 / -1;
        aspect-ratio: 16/7;
      }

      /* ── Right sidebar ── */
      .project-sidebar {
        position: sticky;
        top: 5.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .project-sidebar-card {
        border: 1px solid var(--line);
        border-radius: 1rem;
        overflow: hidden;
        background: #fff;
      }

      .project-sidebar-card-header {
        padding: 1.2rem 1.4rem;
        border-bottom: 1px solid var(--line);
        background: #f8fafd;
      }

      .project-sidebar-card-header h3 {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--navy);
        margin: 0;
      }

      .project-sidebar-card-body {
        padding: 1.2rem 1.4rem;
      }

      .project-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f0f4fa;
        font-size: 0.8rem;
      }

      .project-detail-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .project-detail-row:first-child {
        padding-top: 0;
      }

      .project-detail-key {
        color: var(--muted);
        font-weight: 500;
        white-space: nowrap;
      }

      .project-detail-val {
        color: var(--navy);
        font-weight: 700;
        text-align: right;
      }

      .project-detail-val.is-green {
        color: var(--green);
      }

      /* ── CTA card ── */
      .project-cta-card {
        background: var(--navy);
        border-radius: 1rem;
        padding: 1.8rem 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .project-cta-card h3 {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        line-height: 1.3;
      }

      .project-cta-card p {
        font-size: 0.8rem;
        color: rgba(214, 224, 240, 0.7);
        margin: 0;
        line-height: 1.6;
      }

      .project-cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1.4rem;
        background: var(--green);
        border: 1px solid var(--green);
        color: #fff;
        border-radius: 0.55rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
      }

      .project-cta-btn:hover {
        background: var(--green-dark);
        border-color: var(--green-dark);
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(15, 60, 35, 0.28);
      }

      .project-cta-btn svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Regulatory note ── */
      .project-reg-note {
        background: #f8fafd;
        border: 1px solid var(--line);
        border-radius: 0.8rem;
        padding: 1rem 1.2rem;
        font-size: 0.75rem;
        color: var(--muted);
        line-height: 1.6;
      }

      /* ── Back link ── */
      .project-back-section {
        padding: 3rem 0 0;
        border-top: 1px solid var(--line);
        margin-top: 3rem;
      }

      .project-back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green);
        text-decoration: none;
        transition: gap 180ms ease;
      }

      .project-back-link:hover {
        gap: 0.75rem;
      }

      .project-back-link svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Animations ── */
      [data-animate] {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 580ms ease, transform 580ms ease;
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* ── Responsive ── */
      @media (max-width: 900px) {
        .project-body-grid {
          grid-template-columns: 1fr;
        }

        .project-sidebar {
          position: static;
        }

        .project-metrics-inner {
          gap: 1rem;
        }

        .project-metric-item {
          border-right: none;
          padding: 0.6rem 0;
          border-bottom: 1px solid var(--line);
          min-width: calc(50% - 0.5rem);
          flex: none;
          width: calc(50% - 0.5rem);
        }

        .project-metric-item:last-child {
          border-bottom: none;
          padding-left: 0;
        }

        .project-metric-item:first-child {
          padding-left: 0;
        }
      }

      @media (max-width: 560px) {
        .project-gallery {
          grid-template-columns: 1fr;
        }

        .project-gallery img:first-child {
          aspect-ratio: 4/3;
        }

        .project-metric-item {
          width: 100%;
          min-width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader menuToggleId="mobile-menu-toggle" offsetFirstSection={false} locale={locale} currentPath={Astro.url.pathname} />

    <!-- Hero -->
    <section class="project-hero">
      <div class="project-hero-image">
        <img src={project.image} alt={project.name} />
      </div>
      <div class="project-hero-overlay"></div>
      <div class="project-hero-content">
        <div class="container">
          <div class="project-hero-meta">
            <span class="project-hero-eyebrow">{project.parish} · Andorra</span>
            <span
              class="project-hero-status"
              style={`background: ${statusColour[project.status]}`}
            >
              {project.status}
            </span>
          </div>
          <h1>{project.name}</h1>
          <p class="project-hero-tagline">{project.tagline}</p>
        </div>
      </div>
    </section>

    <!-- Key metrics strip -->
    <div class="project-metrics-strip">
      <div class="container">
        <div class="project-metrics-inner">
          <div class="project-metric-item">
            <span class="project-metric-value">{project.value}</span>
            <span class="project-metric-label">Project value</span>
          </div>
          <div class="project-metric-item">
            <span class="project-metric-value is-green">{project.fixedReturn} p.a.</span>
            <span class="project-metric-label">Fixed annual return</span>
          </div>
          <div class="project-metric-item">
            <span class="project-metric-value">{project.minInvestment}</span>
            <span class="project-metric-label">Minimum investment</span>
          </div>
          <div class="project-metric-item">
            <span class="project-metric-value">{project.holdPeriod}</span>
            <span class="project-metric-label">Hold period</span>
          </div>
          <div class="project-metric-item">
            <span class="project-metric-value">{project.completionDate}</span>
            <span class="project-metric-label">Est. completion</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Breadcrumb -->
    <div class="project-breadcrumb">
      <div class="container">
        <div class="project-breadcrumb-inner">
          <a href={buildLocalizedPath("/", locale)}>Home</a>
          <span class="project-breadcrumb-sep">/</span>
          <a href={buildLocalizedPath("/projects", locale)}>Projects</a>
          <span class="project-breadcrumb-sep">/</span>
          <span class="project-breadcrumb-current">{project.name}</span>
        </div>
      </div>
    </div>

    <!-- Body -->
    <section class="project-body">
      <div class="container">
        <div class="project-body-grid">

          <!-- Left column -->
          <div class="project-main">

            <!-- Gallery -->
            <div class="project-section" data-animate>
              <div class="project-gallery">
                {project.gallery.map((src, i) => (
                  <img src={src} alt={`${project.name} — image ${i + 1}`} loading={i === 0 ? "eager" : "lazy"} />
                ))}
              </div>
            </div>

            <!-- Description -->
            <div class="project-section" data-animate>
              <p class="project-section-label">About this project</p>
              <h2>Project Overview</h2>
              <p>{project.description}</p>
            </div>

            <!-- Investment Case -->
            <div class="project-section" data-animate>
              <p class="project-section-label">Why invest</p>
              <h2>The Investment Case</h2>
              <p>{project.investmentCase}</p>
            </div>

            <!-- Highlights -->
            <div class="project-section" data-animate>
              <p class="project-section-label">Key features</p>
              <h2>Project Highlights</h2>
              <ul class="project-highlights">
                {project.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>

            <!-- Milestones -->
            <div class="project-section" data-animate>
              <p class="project-section-label">Timeline</p>
              <h2>Development Milestones</h2>
              <div class="project-milestones">
                {project.milestones.map((m) => (
                  <div class="project-milestone">
                    <div class="project-milestone-track">
                      <div class={`project-milestone-dot${m.done ? " is-done" : ""}`}>
                        <svg viewBox="0 0 12 12">
                          <polyline points="2,6 5,9 10,3"/>
                        </svg>
                      </div>
                      <div class="project-milestone-line"></div>
                    </div>
                    <div class="project-milestone-content">
                      <p class={`project-milestone-label${m.done ? " is-done" : ""}`}>{m.label}</p>
                      <span class="project-milestone-date">{m.date}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Regulatory note -->
            <div class="project-section" data-animate>
              <p class="project-reg-note">{project.regulatoryNote}</p>
            </div>

            <!-- Back link -->
            <div class="project-back-section" data-animate>
              <a class="project-back-link" href={buildLocalizedPath("/projects", locale)}>
                <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                Back to all projects
              </a>
            </div>

          </div>

          <!-- Right sidebar -->
          <aside class="project-sidebar">

            <!-- Investment details card -->
            <div class="project-sidebar-card" data-animate>
              <div class="project-sidebar-card-header">
                <h3>Investment Details</h3>
              </div>
              <div class="project-sidebar-card-body">
                <div class="project-detail-row">
                  <span class="project-detail-key">Project value</span>
                  <span class="project-detail-val">{project.value}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Investment required</span>
                  <span class="project-detail-val">{project.investmentRequired}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Min. investment</span>
                  <span class="project-detail-val">{project.minInvestment}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Fixed return</span>
                  <span class="project-detail-val is-green">{project.fixedReturn} p.a.</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Profit share</span>
                  <span class="project-detail-val">{project.profitShare} on exit</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Hold period</span>
                  <span class="project-detail-val">{project.holdPeriod}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Return structure</span>
                  <span class="project-detail-val" style="font-size:0.72rem">{project.returnStructure}</span>
                </div>
              </div>
            </div>

            <!-- Property details card -->
            <div class="project-sidebar-card" data-animate>
              <div class="project-sidebar-card-header">
                <h3>Property Details</h3>
              </div>
              <div class="project-sidebar-card-body">
                <div class="project-detail-row">
                  <span class="project-detail-key">Location</span>
                  <span class="project-detail-val">{project.location}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Sector</span>
                  <span class="project-detail-val">{project.sector}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Units</span>
                  <span class="project-detail-val">{project.units}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Total area</span>
                  <span class="project-detail-val">{project.sqm}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Floors</span>
                  <span class="project-detail-val">{project.floors}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Est. completion</span>
                  <span class="project-detail-val">{project.completionDate}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">Planning status</span>
                  <span class="project-detail-val" style="font-size:0.72rem">{project.planningStatus}</span>
                </div>
              </div>
            </div>

            <!-- CTA card -->
            <div class="project-cta-card" data-animate>
              <h3>Interested in this project?</h3>
              <p>Speak with our team to receive the full investment memorandum and discuss your investment profile.</p>
              <a class="project-cta-btn" href={buildLocalizedPath("/contact", locale)}>
                Contact our Team
                <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>

          </aside>

        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId={`newsletter-email-${project.slug}`} locale={locale} />
    <SiteFooter locale={locale} />

    <script type="module">
      const targets = document.querySelectorAll("[data-animate]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.06 }
      );
      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
