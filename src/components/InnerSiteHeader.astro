---
interface Props {
  active?: "home" | "about" | "partners" | "blog" | "test";
  menuToggleId: string;
  offsetFirstSection?: boolean;
}

const { active, menuToggleId, offsetFirstSection = true } = Astro.props;
const menuPanelId = `${menuToggleId}-panel`;
---

<header class:list={["site-header", offsetFirstSection && "offset-next-section"]}>
  <button
    class="menu-toggle"
    type="button"
    aria-label="Toggle navigation menu"
    aria-controls={menuPanelId}
    aria-expanded="false"
  >
    <span class="menu-toggle-bars"></span>
  </button>
  <a href="/" aria-label="Go to homepage">
    <img
      class="logo"
      src="/images/branding/equity-partners-logo-light%20small.png"
      alt="Equity Partners logo"
    />
  </a>
  <nav class="main-nav" aria-label="Primary">
    <ul class="menu-list">
      <li><a class:list={["menu-link", active === "home" && "is-active"]} href="/">Home</a></li>
      <li><a class="menu-link" href="/#team">Services</a></li>
      <li><a class:list={["menu-link", active === "about" && "is-active"]} href="/about">About</a></li>
      <li><a class:list={["menu-link", active === "partners" && "is-active"]} href="/partners">Partners</a></li>
      <li><a class:list={["menu-link", active === "blog" && "is-active"]} href="/blog">Blog</a></li>
      <li><a class:list={["menu-link", active === "test" && "is-active"]} href="/test">Test</a></li>
    </ul>
    <a class="menu-cta" href="/contact">Contact Us</a>
  </nav>
  <div class="menu-backdrop" aria-hidden="true"></div>
  <div class="mobile-drawer" id={menuPanelId} aria-label="Mobile navigation">
    <div class="mobile-drawer-head">
      <button class="menu-close" type="button" aria-label="Close navigation menu">
        <span aria-hidden="true">×</span>
      </button>
      <a href="/" class="mobile-drawer-brand" aria-label="Go to homepage">
        <img
          class="mobile-drawer-logo"
          src="/images/branding/1%20copy.png"
          alt="Equity Partners logo"
        />
      </a>
    </div>
    <div class="mobile-drawer-divider" aria-hidden="true"></div>
    <ul class="mobile-drawer-list">
      <li><a class:list={["mobile-drawer-link", active === "home" && "is-active"]} href="/">Home</a></li>
      <li><a class="mobile-drawer-link" href="/#team">Services</a></li>
      <li><a class:list={["mobile-drawer-link", active === "about" && "is-active"]} href="/about">About</a></li>
      <li><a class:list={["mobile-drawer-link", active === "partners" && "is-active"]} href="/partners">Partners</a></li>
      <li><a class:list={["mobile-drawer-link", active === "blog" && "is-active"]} href="/blog">Blog</a></li>
      <li><a class:list={["mobile-drawer-link", active === "test" && "is-active"]} href="/test">Test</a></li>
    </ul>
    <a class="mobile-drawer-cta" href="/contact">Contact Us</a>
  </div>
</header>

<script define:vars={{ menuPanelId }}>
  const panel = document.getElementById(menuPanelId);
  const header = panel?.closest(".site-header");
  const toggle = header?.querySelector(".menu-toggle");
  const closeButton = header?.querySelector(".menu-close");
  const backdrop = header?.querySelector(".menu-backdrop");

  if (
    panel instanceof HTMLElement &&
    header instanceof HTMLElement &&
    toggle instanceof HTMLButtonElement &&
    closeButton instanceof HTMLButtonElement &&
    backdrop instanceof HTMLDivElement
  ) {
    const closeMenu = () => {
      header.classList.remove("is-menu-open");
      document.body.classList.remove("mobile-nav-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    const openMenu = () => {
      header.classList.add("is-menu-open");
      document.body.classList.add("mobile-nav-open");
      toggle.setAttribute("aria-expanded", "true");
      closeButton.focus();
    };

    toggle.addEventListener("click", () => {
      if (window.innerWidth > 980) return;
      if (header.classList.contains("is-menu-open")) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeButton.addEventListener("click", closeMenu);
    backdrop.addEventListener("click", closeMenu);

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.classList.contains("is-menu-open")) {
        closeMenu();
        toggle.focus();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 980) {
        closeMenu();
      }
    });
  }
</script>

<style>
  :global(:root) {
    --inner-page-offset: clamp(5.5rem, 7vw, 6.5rem);
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
  }

  .site-header,
  .site-header *,
  .site-header *::before,
  .site-header *::after {
    box-sizing: border-box;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 1.8rem;
    padding-top: 2.15rem;
    padding-bottom: 0.15rem;
    padding-left: calc((100vw - min(1120px, 92vw)) / 2);
    padding-right: calc((100vw - min(1120px, 92vw)) / 2);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    transform: none;
    width: 100%;
    z-index: 220;
    background: rgba(15, 26, 42, 0.92);
    border-bottom: 1px solid transparent;
    border-radius: 0;
    transition:
      padding-top 320ms ease,
      padding-bottom 320ms ease,
      background-color 320ms ease,
      backdrop-filter 320ms ease,
      -webkit-backdrop-filter 320ms ease,
      border-color 320ms ease,
      box-shadow 320ms ease;
  }

  .site-header.offset-next-section + :global(section) {
    margin-top: var(--inner-page-offset);
  }

  :global(body.is-scrolled) .site-header {
    background: rgba(15, 26, 42, 0.6);
    padding-top: 1.25rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom-color: rgba(220, 231, 246, 0.2);
    box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
  }

  :global(body.is-scrolled) .logo {
    top: -5px;
  }

  :global(body.is-scrolled) .main-nav {
    top: -7px;
  }

  :global(body.is-scrolled) .menu-cta {
    top: 0;
  }

  .logo {
    width: 180px;
    height: auto;
    position: relative;
    top: -12px;
    filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
    transition: top 320ms ease, margin-top 320ms ease;
  }

  .main-nav {
    display: flex;
    align-items: center;
    margin-left: auto;
    flex-wrap: nowrap;
    gap: 1.3rem;
    position: relative;
    top: -11px;
    z-index: 121;
    transition: top 320ms ease;
  }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0.45rem;
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: top 320ms ease;
  }

  .menu-toggle-bars {
    display: block;
    width: 18px;
    height: 2px;
    background: #ffffff;
    position: relative;
    transition: background 220ms ease;
  }

  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: #ffffff;
    transition: transform 220ms ease, top 220ms ease;
  }

  .menu-toggle-bars::before {
    top: -6px;
  }

  .menu-toggle-bars::after {
    top: 6px;
  }

  .menu-list {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    white-space: nowrap;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
  }

  .menu-link:hover,
  .menu-link.is-active {
    color: #d7e3f5;
  }

  .menu-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    top: 1px;
    flex: 0 0 auto;
    min-width: 126px;
    color: #ffffff;
    background: #53b27f;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    border-radius: 0.45rem;
    padding: 0.65rem 0.95rem;
    font-weight: 600;
    line-height: 1;
    border: 1px solid #53b27f;
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      transform 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .menu-cta:hover {
    background: #3f9568;
    border-color: #3f9568;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
  }

  .menu-cta:focus-visible {
    outline: 2px solid rgba(216, 227, 242, 0.5);
    outline-offset: 3px;
  }

  .menu-backdrop,
  .mobile-drawer {
    display: none;
  }

  @supports not ((backdrop-filter: blur(1px))) {
    :global(body.is-scrolled) .site-header {
      background: rgba(15, 26, 42, 0.84);
    }
  }

  @media (max-width: 980px) {
    .site-header {
      gap: 0.65rem;
      min-height: 44px;
    }

    :global(body.is-scrolled) .site-header {
      padding-top: 2.15rem;
      padding-bottom: 0.15rem;
    }

    :global(body.is-scrolled) .logo {
      top: -12px;
    }

    :global(body.is-scrolled) .main-nav {
      top: -11px;
    }

    .main-nav {
      position: static;
      gap: 0.55rem;
    }

    .menu-toggle {
      display: inline-flex;
      position: relative;
      top: -10px;
      border: 0;
      box-shadow: none;
      z-index: 250;
    }

    .menu-list {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: max(0.8rem, calc((100vw - min(1120px, 92vw)) / 2));
      min-width: min(220px, calc(100vw - 2rem));
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      padding: 0;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-8px);
      pointer-events: none;
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid #d3ddea;
      border-radius: 0.6rem;
      transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
      z-index: 220;
    }

    .menu-list .menu-link {
      width: 100%;
      color: #172235;
      text-shadow: none;
      font-size: 0.76rem;
      padding: 0.3rem 0;
    }

    .menu-list .menu-link:hover,
    .menu-list .menu-link.is-active {
      color: #5e7393;
    }

    .menu-cta {
      display: inline-flex;
      top: -10px;
      min-width: 102px;
      padding: 0.58rem 0.8rem;
      font-size: 0.68rem;
    }

    :global(body.is-scrolled) .menu-cta {
      top: -10px;
    }

    .menu-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(8, 14, 23, 0.36);
      opacity: 0;
      pointer-events: none;
      transition: opacity 240ms ease;
      z-index: 230;
    }

    .mobile-drawer {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      width: min(75vw, 26rem);
      max-width: 100%;
      height: 100vh;
      flex-direction: column;
      gap: 1.8rem;
      padding: 1.2rem 1.15rem 1.5rem;
      background: #ffffff;
      border-top-right-radius: 1rem;
      border-bottom-right-radius: 1rem;
      box-shadow: 0 22px 46px rgba(11, 18, 29, 0.18);
      transform: translateX(-100%);
      transition: transform 260ms ease;
      z-index: 240;
    }

    .mobile-drawer-head {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin: -1.2rem -1.15rem 0;
      min-height: 6rem;
      padding: 1.75rem 1.15rem 1.25rem;
      background: #172235;
      border-top-right-radius: 1rem;
    }

    .mobile-drawer-brand {
      display: inline-flex;
      align-items: center;
    }

    .mobile-drawer-logo {
      width: 180px;
      height: auto;
      filter: none;
    }

    .menu-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      padding: 0;
      margin-top: 0.35rem;
      border: 0;
      background: transparent;
      color: #ffffff;
      font-size: 1.8rem;
      line-height: 1;
      cursor: pointer;
    }

    .mobile-drawer-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.15rem;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .mobile-drawer-divider {
      width: 100%;
      height: 1px;
      background: #dbe2ec;
    }

    .mobile-drawer-link {
      display: inline-flex;
      width: 100%;
      color: #172235;
      text-decoration: none;
      font-size: 0.8rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 600;
      line-height: 1;
      padding: 0.15rem 0;
    }

    .mobile-drawer-link:hover,
    .mobile-drawer-link.is-active {
      color: #5e7393;
    }

    .mobile-drawer-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      margin-top: auto;
      color: #ffffff;
      background: #53b27f;
      text-decoration: none;
      font-size: 0.72rem;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      border-radius: 0.45rem;
      padding: 0.8rem 0.95rem;
      font-weight: 600;
      line-height: 1;
      border: 1px solid #53b27f;
    }

    .site-header.is-menu-open .menu-toggle .menu-toggle-bars {
      background: transparent;
    }

    .site-header.is-menu-open .menu-toggle .menu-toggle-bars::before {
      top: 0;
      transform: rotate(45deg);
    }

    .site-header.is-menu-open .menu-toggle .menu-toggle-bars::after {
      top: 0;
      transform: rotate(-45deg);
    }

    .site-header.is-menu-open .menu-toggle {
      opacity: 0;
      pointer-events: none;
    }

    .site-header.is-menu-open .menu-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .site-header.is-menu-open .mobile-drawer {
      transform: translateX(0);
    }
  }
</style>
