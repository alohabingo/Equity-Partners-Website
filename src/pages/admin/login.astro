---
export const prerender = false;

import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";
import { supabaseServer, isSupabaseConfigured } from "../../lib/supabase";

// Already logged in? Straight to the dashboard.
if (isSupabaseConfigured()) {
  const supabase = supabaseServer(Astro.cookies, Astro.request);
  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (user) return Astro.redirect("/admin");
}

const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  credentials: "Invalid email or password.",
  missing: "Please fill in both fields.",
  noprofile: "Your account has no profile. Contact an administrator.",
  setup: "Backend is not configured yet — add the Supabase keys to .env and restart.",
};
const errorMessage = error ? (errorMessages[error] ?? "Something went wrong. Try again.") : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Login | Equity Partners</title>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        background: radial-gradient(1100px 700px at 20% -10%, #17304f 0%, #0b1626 55%, #070f1b 100%);
        color: #e9eef7;
        padding: 1.5rem;
      }
      .card {
        width: 100%;
        max-width: 400px;
        background: rgba(13, 25, 43, 0.85);
        border: 1px solid rgba(193, 206, 227, 0.14);
        border-radius: 14px;
        padding: 2.4rem 2.2rem;
        box-shadow: 0 24px 60px rgba(4, 9, 17, 0.55);
      }
      .brand {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #53b27f;
      }
      h1 {
        margin-top: 0.6rem;
        font-size: 1.45rem;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .sub { margin-top: 0.35rem; font-size: 0.85rem; color: #9fb0c9; }
      form { margin-top: 1.8rem; display: grid; gap: 1rem; }
      label {
        display: grid;
        gap: 0.4rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #c1cee3;
      }
      input {
        font: inherit;
        font-size: 0.95rem;
        color: #ffffff;
        background: rgba(7, 15, 27, 0.7);
        border: 1px solid rgba(193, 206, 227, 0.22);
        border-radius: 8px;
        padding: 0.7rem 0.85rem;
        outline: none;
        transition: border-color 180ms ease;
      }
      input:focus { border-color: #53b27f; }
      button {
        font: inherit;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
        color: #071018;
        background: #53b27f;
        border: 0;
        border-radius: 8px;
        padding: 0.8rem;
        cursor: pointer;
        transition: filter 180ms ease, transform 180ms ease;
      }
      button:hover { filter: brightness(1.08); transform: translateY(-1px); }
      .error {
        margin-top: 1.2rem;
        padding: 0.7rem 0.9rem;
        border-radius: 8px;
        background: rgba(203, 76, 76, 0.14);
        border: 1px solid rgba(203, 76, 76, 0.4);
        color: #f1b9b9;
        font-size: 0.85rem;
      }
      .back {
        display: inline-block;
        margin-top: 1.6rem;
        font-size: 0.78rem;
        color: #9fb0c9;
        text-decoration: none;
      }
      .back:hover { color: #ffffff; }
    </style>
  </head>
  <body>
    <main class="card">
      <p class="brand">Equity Partners</p>
      <h1>Admin Portal</h1>
      <p class="sub">Sign in with your team account.</p>
      {errorMessage && <p class="error">{errorMessage}</p>}
      <form method="post" action="/api/auth/signin">
        <label>
          Email
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label>
          Password
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Sign in</button>
      </form>
      <a class="back" href="/">← Back to website</a>
    </main>
  </body>
</html>
