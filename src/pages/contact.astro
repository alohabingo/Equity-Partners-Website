                <select class="input" name="investor_type" required>
                  <option value="" disabled selected>{content.form.investorType}</option>
                  {content.form.investorTypeOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
                <select class="input" name="investment_timeline" required>
                  <option value="" disabled selected>{content.form.investmentTimeline}</option>
                  {content.form.investmentTimelineOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
                <select class="input" name="investment_range" required>
                  <option value="" disabled selected>{content.form.investmentRange}</option>
                  {content.form.investmentRangeOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
                <textarea class="textarea" name="message" placeholder={content.form.message}></textarea>
                <button class="submit" type="submit">{content.form.submit}</button>
              </form>
            </div>

          </article>

          <article class="contact-card contact-info-card">

            <div class="contact-info-header">
