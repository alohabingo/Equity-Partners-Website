        border-right: 1px solid #e4eaf3;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0;
        transition: background 200ms ease;
      }

      .timeline-v2-col:last-child {
        border-right: none;
      }

      .timeline-v2-col:hover {
        background: #f6f9fd;
      }

      .timeline-v2-col:hover .timeline-v2-step-icon {
        background: #e6f7f0;
        border-color: #2e8a59;
      }

