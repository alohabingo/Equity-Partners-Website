---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import EnquiryPanel from "../../../components/admin/EnquiryPanel.astro";
import UnitRows from "../../../components/admin/UnitRows.astro";
import LeadRows, { type LeadRow } from "../../../components/admin/LeadRows.astro";
import LostReasonAsk from "../../../components/admin/LostReasonAsk.astro";
import { PARKING_STATES, parkingPrice, parkingTally, parkingState } from "../../../lib/parking";
import LeadProfile from "../../../components/admin/LeadProfile.astro";
import { supabaseServer } from "../../../lib/supabase";
import { BUYER_STAGES, stageLabel, stageShade, OVERDUE_WORKING_DAYS } from "../../../lib/pipeline";
import { UNIT_STATES, SALES_BAR_ORDER, unitState, summarise, unitStateTheme, euros, type UnitRow } from "../../../lib/units";
import {
  TEMPLATE_LOCALES, TEMPLATE_LOCALE_LABEL, TEMPLATE_PLACEHOLDERS, TEMPLATE_COLUMNS,
  writtenIn, bodyIn, type ReplyTemplate,
} from "../../../lib/replyTemplates";
import {
  DOCUMENT_CATEGORIES, categoryLabel, fileKind, humanSize, LINK_EXPIRY_DAYS,
  type ProjectDocument,
} from "../../../lib/projectDocuments";
import { LEAD_SOURCES, bucketOf, needsAttention, BUCKET_LABELS, isLive, shortAge, plain, REJECT_REASONS, rejectReasonLabel, LOCALE_OPTIONS, localeChip, localeTitle, type EnquiryRow } from "../../../lib/enquiries";

const { slug } = Astro.params;
const supabase = supabaseServer(Astro.cookies, Astro.request);
const me = Astro.locals.user;

// How the last reply went. The endpoint puts this on the URL because a send
// that failed must not look like one that worked.
const sent = Astro.url.searchParams.get("sent") === "1";
const sendError = Astro.url.searchParams.get("send_error");
const sentDocs = Number(Astro.url.searchParams.get("docs") ?? 0) || 0;

const { data: project } = await supabase
  .from("projects").select("*").eq("slug", slug).maybeSingle();
if (!project) return Astro.redirect("/admin/projects");

// Which tab is open is settled BEFORE the queries, because it decides which of
// them are worth sending at all.
const VALID_TABS = ["overview", "units", "leads", "inbox", "templates", "documents", "settings"] as const;
const tabParam = Astro.url.searchParams.get("tab") ?? "overview";
const tab = (VALID_TABS as readonly string[]).includes(tabParam) ? tabParam : "overview";

// Two tabs need the saved replies: the Templates tab edits them, the Inbox
// composer offers them.
const wantsTemplates = tab === "inbox" || tab === "templates";
// The Inbox offers documents in the composer; the Documents tab manages them.
const wantsDocuments = tab === "inbox" || tab === "documents";

// Everything the page needs about this project, fetched AT ONCE.
//
// These six were six separate awaits, so the browser waited for each round trip
// before the next was even sent — about half a second of dead time before a
// single byte of HTML went out. That is what made switching tabs feel glitchy:
// the browser holds the old page on screen until the new one is ready, so
// server latency shows up as a frozen page rather than as slowness.
//
// None of them depends on another; they only depend on `project`. So they go
// together, and the page now waits for the slowest one instead of the sum.
const [contentRes, unitRes, buildingRes, enquiryRes, profileRes, rejectionRes, templateRes, parkingRes, documentRes] = await Promise.all([
  supabase.from("portfolio_items").select("name, data")
    .eq("slug", slug).eq("kind", "project").eq("locale", "en").maybeSingle(),
  supabase.from("project_units")
    .select("id, code, state, price, inquiry_id, position, building_id")
    .eq("project_id", project.id).order("position"),
  supabase.from("project_buildings").select("id, name, kind, notes, position")
    .eq("project_id", project.id).order("position"),
  supabase.from("enquiry_state").select("*")
    .eq("project_id", project.id).order("last_activity_at", { ascending: false }),
  supabase.from("profiles").select("id, full_name"),
  supabase.from("ingest_log").select("outcome, reason, created_at")
    .eq("project_id", project.id).eq("outcome", "rejected")
    .is("acknowledged_at", null)
    .order("created_at", { ascending: false }).limit(3),
  // This project's own saved replies. Templates belong to ONE project: wording
  // is where a development's character lives, and a sentence written for a ski
  // apartment should not be able to reach a valley townhouse's buyers.
  // This project's templates AND the starter kit in one trip. The kit is only
  // needed to tell "update the starter" apart from "add a new one", which is a
  // four-row question not worth a second round trip.
  wantsTemplates
    ? supabase.from("reply_templates").select(TEMPLATE_COLUMNS)
        .or(`project_id.eq.${project.id},project_id.is.null`)
        .order("position").order("created_at")
    : Promise.resolve({ data: [] }),
  tab === "settings" || tab === "units" || tab === "leads"
    ? supabase.from("project_parking")
        .select("id, code, price, state, notes, position")
        .eq("project_id", project.id).order("position")
    : Promise.resolve({ data: [] }),
  wantsDocuments
    ? supabase.from("documents")
        .select("id, title, category, storage_path, mime_type, file_size, created_at")
        .eq("project_id", project.id).order("category").order("title")
    : Promise.resolve({ data: [] }),
]);

const documents = (documentRes.data ?? []) as ProjectDocument[];

// What has actually been sent from each document, and whether anyone opened it.
// A second trip, made only on the tab that shows it: the ids are not known until
// the batch above comes back, so this one cannot be run alongside the others.
let linkStats = new Map<string, { sent: number; views: number; opened: number }>();
if (tab === "documents" && documents.length > 0) {
  const { data: links } = await supabase
    .from("document_links")
    .select("document_id, view_count")
    .in("document_id", documents.map((d) => d.id));

  for (const l of links ?? []) {
    const row = linkStats.get(l.document_id) ?? { sent: 0, views: 0, opened: 0 };
    row.sent += 1;
    row.views += l.view_count ?? 0;
    if ((l.view_count ?? 0) > 0) row.opened += 1;
    linkStats.set(l.document_id, row);
  }
}

const splitTemplates = (rows: ReplyTemplate[] | null) => ({
  mine: (rows ?? []).filter((t) => t.project_id === project.id),
  starterIds: new Set((rows ?? []).filter((t) => t.project_id === null).map((t) => t.id)),
});

let { mine: templates, starterIds } = splitTemplates(templateRes.data as ReplyTemplate[] | null);

// The first time anyone opens Templates or the Inbox, a project is given its own
// copy of the starter kit — the templates that carry no project.
//
// This is a write during a GET, which is not something to do casually. It is
// once per project, and the claim happens inside seed_project_templates: the
// row is only stamped while templates_seeded_at is still NULL, so two tabs
// opened at the same moment cannot both copy the kit in. The stamp is what makes
// deleting every template stick, too — without it an emptied project would find
// the whole kit back on the next page load.
if (wantsTemplates && !project.templates_seeded_at) {
  await supabase.rpc("seed_project_templates", { p_project: project.id });
  // Re-read rather than trusting the count the function hands back. Another tab
  // may have won the claim a moment earlier, in which case this call correctly
  // copies nothing — and the templates it wants are nonetheless there now.
  const { data: seeded } = await supabase
    .from("reply_templates").select(TEMPLATE_COLUMNS)
    .or(`project_id.eq.${project.id},project_id.is.null`)
    .order("position").order("created_at");
  ({ mine: templates, starterIds } = splitTemplates(seeded as ReplyTemplate[] | null));
}

const content = contentRes.data;
const heroImage = typeof content?.data?.image === "string" ? content.data.image : "";
const dealStatus = typeof content?.data?.status === "string" ? content.data.status : "";

// The rail's facts come from the PUBLISHED marketing content, not a second copy
// typed into the operational record. One place to change a figure means the
// portal can't quietly disagree with the website.
const pdata: Record<string, any> = (content?.data ?? {}) as Record<string, any>;
const str = (k: string) => (typeof pdata[k] === "string" && pdata[k].trim() ? pdata[k].trim() : "");
const projectLocation = str("location");
const facts = [
  { k: "Units", v: str("units") },
  { k: "Site", v: str("sqm") },
  { k: "Value", v: str("value") },
  { k: "Completion", v: str("completionDate") },
].filter((f) => f.v);

// A small donut for the rail. The arithmetic is done here rather than in the
// template because an SVG arc is dash lengths along a circumference, and that
// is unreadable inline: each segment is drawn as a gap in a full circle, offset
// by everything before it.
const DONUT = { size: 112, r: 42, w: 15 };
const DONUT_C = 2 * Math.PI * DONUT.r;

const saved = Astro.url.searchParams.get("saved") === "1";

// The plaintext ingest key is shown exactly once, right after generation. It
// arrives in a short-lived httpOnly cookie rather than the URL — secrets don't
// belong in browser history, server logs or referrer headers. Reading it here
// also consumes it, so a refresh won't show it again.
const freshKeyCookie = Astro.cookies.get("ep_fresh_ingest_key");
const freshKey = freshKeyCookie?.value ?? "";
if (freshKey) Astro.cookies.delete("ep_fresh_ingest_key", { path: "/admin" });

// ---- units: the project's sellable stock ----
// Every sales figure on this page is COUNTED from these rows. Nothing types a
// total in anywhere, so the figures cannot quietly go stale.
const units = (unitRes.data ?? []) as UnitRow[];
const sales = summarise(units);

// How the project is laid out. A building's unit count is COUNTED here, never
// stored — "3 blocks of 12" typed into a field is a number that can disagree
// with the units actually recorded, and disagreeing numbers are how a portal
// stops being believed.
const buildings = (buildingRes.data ?? []) as { id: string; name: string; kind: string; notes: string | null; position: number }[];

const unitsInBuilding = (id: string | null) =>
  units.filter((u) => (u.building_id ?? null) === id);
const unplacedUnits = unitsInBuilding(null);

// What the "add" form suggests as a name: Block A on an empty project, Block B
// once there is one entry, and so on. It also steps past any letter already in
// use, so it can never suggest a name that is about to be rejected as a
// duplicate.
// There is no stored "unit type" — it is what the units are actually called.
// Deriving it means the card can never claim a building holds apartments while
// its rows all say Villa; the trade is that a mixed building reports "Mixed"
// rather than picking a winner, which is the honest answer.
const unitTypeOf = (buildingId: string | null): string => {
  const kinds = [...new Set(
    unitsInBuilding(buildingId)
      .map((u) => u.code.trim().replace(/\s+\d+$/, "").trim())
      .filter(Boolean),
  )];
  if (kinds.length === 0) return "—";
  return kinds.length === 1 ? kinds[0] : "Mixed";
};

const nextBlockName = (() => {
  const taken = new Set(
    buildings
      .map((b) => b.name.trim().match(/^block\s+([a-z])$/i)?.[1]?.toUpperCase())
      .filter((x): x is string => !!x),
  );
  let i = buildings.length;
  while (i < 26 && taken.has(String.fromCharCode(65 + i))) i += 1;
  return i < 26 ? `Block ${String.fromCharCode(65 + i)}` : "";
})();


let donutAt = 0;
const donutSegments = SALES_BAR_ORDER.map((key) => {
  const full = sales.total > 0 ? (sales[key] / sales.total) * DONUT_C : 0;
  const seg = { key, colour: unitState(key).colour, length: full, offset: donutAt };
  donutAt += full;
  return seg;
}).filter((seg) => seg.length > 0);

// A 2px breath between arcs, so two colours never touch — but only when there
// is more than one, or the single full ring would show a nick in it.
const DONUT_GAP = donutSegments.length > 1 ? 2 : 0;

// Parking sold apart from the home. Kept out of `units` on purpose: units drive
// the sales bar and "how much of this project is sold", and counting spaces in
// there would show a development as half sold before a home changed hands.
const parking = (parkingRes.data ?? []) as {
  id: string; code: string; price: number | null; state: string; notes: string | null; position: number;
}[];
const parkingCount = parkingTally(parking);

// Units and parking are two inventories on one tab, not two tabs: they are the
// same question — what is there and what is left — asked about two things, and
// a project tab each would put parking beside Inbox and Templates as if it were
// a part of the business rather than a column of stock.
// The switch only exists where there is something to switch to. A project that
// sells no parking should not carry a control offering an empty second list —
// and a URL asking for that list falls back rather than showing one.
const hasParking = parking.length > 0;
const unitView = hasParking && Astro.url.searchParams.get("show") === "parking" ? "parking" : "units";
const unitViewHref = (v: string) =>
  `/admin/projects/${slug}?tab=units${v === "parking" ? "&show=parking" : ""}`;

const unitsError = Astro.url.searchParams.get("units_error");
const unitsOk = Astro.url.searchParams.get("units_ok");

// ---- enquiries, with their derived waiting state ----
const allRows = (enquiryRes.data ?? []) as EnquiryRow[];

// Rejected enquiries are archived, not deleted - so they are held apart here
// and everything downstream works off `enquiries`. Doing it once, at the top,
// is why a rejected enquiry can't reappear in a stage count or a metric: there
// is no list further down that still contains it.
const enquiries = allRows.filter(isLive);
const rejected = allRows.filter((e) => !isLive(e));
// Who a unit can be sold to: this project's real buyers, resolved once rather
// than per row.
const buyerOptions = enquiries
  .filter((e) => e.triage === "converted")
  .map((e) => ({ id: e.id, name: e.name }));

const nameById = new Map((profileRes.data ?? []).map((p: any) => [p.id, p.full_name]));

const now = new Date();
const DAY = 86_400_000;
const since = (d: number) => new Date(now.getTime() - d * DAY);

const toTriage = enquiries.filter((e) => e.triage === "pending");
const newThisWeek = enquiries.filter((e) => new Date(e.created_at) > since(7)).length;
const newLastWeek = enquiries.filter(
  (e) => new Date(e.created_at) <= since(7) && new Date(e.created_at) > since(14),
).length;
// "We owe them something": they replied and we haven't, or we've never replied.
// Untriaged enquiries are excluded: we don't "owe a reply" to something nobody
// has decided is real. They have their own queue and their own count.
const awaitingReply = enquiries.filter(
  (e) => e.triage === "converted" && (e.waiting_on_us === true || e.message_count === 0),
).length;
const stageCount = (key: string) =>
  enquiries.filter((e) => e.triage === "converted" && (e.stage ?? "new") === key).length;

const attention = enquiries.filter((e) => needsAttention(e, now));

// ---- Leads tab ----
//
// Triaged-in buyers only: a pending enquiry is not a lead yet, and listing one
// here would make triage look like an optional step. Their count is surfaced
// above the table instead, so nothing goes quietly missing.
let leadRows: LeadRow[] = [];
let profiles: {
  lead: any; messages: any[]; notes: any[]; events: any[];
  activity: any[]; interest: any[]; parkingInterest: any[];
}[] = [];
if (tab === "leads") {
  const converted = allRows.filter((e) => (e.triage ?? "converted") === "converted");
  // When each buyer last MOVED. The endpoint that changes a stage already
  // writes one of these, so the age in the table resets itself with no extra
  // bookkeeping anywhere.
  const movedAt = new Map<string, string>();
  if (converted.length > 0) {
    const { data: moves } = await supabase
      .from("enquiry_events")
      .select("inquiry_id, created_at")
      .eq("kind", "stage_changed")
      .in("inquiry_id", converted.map((e) => e.id))
      .order("created_at", { ascending: false });
    // Newest first, so the first one seen for an enquiry is its latest.
    for (const m of moves ?? []) if (!movedAt.has(m.inquiry_id)) movedAt.set(m.inquiry_id, m.created_at);
  }

  // The units each buyer is looking at, for the list as well as the profile.
  // Declared out here because both are built from it and the fetch below only
  // runs when there is somebody to fetch for.
  const interestByLead = new Map<string, string[]>();

  // ---- every profile, fetched together ----
  //
  // Opening one used to be a page NAVIGATION: click a name, re-run every query
  // for the project, re-render the largest page in the portal, then show the
  // modal. That was chosen so the markup would not carry a profile per row —
  // an optimisation for a scale this does not have, paid for on every click.
  //
  // Doing all of them costs SIX queries, not six per lead: each fetches for
  // the whole set and is grouped in memory here. The profiles then sit in the
  // page closed, and a click just opens one, exactly like Add lead.
  if (converted.length > 0) {
    const ids = converted.map((e: any) => e.id);
    const [pm, pn, pe, pa, pi, pp] = await Promise.all([
      supabase.from("inquiry_messages").select("inquiry_id, direction, subject, sent_at, sent_by")
        .in("inquiry_id", ids).order("sent_at"),
      supabase.from("enquiry_notes").select("inquiry_id, body, created_at, author_id")
        .in("inquiry_id", ids).order("created_at", { ascending: false }),
      supabase.from("enquiry_events").select("inquiry_id, kind, detail, created_at, actor_id")
        .in("inquiry_id", ids).order("created_at", { ascending: false }),
      supabase.from("enquiry_activity")
        .select("id, inquiry_id, kind, body, happened_at, created_at, logged_by")
        .in("inquiry_id", ids).order("happened_at", { ascending: false }),
      supabase.from("enquiry_interest")
        .select("inquiry_id, unit_id, created_at")
        .in("inquiry_id", ids).order("created_at"),
      supabase.from("enquiry_parking_interest")
        .select("inquiry_id, parking_id, created_at")
        .in("inquiry_id", ids).order("created_at"),
    ]);

    const bucket = <T extends { inquiry_id: string }>(rows: T[] | null) => {
      const m = new Map<string, T[]>();
      for (const r of rows ?? []) {
        const list = m.get(r.inquiry_id);
        if (list) list.push(r); else m.set(r.inquiry_id, [r]);
      }
      return m;
    };
    const byMsg = bucket(pm.data as any[]);
    const byNote = bucket(pn.data as any[]);
    const byEvent = bucket(pe.data as any[]);
    const byActivity = bucket(pa.data as any[]);
    const byInterest = bucket(pi.data as any[]);
    const byParking = bucket(pp.data as any[]);
    const codeById = new Map(units.map((u: any) => [u.id, u.code]));
    for (const [leadId, rows] of byInterest) {
      interestByLead.set(leadId, rows.map((r: any) => codeById.get(r.unit_id)).filter(Boolean));
    }

    profiles = converted.map((lead: any) => ({
      lead,
      messages: (byMsg.get(lead.id) ?? []).map((x: any) => ({ ...x, sentByName: nameById.get(x.sent_by) ?? null })),
      notes: (byNote.get(lead.id) ?? []).map((x: any) => ({ ...x, author: nameById.get(x.author_id) ?? "Someone" })),
      events: (byEvent.get(lead.id) ?? []).map((x: any) => ({ ...x, actor: nameById.get(x.actor_id) ?? "System" })),
      activity: (byActivity.get(lead.id) ?? []).map((x: any) => ({ ...x, who: nameById.get(x.logged_by) ?? "Someone" })),
      interest: byInterest.get(lead.id) ?? [],
      parkingInterest: byParking.get(lead.id) ?? [],
    }));
  }

  leadRows = converted.map((e: any) => ({
    id: e.id,
    name: e.name,
    email: e.email,
    stage: e.stage ?? "new",
    locale: e.locale ?? null,
    project_id: e.project_id ?? project.id,
    // No movement recorded means they have not moved: they have been sitting in
    // the stage they arrived in since the day they arrived.
    since: movedAt.get(e.id) ?? e.created_at,
    properties: interestByLead.get(e.id) ?? [],
    lost_reason: e.lost_reason ?? null,
  }));
}
const groups = (["triage", "waiting", "overdue"] as const)
  .map((b) => ({ bucket: b, label: BUCKET_LABELS[b], items: attention.filter((e) => bucketOf(e, now) === b) }))
  .filter((g) => g.items.length > 0);

const maxStage = Math.max(1, ...BUYER_STAGES.map((s) => stageCount(s.key)));

// Two cards, not one queue: deciding whether someone is a real buyer and
// chasing someone who already is are different jobs, done at different moments.
// Both still come from the same bucketing, so nothing can appear in both.
const triageItems = groups.find((g) => g.bucket === "triage")?.items ?? [];
const followUpGroups = groups.filter((g) => g.bucket !== "triage");
const followUpCount = followUpGroups.reduce((n, g) => n + g.items.length, 0);

// ---- inbox: segment + selected enquiry ----
const SEGMENTS = [
  { key: "needs", label: "Needs you", rows: attention },
  { key: "triage", label: "To triage", rows: toTriage },
  { key: "all", label: "All", rows: enquiries },
  // Last, and only ever reached deliberately - rejecting is meant to make an
  // enquiry go away, but recoverably.
  { key: "rejected", label: "Rejected", rows: rejected },
];
const segParam = Astro.url.searchParams.get("seg") ?? "needs";
const segment = SEGMENTS.find((s) => s.key === segParam) ?? SEGMENTS[0];
const inboxRows = segment.rows;

const selectedId = Astro.url.searchParams.get("e") ?? inboxRows[0]?.id ?? "";
const selected = allRows.find((e) => e.id === selectedId) ?? null;

let messages: any[] = [];
let notes: any[] = [];
let events: any[] = [];
let linkViews: Record<string, number> = {};

// Only the Inbox draws a conversation. Without the tab check these ran on every
// tab, so opening the Overview fetched an email thread, its notes and its
// history that nothing on that page shows.
if (selected && tab === "inbox") {
  const [m, n, ev, sentLinks] = await Promise.all([
    supabase.from("inquiry_messages").select("direction, subject, body_html, sent_at, sent_by")
      .eq("inquiry_id", selected.id).order("sent_at"),
    supabase.from("enquiry_notes").select("body, created_at, author_id")
      .eq("inquiry_id", selected.id).order("created_at", { ascending: false }),
    supabase.from("enquiry_events").select("kind, detail, created_at, actor_id")
      .eq("inquiry_id", selected.id).order("created_at", { ascending: false }).limit(12),
    // What this buyer was actually sent, and whether they opened it.
    supabase.from("document_links").select("id, view_count").eq("inquiry_id", selected.id),
  ]);
  // The mailbox is shared, so an outbound message says who actually wrote it
  // rather than assuming it was whoever happens to be reading the thread.
  messages = (m.data ?? []).map((x: any) => ({ ...x, sentByName: nameById.get(x.sent_by) ?? null }));
  notes = (n.data ?? []).map((x: any) => ({ ...x, author: nameById.get(x.author_id) ?? "Someone" }));
  events = (ev.data ?? []).map((x: any) => ({ ...x, actor: nameById.get(x.actor_id) ?? "System" }));
  linkViews = Object.fromEntries((sentLinks.data ?? []).map((l: any) => [l.id, l.view_count ?? 0]));
}

// ---- setup state ----
const hasDomain = !!project.domain;
const hasKey = !!project.ingest_key_hash;
const receivedAny = enquiries.length > 0;

// The checklist follows the mailbox route, which is how enquiries actually
// arrive: the website form emails the project inbox, and people email it
// directly too. The webhook is an optional extra, so it isn't a step here.
const steps = [
  { done: hasDomain, label: "Add the project domain", hint: "Identifies the site this project belongs to." },
  { done: !!project.mailbox_connected_at, label: "Connect the mailbox",
    hint: "Lets enquiries arrive automatically and replies go out from the project address." },
  { done: receivedAny, label: "First enquiry arrives",
    hint: "Ticks itself once mail from the inbox has been picked up." },
];
const remaining = steps.filter((s) => !s.done && !s.later).length;

// Only rejections nobody has dismissed yet. The rows stay either way — the log
// is the record that a submission was refused, and that remains true after it
// has been read.
const rejections = rejectionRes.data;

const inboxHref = (opts: { seg?: string; e?: string }) => {
  const p = new URLSearchParams({ tab: "inbox", seg: opts.seg ?? segment.key });
  if (opts.e) p.set("e", opts.e);
  return `/admin/projects/${slug}?${p.toString()}`;
};
// Where a form action returns to. Outcome parameters are stripped out first:
// leaving them in would stack "&sent=1" on every send, and would keep showing a
// stale banner over an action that had just gone perfectly well.
const backParams = new URLSearchParams(Astro.url.search);
backParams.delete("sent");
backParams.delete("send_error");
backParams.delete("mailbox");
backParams.delete("notice");
backParams.delete("parking_notice");
const selfHref = Astro.url.pathname + (backParams.size ? `?${backParams}` : "");

// One line under the tab row for "something just happened": the mailbox sync
// reports through it, and so does anything else that needs to say a word back.
const mailboxMessage =
  Astro.url.searchParams.get("mailbox") ?? Astro.url.searchParams.get("notice") ?? "";
/** Parking speaks for itself, inside its own card. */
const parkingNotice = Astro.url.searchParams.get("parking_notice") ?? "";

const mailboxConnected = !!project.mailbox_connected_at;
const oauthReady = !!(import.meta.env.ZOHO_OAUTH_CLIENT_ID && import.meta.env.ZOHO_OAUTH_CLIENT_SECRET);

const webhookUrl = `${Astro.url.origin}/api/ingest/inquiry`;

const snippet = `// Example only — any language or form service can do this.
// The endpoint also accepts urlencoded and multipart bodies.
await fetch("${webhookUrl}", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "X-Ingest-Key": process.env.EP_INGEST_KEY,   // never expose this in the browser
  },
  body: JSON.stringify({
    name:    "Marta Puig",
    email:   "marta@example.com",
    phone:   "+376 300 111",       // optional
    message: "Interested in villa 4",
    locale:  "ca",                 // optional: en | es | ca
    source_page: "/vila-4",        // optional
  }),
});`;
---

<AdminLayout title={project.name} active={`project:${slug}`}>
  <style is:global>
    /* Cross-document view transitions: the browser cross-fades the old page into
       the new one and morphs any element the two share a view-transition-name
       for — here, the switcher's thumb, which slides between tabs.
       Global because @view-transition applies to the document, not a selector.
       Unsupported browsers ignore the whole rule and simply navigate. */
    @view-transition { navigation: auto; }

    /* The thumb travels on a slight overshoot, the same easing the switcher
       uses when it moves within a page — so the two are one motion, not two
       different-feeling ones. */
    ::view-transition-group(tab-thumb),
    ::view-transition-group(tab-label) {
      animation-duration: 380ms;
      animation-timing-function: cubic-bezier(0.32, 1.15, 0.44, 1);
    }

    /* The body of the page does not merely cross-fade: the outgoing content
       drops a few pixels as it goes and the incoming rises into place, which is
       what makes a full page load read as a switch rather than a flash. */
    ::view-transition-old(root) {
      animation: 200ms cubic-bezier(0.4, 0, 1, 1) both vt-leave;
    }
    ::view-transition-new(root) {
      animation: 320ms cubic-bezier(0.16, 1, 0.3, 1) both vt-enter;
    }
    @keyframes vt-leave {
      to { opacity: 0; transform: translateY(6px); }
    }
    @keyframes vt-enter {
      from { opacity: 0; transform: translateY(10px); }
    }

    /* Browsers without view transitions get the same feeling by other means:
       the new page's content rises into place on load. Behind @supports so the
       two can never both run and read as a double take. */
    @supports not (view-transition-name: none) {
      @media (prefers-reduced-motion: no-preference) {
        .tabpane { animation: 300ms cubic-bezier(0.16, 1, 0.3, 1) both vt-enter; }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) { animation: none !important; }
    }

    /* AdminLayout wraps every select on the page and draws one chevron on the
       wrapper. These rules only retune that chevron for the unit pills: smaller,
       tucked closer in, and in the row's own state colour. Written here rather
       than in the scoped block because the wrapper is created by script and so
       has no scope attribute for Astro to match on. The extra class in the
       selector also puts it above the layout's own (0,2,1) rules. */
    .pick .select-wrap select.ep-select {
      padding-right: 1.75rem;
      padding-left: 0.85rem;
      padding-top: 0.34rem;
      padding-bottom: 0.34rem;
    }
    /* Drawn with borders rather than the layout's SVG: an SVG used as a
       background-image is its own document, so currentColor inside it resolves
       to black and never picks up the row's state colour. Two borders on a
       rotated box can. */
    .pick .select-wrap::after {
      right: 0.66rem;
      width: 7px; height: 7px; margin-top: -4px;
      background-image: none;
      border-right: 1.8px solid var(--ink, #93a3b8);
      border-bottom: 1.8px solid var(--ink, #93a3b8);
      transform: rotate(45deg);
    }
    .pick .select-wrap.is-open::after { transform: rotate(225deg); }
  </style>

  <style>
    /* No page title: the project's name is on the rail card, and the browser
       tab carries it too, so a heading above the switcher was saying the same
       thing a third time. The tab row is the first thing on the page. */

    /* ---- Overview: work on the left, the property on the right ---- */
    .ov { display: grid; grid-template-columns: minmax(0, 1fr) 348px; gap: 1rem; align-items: start; margin-top: 1.3rem; }
    .ov .strip { margin-top: 0; }
    /* .card.rail, not .rail: .card sets its own padding further down this
       stylesheet, and on equal specificity the later rule wins - which is what
       left the photo floating inside a white border instead of running to the
       card's edges. The padding moves inside, to .rbody. */
    .card.rail { overflow: hidden; padding: 0; }
    .rail .rphoto { display: block; width: 100%; height: 208px; object-fit: cover; }
    .rail .no-img { width: 100%; height: 208px; background: linear-gradient(120deg, #16283e, #0f2036); }
    .rail .rbody { padding: 1.2rem 1.4rem 1.3rem; }
    .rphoto-wrap { position: relative; }
    /* The status belongs to the photo, not to the name - and off that row the
       project name gets the full width, which is what keeps it on one line. */
    .rpill {
      position: absolute; top: 0.8rem; right: 0.85rem;
      background: rgba(255, 255, 255, 0.94); color: #a35700;
      box-shadow: 0 4px 14px rgba(15, 26, 42, 0.22);
    }
    /* Sits on the switcher's row, at the far end of it — the same height as the
       tabs, so the row reads as one control strip rather than a button parked
       above the content. */
    .tabrow {
      display: flex; align-items: center;
      justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    }
    .tabacts { display: flex; align-items: center; gap: 0.6rem; }
    .syncbtn {
      font: inherit; font-size: 0.78rem; font-weight: 700; color: #ffffff; background: #53b27f;
      border: 0; border-radius: 999px; padding: 0.55rem 1.25rem; cursor: pointer;
      box-shadow: 0 8px 20px rgba(83, 178, 127, 0.3);
      transition: background-color 200ms ease, transform 200ms ease;
    }
    .syncbtn:hover { background: #47a071; }
    .syncbtn:active { transform: translateY(1px); }
    .syncbtn.addlead {
      background: #ffffff; color: #2e7d54; border: 1px solid #b7dfc9; box-shadow: none;
    }
    .syncbtn.addlead:hover { background: rgba(83, 178, 127, 0.1); border-color: #53b27f; }

    .alform { display: grid; gap: 0.9rem 1.2rem; margin-top: 1rem; }
    .alrow { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1.2rem; }
    @media (max-width: 620px) { .alrow { grid-template-columns: 1fr; } }
    .alform .field { margin-top: 0; }
    .alfoot { display: flex; justify-content: flex-end; align-items: center; gap: 0.7rem; }
    .alfoot .btn { margin-top: 0; }
    .aldup {
      display: none; font-size: 0.8rem; line-height: 1.5; border-radius: 10px; padding: 0.6rem 0.8rem;
      background: rgba(176, 138, 46, 0.1); border: 1px solid rgba(176, 138, 46, 0.32); color: #8a6d24;
    }
    .aldup.on { display: block; }
    .aldup a { font-weight: 700; color: #8a6d24; }
    .syncmsg {
      margin-top: 0.8rem; font-size: 0.78rem; line-height: 1.45; color: #2e7d54;
      background: rgba(83, 178, 127, 0.1); border: 1px solid rgba(83, 178, 127, 0.28);
      border-radius: 10px; padding: 0.55rem 0.8rem;
      display: flex; align-items: flex-start; justify-content: space-between; gap: 0.8rem;
    }
    .msgx {
      flex: none; font-size: 1.05rem; line-height: 1; color: #2e7d54; opacity: 0.55;
      text-decoration: none; padding: 0 0.25rem; border-radius: 6px;
      transition: opacity 160ms ease, background-color 160ms ease;
    }
    .msgx:hover { opacity: 1; background: rgba(83, 178, 127, 0.16); }

    .rname {
      font-size: 1.02rem; font-weight: 700; line-height: 1.2;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .rloc { margin-top: 0.15rem; font-size: 0.75rem; color: #5c6f88; }
    .rpill {
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 0.22rem 0.6rem; border-radius: 999px; white-space: nowrap;
    }
    .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 1rem; }
    .fact .k { font-size: 0.66rem; letter-spacing: 0.05em; text-transform: uppercase; color: #93a3b8; }
    .fact .v { margin-top: 0.1rem; font-size: 0.92rem; font-weight: 700; }
    /* Card B, shrunk to fit the rail: the ring on the left, the three states
       read down the right. Small enough that the counts do the work and the
       ring is the shape of the thing rather than the measurement. */
    .donutrow { display: flex; align-items: center; gap: 1rem; margin-top: 0.8rem; }
    .donut { position: relative; flex: none; }
    .dcen { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
    .dcen b { font-size: 1.45rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
    .dcen span { display: block; margin-top: 0.15rem; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: #93a3b8; }
    .dlist { flex: 1; min-width: 0; display: grid; gap: 0.1rem; }
    .drow {
      display: grid; grid-template-columns: 9px 1fr auto auto; align-items: center; gap: 0.5rem;
      padding: 0.34rem 0; border-bottom: 1px solid #f2f5f9; font-size: 0.76rem;
    }
    .drow:last-child { border-bottom: 0; }
    .drow .dot { width: 9px; height: 9px; border-radius: 3px; }
    .drow .k { color: #5c6f88; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .drow b { font-weight: 700; }
    .drow .p { color: #93a3b8; font-size: 0.7rem; width: 34px; text-align: right; }
    .rnone { margin-top: 0.5rem; font-size: 0.76rem; color: #93a3b8; }

    .rsep { height: 1px; background: #eef2f7; margin: 1.1rem 0 0.8rem; }
    .rkv { display: flex; justify-content: space-between; gap: 0.8rem; font-size: 0.78rem; padding: 0.32rem 0; border-bottom: 1px solid #f2f5f9; }
    .rkv:last-child { border-bottom: 0; }
    .rkv span { color: #93a3b8; }
    .rkv b { font-weight: 700; text-align: right; word-break: break-word; }
    .rkv a { color: #2e7d54; text-decoration: none; font-weight: 700; }

    .cardhead { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
    .cardhead .hint { margin-left: auto; font-size: 0.72rem; color: #93a3b8; }
    /* ---- sales status ---- */
    /* 2px of surface between segments, so two colours never touch. */
    .s-bar { display: flex; gap: 2px; height: 26px; margin-top: 1.1rem; }
    .s-bar i { display: block; height: 100%; min-width: 4px; }
    .s-bar i:first-child { border-radius: 8px 0 0 8px; }
    .s-bar i:last-child { border-radius: 0 8px 8px 0; }
    .s-bar i:only-child { border-radius: 8px; }
    .s-leg { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.1rem; align-items: center; }
    .s-leg .it { display: flex; align-items: center; gap: 0.45rem; }
    .s-leg .dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }
    .s-leg .k { font-size: 0.76rem; color: #5c6f88; }
    .s-leg b { font-size: 0.9rem; font-weight: 700; }
    .s-leg .money { margin-left: auto; font-size: 0.78rem; font-weight: 700; color: #2e7d54; }
    .s-leg .money em { font-style: normal; font-weight: 500; color: #93a3b8; }

    .btn.top { margin-top: 0; margin-left: auto; padding: 0.5rem 1.1rem; font-size: 0.8rem; }
    .enqmodal.wide { width: min(920px, calc(100vw - 2.4rem)); }
    .msep { height: 1px; background: #eef2f7; margin: 1.4rem 0 1rem; }
    .msub-h { margin: 0; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #2e7d54; }
    .genform { display: flex; align-items: flex-end; gap: 0.9rem; flex-wrap: wrap; margin-top: 1rem; }
    /* Four equal columns and the button on the end. Equal rather than sized to
       their contents: the fields are a set of four choices about one building,
       and giving one of them the leftover width made the row read as three
       fields and an afterthought. */
    .modalform {
      display: grid; gap: 0.9rem;
      grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
      align-items: end;
    }
    .modalform .field { max-width: none; }
    .modalform .btn { margin-top: 0; }
    @media (max-width: 780px) {
      .modalform { grid-template-columns: minmax(0, 1fr); }
      .modalform .btn { justify-self: start; }
    }
    .genform .btn { margin-top: 0; }
    .genform .field { max-width: 190px; }
    /* The Units / Parking switch. The project header's own treatment — white
       track, navy gradient on the selected pill — so a view switch looks the
       same wherever it appears. */
    .uviews {
      display: inline-flex; padding: 0.25rem; border-radius: 999px;
      background: #ffffff; border: 1px solid #d5deea; box-shadow: 0 6px 18px rgba(15, 26, 42, 0.06);
    }
    .uview {
      font-size: 0.76rem; font-weight: 700; color: #46586f; text-decoration: none; white-space: nowrap;
      padding: 0.4rem 0.95rem; border-radius: 999px;
      transition: color 300ms ease, background-color 200ms ease;
    }
    .uview:hover:not(.on) { color: #2e7d54; }
    .uview.on {
      color: #ffffff; background: linear-gradient(180deg, #16283e 0%, #0f2036 100%);
      box-shadow: 0 6px 16px rgba(15, 26, 42, 0.28);
    }

    /* Parking: the unit state pill's colours, on a plain span rather than a
       control, because this one only reports. */
    .pstate {
      display: inline-block; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.03em;
      color: var(--ink); background: var(--bg); border: 1px solid var(--bd);
      border-radius: 999px; padding: 0.2rem 0.6rem; white-space: nowrap;
    }
    .pnote { color: #5c6f88; }
    .prowall { display: flex; justify-content: flex-end; margin-top: 0.7rem; }
    .pacts {
      display: flex; align-items: center; justify-content: flex-end;
      gap: 0.4rem; white-space: nowrap;
    }
    .pacts form { display: flex; }
    .pacts .tiny { margin: 0; }
    /* Colours only — AdminLayout draws the chevron on every .main select.
       Geometry copied from the unit and lead pills so all three are one shape. */
    .lpick { position: relative; display: inline-flex; }
    .lpick select {
      font: inherit; font-size: 0.76rem; font-weight: 700;
      color: var(--ink, #5c6f88); background: var(--bg, #f2f5f9);
      border: 1px solid var(--bd, transparent); border-radius: 999px;
      cursor: pointer; min-width: 128px;
      padding-top: 0.45rem; padding-bottom: 0.45rem; padding-left: 0.95rem;
      line-height: 1.25;
      transition: filter 180ms ease, box-shadow 180ms ease;
    }
    .lpick select:hover { filter: brightness(0.96); }
    .lpick select:focus { outline: none; }
    .lpick select:focus-visible { box-shadow: 0 0 0 3px rgba(83, 178, 127, 0.32); }
    .prow { display: contents; }
    .pcode { max-width: 7rem; }
    .pprice { max-width: 8rem; }

    .b-table td { vertical-align: middle; }
    .b-table .inline { display: flex; align-items: center; gap: 0.4rem; }
    .b-table .in.bname { width: 190px; padding: 0.4rem 0.6rem; font-size: 0.8rem; }
    .b-table .in.bkind { width: 130px; padding: 0.4rem 0.6rem; font-size: 0.8rem; }
    .b-table .hint { font-size: 0.7rem; color: #93a3b8; }
    .tiny {
      font: inherit; font-size: 0.68rem; font-weight: 700; color: #5c6f88; background: #fff;
      border: 1px solid #d5deea; border-radius: 999px; padding: 0.22rem 0.6rem; cursor: pointer;
    }
    .tiny:hover { color: #2e7d54; border-color: rgba(83, 178, 127, 0.5); }
    .tiny.danger:hover { color: #b3261e; border-color: #e7b9b5; }

    .cardhead .n { background: #f2f5f9; color: #5c6f88; border-radius: 999px; padding: 0.1rem 0.45rem; font-size: 0.66rem; font-weight: 800; }
    .cardhead + .rows, .cardhead + .group { margin-top: 0.5rem; }

    @media (max-width: 1080px) {
      .ov { grid-template-columns: minmax(0, 1fr); }
    }
    /* Four metric cards now share the page with a 348px rail, so they run out of
       room sooner than they used to. */
    @media (max-width: 1240px) {
      .ov .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    /* Same sliding-thumb switcher as Projects / Opportunities on the Portfolio
       page and the Team / Partners one. The thumb is positioned by script rather
       than by CSS because only the browser knows how wide each label ends up. */
    .seg {
      position: relative; display: inline-flex;
      background: #ffffff; border: 1px solid #d5deea; border-radius: 999px;
      padding: 0.3rem; box-shadow: 0 6px 18px rgba(15, 26, 42, 0.06);
      /* Deliberately no flex-wrap: the thumb is placed with offsetLeft, which
         only describes one row. Four short labels always fit. */
      isolation: isolate;
    }
    .seg-thumb {
      position: absolute; top: 0.3rem; bottom: 0.3rem; left: 0; width: 0;
      border-radius: 999px; background: linear-gradient(180deg, #16283e 0%, #0f2036 100%);
      box-shadow: 0 6px 16px rgba(15, 26, 42, 0.28); z-index: -1;
      transition: transform 420ms cubic-bezier(0.32, 1.3, 0.44, 1), width 420ms cubic-bezier(0.32, 1.3, 0.44, 1);
    }
    .seg-thumb.no-anim { transition: none; }
    /* Named, so the browser can morph THIS element from its old position to its
       new one across the page load rather than cross-fading the whole strip. */
    .seg-thumb { view-transition-name: tab-thumb; }
    /* The active label is named too, and comes later in the DOM, so its snapshot
       is painted ABOVE the thumb's. Without this the sliding pill passes over
       the white label instead of carrying it. */
    .seg-btn.active { view-transition-name: tab-label; }
    .seg-btn {
      font: inherit; font-size: 0.84rem; font-weight: 700; color: #46586f; text-decoration: none;
      background: none; border: 0; cursor: pointer; white-space: nowrap;
      padding: 0.5rem 1.4rem; border-radius: 999px;
      display: inline-flex; align-items: center; gap: 0.45rem;
      transition: color 300ms ease;
    }
    .seg-btn:hover:not(.active):not(.off) { color: #2e7d54; }
    .seg-btn.active { color: #ffffff; }
    .seg-btn.off { color: #c3cfe0; cursor: not-allowed; }
    .seg .count {
      font-size: 0.62rem; font-weight: 800; border-radius: 999px; padding: 0.08rem 0.42rem;
      background: rgba(83, 178, 127, 0.16); color: #2e7d54;
    }
    .seg-btn.active .count { background: rgba(255, 255, 255, 0.18); color: #ffffff; }

    .card {
      background: #ffffff; border: 1px solid #d7deea; border-radius: 1.2rem;
      padding: 1.5rem 1.7rem; box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
    }
    .card + .card { margin-top: 0.9rem; }
    .stack > .card + .card { margin-top: 0; }
    /* Section titles are green rather than grey: they are the portal's own
       labels, and reading them as headings instead of as muted metadata makes
       each card easier to find at a glance. */
    h2.sec, h3.sec { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #2e7d54; }
    .lede { margin-top: 0.5rem; font-size: 0.85rem; color: #5c6f88; line-height: 1.6; }

    .steps { margin-top: 1.1rem; display: grid; gap: 0.1rem; }
    .step { display: grid; grid-template-columns: 24px 1fr; gap: 0.75rem; padding: 0.7rem 0; border-bottom: 1px solid #eef2f7; }
    .step:last-child { border-bottom: 0; }
    .tick {
      width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;
      font-size: 0.7rem; font-weight: 800; margin-top: 0.1rem;
    }
    .tick.done { background: rgba(15, 138, 95, 0.13); color: #0f8a5f; }
    .tick.todo { background: #f2f5f9; color: #93a3b8; }
    .step .l { font-size: 0.86rem; font-weight: 600; }
    .step.is-later .l { color: #93a3b8; }
    .step .h { margin-top: 0.15rem; font-size: 0.76rem; color: #93a3b8; }

    .field { display: grid; gap: 0.35rem; margin-top: 1rem; }
    .field span { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #46586f; }
    .field em { font-weight: 400; text-transform: none; letter-spacing: 0; color: #93a3b8; font-size: 0.92em; }
    .in {
      font: inherit; font-size: 0.9rem; color: #16283e; width: 100%;
      padding: 0.6rem 0.75rem; border: 1px solid #d5deea; border-radius: 9px; background: #fbfcfe;
    }
    .in:focus { outline: none; background: #fff; border-color: #53b27f; box-shadow: 0 0 0 3px rgba(83,178,127,.16); }
    .row2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1.2rem; }
    .field-spacer { display: block; }
    @media (max-width: 720px) { .field-spacer { display: none; } }
    .btn {
      font: inherit; font-size: 0.85rem; font-weight: 700; color: #fff; background: #53b27f;
      border: 0; border-radius: 10px; padding: 0.7rem 1.3rem; cursor: pointer; margin-top: 1.2rem;
      box-shadow: 0 8px 20px rgba(83, 178, 127, 0.28);
    }
    .btn.ghost { background: #fff; color: #46586f; border: 1px solid #d5deea; box-shadow: none; }
    .saved { margin-top: 0.8rem; font-size: 0.82rem; font-weight: 700; color: #2e7d54; }

    .keybox { margin-top: 0.9rem; background: #fffdf5; border: 1px solid #eadfbf; border-radius: 0.9rem; padding: 1rem 1.1rem; }
    .keybox .kh { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: #8a6420; }
    .keybox code {
      display: block; margin-top: 0.5rem; font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.82rem; background: #fff; border: 1px solid #eadfbf; border-radius: 7px;
