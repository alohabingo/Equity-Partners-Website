  <div class="tabrow">
  <div class="seg" data-seg="tabs">
    <span class="seg-thumb no-anim"></span>
    <a href={`/admin/projects/${slug}`} class:list={["seg-btn", { active: tab === "overview" }]}>Overview</a>
    <a href={`/admin/projects/${slug}?tab=units`} class:list={["seg-btn", { active: tab === "units" }]}>Units</a>
    <a href={`/admin/projects/${slug}?tab=leads`} class:list={["seg-btn", { active: tab === "leads" }]}>Leads</a>
    <a href={inboxHref({ seg: "needs" })} class:list={["seg-btn", { active: tab === "inbox" }]}>
      Inbox {attention.length > 0 && <span class="count">{attention.length}</span>}
    </a>
    <a href={`/admin/projects/${slug}?tab=templates`} class:list={["seg-btn", { active: tab === "templates" }]}>Templates</a>
    <a href={`/admin/projects/${slug}?tab=documents`} class:list={["seg-btn", { active: tab === "documents" }]}>Documents</a>
    <a href={`/admin/projects/${slug}?tab=settings`} class:list={["seg-btn", { active: tab === "settings" }]}>Settings</a>
  </div>

  {/* One group, so the row's space-between puts the tabs at one end and the
      pair of buttons together at the other. As three separate children the
      Add lead button was spaced out into the middle of the row, beside nothing. */}
  {/* Rendered only when it would hold something, so the row's space-between has
      nothing invisible to push against. */}
  {(tab === "leads" || (tab === "units" && hasParking) || (tab === "overview" && mailboxConnected)) && (
    <div class="tabacts">
      {/* Two inventories, one switch — in the tab row rather than above the
          cards, because it selects what the whole tab is showing, which is the
          same job the tabs beside it do. */}
      {tab === "units" && hasParking && (
        <div class="uviews" role="group" aria-label="Show">
          <a href={unitViewHref("units")} class:list={["uview", { on: unitView === "units" }]}
             aria-current={unitView === "units" ? "true" : undefined}>Units</a>
          <a href={unitViewHref("parking")} class:list={["uview", { on: unitView === "parking" }]}
             aria-current={unitView === "parking" ? "true" : undefined}>Parking</a>
        </div>
      )}
      {/* Only on Leads, where the list it adds to is on screen. Offered even
          without a mailbox, though: a project with no inbox still gets walk-ins,
          and that is exactly when adding one by hand is the only way in. */}
      {tab === "leads" && (
        <button class="syncbtn addlead" type="button" data-open-dialog="add-lead">+ Add lead</button>
      )}

      {/* Overview only. Syncing is a whole-project action and its result — new
          enquiries, a message count, a failure notice — is what the overview is
