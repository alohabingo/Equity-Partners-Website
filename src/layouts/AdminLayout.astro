---
import { BRAND_WORDMARK, BRAND_MARK } from "../lib/brandAssets";
import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/600.css";
import "@fontsource/montserrat/700.css";

// Preloaded so Montserrat is ready before first paint. Without this the
// fonts load with `font-display: swap`, so text renders in a fallback face
// and visibly re-flows when the real font arrives — most noticeable on the
// wide-tracked "COMMAND CENTER" caption.
import montserrat400 from "@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url";
import montserrat600 from "@fontsource/montserrat/files/montserrat-latin-600-normal.woff2?url";
import montserrat700 from "@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url";

interface Props {
  title: string;
  active?: string;
}
const { title, active = "" } = Astro.props;
const user = Astro.locals.user;
const isSuper = user?.role === "super_admin";

const nav = [
  { key: "dashboard", label: "Dashboard", href: "/admin", superOnly: false },
  { key: "leads", label: "Leads", href: "/admin/leads", superOnly: true },
  { key: "blog", label: "Blog", href: "/admin/blog", superOnly: false },
  { key: "portfolio", label: "Portfolio", href: "/admin/portfolio", superOnly: false },
  { key: "team", label: "Team / Partners", href: "/admin/team", superOnly: false },
  { key: "subscribers", label: "Subscribers", href: "/admin/subscribers", superOnly: true },
  { key: "vault", label: "Document Vault", href: "/admin/vault", superOnly: true },
  { key: "users", label: "Users", href: "/admin/users", superOnly: true },
];
const visibleNav = nav.filter((n) => isSuper || !n.superOnly);

const S = 'width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const NAV_ICONS: Record<string, string> = {
  dashboard: `<svg viewBox="0 0 24 24" ${S}><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>`,
  leads: `<svg viewBox="0 0 24 24" ${S}><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  blog: `<svg viewBox="0 0 24 24" ${S}><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`,
  portfolio: `<svg viewBox="0 0 24 24" ${S}><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>`,
  team: `<svg viewBox="0 0 24 24" ${S}><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="4.5" cy="10.5" r="2"/><circle cx="19.5" cy="10.5" r="2"/></svg>`,
  subscribers: `<svg viewBox="0 0 24 24" ${S}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>`,
  vault: `<svg viewBox="0 0 24 24" ${S}><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
  users: `<svg viewBox="0 0 24 24" ${S}><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | EP Admin</title>
    <link rel="preload" href={montserrat700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserrat600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={montserrat400} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Runs before paint so a collapsed sidebar never flashes open on navigation.
      try {
        if (localStorage.getItem("ep-admin-sidebar-collapsed") === "1") {
          document.documentElement.classList.add("is-collapsed");
        }
      } catch (e) {}
    </script>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 232px 1fr;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        background: transparent;
        color: #16283e;
      }
      /* ---- Sidebar ---- */
      aside {
        background: linear-gradient(180deg, #0f2036 0%, #0a1727 100%);
        color: #dbe5f3;
        display: flex;
        flex-direction: column;
        padding: 1.6rem 1rem;
        position: sticky;
        top: 0;
        height: 100vh;
      }
      .brand-logo {
        display: block;
        width: 100%;
        height: auto;
        padding: 0 0.3rem;
      }
      .brand-sub {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        text-align: center;
        margin-top: 1.1rem;
        padding: 0 0.7rem;
        color: #53b27f;
      }
      nav { margin-top: 1.6rem; display: grid; gap: 0.25rem; }
      nav a {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.6rem 0.7rem;
        border-radius: 8px;
        color: #c1cee3;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 160ms ease, color 160ms ease;
      }
      nav a svg { width: 17px; height: 17px; flex: none; }
      nav a:hover { background: rgba(83, 178, 127, 0.12); color: #ffffff; }
      nav a.active { background: #53b27f; color: #ffffff; }

      /* ---- Collapse toggle ---- */
      .collapse-btn {
        margin-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        font: inherit;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9fb0c9;
        background: none;
        border: 1px solid rgba(193, 206, 227, 0.18);
        border-radius: 8px;
        padding: 0.42rem 0.5rem;
        cursor: pointer;
        transition: color 160ms ease, border-color 160ms ease;
      }
      .collapse-btn:hover { color: #ffffff; border-color: rgba(193, 206, 227, 0.5); }
      .collapse-btn svg { width: 14px; height: 14px; transition: transform 260ms ease; }

      /* ---- Collapsed state (icons only) ---- */
      .is-collapsed body { grid-template-columns: 74px 1fr; }
      .is-collapsed body aside { padding-left: 0.6rem; padding-right: 0.6rem; }
      .is-collapsed body .brand-logo,
      .is-collapsed body .brand-sub,
      .is-collapsed body nav a .nav-text,
      .is-collapsed body .who,
      .is-collapsed body .role-badge,
      .is-collapsed body .collapse-btn .nav-text,
      .is-collapsed body .signout .btn-text { display: none; }
      .is-collapsed body .brand-mark { display: block; }
      .is-collapsed body nav a { justify-content: center; padding: 0.65rem 0; }
      .is-collapsed body .side-footer { padding: 0.9rem 0 0; text-align: center; }
      .is-collapsed body .signout button { width: 100%; padding: 0.45rem 0; }
      .is-collapsed body .collapse-btn svg { transform: rotate(180deg); }
      .brand-mark { display: none; width: 40px; height: 40px; margin: 0.2rem auto 0; }
      /* Animate only on user toggle, never on page load. */
      body { transition: grid-template-columns 240ms ease; }
      html:not(.ready) body { transition: none; }
      @media (prefers-reduced-motion: reduce) { body { transition: none; } }
      .side-footer {
        margin-top: auto;
        padding: 0.9rem 0.7rem 0;
        border-top: 1px solid rgba(193, 206, 227, 0.14);
      }
      .who { font-size: 0.82rem; font-weight: 600; color: #ffffff; word-break: break-word; }
      .role-badge {
        display: inline-block;
        margin-top: 0.35rem;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.22rem 0.5rem;
        border-radius: 999px;
        background: rgba(83, 178, 127, 0.16);
        border: 1px solid rgba(83, 178, 127, 0.45);
        color: #7dd3a6;
      }
      .signout {
        margin-top: 0.9rem;
      }
      .signout button {
        font: inherit;
        font-size: 0.78rem;
        font-weight: 600;
        color: #9fb0c9;
        background: none;
        border: 1px solid rgba(193, 206, 227, 0.25);
        border-radius: 8px;
        padding: 0.45rem 0.85rem;
        cursor: pointer;
        transition: color 160ms ease, border-color 160ms ease;
      }
      .signout button:hover { color: #ffffff; border-color: #ffffff; }
      /* ---- Main ---- */
      /* A little more breathing room between the content and the page edges,
         scaling down gracefully on narrower screens. */
      .main {
        padding: 2.4rem clamp(1.4rem, 5vw, 5.2rem) 3.4rem;
        max-width: 1460px;
        width: 100%;
        margin-inline: auto;
      }
      .page-head h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; }
      .page-head p { margin-top: 0.3rem; color: #5c6f88; font-size: 0.9rem; }
      @media (max-width: 860px) {
        body { grid-template-columns: 1fr; }
        aside { position: static; height: auto; }
      }
    </style>

    <style is:global>
      /* Root-level rules must be global: Astro would otherwise scope them
         and the view-transition pseudo-elements would never match. */
      html {
        background:
          radial-gradient(ellipse at 30% 0%, rgba(83, 178, 127, 0.12), transparent 55%),
          radial-gradient(circle at 10% -10%, #eef2f8 0, #f2f5f9 50%),
          #f2f5f9;
        background-attachment: fixed;
      }

      /* Smooth cross-document navigation: the sidebar stays put while the
         page content cross-fades. Browsers without support just navigate. */
      @view-transition { navigation: auto; }
      aside { view-transition-name: ep-sidebar; }
      .main { view-transition-name: ep-main; }

      ::view-transition-old(ep-main) { animation: epFadeOut 120ms ease-in both; }
      ::view-transition-new(ep-main) { animation: epFadeIn 240ms ease-out both; }
      ::view-transition-old(ep-sidebar),
      ::view-transition-new(ep-sidebar) { animation: none; }

      @keyframes epFadeOut { to { opacity: 0; } }
      @keyframes epFadeIn { from { opacity: 0; transform: translateY(6px); } }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(ep-main),
        ::view-transition-new(ep-main) { animation: none; }
      }
    </style>
  </head>
  <body>
    <aside>
      <img class="brand-logo" src={BRAND_WORDMARK} alt="Equity Partners — Andorra Property Group" width="400" height="132" decoding="sync" fetchpriority="high" />
      <img class="brand-mark" src={BRAND_MARK} alt="Equity Partners" width="96" height="96" decoding="sync" />
      <p class="brand-sub">Command Center</p>
      <nav>
        {visibleNav.map((item) => (
          <a href={item.href} class={active === item.key ? "active" : ""} title={item.label}>
            <Fragment set:html={NAV_ICONS[item.key] ?? ""} />
            <span class="nav-text">{item.label}</span>
          </a>
        ))}
      </nav>
      <button class="collapse-btn" type="button" id="sidebar-toggle" aria-label="Collapse menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <span class="nav-text">Collapse</span>
      </button>
      <div class="side-footer">
        <p class="who">{user?.fullName}</p>
        <span class="role-badge">{isSuper ? "Super Admin" : "Content Editor"}</span>
        <form class="signout" method="post" action="/api/auth/signout">
          <button type="submit" title="Sign out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;vertical-align:-2px;"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
            <span class="btn-text">&nbsp;Sign out</span>
          </button>
        </form>
      </div>
    </aside>
    <div class="main">
      <slot />
    </div>

    <script is:inline>
      (function () {
        const KEY = "ep-admin-sidebar-collapsed";
        const root = document.documentElement;
        const btn = document.getElementById("sidebar-toggle");
        requestAnimationFrame(() => root.classList.add("ready"));
        btn?.addEventListener("click", () => {
          root.classList.toggle("is-collapsed");
          localStorage.setItem(KEY, root.classList.contains("is-collapsed") ? "1" : "0");
        });
      })();
    </script>
  </body>
</html>
