      /* ────────────────────────────────────────────────────────────
         Timeline V2 — Spotlight treatment (light)
         Mirrors the other home spotlight sections for visual unity.
         ──────────────────────────────────────────────────────────── */
      .timeline-v2.is-spotlight {
        position: relative;
        padding: 5.5rem 0 4.5rem;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .timeline-v2.is-spotlight::before,
      .timeline-v2.is-spotlight::after {
        content: none;
      }

      .timeline-v2.is-spotlight .container {
        position: relative;
        z-index: 1;
      }

      .timeline-v2.is-spotlight .section-header {
        margin-bottom: 3rem;
      }

      .timeline-v2.is-spotlight .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: #3f9568;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 0;
      }

      .timeline-v2.is-spotlight .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      .timeline-v2.is-spotlight h2 {
        color: var(--text-primary);
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -0.012em;
