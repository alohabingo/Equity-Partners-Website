---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseServer } from "../../../lib/supabase";

const supabase = supabaseServer(Astro.cookies, Astro.request);

const kindFilter = Astro.url.searchParams.get("kind") === "opportunity" ? "opportunity" : "project";
const VALID_STAGES = ["prospective", "current", "past"] as const;
type Stage = (typeof VALID_STAGES)[number];
const stageParam = Astro.url.searchParams.get("stage") ?? "current";
const stageFilter: Stage = (VALID_STAGES as readonly string[]).includes(stageParam) ? (stageParam as Stage) : "current";

const { data: rows } = await supabase
  .from("portfolio_items")
  .select("id, kind, slug, locale, status, sort_order, name, data")
  .eq("kind", kindFilter)
  .order("sort_order");

/** Derive the lifecycle stage from the item's deal status text. */
function stageOf(dealStatus: string | undefined): Stage {
  const s = (dealStatus ?? "").toLowerCase();
  if (/completed|closed$|fully subscribed/.test(s)) return "past";
  if (/pipeline|waitlist/.test(s)) return "prospective";
  return "current";
}

// One card per slug: EN is canonical, other locales become edit links.
type Item = NonNullable<typeof rows>[number];
const bySlug = new Map<string, Item[]>();
for (const r of rows ?? []) {
  const arr = bySlug.get(r.slug) ?? [];
  arr.push(r);
  bySlug.set(r.slug, arr);
}

const LOCALES = ["en", "es", "ca"];
const cards = [...bySlug.values()]
  .map((variants) => {
    const canonical = variants.find((v) => v.locale === "en") ?? variants[0];
    const d = (canonical.data ?? {}) as Record<string, any>;
    return {
      id: canonical.id,
      slug: canonical.slug,
      name: canonical.name,
      kind: canonical.kind,
      published: canonical.status === "published",
      sortOrder: canonical.sort_order,
      stage: stageOf(d.status),
      dealStatus: d.status ?? "—",
      image: d.image ?? "",
      tagline: d.tagline ?? "",
      location: d.location ?? d.parish ?? "",
      sector: d.sector ?? "",
      value: d.value ?? d.totalProjectValue ?? "",
      completion: d.completionDate ?? "",
      units: d.units ?? "",
      fundingProgress: typeof d.fundingProgress === "number" ? d.fundingProgress : null,
      minInvestment: d.minInvestment ?? "",
      variants: LOCALES.map((loc) => ({
        locale: loc,
        item: variants.find((v) => v.locale === loc) ?? null,
      })),
    };
  })
  .filter((c) => c.stage === stageFilter)
  .sort((a, b) => a.sortOrder - b.sortOrder);

const stageCounts: Record<Stage, number> = { prospective: 0, current: 0, past: 0 };
for (const variants of bySlug.values()) {
  const canonical = variants.find((v) => v.locale === "en") ?? variants[0];
  stageCounts[stageOf(((canonical.data ?? {}) as any).status)] += 1;
}

const href = (kind: string, stage: string) => {
  const p = new URLSearchParams();
  if (kind === "opportunity") p.set("kind", kind);
  if (stage !== "current") p.set("stage", stage);
  const q = p.toString();
  return q ? `/admin/portfolio?${q}` : "/admin/portfolio";
};

const publicPath = (c: { kind: string; slug: string }) =>
  `/${c.kind === "project" ? "projects" : "opportunities"}/${c.slug}`;

const STAGES: Array<{ key: Stage; label: string }> = [
  { key: "prospective", label: "Prospective" },
  { key: "current", label: "Current" },
  { key: "past", label: "Past" },
];
---

<AdminLayout title="Portfolio" active="portfolio">
  <style>
    .head-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .new-btns { display: flex; gap: 0.5rem; }
    .new-btn {
      font-size: 0.8rem; font-weight: 700; color: #ffffff; text-decoration: none;
      background: #53b27f; border-radius: 8px; padding: 0.6rem 1rem;
    }
    .new-btn.alt { background: #16283e; }
    .new-btn:hover { filter: brightness(1.1); }
    .filters { margin-top: 1.4rem; display: flex; gap: 0.7rem; flex-wrap: wrap; }
    .seg {
      display: inline-flex;
      background: #ffffff;
      border: 1px solid #d5deea;
      border-radius: 999px;
      padding: 0.25rem;
      gap: 0.2rem;
    }
    .seg-btn {
      font-size: 0.78rem; font-weight: 700; color: #46586f; text-decoration: none;
      padding: 0.4rem 1.1rem; border-radius: 999px;
      transition: background-color 200ms ease, color 200ms ease;
    }
    .seg-btn:hover:not(.active) { color: #2e7d54; }
    .seg-btn.active { background: #16283e; color: #ffffff; }
    .count { opacity: 0.65; font-weight: 600; margin-left: 0.15rem; }
    .empty { margin-top: 2rem; color: #5c6f88; font-size: 0.92rem; }

    .cards {
      margin-top: 1.4rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
    .pcard {
      background: #ffffff;
      border: 1px solid #d7deea;
      border-radius: 0.9rem;
      overflow: hidden;
      isolation: isolate;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
      display: flex;
      flex-direction: column;
      transition: border-color 360ms ease, box-shadow 360ms ease, transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1);
    }
    .pcard:hover {
      transform: translateY(-4px);
      border-color: rgba(83, 178, 127, 0.42);
      box-shadow: 0 20px 40px rgba(15, 26, 42, 0.1), 0 0 0 1px rgba(83, 178, 127, 0.16) inset;
    }
    .pcard-media { position: relative; display: block; height: 150px; background: #eef2f7; }
    .pcard-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .no-img { height: 100%; display: grid; place-items: center; color: #93a3b8; font-size: 0.8rem; }
    .deal-badge {
      position: absolute; left: 0.7rem; bottom: 0.7rem;
      font-size: 0.66rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
      background: rgba(10, 20, 34, 0.78); color: #ffffff;
      padding: 0.28rem 0.6rem; border-radius: 999px; backdrop-filter: blur(4px);
    }
    .draft-badge {
      position: absolute; right: 0.7rem; top: 0.7rem;
      font-size: 0.64rem; font-weight: 700; text-transform: uppercase;
      background: rgba(196, 148, 58, 0.92); color: #ffffff;
      padding: 0.24rem 0.55rem; border-radius: 999px;
    }
    .pcard-body { padding: 0.95rem 1.1rem 1rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1; }
    .pcard-title { font-size: 1rem; font-weight: 700; color: #16283e; text-decoration: none; line-height: 1.25; }
    .pcard-title:hover { color: #2e7d54; }
    .pcard-meta { font-size: 0.74rem; color: #7a8ba1; font-weight: 600; }
    .pcard-tagline {
      font-size: 0.78rem; color: #5c6f88; line-height: 1.45;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .facts { margin: 0.2rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 0.8rem; }
    .facts div { display: flex; flex-direction: column; }
    .facts dt { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: #93a3b8; }
    .facts dd { margin: 0; font-size: 0.82rem; font-weight: 700; color: #16283e; }
    .fund { margin-top: 0.2rem; }
    .fund-track { height: 6px; border-radius: 4px; background: rgba(22, 40, 62, 0.08); overflow: hidden; }
    .fund-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0.55)); }
    .fund-label { font-size: 0.68rem; font-weight: 700; color: #2e7d54; }
    .pcard-foot {
      margin-top: auto; padding-top: 0.55rem; border-top: 1px solid #eef2f7;
      display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    }
    .langs { display: inline-flex; gap: 0.25rem; }
    .lang {
      font-size: 0.62rem; font-weight: 700; text-decoration: none;
      padding: 0.2rem 0.45rem; border-radius: 6px;
    }
    .lang.has { background: rgba(83, 178, 127, 0.13); color: #2e7d54; }
    .lang.has:hover { background: rgba(83, 178, 127, 0.25); }
    .lang.missing { background: rgba(203, 76, 76, 0.08); color: #b98484; border: 1px dashed rgba(203, 76, 76, 0.3); }
    .actions { display: inline-flex; gap: 0.7rem; }
    .mini-link { font-size: 0.72rem; font-weight: 700; color: #3d5a80; text-decoration: none; }
    .mini-link:hover { text-decoration: underline; }
  </style>

  <div class="page-head head-row">
    <div>
      <h1>Portfolio</h1>
      <p>Investment opportunities and development projects — live on save.</p>
    </div>
    <div class="new-btns">
      <a class="new-btn" href="/admin/portfolio/new?kind=opportunity">+ New opportunity</a>
      <a class="new-btn alt" href="/admin/portfolio/new?kind=project">+ New project</a>
    </div>
  </div>

  <div class="filters">
    <div class="seg">
      {[["project", "Projects"], ["opportunity", "Opportunities"]].map(([k, label]) => (
        <a class={kindFilter === k ? "seg-btn active" : "seg-btn"} href={href(k, stageFilter)}>{label}</a>
      ))}
    </div>
    <div class="seg">
      {STAGES.map((s) => (
        <a class={stageFilter === s.key ? "seg-btn active" : "seg-btn"} href={href(kindFilter, s.key)}>
          {s.label} <span class="count">{stageCounts[s.key]}</span>
        </a>
      ))}
    </div>
  </div>

  {cards.length === 0 ? (
    <p class="empty">No {stageFilter} {kindFilter === "project" ? "projects" : "opportunities"}.</p>
  ) : (
    <div class="cards">
      {cards.map((c) => (
        <article class="pcard">
          <a class="pcard-media" href={`/admin/portfolio/${c.id}`}>
            {c.image
              ? <img src={c.image} alt={c.name} loading="lazy" />
              : <div class="no-img">No image</div>}
            <span class="deal-badge">{c.dealStatus}</span>
            {!c.published && <span class="draft-badge">draft</span>}
          </a>
          <div class="pcard-body">
            <a class="pcard-title" href={`/admin/portfolio/${c.id}`}>{c.name}</a>
            {(c.location || c.sector) && (
              <p class="pcard-meta">{[c.location, c.sector].filter(Boolean).join(" · ")}</p>
            )}
            {c.tagline && <p class="pcard-tagline">{c.tagline}</p>}

            <dl class="facts">
              {c.value && <div><dt>Value</dt><dd>{c.value}</dd></div>}
              {c.kind === "opportunity" && c.minInvestment && <div><dt>Min. invest</dt><dd>{c.minInvestment}</dd></div>}
              {c.units && <div><dt>Units</dt><dd>{c.units}</dd></div>}
              {c.completion && <div><dt>Completion</dt><dd>{c.completion}</dd></div>}
            </dl>

            {c.fundingProgress !== null && (
              <div class="fund">
                <div class="fund-track"><div class="fund-fill" style={`width:${Math.min(100, c.fundingProgress)}%`}></div></div>
                <span class="fund-label">{c.fundingProgress}% committed</span>
              </div>
            )}

            <div class="pcard-foot">
              <span class="langs">
                {c.variants.map((v) =>
                  v.item
                    ? <a class="lang has" href={`/admin/portfolio/${v.item.id}`} title={`Edit ${v.locale.toUpperCase()}`}>{v.locale.toUpperCase()}</a>
                    : <a class="lang missing" href={`/admin/portfolio/new?kind=${c.kind}&from=${c.id}`} title={`Missing ${v.locale.toUpperCase()} — duplicate to translate`}>{v.locale.toUpperCase()}</a>
                )}
              </span>
              <span class="actions">
                {c.published && <a class="mini-link" href={publicPath(c)} target="_blank">View ↗</a>}
                <a class="mini-link" href={`/admin/portfolio/new?kind=${c.kind}&from=${c.id}`}>Duplicate</a>
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  )}
</AdminLayout>
