---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../lib/i18n";
import { getContentTranslations } from "../i18n/content";
import { getPageTitle } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const content = getContentTranslations(locale).cookies;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{getPageTitle(locale, "cookiePolicy")}</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --navy: #0f1a2a;
        --navy-soft: #1f2f46;
        --slate: #5f7087;
        --slate-light: #8da0b9;
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --line: #dbe3ee;
        --accent: #8293ae;
        --max-width: 1120px;
        --header-offset: 6.1rem;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--navy-soft);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.55;
      }
      h1, h2, h3, p, ul { margin: 0; }
      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .legal-hero {
        margin-top: var(--header-offset);
        padding: 4rem 0 2rem;
        background: linear-gradient(180deg, #f4f6fa, #edf1f7);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.85rem;
      }
      h1 {
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1.08;
        letter-spacing: 0.02em;
        color: var(--navy);
        max-width: 18ch;
      }
      .legal-hero p {
        margin-top: 1rem;
        max-width: 50rem;
        color: var(--slate);
        font-size: 1rem;
        line-height: 1.65;
      }
      .legal-content {
        padding: 4rem 0;
      }
      .legal-shell {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 2rem;
      }
      .legal-block + .legal-block {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
      }
      .legal-block h2 {
        font-size: clamp(1.55rem, 3vw, 2.45rem);
        line-height: 1.12;
        color: var(--navy);
      }
      .legal-block p,
      .legal-block li {
        margin-top: 0.85rem;
        color: var(--slate);
        font-size: 0.98rem;
        line-height: 1.7;
      }
      .legal-block ul { padding-left: 1.1rem; }
      .legal-meta {
        color: var(--slate-light);
        font-size: 0.86rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
      .legal-contact-button {
        margin-top: 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #d8e3f2;
        color: #132238;
        text-decoration: none;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(216, 227, 242, 0.96);
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease;
      }
      .legal-contact-button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-1px);
      }

      @media (max-width: 980px) {
        .legal-shell { padding: 1.35rem; }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader menuToggleId="mobile-menu-toggle-cookies" locale={locale} currentPath={Astro.url.pathname} />

    <section class="legal-hero">
      <div class="container">
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.title}</h1>
        <p>{content.intro}</p>
      </div>
    </section>

    <section class="legal-content">
      <div class="container">
        <div class="legal-shell">
          <div class="legal-block">
            <p class="legal-meta">{content.updated}</p>
          </div>
          {
            content.sections.map((section, index) => (
              <div class="legal-block">
                <h2>{section.title}</h2>
                {section.body?.map((paragraph) => <p>{paragraph}</p>)}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
                {index === content.sections.length - 1 ? (
                  <a class="legal-contact-button" href={buildLocalizedPath("/contact", locale)}>{content.contactCta}</a>
                ) : null}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <SiteFooter locale={locale} />

    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>
  </body>
</html>
