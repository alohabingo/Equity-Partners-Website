---
/**
 * The Meta (Facebook) pixel, consent-gated.
 *
 * Included from SEO.astro, which is the one thing every public page's head
 * already carries — the public site has no shared layout, so that component is
 * the only place a tag can be added once and be true everywhere. Deliberately
 * NOT in AdminLayout: a marketing pixel firing inside the portal would send our
 * own working day to Meta and pollute the audiences it is there to build.
 *
 * It loads REVOKED. `fbq('consent', 'revoke')` before init means the library is
 * on the page but sends nothing — no PageView, no cookies — until a visitor
 * accepts marketing cookies. That is why there is no `fbq('track', 'PageView')`
 * in the base snippet: the first PageView fires at the moment consent is given,
 * not at load.
 *
 * The id comes from lib/tracking.ts, which the portal's Tracking card also
 * reads. One constant, two consumers: the overview in the admin cannot drift
 * from what the site actually carries.
 */
import { META_PIXEL_ID } from "../lib/tracking";
import { CONSENT_KEY } from "../lib/consent";
const PIXEL_ID = META_PIXEL_ID;
---

<!-- Meta Pixel Code -->
<script is:inline define:vars={{ PIXEL_ID, CONSENT_KEY }}>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window,document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');

  /**
   * The consent state is set BEFORE init, and it is the real answer, not a
   * placeholder.
   *
   * This used to revoke unconditionally and grant afterwards if a choice was
   * stored. On a page load that is all queued before Meta's library has
   * downloaded, and the library honours whatever consent state it sees when it
   * initialises — so it started up switched off and dropped the queued page
   * view without a word. It only worked on the page where the visitor actually
   * clicked Accept, because by then the library was loaded and the commands
   * were live rather than queued.
   *
   * Reading storage first and telling the truth up front fixes it, and a
   * returning visitor who accepted is never told "revoke" at all.
   */
  /**
   * Storage is wrapped because localStorage throws outright in some privacy
   * modes, and a consent check that threw would take the page's other scripts
   * down with it. Defined FIRST: everything below calls it, including the
   * page-view tracker on the very next lines.
   */
  window.epMarketingConsent = function () {
    try { return localStorage.getItem(CONSENT_KEY) === 'accepted'; }
    catch (e) { return false; }
  };

  var epConsent = window.epMarketingConsent();

  fbq('consent', epConsent ? 'grant' : 'revoke');
  fbq('init', PIXEL_ID);

  /**
   * One page view per page, however the page arrived.
   *
   * Today every navigation on this site is a real page load, so this script
   * runs again each time and the call below is the whole story. That stops
   * being true the moment anyone adds Astro's <ClientRouter /> for snappier
   * navigation: the document is swapped in place, head scripts do not re-run,
   * and page views would quietly stop — the failure nobody notices until an
   * audience is mysteriously empty six weeks later.
   *
   * `astro:page-load` covers that case. It is dispatched by the ClientRouter
   * runtime, so it fires only once that exists — and when it does, it ALSO
   * fires on the first load, on top of the call below. Hence the guard: the key
   * lives on `window`, which survives a client-side swap and is destroyed by a
   * genuine navigation, so it dedupes correctly in both worlds without needing
   * to know which one it is in.
   *
   * Keyed on path AND query, because the report carries the full URL and
   * audiences can be built on query strings — `?project=nanta` and
   * `?project=ordino` are two pages, not one.
   */
  window.epTrackPageView = function () {
    if (!window.fbq || !window.epMarketingConsent()) return;
    var here = location.pathname + location.search;
    if (window.__epLastPath === here) return;
    window.__epLastPath = here;
    fbq('track', 'PageView');
  };

  document.addEventListener('astro:page-load', function () { window.epTrackPageView(); });

  if (epConsent) {
    window.__epPixelOn = true;
    window.epTrackPageView();
  }

  /**
   * Turning it on.
   *
   * Exposed on `window` so whatever records the visitor's choice can call it
   * without having to know anything about the pixel: granting consent unblocks
   * the library, and the page view is the event that would otherwise never have
   * happened for this visit.
   */
  window.epEnableMetaPixel = function () {
    if (!window.fbq || window.__epPixelOn) return;
    window.__epPixelOn = true;
    fbq('consent', 'grant');
    // Through the same door as every other page view, so accepting sets the
    // dedupe key and cannot double up with what follows.
    window.epTrackPageView();
  };

  window.epDisableMetaPixel = function () {
    if (!window.fbq) return;
    window.__epPixelOn = false;
    fbq('consent', 'revoke');
  };

  // Nothing to do on load any more — the state was set before init, above.
  // epEnableMetaPixel remains for the live case: the visitor answering the
  // banner on this page, when the library is already running.
</script>
{/* Meta's snippet ends with a <noscript> tracking image here. It is left out
    deliberately.

    An image needs no JavaScript, so it loads for a visitor who has JavaScript
    switched off — and those are exactly the visitors the banner cannot reach,
    because the banner is JavaScript too. The result is a page view reported to
    Meta by someone who was never asked. It is a small group and the data is
    close to worthless (no cookie is set, so they can never be matched to an ad
    or an audience), but the banner and the cookie policy both promise that
    marketing tracking only happens with permission, and that promise is worth
    more than an anonymous page count.

    Add it back only alongside a way to ask those visitors first, which in
    practice does not exist. */}
<!-- End Meta Pixel Code -->
