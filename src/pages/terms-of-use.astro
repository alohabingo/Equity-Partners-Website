---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/SEO.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../lib/i18n";
import { getContentTranslations } from "../i18n/content";
import { getPageTitle } from "../i18n/ui";
const locale = getLocaleFromUrl(Astro.url);
const content = getContentTranslations(locale).terms;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO
      title={getPageTitle(locale, "termsOfUse")}
      description="Terms governing access to and use of the Equity Partners website."
      locale={locale}
      path={Astro.url.pathname}
    />
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --navy: #0f1a2a;
        --navy-soft: #1f2f46;
        --slate: #5f7087;
        --slate-light: #8da0b9;
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --line: #dbe3ee;
        --accent: #8293ae;
        --max-width: 1120px;
        --header-offset: 6.1rem;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--navy-soft);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.55;
      }

      h1, h2, h3, p, ul { margin: 0; }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .legal-hero {
        margin-top: var(--header-offset);
        padding: 4rem 0 2.5rem;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--paper) 50%);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: #3f9568;
        margin-bottom: 0;
      }

      .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      h1 {
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        line-height: 1.05;
        letter-spacing: -0.012em;
        color: var(--navy);
        margin-top: 1rem;
        max-width: none;
      }

      h1::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .legal-hero p {
        margin-top: 1.2rem;
        max-width: none;
        width: 100%;
        color: var(--slate);
        font-size: 1.02rem;
        line-height: 1.6;
      }

      .legal-content {
        padding: 4rem 0;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--paper) 50%);
      }

      .legal-shell {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        padding: 2.4rem;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
      }

      .legal-block + .legal-block {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--line);
      }

      .legal-block h2 {
        font-size: clamp(1.35rem, 2.4vw, 1.75rem);
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: -0.005em;
        color: var(--navy);
      }

      .legal-block h2::after {
        content: "";
        display: block;
        width: 48px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 0.85rem;
        border-radius: 2px;
      }

      .legal-block p,
      .legal-block li {
        margin-top: 0.85rem;
        color: var(--slate);
        font-size: 0.98rem;
        line-height: 1.7;
      }

      .legal-block ul {
        padding-left: 1.1rem;
      }

      .legal-meta {
        color: var(--slate-light);
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 600;
      }

      .legal-contact-button {
        margin-top: 1.4rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(83, 178, 127, 0.08);
        color: #3f9568;
        text-decoration: none;
        border-radius: 0.55rem;
        padding: 0.85rem 1.4rem;
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(83, 178, 127, 0.55);
        transition: background 220ms ease, border-color 220ms ease,
          transform 220ms ease, color 220ms ease, box-shadow 220ms ease;
      }

      .legal-contact-button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.28);
      }

      @media (max-width: 980px) {
        .legal-shell {
          padding: 1.6rem;
        }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader menuToggleId="mobile-menu-toggle-terms" locale={locale} currentPath={Astro.url.pathname} />

    <section class="legal-hero">
      <div class="container">
        <p class="eyebrow">{content.eyebrow}</p>
        <h1>{content.title}</h1>
        <p>{content.intro}</p>
      </div>
    </section>

    <section class="legal-content">
      <div class="container">
        <div class="legal-shell">
          <div class="legal-block">
            <p class="legal-meta">{content.updated}</p>
          </div>
          {
            content.sections.map((section, index) => (
              <div class="legal-block">
                <h2>{section.title}</h2>
                {section.body?.map((paragraph) => <p>{paragraph}</p>)}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
                {index === content.sections.length - 1 ? (
                  <a class="legal-contact-button" href={buildLocalizedPath("/contact", locale)}>{content.contactCta}</a>
                ) : null}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <SiteFooter locale={locale} />

    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>
  </body>
</html>
