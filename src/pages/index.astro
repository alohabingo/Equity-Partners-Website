        </div>
      </section>
    )}

    <NewsletterSignup emailInputId="newsletter-email-home" locale={locale} />

    <SiteFooter locale={locale} />
    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 60);
      };

      const projectGrid = document.querySelector(".project-grid");
      const projectDots = Array.from(document.querySelectorAll("[data-project-dot]"));

      if (projectGrid && projectDots.length > 0) {
        const syncProjectDots = () => {
          const card = projectGrid.querySelector(".project-card");
          if (!card) return;

          const cardWidth = card.getBoundingClientRect().width;
          const gap = parseFloat(getComputedStyle(projectGrid).columnGap || getComputedStyle(projectGrid).gap || "0");
          const step = cardWidth + gap;
          const activeIndex = Math.max(0, Math.min(projectDots.length - 1, Math.round(projectGrid.scrollLeft / step)));

          projectDots.forEach((dot, index) => {
            dot.classList.toggle("is-active", index === activeIndex);
          });
        };

        projectDots.forEach((dot, index) => {
          dot.addEventListener("click", () => {
            const card = projectGrid.querySelectorAll(".project-card")[index];
            if (!card) return;
            projectGrid.scrollTo({ left: card.offsetLeft - projectGrid.offsetLeft, behavior: "smooth" });
          });
        });

        projectGrid.addEventListener("scroll", syncProjectDots, { passive: true });
        window.addEventListener("resize", syncProjectDots);
        syncProjectDots();
      }

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>

    <script type="module">
      // Scroll entrance animations
      const targets = document.querySelectorAll("[data-animate]");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );

      targets.forEach((el) => observer.observe(el));
    </script>

  </body>
</html>
