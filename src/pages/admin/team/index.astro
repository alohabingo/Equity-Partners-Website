---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseServer } from "../../../lib/supabase";

const supabase = supabaseServer(Astro.cookies, Astro.request);
const q = Astro.url.searchParams;
const view = q.get("view") === "partners" ? "partners" : "team";

const [{ data: members }, { data: partnerRows }] = await Promise.all([
  supabase
    .from("team_members")
    .select("id, name, photo_url, linkedin_url, sort_order, status, translations")
    .order("sort_order"),
  supabase
    .from("partners")
    .select("id, name, logo_url, website_url, sort_order, status, translations")
    .order("sort_order"),
]);

const list = members ?? [];
const partners = partnerRows ?? [];

const error = q.get("error") === "name_required" ? "A name is required." : null;

const tr = (m: any, loc: string, field: "role" | "description" | "summary") =>
  (m?.translations?.[loc]?.[field] ?? "") as string;

const LOCALES = [
  { key: "en", label: "English" },
  { key: "es", label: "Español" },
  { key: "ca", label: "Català" },
];
---

<AdminLayout title="Team" active="team">
  <style>
    .head-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .new-btn {
      font: inherit; font-size: 0.82rem; font-weight: 700; color: #ffffff;
      background: #53b27f; border: 0; border-radius: 8px; padding: 0.6rem 1.1rem; cursor: pointer;
    }
    .new-btn:hover { filter: brightness(1.08); }
    .notice { margin-top: 1.1rem; padding: 0.65rem 0.9rem; border-radius: 8px; font-size: 0.85rem; }
    .notice.err { background: rgba(203, 76, 76, 0.1); border: 1px solid rgba(203, 76, 76, 0.35); color: #a33d3d; }
    .empty { margin-top: 2rem; color: #5c6f88; font-size: 0.92rem; }

    /* Four per row, mirroring the public "Meet the team" grid */
    .cards { margin-top: 1.4rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
    @media (max-width: 1280px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 980px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 640px) { .cards { grid-template-columns: 1fr; } }

    .mcard {
      position: relative; cursor: pointer;
      background: #ffffff; border: 1px solid #d7deea; border-radius: 0.9rem;
      padding: 1.2rem 1.2rem 1rem; text-align: center;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
      display: flex; flex-direction: column; align-items: center; gap: 0.45rem;
      overflow: hidden; isolation: isolate;
      transition: border-color 360ms ease, box-shadow 360ms ease, transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1);
    }
    .mcard::after {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
      opacity: 0; transition: opacity 360ms ease;
    }
    .mcard:hover { transform: translateY(-4px); border-color: rgba(83, 178, 127, 0.42); box-shadow: 0 20px 40px rgba(15, 26, 42, 0.1); }
    .mcard:hover::after { opacity: 1; }
    .avatar { width: 96px; height: 96px; border-radius: 999px; object-fit: cover; border: 3px solid rgba(83, 178, 127, 0.25); background: #eef2f7; }
    .avatar-empty { display: grid; place-items: center; color: #93a3b8; font-size: 0.7rem; }
    .m-name { font-size: 1rem; font-weight: 700; color: #16283e; }
    .m-role { font-size: 0.78rem; font-weight: 600; color: #2e7d54; }
    .m-bio { font-size: 0.76rem; color: #5c6f88; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .badges { display: inline-flex; gap: 0.25rem; margin-top: 0.15rem; align-items: center; }
    .lang { font-size: 0.6rem; font-weight: 700; padding: 0.18rem 0.42rem; border-radius: 6px; }
    .lang.has { background: rgba(83, 178, 127, 0.13); color: #2e7d54; }
    .lang.missing { background: rgba(203, 76, 76, 0.08); color: #b98484; border: 1px dashed rgba(203, 76, 76, 0.3); }
    .li-dot { display: inline-flex; color: #3d5a80; }
    .li-dot svg { width: 13px; height: 13px; }
    .draft-tag {
      position: absolute; top: 0.7rem; right: 0.7rem;
      font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
      background: rgba(196, 148, 58, 0.9); color: #fff; padding: 0.2rem 0.5rem; border-radius: 999px;
    }
    .m-foot {
      margin-top: auto; padding-top: 0.7rem; width: 100%;
      display: flex; justify-content: center; align-items: center; gap: 0.7rem;
      border-top: 1px solid #eef2f7;
    }
    .mini { font: inherit; font-size: 0.72rem; font-weight: 700; color: #3d5a80; background: none; border: 0; padding: 0; cursor: pointer; }
    .mini:hover { text-decoration: underline; }
    .mini.danger { color: #a33d3d; }
    .arrows { display: inline-flex; gap: 0.2rem; }
    .arrow {
      font: inherit; font-size: 0.7rem; line-height: 1; color: #5c6f88;
      background: #f4f7fb; border: 1px solid #d5deea; border-radius: 6px;
      padding: 0.25rem 0.4rem; cursor: pointer;
    }
    .arrow:hover:not([disabled]) { border-color: #53b27f; color: #2e7d54; }
    .inline { display: inline; }

    /* ---------- Slide-over drawer ---------- */
    .backdrop {
      position: fixed; inset: 0; background: rgba(9, 17, 28, 0.45);
      opacity: 0; pointer-events: none; transition: opacity 260ms ease; z-index: 40;
      backdrop-filter: blur(2px);
    }
    .backdrop.open { opacity: 1; pointer-events: auto; }
    .drawer {
      position: fixed; top: 0; right: 0; height: 100vh; width: min(480px, 100vw);
      background: #ffffff; border-left: 1px solid #d7deea;
      box-shadow: -18px 0 48px rgba(9, 17, 28, 0.16);
      transform: translateX(100%); transition: transform 320ms cubic-bezier(0.2, 0.7, 0.3, 1);
      z-index: 50; display: flex; flex-direction: column;
    }
    .drawer.open { transform: translateX(0); }
    .drawer-head {
      padding: 1.1rem 1.4rem; border-bottom: 1px solid #eef2f7;
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      background: linear-gradient(180deg, #12233c 0%, #0f2036 100%); color: #ffffff;
    }
    .drawer-head h2 { font-size: 1rem; font-weight: 700; }
    .close-btn {
      width: 38px; height: 38px; flex: none;
      display: grid; place-items: center;
      color: #c1cee3; background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(193, 206, 227, 0.22); border-radius: 999px;
      cursor: pointer; padding: 0;
      transition: background-color 260ms ease, border-color 260ms ease,
        color 260ms ease, transform 380ms cubic-bezier(0.34, 1.4, 0.5, 1);
    }
    .close-btn svg { width: 18px; height: 18px; }
    .close-btn:hover {
      color: #ffffff;
      background: rgba(83, 178, 127, 0.28);
      border-color: rgba(83, 178, 127, 0.7);
      transform: rotate(90deg) scale(1.08);
    }
    .close-btn:active { transform: rotate(90deg) scale(0.94); }

    /* ---------- Language accordions ---------- */
    .loc-acc {
      margin-top: 0.8rem; border: 1px solid #e2e8f1; border-radius: 10px;
      background: #fbfcfe; overflow: hidden;
    }
    .loc-acc summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.7rem 0.9rem;
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: #46586f;
      transition: background-color 200ms ease, color 200ms ease;
    }
    .loc-acc summary::-webkit-details-marker { display: none; }
    .loc-acc summary:hover { background: rgba(83, 178, 127, 0.07); color: #2e7d54; }
    .loc-acc .chev { width: 14px; height: 14px; flex: none; transition: transform 260ms ease; }
    .loc-acc[open] .chev { transform: rotate(90deg); }
    .loc-acc[open] summary { border-bottom: 1px solid #eef2f7; }
    .acc-flag {
      margin-left: auto; font-size: 0.62rem; font-weight: 700;
      padding: 0.18rem 0.45rem; border-radius: 6px;
      background: rgba(122, 139, 161, 0.14); color: #7a8ba1;
    }
    .acc-flag.filled { background: rgba(83, 178, 127, 0.14); color: #2e7d54; }
    .acc-body { padding: 0.2rem 0.9rem 0.9rem; }
    .loc-acc[open] .acc-body { animation: accIn 240ms ease; }
    @keyframes accIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
    .drawer-body { padding: 1.2rem 1.4rem 1.5rem; overflow-y: auto; flex: 1; }
    .drawer-foot {
      padding: 0.9rem 1.4rem; border-top: 1px solid #eef2f7; background: #fbfcfe;
      display: flex; gap: 0.7rem; align-items: center;
    }
    .photo-row { display: flex; gap: 1rem; align-items: center; }
    .photo-preview {
      width: 84px; height: 84px; flex: none; border-radius: 999px; object-fit: cover;
      border: 3px solid rgba(83, 178, 127, 0.25); background: #eef2f7;
    }
    .upload-btn {
      font: inherit; display: inline-block; font-size: 0.76rem; font-weight: 700; color: #3d5a80;
      border: 1px solid #d5deea; border-radius: 8px; padding: 0.45rem 0.9rem; cursor: pointer; background: #f4f7fb;
    }
    .upload-wrap:hover .upload-btn { border-color: #53b27f; color: #2e7d54; }
    /* The real file input sits invisibly on top of the button, so the click
       lands directly on it — browsers only open the picker for genuine clicks. */
    .upload-wrap { position: relative; display: inline-block; }
    .file-overlay {
      position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; cursor: pointer; font-size: 0;
    }
    .upload-status { font-size: 0.74rem; color: #5c6f88; margin-top: 0.25rem; min-height: 1em; }
    .upload-status.err { color: #a33d3d; font-weight: 600; }
    .upload-status.ok { color: #2e7d54; font-weight: 600; }
    .photo-row.dragover {
      outline: 2px dashed rgba(83, 178, 127, 0.6); outline-offset: 6px; border-radius: 12px;
      background: rgba(83, 178, 127, 0.05);
    }
    .field { display: grid; gap: 0.35rem; margin-top: 0.9rem; }
    .field span { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #46586f; }
    .field em { font-weight: 400; text-transform: none; letter-spacing: 0; color: #93a3b8; }
    .in {
      font: inherit; font-size: 0.88rem; width: 100%;
      padding: 0.55rem 0.7rem; border: 1px solid #d5deea; border-radius: 8px; background: #fbfcfe;
    }
    .in:focus { outline: none; border-color: #53b27f; }
    .loc-block { border: 1px dashed #e2e8f1; border-radius: 10px; padding: 0.5rem 1rem 1rem; margin-top: 1rem; }
    .loc-block legend { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #5c6f88; padding: 0 0.4rem; }
    .save {
      font: inherit; font-size: 0.88rem; font-weight: 700; color: #ffffff;
      background: #53b27f; border: 0; border-radius: 9px; padding: 0.65rem 1.4rem; cursor: pointer;
    }
    .save:hover { filter: brightness(1.07); }
    .drawer-cancel { font: inherit; font-size: 0.8rem; font-weight: 600; color: #7a8ba1; background: none; border: 0; cursor: pointer; }
    .drawer-delete { margin-left: auto; font: inherit; font-size: 0.78rem; font-weight: 700; color: #a33d3d; background: none; border: 0; cursor: pointer; }
    .drawer-delete:hover { text-decoration: underline; }

    /* ---------- View switcher (sliding thumb) ---------- */
    .seg {
      position: relative;
      display: inline-flex;
      background: #ffffff;
      border: 1px solid #d5deea;
      border-radius: 999px;
      padding: 0.3rem;
      margin-top: 1.4rem;
      box-shadow: 0 6px 18px rgba(15, 26, 42, 0.06);
      isolation: isolate;
    }
    /* the gliding pill */
    .seg-thumb {
      position: absolute;
      top: 0.3rem;
      bottom: 0.3rem;
      left: 0;
      width: 0;
      border-radius: 999px;
      background: linear-gradient(180deg, #16283e 0%, #0f2036 100%);
      box-shadow: 0 6px 16px rgba(15, 26, 42, 0.28);
      transition: transform 420ms cubic-bezier(0.32, 1.3, 0.44, 1), width 420ms cubic-bezier(0.32, 1.3, 0.44, 1);
      z-index: -1;
    }
    .seg-thumb.no-anim { transition: none; }
    .seg-btn {
      font: inherit;
      font-size: 0.84rem;
      font-weight: 700;
      color: #46586f;
      background: none;
      border: 0;
      cursor: pointer;
      padding: 0.5rem 1.4rem;
      border-radius: 999px;
      white-space: nowrap;
      transition: color 300ms ease;
    }
    .seg-btn:focus { outline: none; }
    .seg-btn:focus-visible { box-shadow: 0 0 0 3px rgba(83, 178, 127, 0.35); }
    .seg-btn:hover:not(.active) { color: #2e7d54; }
    .seg-btn.active { color: #ffffff; }
    .seg-btn .count { opacity: 0.6; font-weight: 600; margin-left: 0.3rem; font-size: 0.85em; }

    /* ---------- Partner cards (mirrors the public Partners page) ---------- */
    .pcards { margin-top: 1.4rem; display: grid; gap: 1rem; }
    .pcard {
      position: relative; cursor: pointer;
      background: #ffffff; border: 1px solid #d7deea; border-radius: 1.2rem;
      padding: 1.4rem 1.7rem;
      display: grid; grid-template-columns: 260px 1fr; gap: 1.8rem; align-items: center;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
      overflow: hidden; isolation: isolate;
      transition: border-color 360ms ease, box-shadow 360ms ease, transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1);
    }
    .pcard::after {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
      opacity: 0; transition: opacity 360ms ease;
    }
    .pcard:hover { transform: translateY(-4px); border-color: rgba(83, 178, 127, 0.42); box-shadow: 0 20px 40px rgba(15, 26, 42, 0.1); }
    .pcard:hover::after { opacity: 1; }
    .logo-box {
      height: 100%; min-height: 92px;
      display: flex; align-items: center; justify-content: center;
      padding-right: 1.6rem; border-right: 1px solid #e2e8f1;
    }
    .logo-box img { max-height: 76px; max-width: 190px; object-fit: contain; }
    .logo-box .no-logo { color: #93a3b8; font-size: 0.72rem; }
    .p-body { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
    .p-name { font-size: 1.05rem; font-weight: 700; color: #16283e; }
    .p-role {
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.09em;
      text-transform: uppercase; color: #2e7d54;
    }
    .p-summary {
      font-size: 0.83rem; color: #5c6f88; line-height: 1.6;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .p-foot {
      margin-top: 0.4rem; display: flex; align-items: center; gap: 0.9rem;
    }
    .p-site { font-size: 0.72rem; color: #3d5a80; text-decoration: none; }
    .p-site:hover { text-decoration: underline; }
    .status-pill {
      position: absolute; top: 0.9rem; right: 1rem;
      font-size: 0.58rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
      padding: 0.2rem 0.5rem; border-radius: 999px;
    }
    .status-pill.live { background: rgba(83, 178, 127, 0.15); color: #2e7d54; }
    .status-pill.hidden { background: rgba(196, 148, 58, 0.9); color: #ffffff; }
    @media (max-width: 820px) {
      .pcard { grid-template-columns: 1fr; }
      .logo-box { border-right: 0; border-bottom: 1px solid #e2e8f1; padding: 0 0 1rem; }
    }

    /* ---------- Smooth view switching ---------- */
    .view { transition: opacity 260ms ease, transform 260ms ease; }
    .view[hidden] { display: none; }
    .view.leaving { opacity: 0; transform: translateY(6px); }
    .view.entering { animation: viewIn 300ms cubic-bezier(0.2, 0.7, 0.3, 1); }
    @keyframes viewIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  </style>

  <div class="page-head head-row">
    <div>
      <h1 id="view-title">{view === "partners" ? "Partners" : "Team"}</h1>
      <p id="view-sub">
        {view === "partners"
          ? "Click a partner to edit. Visible partners appear on the public Partners page."
          : "Click a team member to edit. Changes go live on the About page immediately."}
      </p>
    </div>
    <button class="new-btn" type="button" id="add-member" hidden={view === "partners"}>+ Add team member</button>
    <button class="new-btn" type="button" id="add-partner" hidden={view !== "partners"}>+ Add partner</button>
  </div>

  <div class="seg" id="view-seg">
    <span class="seg-thumb no-anim" id="seg-thumb"></span>
    <button class={view === "team" ? "seg-btn active" : "seg-btn"} type="button" data-view="team">
      Team <span class="count">{list.length}</span>
    </button>
    <button class={view === "partners" ? "seg-btn active" : "seg-btn"} type="button" data-view="partners">
      Partners <span class="count">{partners.length}</span>
    </button>
  </div>

  {error && <p class="notice err">{error}</p>}

  <section class="view" id="view-partners" hidden={view !== "partners"}>
    <div class="pcards">
      {partners.map((p, i) => (
        <article class="pcard" data-open-partner={p.id} title={`Edit ${p.name}`}>
          <span class={p.status === "published" ? "status-pill live" : "status-pill hidden"}>
            {p.status === "published" ? "visible" : "hidden"}
          </span>
          <div class="logo-box">
            {p.logo_url ? <img src={p.logo_url} alt={p.name} loading="lazy" /> : <span class="no-logo">no logo</span>}
          </div>
          <div class="p-body">
            <p class="p-role">{tr(p, "en", "role")}</p>
            <p class="p-name">{p.name}</p>
            <p class="p-summary">{tr(p, "en", "summary")}</p>
            <div class="p-foot">
              <span class="badges">
                {["en", "es", "ca"].map((loc) => (
                  <span class={tr(p, loc, "role") ? "lang has" : "lang missing"}>{loc.toUpperCase()}</span>
                ))}
              </span>
              {p.website_url && (
                <a class="p-site" href={p.website_url} target="_blank" rel="noreferrer">Website ↗</a>
              )}
              <span class="arrows">
                <form class="inline" method="post" action="/api/admin/partners">
                  <input type="hidden" name="action" value="move" />
                  <input type="hidden" name="id" value={p.id} />
                  <input type="hidden" name="dir" value="up" />
                  <button class="arrow" type="submit" disabled={i === 0} title="Move up">↑</button>
                </form>
                <form class="inline" method="post" action="/api/admin/partners">
                  <input type="hidden" name="action" value="move" />
                  <input type="hidden" name="id" value={p.id} />
                  <input type="hidden" name="dir" value="down" />
                  <button class="arrow" type="submit" disabled={i === partners.length - 1} title="Move down">↓</button>
                </form>
              </span>
              <button class="mini" type="button" data-open-partner={p.id}>Edit</button>
            </div>
          </div>
        </article>
      ))}
    </div>
    {partners.length === 0 && <p class="empty">No partners yet — add the first one.</p>}
  </section>

  <section class="view" id="view-team" hidden={view === "partners"}>
  <div class="cards">
    {list.map((m, i) => (
      <article class="mcard" data-open={m.id} title={`Edit ${m.name}`}>
        {m.status !== "published" && <span class="draft-tag">draft</span>}
        {m.photo_url
          ? <img class="avatar" src={m.photo_url} alt={m.name} loading="lazy" />
          : <div class="avatar avatar-empty">no photo</div>}
        <p class="m-name">{m.name}</p>
        <p class="m-role">{tr(m, "en", "role")}</p>
        <p class="m-bio">{tr(m, "en", "description")}</p>
        <span class="badges">
          {["en", "es", "ca"].map((loc) => (
            <span class={tr(m, loc, "role") ? "lang has" : "lang missing"}>{loc.toUpperCase()}</span>
          ))}
          {m.linkedin_url && (
            <span class="li-dot" title="LinkedIn on file">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3-.02-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21H9z"/></svg>
            </span>
          )}
        </span>
        <div class="m-foot">
          <span class="arrows">
            <form class="inline" method="post" action="/api/admin/team">
              <input type="hidden" name="action" value="move" />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="dir" value="up" />
              <button class="arrow" type="submit" disabled={i === 0} title="Move up">↑</button>
            </form>
            <form class="inline" method="post" action="/api/admin/team">
              <input type="hidden" name="action" value="move" />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="dir" value="down" />
              <button class="arrow" type="submit" disabled={i === list.length - 1} title="Move down">↓</button>
            </form>
          </span>
          <button class="mini" type="button" data-open={m.id}>Edit</button>
        </div>
      </article>
    ))}
  </div>

  {list.length === 0 && <p class="empty">No team members yet — add the first one.</p>}
  </section>

  <!-- ---------- Drawer ---------- -->
  <div class="backdrop" id="drawer-backdrop"></div>
  <aside class="drawer" id="drawer" aria-hidden="true">
    <div class="drawer-head">
      <h2 id="drawer-title">Edit team member</h2>
      <button class="close-btn" type="button" id="drawer-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <form method="post" action="/api/admin/team" id="member-form" style="display:contents;">
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="id" id="f-id" />
      <div class="drawer-body">
        <div class="photo-row" id="f-dropzone">
          <img class="photo-preview" id="f-preview" src="" alt="" />
          <div>
            <span class="upload-wrap">
              <span class="upload-btn" id="f-photo-btn">Choose photo…</span>
              <input
                class="file-overlay"
                type="file"
                id="f-photo-input"
                accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,.png,.jpg,.jpeg,.webp,.gif,.svg"
                title="Choose a photo"
              />
            </span>
            <p class="upload-status" id="f-upload-status"></p>
          </div>
        </div>
        <label class="field">
          <span>Photo URL</span>
          <input class="in" type="text" name="photo_url" id="f-photo-url" />
        </label>
        <label class="field">
          <span>Name</span>
          <input class="in" type="text" name="name" id="f-name" required />
        </label>
        <label class="field">
          <span>LinkedIn <em>(full URL or just the handle)</em></span>
          <input class="in" type="text" name="linkedin_url" id="f-linkedin" placeholder="https://www.linkedin.com/in/…" />
        </label>
        <label class="field">
          <span>Status</span>
          <select class="in" name="status" id="f-status">
            <option value="published">Published</option>
            <option value="draft">Draft (hidden from website)</option>
          </select>
        </label>

        <fieldset class="loc-block">
          <legend>English</legend>
          <label class="field">
            <span>Role</span>
            <input class="in" type="text" name="role_en" id="f-role-en" />
          </label>
          <label class="field">
            <span>Bio</span>
            <textarea class="in" name="bio_en" id="f-bio-en" rows="4"></textarea>
          </label>
        </fieldset>

        {LOCALES.filter((l) => l.key !== "en").map((loc) => (
          <details class="loc-acc" data-acc={loc.key}>
            <summary>
              <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              <span class="acc-title">{loc.label}</span>
              <span class="acc-flag" data-flag={loc.key}></span>
            </summary>
            <div class="acc-body">
              <label class="field">
                <span>Role</span>
                <input class="in" type="text" name={`role_${loc.key}`} id={`f-role-${loc.key}`} />
              </label>
              <label class="field">
                <span>Bio</span>
                <textarea class="in" name={`bio_${loc.key}`} id={`f-bio-${loc.key}`} rows="4"></textarea>
              </label>
            </div>
          </details>
        ))}
      </div>
      <div class="drawer-foot">
        <button class="save" type="submit">Save</button>
        <button class="drawer-cancel" type="button" id="drawer-cancel">Cancel</button>
        <button class="drawer-delete" type="submit" name="action" value="delete" id="drawer-delete" formnovalidate>Remove</button>
      </div>
    </form>
  </aside>

  <!-- ---------- Partner drawer ---------- -->
  <aside class="drawer" id="pdrawer" aria-hidden="true">
    <div class="drawer-head">
      <h2 id="pdrawer-title">Edit partner</h2>
      <button class="close-btn" type="button" id="pdrawer-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <form method="post" action="/api/admin/partners" style="display:contents;">
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="id" id="p-id" />
      <div class="drawer-body">
        <div class="photo-row" id="p-dropzone">
          <div class="logo-box" style="width:110px;flex:none;">
            <img id="p-preview" src="" alt="" style="max-height:100%;max-width:100%;object-fit:contain;" />
          </div>
          <div>
            <span class="upload-wrap">
              <span class="upload-btn">Choose logo…</span>
              <input
                class="file-overlay"
                type="file"
                id="p-logo-input"
                accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,.png,.jpg,.jpeg,.webp,.gif,.svg"
                title="Choose a logo"
              />
            </span>
            <p class="upload-status" id="p-upload-status"></p>
          </div>
        </div>
        <label class="field">
          <span>Logo URL</span>
          <input class="in" type="text" name="logo_url" id="p-logo-url" />
        </label>
        <label class="field">
          <span>Partner name</span>
          <input class="in" type="text" name="name" id="p-name" required />
        </label>
        <label class="field">
          <span>Website <em>(optional)</em></span>
          <input class="in" type="text" name="website_url" id="p-website" placeholder="https://…" />
        </label>
        <label class="field">
          <span>Visibility</span>
          <select class="in" name="status" id="p-status">
            <option value="published">Visible on website</option>
            <option value="draft">Hidden</option>
          </select>
        </label>

        <fieldset class="loc-block">
          <legend>English</legend>
          <label class="field">
            <span>Role</span>
            <input class="in" type="text" name="role_en" id="p-role-en" />
          </label>
          <label class="field">
            <span>Summary</span>
            <textarea class="in" name="summary_en" id="p-summary-en" rows="4"></textarea>
          </label>
        </fieldset>

        {LOCALES.filter((l) => l.key !== "en").map((loc) => (
          <details class="loc-acc" data-pacc={loc.key}>
            <summary>
              <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              <span class="acc-title">{loc.label}</span>
              <span class="acc-flag"></span>
            </summary>
            <div class="acc-body">
              <label class="field">
                <span>Role</span>
                <input class="in" type="text" name={`role_${loc.key}`} id={`p-role-${loc.key}`} />
              </label>
              <label class="field">
                <span>Summary</span>
                <textarea class="in" name={`summary_${loc.key}`} id={`p-summary-${loc.key}`} rows="4"></textarea>
              </label>
            </div>
          </details>
        ))}
      </div>
      <div class="drawer-foot">
        <button class="save" type="submit">Save</button>
        <button class="drawer-cancel" type="button" id="pdrawer-cancel">Cancel</button>
        <button class="drawer-delete" type="submit" name="action" value="delete" id="pdrawer-delete" formnovalidate>Remove</button>
      </div>
    </form>
  </aside>

  <script type="application/json" id="team-data" set:html={JSON.stringify(list)}></script>
  <script type="application/json" id="partner-data" set:html={JSON.stringify(partners)}></script>

  <script>
    // Tidy the URL after a save/remove redirect (no banner is shown).
    (() => {
      const p = new URLSearchParams(location.search);
      if (p.has("saved") || p.has("removed")) {
        p.delete("saved");
        p.delete("removed");
        const q = p.toString();
        history.replaceState({}, "", q ? `/admin/team?${q}` : "/admin/team");
      }
    })();

    // ---------- Smooth Team ⇄ Partners switching (no page reload) ----------
    (() => {
      const views: Record<string, HTMLElement | null> = {
        team: document.getElementById("view-team"),
        partners: document.getElementById("view-partners"),
      };
      const title = document.getElementById("view-title")!;
      const sub = document.getElementById("view-sub")!;
      const addMember = document.getElementById("add-member") as HTMLButtonElement;
      const addPartner = document.getElementById("add-partner") as HTMLButtonElement;
      const COPY: Record<string, [string, string]> = {
        team: ["Team", "Click a team member to edit. Changes go live on the About page immediately."],
        partners: ["Partners", "Click a partner to edit. Visible partners appear on the public Partners page."],
      };

      const thumb = document.getElementById("seg-thumb")!;
      function moveThumb(animate = true) {
        const active = document.querySelector<HTMLElement>(".seg-btn.active");
        if (!active) return;
        thumb.classList.toggle("no-anim", !animate);
        thumb.style.width = `${active.offsetWidth}px`;
        thumb.style.transform = `translateX(${active.offsetLeft}px)`;
        if (!animate) requestAnimationFrame(() => thumb.classList.remove("no-anim"));
      }
      // position on load (fonts can shift widths, so redo once ready)
      moveThumb(false);
      document.fonts?.ready.then(() => moveThumb(false));
      window.addEventListener("resize", () => moveThumb(false));

      function show(next: string, push = true) {
        const current = views.team?.hidden ? "partners" : "team";
        if (next === current) return;
        const from = views[current]!;
        const to = views[next]!;

        from.classList.add("leaving");
        setTimeout(() => {
          from.hidden = true;
          from.classList.remove("leaving");
          to.hidden = false;
          to.classList.add("entering");
          setTimeout(() => to.classList.remove("entering"), 320);
        }, 180);

        document.querySelectorAll<HTMLElement>(".seg-btn").forEach((b) =>
          b.classList.toggle("active", b.dataset.view === next)
        );
        moveThumb();
        const [h, p] = COPY[next];
        title.textContent = h;
        sub.textContent = p;
        addMember.hidden = next === "partners";
        addPartner.hidden = next !== "partners";
        if (push) {
          const url = next === "partners" ? "/admin/team?view=partners" : "/admin/team";
          history.pushState({ view: next }, "", url);
        }
      }

      document.querySelectorAll<HTMLElement>(".seg-btn").forEach((btn) =>
        btn.addEventListener("click", () => show(btn.dataset.view!))
      );
      window.addEventListener("popstate", () => {
        const v = new URLSearchParams(location.search).get("view") === "partners" ? "partners" : "team";
        show(v, false);
      });
    })();

    const members = JSON.parse(document.getElementById("team-data")?.textContent || "[]");
    const byId = new Map(members.map((m: any) => [m.id, m]));

    const drawer = document.getElementById("drawer")!;
    const backdrop = document.getElementById("drawer-backdrop")!;
    const title = document.getElementById("drawer-title")!;
    const del = document.getElementById("drawer-delete") as HTMLButtonElement;
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

    const BLANK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 84 84'%3E%3Crect width='84' height='84' fill='%23eef2f7'/%3E%3C/svg%3E";

    function open(id: string | null) {
      const m: any = id ? byId.get(id) : null;
      const t = m?.translations ?? {};
      title.textContent = m ? `Edit ${m.name}` : "New team member";
      $("f-id").value = m?.id ?? "";
      $("f-name").value = m?.name ?? "";
      $("f-photo-url").value = m?.photo_url ?? "";
      $("f-linkedin").value = m?.linkedin_url ?? "";
      ($("f-status") as unknown as HTMLSelectElement).value = m?.status ?? "published";
      (document.getElementById("f-preview") as HTMLImageElement).src = m?.photo_url || BLANK;
      for (const loc of ["en", "es", "ca"]) {
        $(`f-role-${loc}`).value = t[loc]?.role ?? "";
        ($(`f-bio-${loc}`) as unknown as HTMLTextAreaElement).value = t[loc]?.description ?? "";
      }
      // Translation accordions start closed; flag shows whether copy exists.
      document.querySelectorAll<HTMLDetailsElement>(".loc-acc").forEach((acc) => {
        acc.open = false;
        const loc = acc.dataset.acc!;
        const flag = acc.querySelector<HTMLElement>(".acc-flag")!;
        const filled = Boolean(t[loc]?.role || t[loc]?.description);
        flag.textContent = filled ? "translated" : "empty";
        flag.classList.toggle("filled", filled);
      });
      del.style.display = m ? "block" : "none";
      del.onclick = (e) => {
        if (!confirm(`Remove ${m?.name} from the team page?`)) e.preventDefault();
      };
      const st = document.getElementById("f-upload-status")!;
      st.textContent = "";
      st.className = "upload-status";
      drawer.classList.add("open");
      backdrop.classList.add("open");
      drawer.setAttribute("aria-hidden", "false");
      setTimeout(() => $("f-name").focus(), 320);
    }

    function close() {
      drawer.classList.remove("open");
      backdrop.classList.remove("open");
      drawer.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll("[data-open]").forEach((el) => {
      el.addEventListener("click", (e) => {
        // don't hijack the reorder arrows
        if ((e.target as HTMLElement).closest("form.inline")) return;
        e.preventDefault();
        open(el.getAttribute("data-open"));
      });
    });
    document.getElementById("add-member")?.addEventListener("click", () => open(null));
    document.getElementById("drawer-close")?.addEventListener("click", close);
    document.getElementById("drawer-cancel")?.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

    // ---------- Photo upload (button, drag & drop) ----------
    const photoInput = document.getElementById("f-photo-input") as HTMLInputElement;
    const dropzone = document.getElementById("f-dropzone")!;
    const status = () => document.getElementById("f-upload-status")!;

    function setStatus(msg: string, kind: "" | "ok" | "err" = "") {
      const el = status();
      el.textContent = msg;
      el.className = "upload-status" + (kind ? " " + kind : "");
    }

    const ERRORS: Record<string, string> = {
      bad_type: "That file type isn't supported. Please use JPG, PNG, WebP or GIF (iPhone .HEIC photos need exporting as JPG first).",
      too_large: "That image is over 8 MB — please use a smaller file.",
      no_file: "No file was received. Please try again.",
    };

    async function uploadFile(file: File) {
      if (!file) return;
      if (file.size > 8 * 1024 * 1024) return setStatus(ERRORS.too_large, "err");
      setStatus(`Uploading ${file.name}…`);
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(ERRORS[data.error] || data.error || `upload failed (${res.status})`);
        $("f-photo-url").value = data.url;
        (document.getElementById("f-preview") as HTMLImageElement).src = data.url;
        setStatus("Photo uploaded ✓ — remember to Save", "ok");
      } catch (err) {
        setStatus(err instanceof Error ? err.message : "Upload failed", "err");
      }
    }

    photoInput?.addEventListener("change", () => {
      const file = photoInput.files?.[0];
      if (file) uploadFile(file);
    });

    ["dragenter", "dragover"].forEach((ev) =>
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        dropzone.classList.add("dragover");
      })
    );
    ["dragleave", "drop"].forEach((ev) =>
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        dropzone.classList.remove("dragover");
      })
    );
    dropzone.addEventListener("drop", (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) uploadFile(file);
    });

    // ================= PARTNERS =================
    const partners = JSON.parse(document.getElementById("partner-data")?.textContent || "[]");
    const pById = new Map(partners.map((p: any) => [p.id, p]));
    const pdrawer = document.getElementById("pdrawer")!;
    const pTitle = document.getElementById("pdrawer-title")!;
    const pDel = document.getElementById("pdrawer-delete") as HTMLButtonElement;
    const LOGO_BLANK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E";

    function openPartner(id: string | null) {
      const p: any = id ? pById.get(id) : null;
      const t = p?.translations ?? {};
      pTitle.textContent = p ? `Edit ${p.name}` : "New partner";
      $("p-id").value = p?.id ?? "";
      $("p-name").value = p?.name ?? "";
      $("p-logo-url").value = p?.logo_url ?? "";
      $("p-website").value = p?.website_url ?? "";
      ($("p-status") as unknown as HTMLSelectElement).value = p?.status ?? "published";
      (document.getElementById("p-preview") as HTMLImageElement).src = p?.logo_url || LOGO_BLANK;
      for (const loc of ["en", "es", "ca"]) {
        $(`p-role-${loc}`).value = t[loc]?.role ?? "";
        ($(`p-summary-${loc}`) as unknown as HTMLTextAreaElement).value = t[loc]?.summary ?? "";
      }
      document.querySelectorAll<HTMLDetailsElement>("[data-pacc]").forEach((acc) => {
        acc.open = false;
        const loc = acc.dataset.pacc!;
        const flag = acc.querySelector<HTMLElement>(".acc-flag")!;
        const filled = Boolean(t[loc]?.role || t[loc]?.summary);
        flag.textContent = filled ? "translated" : "empty";
        flag.classList.toggle("filled", filled);
      });
      pDel.style.display = p ? "block" : "none";
      pDel.onclick = (e) => {
        if (!confirm(`Remove ${p?.name} from the partners page?`)) e.preventDefault();
      };
      const st = document.getElementById("p-upload-status")!;
      st.textContent = "";
      st.className = "upload-status";
      pdrawer.classList.add("open");
      backdrop.classList.add("open");
      pdrawer.setAttribute("aria-hidden", "false");
      setTimeout(() => $("p-name").focus(), 320);
    }

    function closePartner() {
      pdrawer.classList.remove("open");
      backdrop.classList.remove("open");
      pdrawer.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll("[data-open-partner]").forEach((el) => {
      el.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("form.inline")) return;
        e.preventDefault();
        openPartner(el.getAttribute("data-open-partner"));
      });
    });
    document.getElementById("add-partner")?.addEventListener("click", () => openPartner(null));
    document.getElementById("pdrawer-close")?.addEventListener("click", closePartner);
    document.getElementById("pdrawer-cancel")?.addEventListener("click", closePartner);
    backdrop.addEventListener("click", closePartner);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closePartner(); });

    // Logo upload (button + drag & drop)
    const logoInput = document.getElementById("p-logo-input") as HTMLInputElement;
    const pDropzone = document.getElementById("p-dropzone")!;
    function setPStatus(msg: string, kind: "" | "ok" | "err" = "") {
      const el = document.getElementById("p-upload-status")!;
      el.textContent = msg;
      el.className = "upload-status" + (kind ? " " + kind : "");
    }
    async function uploadLogo(file: File) {
      if (!file) return;
      if (file.size > 8 * 1024 * 1024) return setPStatus(ERRORS.too_large, "err");
      setPStatus(`Uploading ${file.name}…`);
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(ERRORS[data.error] || data.error || `upload failed (${res.status})`);
        $("p-logo-url").value = data.url;
        (document.getElementById("p-preview") as HTMLImageElement).src = data.url;
        setPStatus("Logo uploaded ✓ — remember to Save", "ok");
      } catch (err) {
        setPStatus(err instanceof Error ? err.message : "Upload failed", "err");
      }
    }
    logoInput?.addEventListener("change", () => {
      const file = logoInput.files?.[0];
      if (file) uploadLogo(file);
    });
    ["dragenter", "dragover"].forEach((ev) =>
      pDropzone.addEventListener(ev, (e) => { e.preventDefault(); pDropzone.classList.add("dragover"); })
    );
    ["dragleave", "drop"].forEach((ev) =>
      pDropzone.addEventListener(ev, (e) => { e.preventDefault(); pDropzone.classList.remove("dragover"); })
    );
    pDropzone.addEventListener("drop", (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) uploadLogo(file);
    });
  </script>
</AdminLayout>
