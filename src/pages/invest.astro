---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../lib/i18n";

const locale = getLocaleFromUrl(Astro.url) ?? "en";
const contactHref = buildLocalizedPath("/contact", locale);
const opportunitiesHref = buildLocalizedPath("/opportunities", locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invest with Equity Partners | Andorran Real Estate</title>
    <meta
      name="description"
      content="Three ways to invest in Andorran real estate with Equity Partners: Debt for contractual annual income, Equity for full project upside, or the most popular Debt + Equity structure blending both. Returns are set per project — see live figures on our Opportunities page."
    />
    <link rel="icon" type="image/png" href="/EP favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --navy: #0f1a2a;
        --navy-deep: #0a1422;
        --navy-mid: #172235;
        --green: #53b27f;
        --green-light: #6ec595;
        --green-dark: #3f9568;
        --line: #dce3ee;
        --line-soft: #eef2f8;
        --text: #172235;
        --muted: #5a667a;
        --font: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: #ffffff;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
      }

      [data-animate] {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 700ms ease, transform 700ms ease;
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* ────────────────  Hero  ──────────────── */
      .invest-hero {
        position: relative;
        padding: 9rem 0 5rem;
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          radial-gradient(ellipse at 88% 100%, rgba(130, 147, 174, 0.16), transparent 60%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        overflow: hidden;
      }

      .invest-hero::before,
      .invest-hero::after {
        content: "";
        position: absolute;
        width: 620px;
        height: 620px;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.55;
      }

      .invest-hero::before {
        top: -180px;
        right: -160px;
        background: radial-gradient(circle, rgba(83, 178, 127, 0.18), transparent 70%);
      }

      .invest-hero::after {
        bottom: -220px;
        left: -160px;
        background: radial-gradient(circle, rgba(130, 147, 174, 0.18), transparent 70%);
      }

      .invest-hero .container {
        position: relative;
        z-index: 1;
      }

      .invest-hero-inner {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .invest-hero .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--green-light);
        margin: 0;
      }

      .invest-hero .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--green));
        display: inline-block;
      }

      .invest-hero h1 {
        font-size: clamp(2rem, 4.4vw, 3.2rem);
        font-weight: 700;
        color: #f3f7fc;
        margin: 0;
        line-height: 1.05;
        letter-spacing: -0.012em;
      }

      .invest-hero h1::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, var(--green), rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .invest-hero p {
        font-size: 1.02rem;
        color: rgba(220, 230, 245, 0.72);
        margin: 0;
        line-height: 1.6;
      }

      .invest-hero-link {
        color: #7bd6a2;
        text-decoration: none;
        border-bottom: 1px solid rgba(123, 214, 162, 0.45);
        padding-bottom: 1px;
        transition: color 200ms ease, border-color 200ms ease;
      }

      .invest-hero-link:hover {
        color: #ffffff;
        border-bottom-color: #ffffff;
      }

      /* ────────────────  Section base  ──────────────── */
      .invest-section {
        position: relative;
        padding: 5rem 0;
      }

      .invest-section.is-light {
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
      }

      .invest-section.is-white {
        background: #ffffff;
      }

      .invest-section.is-spotlight {
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.10), transparent 55%),
          radial-gradient(ellipse at 88% 100%, rgba(130, 147, 174, 0.12), transparent 60%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
        color: #f3f7fc;
      }

      .invest-section-heading {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 3rem;
        max-width: 100%;
      }

      .invest-section-heading .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: var(--green-dark);
        margin: 0;
      }

      .invest-section.is-spotlight .invest-section-heading .eyebrow {
        color: var(--green-light);
      }

      .invest-section-heading .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--green));
        display: inline-block;
      }

      .invest-section-heading h2 {
        font-size: clamp(1.7rem, 3.2vw, 2.5rem);
        font-weight: 700;
        color: var(--navy);
        margin: 1rem 0 0;
        line-height: 1.15;
        letter-spacing: -0.012em;
        text-wrap: balance;
      }

      .invest-section.is-spotlight .invest-section-heading h2 {
        color: #f3f7fc;
      }

      .invest-section-heading h2::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, var(--green), rgba(83, 178, 127, 0));
        margin-top: 1rem;
        border-radius: 2px;
      }

      .invest-section-heading p {
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.6;
        margin: 1.2rem 0 0;
      }

      .invest-section.is-spotlight .invest-section-heading p {
        color: rgba(220, 230, 245, 0.72);
      }

      /* ────────────────  Three structure cards  ──────────────── */
      .invest-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.4rem;
        align-items: stretch;
      }

      @media (max-width: 960px) {
        .invest-grid {
          grid-template-columns: 1fr;
          gap: 1.6rem;
        }
      }

      .invest-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        padding: 2rem 1.8rem 2.1rem;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
        transition: transform 320ms ease, box-shadow 320ms ease,
          border-color 320ms ease;
      }

      .invest-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 22px 44px rgba(15, 26, 42, 0.12);
        border-color: rgba(83, 178, 127, 0.45);
      }

      .invest-card.is-featured {
        background:
          linear-gradient(180deg, rgba(83, 178, 127, 0.06), transparent 60%),
          #ffffff;
        border: 1.5px solid var(--green);
        box-shadow: 0 24px 50px rgba(83, 178, 127, 0.18);
        transform: translateY(-8px);
      }

      .invest-card.is-featured:hover {
        transform: translateY(-12px);
        box-shadow: 0 30px 60px rgba(83, 178, 127, 0.24);
      }

      @media (max-width: 960px) {
        .invest-card.is-featured {
          transform: none;
        }
        .invest-card.is-featured:hover {
          transform: translateY(-4px);
        }
      }

      .invest-card-badge {
        position: absolute;
        top: -0.7rem;
        left: 50%;
        transform: translateX(-50%);
        background: var(--green);
        color: #ffffff;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        line-height: 1;
        box-shadow: 0 6px 14px rgba(83, 178, 127, 0.35);
      }

      /* Role pill — product family (Andorra Real Estate Fund / Direct Project Financing) */
      .invest-card-role {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        background: rgba(15, 26, 42, 0.06);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        width: fit-content;
        margin-bottom: 1.1rem;
      }

      .invest-card.is-featured .invest-card-role {
        background: rgba(83, 178, 127, 0.14);
        color: var(--green-dark);
      }

      .invest-card h3 {
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 0.4rem;
        letter-spacing: -0.01em;
        line-height: 1.2;
      }

      /* Subtitle — Passive Investment · Lowest Risk, etc. */
      .invest-card-subtitle {
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 0.85rem;
      }

      /* Fading divider — matches advantage-home-card-divider on the homepage */
      .invest-card-divider {
        height: 1px;
        background: linear-gradient(
          90deg,
          rgba(83, 178, 127, 0.5),
          rgba(83, 178, 127, 0.05)
        );
        margin: 0.65rem 0 1.25rem;
      }

      .invest-card-tagline {
        font-size: 0.95rem;
        color: var(--text);
        line-height: 1.6;
        margin: 0 0 1.4rem;
      }

      /* Iconified returns card — matches homepage What We Offer styling */
      .invest-card-returns {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        align-items: center;
        padding: 1.05rem 1.15rem;
        border-radius: 0.85rem;
        background: var(--line-soft);
        border: 1px solid var(--line);
        margin-bottom: 1.4rem;
      }

      .invest-card.is-featured .invest-card-returns {
        background: rgba(83, 178, 127, 0.08);
        border-color: rgba(83, 178, 127, 0.3);
      }

      .invest-card-returns-icon {
        width: 3.4rem;
        height: 3.4rem;
        border-radius: 0.7rem;
        background: rgba(15, 26, 42, 0.05);
        border: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        flex-shrink: 0;
      }

      .invest-card.is-featured .invest-card-returns-icon {
        background: rgba(83, 178, 127, 0.16);
        border-color: rgba(83, 178, 127, 0.3);
        color: var(--green-dark);
      }

      .invest-card-returns-icon svg {
        width: 1.5rem;
        height: 1.5rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .invest-card-returns-label {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 0.4rem;
      }

      .invest-card-returns-value {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--navy);
        line-height: 1.3;
        margin: 0 0 0.3rem;
      }

      .invest-card.is-featured .invest-card-returns-value {
        color: var(--green-dark);
      }

      .invest-card-returns-sub {
        font-size: 0.78rem;
        color: var(--muted);
        margin: 0;
        line-height: 1.4;
      }

      .invest-card-features {
        list-style: none;
        padding: 0;
        margin: 0 0 1.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        flex: 1;
      }

      .invest-card-features li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        font-size: 0.92rem;
        line-height: 1.5;
        color: var(--text);
      }

      .invest-card-check {
        flex: none;
        width: 18px;
        height: 18px;
        margin-top: 2px;
        color: var(--green);
      }

      .invest-card-check svg {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .invest-card-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        background: var(--navy);
        color: #ffffff;
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 0.95rem 1.4rem;
        border-radius: 0.55rem;
        border: 1px solid var(--navy);
        transition: background 220ms ease, transform 220ms ease,
          border-color 220ms ease, box-shadow 220ms ease;
      }

      .invest-card-cta:hover {
        background: var(--green);
        border-color: var(--green);
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.28);
      }

      .invest-card.is-featured .invest-card-cta {
        background: var(--green);
        border-color: var(--green);
        box-shadow: 0 10px 22px rgba(83, 178, 127, 0.28);
      }

      .invest-card.is-featured .invest-card-cta:hover {
        background: var(--navy);
        border-color: var(--navy);
        box-shadow: 0 14px 28px rgba(15, 26, 42, 0.28);
      }

      /* ────────────────  Comparison table  ──────────────── */
      .invest-compare-wrap {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.06);
      }

      .invest-compare-note {
        margin: 0;
        padding: 0.95rem 1.3rem;
        background: rgba(83, 178, 127, 0.06);
        border-bottom: 1px solid var(--line);
        color: var(--text-muted);
        font-size: 0.82rem;
        line-height: 1.5;
      }

      .invest-compare-link {
        color: var(--green-dark);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(63, 149, 104, 0.4);
        padding-bottom: 1px;
        transition: color 200ms ease, border-color 200ms ease;
      }

      .invest-compare-link:hover {
        color: var(--navy);
        border-bottom-color: var(--navy);
      }

      .invest-compare {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.93rem;
      }

      .invest-compare thead th {
        background: var(--line-soft);
        color: var(--navy);
        font-weight: 700;
        text-align: left;
        padding: 1.1rem 1.3rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }

      .invest-compare thead th.is-highlight {
        background: rgba(83, 178, 127, 0.12);
        color: var(--green-dark);
      }

      /* Column header role pill (synced with structure cards) */
      .invest-compare-th-role {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        background: rgba(15, 26, 42, 0.08);
        font-size: 0.56rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.55rem;
        line-height: 1.1;
      }

      .invest-compare thead th.is-highlight .invest-compare-th-role {
        background: rgba(83, 178, 127, 0.2);
        color: var(--green-dark);
      }

      .invest-compare-th-title {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .invest-compare tbody td {
        padding: 1rem 1.3rem;
        border-bottom: 1px solid var(--line);
        color: var(--text);
        vertical-align: top;
      }

      .invest-compare tbody td.is-highlight {
        background: rgba(83, 178, 127, 0.04);
      }

      .invest-compare tbody tr:last-child td {
        border-bottom: none;
      }

      .invest-compare-row-label {
        font-weight: 600;
        color: var(--navy);
        background: #fafbfd !important;
        font-size: 0.86rem;
      }

      @media (max-width: 760px) {
        .invest-compare-wrap {
          overflow-x: auto;
        }
        .invest-compare {
          min-width: 640px;
        }
      }

      /* ────────────────  Deep-dive explainer blocks  ──────────────── */
      .invest-explainer {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }

      .invest-explainer-block {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        box-shadow: 0 6px 18px rgba(15, 26, 42, 0.04);
        overflow: hidden;
        transition: box-shadow 240ms ease, border-color 240ms ease;
      }

      .invest-explainer-block:hover {
        border-color: rgba(83, 178, 127, 0.35);
        box-shadow: 0 10px 28px rgba(15, 26, 42, 0.07);
      }

      .invest-explainer-block[open] {
        border-color: rgba(83, 178, 127, 0.45);
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.09);
      }

      .invest-explainer-summary {
        list-style: none;
        cursor: pointer;
        padding: 1.4rem 1.6rem;
        display: flex;
        align-items: center;
        gap: 1.2rem;
        outline: none;
      }

      .invest-explainer-summary::-webkit-details-marker {
        display: none;
      }

      .invest-explainer-summary::marker {
        content: "";
      }

      .invest-explainer-summary:focus-visible {
        box-shadow: inset 0 0 0 2px rgba(83, 178, 127, 0.4);
      }

      .invest-explainer-summary-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        min-width: 0;
      }

      .invest-explainer-summary-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .invest-explainer-tag {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--green-dark);
      }

      .invest-explainer-summary h3 {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0;
        letter-spacing: -0.01em;
      }

      .invest-explainer-return {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--green-dark);
        white-space: nowrap;
      }

      .invest-explainer-chevron {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(83, 178, 127, 0.1);
        color: var(--green-dark);
        flex-shrink: 0;
        transition: transform 320ms cubic-bezier(0.2, 0.65, 0.35, 1), background 200ms ease;
      }

      .invest-explainer-chevron svg {
        width: 14px;
        height: 14px;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .invest-explainer-summary:hover .invest-explainer-chevron {
        background: rgba(83, 178, 127, 0.2);
      }

      .invest-explainer-block[open] .invest-explainer-chevron {
        transform: rotate(180deg);
      }

      .invest-explainer-body {
        padding: 0 1.6rem 1.6rem;
        border-top: 1px solid var(--line);
        padding-top: 1.4rem;
        margin-top: 0;
      }

      .invest-explainer-body p {
        margin: 0 0 1rem;
        line-height: 1.65;
        color: var(--text);
      }

      .invest-explainer-body p:last-child {
        margin-bottom: 0;
      }

      .invest-explainer-body strong {
        color: var(--navy);
      }

      @media (max-width: 640px) {
        .invest-explainer-summary {
          padding: 1.2rem 1.3rem;
          gap: 1rem;
        }

        .invest-explainer-summary h3 {
          font-size: 1.15rem;
        }

        .invest-explainer-summary-row {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.3rem;
        }

        .invest-explainer-return {
          white-space: normal;
        }

        .invest-explainer-body {
          padding: 1.2rem 1.3rem 1.3rem;
        }
      }

      .invest-explainer-link {
        color: var(--green-dark);
        text-decoration: none;
        font-weight: 600;
        border-bottom: 1px solid rgba(63, 149, 104, 0.4);
        padding-bottom: 1px;
        transition: color 200ms ease, border-color 200ms ease;
      }

      .invest-explainer-link:hover {
        color: var(--navy);
        border-bottom-color: var(--navy);
      }

      /* ────────────────  Bottom CTA  ──────────────── */
      .invest-cta-banner {
        padding: 4rem 0;
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
      }

      .invest-cta-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 2.5rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 1.2rem;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      @media (max-width: 760px) {
        .invest-cta-inner {
          flex-direction: column;
          align-items: flex-start;
          padding: 1.8rem;
        }
      }

      .invest-cta-copy h2 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.4rem, 3vw, 1.9rem);
        font-weight: 700;
        color: #f3f7fc;
        letter-spacing: -0.012em;
      }

      .invest-cta-copy p {
        margin: 0;
        color: rgba(220, 230, 245, 0.78);
        line-height: 1.6;
        max-width: 36rem;
      }

      .invest-cta-btn {
        flex: none;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: var(--green);
        color: #ffffff;
        text-decoration: none;
        padding: 1.05rem 1.6rem;
        border-radius: 0.55rem;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        border: 1px solid var(--green);
        transition: background 220ms ease, transform 220ms ease,
          border-color 220ms ease, box-shadow 220ms ease;
      }

      .invest-cta-btn svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .invest-cta-btn:hover {
        background: #ffffff;
        color: var(--navy);
        border-color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 16px 32px rgba(0, 0, 0, 0.18);
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader
      active="invest"
      menuToggleId="mobile-menu-toggle"
      offsetFirstSection={false}
      locale={locale}
      currentPath={Astro.url.pathname}
    />

    <!-- ───────────  Hero  ─────────── -->
    <section class="invest-hero">
      <div class="container">
        <div class="invest-hero-inner" data-animate>
          <p class="eyebrow">Three Ways to Invest</p>
          <h1>Choose how you participate in Andorran real estate</h1>
          <p>
            Choose between Debt, Equity, or our most popular Debt + Equity structure. Returns vary per project. See our
            <a href={opportunitiesHref} class="invest-hero-link">live Opportunities</a> for current figures.
          </p>
        </div>
      </div>
    </section>

    <!-- ───────────  Three structure cards  ─────────── -->
    <section class="invest-section is-light">
      <div class="container">
        <div class="invest-section-heading" data-animate>
          <p class="eyebrow">Investment structures</p>
          <h2>Pick the structure that fits your mandate</h2>
          <p>
            All three structures are available on every live opportunity.
            The right one for you depends on your appetite for risk, your
            target return and how long you can lock up capital.
          </p>
        </div>

        <div class="invest-grid" data-animate>
          <!-- DEBT -->
          <article class="invest-card">
            <span class="invest-card-role">Andorra Real Estate Fund</span>
            <h3>Debt</h3>
            <p class="invest-card-subtitle">Passive Investment · Lowest Risk</p>
            <div class="invest-card-divider" aria-hidden="true"></div>
            <p class="invest-card-tagline">
              You lend capital to the project and receive a contractual annual coupon. Your position sits senior in the capital stack and is secured against the underlying real estate, with no exposure to project upside or downside.
            </p>
            <div class="invest-card-returns">
              <span class="invest-card-returns-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </span>
              <div>
                <p class="invest-card-returns-label">Headline return</p>
                <p class="invest-card-returns-value">Annual coupon</p>
                <p class="invest-card-returns-sub">Return varies per project · shared on your call</p>
              </div>
            </div>
            <ul class="invest-card-features">
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Predictable contractual payments, with no project performance exposure</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Capital secured against the property, senior to equity in repayment priority</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Fully passive, with no involvement once committed</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Shorter typical hold, capital returns at project completion or refinancing</span>
              </li>
            </ul>
            <a class="invest-card-cta" href={`${contactHref}#video-call`}>Request Video Call</a>
          </article>

          <!-- DEBT + EQUITY (featured) -->
          <article class="invest-card is-featured">
            <span class="invest-card-badge">Most popular</span>
            <span class="invest-card-role">Direct Project Financing</span>
            <h3>Debt + Equity</h3>
            <p class="invest-card-subtitle">Active Investment · Balanced Risk + Upside</p>
            <div class="invest-card-divider" aria-hidden="true"></div>
            <p class="invest-card-tagline">
              Part of your capital earns a contractual coupon, while the rest takes an ownership stake, so you get recurring income while the project runs and share in the upside at exit. You participate directly in the project's progress.
            </p>
            <div class="invest-card-returns">
              <span class="invest-card-returns-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 17 9 11l4 4 8-8"/><path d="M14 7h7v7"/></svg>
              </span>
              <div>
                <p class="invest-card-returns-label">Headline return</p>
                <p class="invest-card-returns-value">Annual coupon + Equity upside</p>
                <p class="invest-card-returns-sub">Return varies per project · shared on your call</p>
              </div>
            </div>
            <ul class="invest-card-features">
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Recurring contractual income on the debt portion while the project develops</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Equity profit share at exit on the equity portion</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Active participation in the project you back, with a direct stake in its success</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>The structure most of our investors choose</span>
              </li>
            </ul>
            <a class="invest-card-cta" href={`${contactHref}#video-call`}>Request Video Call</a>
          </article>

          <!-- EQUITY -->
          <article class="invest-card">
            <span class="invest-card-role">Direct Project Financing</span>
            <h3>Equity</h3>
            <p class="invest-card-subtitle">Active Investment · Highest Upside</p>
            <div class="invest-card-divider" aria-hidden="true"></div>
            <p class="invest-card-tagline">
              Take a pure ownership stake in a single project and share fully in the profit at exit, with the highest return potential of the three structures and the longest typical hold. Less common than Debt + Equity, but available for investors comfortable with full project exposure.
            </p>
            <div class="invest-card-returns">
              <span class="invest-card-returns-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><line x1="6" y1="20" x2="6" y2="16"/><line x1="12" y1="20" x2="12" y2="11"/><line x1="18" y1="20" x2="18" y2="6"/></svg>
              </span>
              <div>
                <p class="invest-card-returns-label">Headline return</p>
                <p class="invest-card-returns-value">Equity profit share</p>
                <p class="invest-card-returns-sub">Return varies per project · shared on your call</p>
              </div>
            </div>
            <ul class="invest-card-features">
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Full participation in project profits, with uncapped upside</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Direct ownership stake in the underlying real estate asset</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Active participation in the project you back, with a direct stake in its success</span>
              </li>
              <li>
                <span class="invest-card-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                </span>
                <span>Returns realised at project exit, with longer lock-up and no interim coupon</span>
              </li>
            </ul>
            <a class="invest-card-cta" href={`${contactHref}#video-call`}>Request Video Call</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ───────────  Comparison table  ─────────── -->
    <section class="invest-section is-white">
      <div class="container">
        <div class="invest-section-heading" data-animate>
          <p class="eyebrow">Side by side</p>
          <h2>Compare the three structures at a glance</h2>
          <p>
            A quick reference for the trade-offs across return,
            risk, position in the capital stack, and capital lock-up.
          </p>
        </div>

        <div class="invest-compare-wrap" data-animate>
          <p class="invest-compare-note">Returns vary per project. The exact coupon, equity share and hold period are calibrated to each deal and shared on your call. For live opportunities and current figures, <a href={opportunitiesHref} class="invest-compare-link">see our Opportunities page</a>.</p>
          <table class="invest-compare">
            <thead>
              <tr>
                <th></th>
                <th>
                  <span class="invest-compare-th-role">Andorra Real Estate Fund</span>
                  <span class="invest-compare-th-title">Debt</span>
                </th>
                <th class="is-highlight">
                  <span class="invest-compare-th-role">Direct Project Financing</span>
                  <span class="invest-compare-th-title">Debt + Equity</span>
                </th>
                <th>
                  <span class="invest-compare-th-role">Direct Project Financing</span>
                  <span class="invest-compare-th-title">Equity</span>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="invest-compare-row-label">Return mechanic</td>
                <td>Annual coupon</td>
                <td class="is-highlight">Coupon + equity profit share</td>
                <td>Equity profit share</td>
              </tr>
              <tr>
                <td class="invest-compare-row-label">When you get paid</td>
                <td>Throughout the project</td>
                <td class="is-highlight">During the project + at exit</td>
                <td>At project exit</td>
              </tr>
              <tr>
                <td class="invest-compare-row-label">Income profile</td>
                <td>Predictable, contractual</td>
                <td class="is-highlight">Coupon + exit profit</td>
                <td>Lump sum at exit</td>
              </tr>
              <tr>
                <td class="invest-compare-row-label">Position in capital stack</td>
                <td>Senior (secured)</td>
                <td class="is-highlight">Senior + subordinated</td>
                <td>Subordinated (ownership)</td>
              </tr>
              <tr>
                <td class="invest-compare-row-label">Risk profile</td>
                <td>Lower</td>
                <td class="is-highlight">Balanced</td>
                <td>Higher</td>
              </tr>
              <tr>
                <td class="invest-compare-row-label">Upside potential</td>
                <td>Capped at coupon</td>
                <td class="is-highlight">Capped coupon + uncapped equity</td>
                <td>Uncapped</td>
              </tr>
              <tr>
                <td class="invest-compare-row-label">Typical hold</td>
                <td>Shorter</td>
                <td class="is-highlight">Medium to long</td>
                <td>Longer</td>
              </tr>
              <tr>
                <td class="invest-compare-row-label">Best suited to</td>
                <td>Capital preservation</td>
                <td class="is-highlight">Most investors (balanced profile)</td>
                <td>Return maximisation</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ───────────  Deep-dive explainer  ─────────── -->
    <section class="invest-section is-light">
      <div class="container">
        <div class="invest-section-heading" data-animate>
          <p class="eyebrow">Understanding the structures</p>
          <h2>How each structure actually works</h2>
          <p>
            A closer look at what you're investing in, how returns are
            generated, and where each structure sits on the risk spectrum.
          </p>
        </div>

        <div class="invest-explainer">

          <!-- DEBT explainer -->
          <details class="invest-explainer-block" data-animate>
            <summary class="invest-explainer-summary">
              <div class="invest-explainer-summary-text">
                <span class="invest-explainer-tag">Structure 01</span>
                <div class="invest-explainer-summary-row">
                  <h3>Debt</h3>
                  <span class="invest-explainer-return">Annual coupon · set per project</span>
                </div>
              </div>
              <span class="invest-explainer-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="invest-explainer-body">
              <p>
                In a debt position you are <strong>lending capital</strong> to
                the project rather than owning a piece of it. In return you
                receive a contractual annual coupon, calibrated deal by
                deal and paid out at agreed intervals throughout the life
                of the investment. The exact coupon depends on the
                specific project — see our
                <a href={opportunitiesHref} class="invest-explainer-link">live Opportunities</a>
                for current figures.
              </p>
              <p>
                Your capital sits <strong>senior in the capital stack</strong>,
                which means in the event of an exit, refinancing, or wind-down,
                debt holders are repaid <em>before</em> equity holders. The
                loan is secured against the underlying Andorran property,
                providing real-asset collateral behind your return.
              </p>
              <p>
                The trade-off is simple: you give up exposure to project
                upside in exchange for predictability and downside protection.
                Even if the project delivers exceptional returns, your return
                is capped at the agreed coupon. Equally, you are insulated
                from a material part of project execution risk.
              </p>
              <p>
                Debt typically suits investors who want <strong>steady,
                contractual cash flow</strong>, want a defined exit horizon,
                and value capital preservation over outsized return.
              </p>
            </div>
          </details>

          <!-- DEBT + EQUITY explainer -->
          <details class="invest-explainer-block" data-animate>
            <summary class="invest-explainer-summary">
              <div class="invest-explainer-summary-text">
                <span class="invest-explainer-tag">Structure 02 · Most popular</span>
                <div class="invest-explainer-summary-row">
                  <h3>Debt + Equity</h3>
                  <span class="invest-explainer-return">Coupon + Equity upside · set per project</span>
                </div>
              </div>
              <span class="invest-explainer-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="invest-explainer-body">
              <p>
                A blended position — and the structure the
                <strong>majority of our investors choose</strong>. Your
                commitment is split between a debt tranche and an equity
                tranche, so you sit in <em>both</em> layers of the capital
                stack at once.
              </p>
              <p>
                The debt portion pays an annual coupon — typically
                slightly below the pure-debt coupon, because you are
                also participating in the equity upside. The equity
                portion pays out as a share of project profit when the
                asset is sold or refinanced. The split between debt and
                equity, and the exact figures on both sides, are set per
                project — see our
                <a href={opportunitiesHref} class="invest-explainer-link">live Opportunities</a>
                for current figures.
              </p>
              <p>
                The result is a profile that <strong>balances downside
                protection with full upside participation</strong>: you
                receive contractual income while the project develops,
                and you share in the gain at exit. If the project
                under-performs on the equity side, the secured coupon
                still cushions the overall return.
              </p>
              <p>
                Most investors land here because it captures the appeal of
                both structures without committing fully to either. It is
                the most common deployment we see across our investor
                base.
              </p>
            </div>
          </details>

          <!-- EQUITY explainer -->
          <details class="invest-explainer-block" data-animate>
            <summary class="invest-explainer-summary">
              <div class="invest-explainer-summary-text">
                <span class="invest-explainer-tag">Structure 03</span>
                <div class="invest-explainer-summary-row">
                  <h3>Equity</h3>
                  <span class="invest-explainer-return">Equity profit share at exit · set per project</span>
                </div>
              </div>
              <span class="invest-explainer-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="invest-explainer-body">
              <p>
                In an equity position you take a <strong>direct ownership
                stake</strong> in the project entity that holds the
                underlying Andorran asset. You are a principal alongside
                Equity Partners, not a lender to us.
              </p>
              <p>
                There is no coupon. Instead, returns are realised when the
                project is sold or refinanced — at which point you receive
                your pro-rata share of the profit. Target returns are set
                on a per-project basis and reflect the specific risk and
                lock-up profile of the deal. For the actual target on a
                specific opportunity, see our
                <a href={opportunitiesHref} class="invest-explainer-link">live Opportunities</a>.
              </p>
              <p>
                Equity sits <strong>subordinated to debt</strong> in the
                capital stack, meaning lenders are repaid first. In
                exchange, equity captures <em>all</em> of the upside above
                the debt obligations — uncapped. A project that
                out-performs delivers materially higher returns to equity
                than to debt.
              </p>
              <p>
                Equity is for investors who can tolerate longer hold
                periods, no interim cash flow, and meaningful project
                risk, in exchange for the <strong>highest return
                potential</strong> of the three structures.
              </p>
            </div>
          </details>

        </div>
      </div>
    </section>

    <!-- ───────────  Bottom CTA  ─────────── -->
    <section class="invest-cta-banner">
      <div class="container">
        <div class="invest-cta-inner" data-animate>
          <div class="invest-cta-copy">
            <h2>Not sure which structure fits you?</h2>
            <p>
              Book a 30-minute video call with our investment team. We
              will walk you through the live opportunities, explain how
              each structure would apply to your mandate, and answer any
              questions on returns, risk and timeline.
            </p>
          </div>
          <a class="invest-cta-btn" href={`${contactHref}#video-call`}>
            Request Video Call
            <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId="newsletter-email-invest" locale={locale} />
    <SiteFooter locale={locale} />

    <script type="module">
      const targets = document.querySelectorAll("[data-animate]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
