---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={t.seoTitle}
      description={t.seoDescription}
      locale={locale}
      path={Astro.url.pathname}
    />
    <link rel="icon" type="image/png" href="/EP favicon.png" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --navy: #0f1a2a;
        --green: #53b27f;
        --green-dark: #3f9568;
        --amber: #d97447;
        --blue: #4a90d9;
        --line: #dce3ee;
        --text: #172235;
        --muted: #5a667a;
        --font: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: #ffffff;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
      }

      /* ── Page Hero (Dark spotlight) ── */
      .opps-hero {
        position: relative;
        padding: 9rem 0 5rem;
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          radial-gradient(ellipse at 88% 100%, rgba(130, 147, 174, 0.16), transparent 60%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        overflow: hidden;
      }

      .opps-hero::before,
      .opps-hero::after {
        content: "";
        position: absolute;
        width: 620px;
        height: 620px;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.55;
      }

      .opps-hero::before {
        top: -180px;
        right: -160px;
        background: radial-gradient(circle, rgba(83, 178, 127, 0.18), transparent 70%);
      }

      .opps-hero::after {
        bottom: -220px;
        left: -160px;
        background: radial-gradient(circle, rgba(130, 147, 174, 0.18), transparent 70%);
      }

      .opps-hero .container {
        position: relative;
        z-index: 1;
      }

      .opps-hero-inner {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .opps-hero .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: #6ec595;
        margin: 0;
      }

      .opps-hero .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--green));
        display: inline-block;
      }

      .opps-hero h1 {
        font-size: clamp(2rem, 4.4vw, 3.2rem);
        font-weight: 700;
        color: #f3f7fc;
        margin: 0;
        line-height: 1.05;
        letter-spacing: -0.012em;
      }

      .opps-hero h1::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, var(--green), rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .opps-hero p {
        font-size: 1.02rem;
        color: rgba(220, 230, 245, 0.72);
        margin: 0;
        line-height: 1.6;
      }

      .opps-hero-link {
        color: var(--green-light, #7bd6a2);
        text-decoration: none;
        border-bottom: 1px solid rgba(123, 214, 162, 0.45);
        padding-bottom: 1px;
        transition: color 200ms ease, border-color 200ms ease;
      }

      .opps-hero-link:hover {
        color: #ffffff;
        border-bottom-color: #ffffff;
      }

      /* ── Stats strip (unified card with dividers) ── */
      .opps-stats {
        position: relative;
        padding: 2.2rem 0;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        overflow: hidden;
      }

      .opps-stats .container {
        position: relative;
        z-index: 1;
      }

      .opps-stats-inner {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
      }

      .opps-stat {
        padding: 1.4rem 1.6rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        text-align: center;
        border-right: 1px solid var(--line);
        transition: background 320ms ease;
      }

      .opps-stat:last-child {
        border-right: none;
      }

      .opps-stat:hover {
        background: rgba(83, 178, 127, 0.05);
      }

      .opps-stat-value {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--navy);
        letter-spacing: -0.012em;
        line-height: 1;
      }

      .opps-stat-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ── Grid (matches projects/About light section) ── */
      .opps-grid-section {
        position: relative;
        padding: 3rem 0 2rem;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        overflow: hidden;
      }

      .opps-grid-section .container {
        position: relative;
        z-index: 1;
      }

      .opps-section-heading {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 2rem;
      }

      .opps-section-heading .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: #3f9568;
        margin: 0;
      }

      .opps-section-heading .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--green));
        display: inline-block;
      }

      .opps-section-heading h2 {
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        color: var(--navy);
        margin: 1rem 0 0;
        line-height: 1.05;
        letter-spacing: -0.012em;
      }

      .opps-section-heading h2::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, var(--green), rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .opps-section-heading p {
        color: var(--muted);
        font-size: 1.02rem;
        line-height: 1.6;
        max-width: none;
        width: 100%;
        margin: 1.2rem 0 0;
      }

      .opps-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.4rem;
        align-items: start;
      }

      /* ── Opportunity Card ── */
      .opp-card {
        position: relative;
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
        text-decoration: none;
        color: inherit;
        isolation: isolate;
        box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
        transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
          box-shadow 360ms ease, border-color 360ms ease;
      }

      .opp-card::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: 2;
      }

      .opp-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 30px 60px rgba(15, 26, 42, 0.14),
          0 0 0 1px rgba(83, 178, 127, 0.16) inset;
        border-color: rgba(83, 178, 127, 0.42);
      }

      .opp-card:hover::before {
        opacity: 1;
      }

      .opp-card-image {
        position: relative;
        width: 100%;
        aspect-ratio: 16/10;
        overflow: hidden;
      }

      .opp-card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 400ms ease;
      }

      .opp-card:hover .opp-card-image img {
        transform: scale(1.04);
      }

      .opp-card-chips {
        position: absolute;
        top: 0.9rem;
        left: 0.9rem;
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
      }

      .opp-card-chip {
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: #ffffff;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        line-height: 1;
      }

      .opp-card-body {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 1.6rem 1.5rem 1.5rem;
        isolation: isolate;
        overflow: hidden;
      }

      .opp-card-body::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 85% 0%, rgba(83, 178, 127, 0.14), transparent 60%);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: -1;
        pointer-events: none;
      }

      .opp-card:hover .opp-card-body::before {
        opacity: 1;
      }

      .opp-card-location {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--green-dark);
        margin: 0 0 0.5rem;
      }

      .opp-card-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 0.6rem;
        line-height: 1.25;
      }

      .opp-card-tagline {
        font-size: 0.83rem;
        color: var(--muted);
        line-height: 1.55;
        margin: 0 0 1.4rem;
      }

      .opp-card-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        padding: 1.1rem 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        margin-bottom: 1.2rem;
      }

      .opp-card-metric {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .opp-card-metric-label {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.15rem;
      }

      .opp-card-metric-value {
        font-size: 0.92rem;
        font-weight: 700;
        color: var(--navy);
        line-height: 1.25;
      }

      .opp-card-metric-value.is-green {
        color: var(--green);
      }

      .opp-card-progress {
        margin-bottom: 1.2rem;
      }

      .opp-card-progress-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.7rem;
        color: var(--muted);
        margin-bottom: 0.4rem;
      }

      .opp-card-progress-top strong {
        color: var(--navy);
        font-weight: 700;
      }

      .opp-card-progress-bar {
        width: 100%;
        height: 6px;
        background: #ecf1f7;
        border-radius: 999px;
        overflow: hidden;
      }

      .opp-card-progress-fill {
        height: 100%;
        background: var(--green);
        border-radius: 999px;
      }

      .opp-card-progress-meta {
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-top: 0.4rem;
      }

      .opp-card-progress-note {
        font-size: 0.62rem;
        color: var(--muted);
        font-style: italic;
        margin: 0.4rem 0 0;
      }

      /* CTA stack (View opportunity + Request video call) */
      .opp-card-ctas {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .opp-card-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        background: var(--navy);
        color: #ffffff;
        text-decoration: none;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 0.85rem 1.4rem;
        border-radius: 0.55rem;
        border: 1px solid var(--navy);
        transition: background 220ms ease, transform 220ms ease, border-color 220ms ease;
      }

      .opp-card-cta:hover {
        background: var(--green);
        border-color: var(--green);
        transform: translateY(-1px);
      }

      .opp-card-cta.is-secondary {
        background: transparent;
        color: var(--green-dark);
        border-color: rgba(83, 178, 127, 0.4);
      }

      .opp-card-cta.is-secondary:hover {
        background: rgba(83, 178, 127, 0.08);
        color: var(--green-dark);
        border-color: var(--green);
      }

      /* ────────────────────────────────────────────────────────────
         6th card — Investment structures callout (Variation B)
         Sits in the same grid slot as opportunity cards; dark navy
         background with iconified Q&A "options" for each structure.
         ──────────────────────────────────────────────────────────── */
      .opp-card-info {
        position: relative;
        background:
          radial-gradient(ellipse at 80% -10%, rgba(83, 178, 127, 0.16), transparent 55%),
          linear-gradient(160deg, #0a1422 0%, #101e34 60%, #0a1422 100%);
        border: 1px solid rgba(83, 178, 127, 0.32);
        border-radius: 1.2rem;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(5, 12, 20, 0.22);
        color: #f3f7fc;
        display: flex;
        flex-direction: column;
        /* Match the height of the opportunity cards in the same row. */
        align-self: stretch;
      }

      .opp-card-info-inner {
        padding: 1.5rem 1.4rem 1.4rem;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .info-eyebrow {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #7bd6a2;
        margin: 0 0 0.6rem;
      }

      .info-question {
        font-size: 1.2rem;
        font-weight: 700;
        color: #f3f7fc;
        line-height: 1.25;
        letter-spacing: -0.005em;
        margin: 0 0 0.9rem;
      }

      .info-body {
        font-size: 0.8rem;
        line-height: 1.55;
        color: rgba(220, 230, 245, 0.72);
        margin: 0 0 1rem;
      }

      .info-option {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.85rem;
        align-items: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 0.7rem;
        padding: 0.9rem;
        margin-bottom: 0.85rem;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: background 220ms ease, border-color 220ms ease,
          transform 220ms ease, box-shadow 220ms ease;
      }

      .info-option:hover {
        background: rgba(83, 178, 127, 0.08);
        border-color: rgba(83, 178, 127, 0.35);
        transform: translateY(-3px);
        box-shadow: 0 12px 24px rgba(5, 12, 20, 0.28);
      }

      .info-option-icon {
        width: 2.85rem;
        height: 2.85rem;
        border-radius: 0.65rem;
        background: rgba(83, 178, 127, 0.18);
        border: 1px solid rgba(83, 178, 127, 0.4);
        color: #7bd6a2;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .info-option-icon svg {
        width: 1.3rem;
        height: 1.3rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .info-option-name {
        font-size: 0.82rem;
        font-weight: 700;
        color: #f3f7fc;
        margin: 0 0 0.18rem;
        line-height: 1.2;
      }

      .info-option-hint {
        font-size: 0.7rem;
        color: rgba(220, 230, 245, 0.7);
        line-height: 1.4;
        margin: 0;
      }

      .info-note {
        font-size: 0.72rem;
        line-height: 1.5;
        color: rgba(220, 230, 245, 0.6);
        font-style: italic;
        margin: 0.85rem 0 1.1rem;
      }

      /* "Read about structures" — fully solid green, sits below the note */
      .info-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.75rem 1.1rem;
        border-radius: 0.55rem;
        background: var(--green);
        border: 1px solid var(--green);
        color: #fff;
        text-decoration: none;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        transition: background 220ms ease, transform 220ms ease;
        /* Push to the bottom of the card so it lines up with the
           "Request video call" CTA on the adjacent opportunity cards. */
        margin-top: auto;
        margin-bottom: 0;
      }

      .info-cta:hover {
        background: #5fc189;
        transform: translateY(-1px);
      }

      .info-cta svg {
        width: 0.85rem;
        height: 0.85rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* Bottom "personal guidance" section — title + clickable video row,
         anchored to the bottom of the info card via margin-top: auto. */
      .info-video-section {
        margin-top: auto;
      }

      /* Video-call callout (Variation A — subtle clickable row).
         Sized and typed to match the structure option cards above. */
      .info-video-row {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 0.85rem;
        align-items: center;
        background: rgba(83, 178, 127, 0.10);
        border: 1px solid rgba(83, 178, 127, 0.35);
        border-radius: 0.7rem;
        padding: 0.75rem 0.9rem;
        text-decoration: none;
        transition: background 220ms ease, border-color 220ms ease;
      }

      .info-video-row:hover {
        background: rgba(83, 178, 127, 0.16);
        border-color: rgba(83, 178, 127, 0.55);
      }

      .info-video-icon {
        width: 2.35rem;
        height: 2.35rem;
        border-radius: 0.55rem;
        background: rgba(83, 178, 127, 0.18);
        border: 1px solid rgba(83, 178, 127, 0.4);
        color: #7bd6a2;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .info-video-icon svg {
        width: 1.05rem;
        height: 1.05rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .info-video-text {
        color: #f3f7fc;
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1.2;
      }

      .info-video-text small {
        display: block;
        font-size: 0.7rem;
        font-weight: 400;
        color: rgba(220, 230, 245, 0.7);
        margin-top: 0.18rem;
        line-height: 1.4;
      }

      .info-video-arrow {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        background: var(--green);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .info-video-arrow svg {
        width: 0.7rem;
        height: 0.7rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .opp-card-cta svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Investor process strip ── */
      /* ── Timeline V2 (spotlight) — duplicated from home page ── */
      .timeline-v2.is-spotlight {
        position: relative;
        padding: 5.5rem 0 4.5rem;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .timeline-v2.is-spotlight .container {
        position: relative;
        z-index: 1;
      }

      .timeline-v2.is-spotlight .section-header {
        max-width: none;
        width: 100%;
        margin-bottom: 3rem;
      }

      .timeline-v2.is-spotlight .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: #3f9568;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        margin: 0;
      }

      .timeline-v2.is-spotlight .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      .timeline-v2.is-spotlight h2 {
        color: var(--navy);
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.05;
        margin: 1rem 0 0;
        max-width: none;
        white-space: nowrap;
      }

      .timeline-v2.is-spotlight h2::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .timeline-v2.is-spotlight .intro {
        color: var(--muted);
        max-width: none;
        width: 100%;
        margin-top: 1.2rem;
        font-size: 1.02rem;
        line-height: 1.6;
      }

      .timeline-v2.is-spotlight .timeline-v2-card {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
      }

      .timeline-v2.is-spotlight .timeline-v2-col {
        position: relative;
        background: transparent;
        border: none;
        border-right: 1px solid var(--line);
        border-radius: 0;
        padding: 2rem 1.4rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        overflow: hidden;
        transition: background 320ms ease;
      }

      .timeline-v2.is-spotlight .timeline-v2-col:last-child {
        border-right: none;
      }

      .timeline-v2.is-spotlight .timeline-v2-col:hover {
        background: rgba(83, 178, 127, 0.05);
      }

      .timeline-v2.is-spotlight .timeline-v2-step-num {
        color: #3f9568;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        margin-bottom: 1rem;
      }

      .timeline-v2.is-spotlight .timeline-v2-step-icon {
        width: 3.4rem;
        height: 3.4rem;
        border-radius: 0.95rem;
        background: linear-gradient(135deg, #53b27f 0%, #3f9568 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 10px 22px rgba(83, 178, 127, 0.28),
          inset 0 1px 0 rgba(255, 255, 255, 0.22);
        margin-bottom: 1rem;
        transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
          box-shadow 360ms ease, background 360ms ease;
      }

      .timeline-v2.is-spotlight .timeline-v2-col:hover .timeline-v2-step-icon {
        background: linear-gradient(135deg, #5fc48d 0%, #4aa775 100%);
        transform: scale(1.05) rotate(-3deg);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.34),
          inset 0 1px 0 rgba(255, 255, 255, 0.28);
      }

      .timeline-v2.is-spotlight .timeline-v2-step-icon svg {
        width: 1.55rem;
        height: 1.55rem;
        stroke: #ffffff;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .timeline-v2.is-spotlight .timeline-v2-col h3 {
        color: var(--navy);
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        line-height: 1.25;
        margin: 0;
      }

      .timeline-v2.is-spotlight .timeline-v2-col p {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0.7rem auto 0;
        max-width: 22ch;
      }

      .timeline-v2.is-spotlight .timeline-v2-cta {
        margin-top: 2.4rem;
      }

      .timeline-v2.is-spotlight .timeline-v2-cta .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: auto;
        color: #3f9568;
        background: rgba(83, 178, 127, 0.08);
        border: 1px solid rgba(83, 178, 127, 0.55);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 600;
        padding: 0.85rem 1.4rem;
        border-radius: 0.55rem;
        text-decoration: none;
        white-space: nowrap;
        transition: background 220ms ease, border-color 220ms ease,
          transform 220ms ease, color 220ms ease, box-shadow 220ms ease;
      }

      .timeline-v2.is-spotlight .timeline-v2-cta .button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.28);
      }

      @media (max-width: 980px) {
        .timeline-v2.is-spotlight .timeline-v2-card {
          grid-template-columns: 1fr;
          gap: 0;
        }

        .timeline-v2.is-spotlight .timeline-v2-col {
          display: grid;
          grid-template-columns: 3.4rem 1fr;
          grid-template-rows: auto auto auto;
          column-gap: 1.2rem;
          align-items: center;
          text-align: left;
          padding: 1.6rem 1.4rem;
          border-right: none;
          border-bottom: 1px solid var(--line);
        }

        .timeline-v2.is-spotlight .timeline-v2-col:last-child {
          border-bottom: none;
        }

        .timeline-v2.is-spotlight .timeline-v2-step-icon {
          grid-column: 1;
          grid-row: 1 / 4;
          margin: 0;
          align-self: center;
        }

        .timeline-v2.is-spotlight .timeline-v2-step-num {
          grid-column: 2;
          grid-row: 1;
          margin-bottom: 0.3rem;
        }

        .timeline-v2.is-spotlight .timeline-v2-col h3 {
          grid-column: 2;
          grid-row: 2;
        }

        .timeline-v2.is-spotlight .timeline-v2-col p {
          grid-column: 2;
          grid-row: 3;
          margin: 0.5rem 0 0;
          max-width: none;
        }
      }

      @media (max-width: 680px) {
        .timeline-v2.is-spotlight {
          padding: 4rem 0 3.5rem;
        }

        .timeline-v2.is-spotlight h2 {
          white-space: normal;
        }
      }

      /* ── CTA Banner (Dark spotlight) ── */
      .opps-cta-banner {
        position: relative;
        padding: 5rem 0 4.5rem;
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          radial-gradient(ellipse at 88% 100%, rgba(130, 147, 174, 0.16), transparent 60%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        overflow: hidden;
      }

      .opps-cta-banner::before,
      .opps-cta-banner::after {
        content: "";
        position: absolute;
        width: 620px;
        height: 620px;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.55;
      }

      .opps-cta-banner::before {
        top: -180px;
        right: -160px;
        background: radial-gradient(circle, rgba(83, 178, 127, 0.18), transparent 70%);
      }

      .opps-cta-banner::after {
        bottom: -220px;
        left: -160px;
        background: radial-gradient(circle, rgba(130, 147, 174, 0.18), transparent 70%);
      }

      .opps-cta-banner .container {
        position: relative;
        z-index: 1;
      }

      .opps-cta-header {
        margin-bottom: 1.4rem;
      }

      .opps-cta-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0;
        color: #6ec595;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.28em;
        text-transform: uppercase;
      }

      .opps-cta-eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        display: inline-block;
        background: linear-gradient(90deg, transparent, var(--green));
      }

      .opps-cta-card {
        border: 1px solid rgba(255, 255, 255, 0.09);
        background: rgba(255, 255, 255, 0.03);
        border-radius: 14px;
        padding: 2rem;
      }

      .opps-cta-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 2rem;
        align-items: center;
      }

      .opps-cta-headline-row {
        display: flex;
        align-items: center;
        gap: 0.95rem;
        margin-top: 0.7rem;
      }

      .opps-cta-icon {
        width: 3rem;
        height: 3rem;
        flex-shrink: 0;
        border-radius: 0.8rem;
        background: rgba(83, 178, 127, 0.16);
        border: 1px solid rgba(83, 178, 127, 0.4);
        color: #7bd6a2;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .opps-cta-icon svg {
        width: 1.35rem;
        height: 1.35rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .opps-cta-grid h2 {
        margin: 0;
        color: #f3f7fc;
        font-size: clamp(1.4rem, 3vw, 1.7rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.15;
      }

      .opps-cta-text {
        margin: 0.9rem 0 0;
        font-size: 1rem;
        color: rgba(220, 230, 245, 0.72);
        line-height: 1.6;
        max-width: 36rem;
      }

      .opps-cta-panel {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0.9rem;
        padding: 1.4rem 1.5rem;
      }

      .opps-cta-panel-title {
        margin: 0 0 0.9rem;
        color: #7bd6a2;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .opps-cta-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }

      .opps-cta-list li {
        display: flex;
        gap: 0.6rem;
        align-items: flex-start;
        color: #e7eef7;
        font-size: 0.95rem;
        line-height: 1.4;
      }

      .opps-cta-list svg {
        width: 1.1rem;
        height: 1.1rem;
        flex-shrink: 0;
        margin-top: 0.05rem;
        stroke: #7bd6a2;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .opps-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        margin-top: 1.4rem;
        padding: 0.9rem 1.5rem;
        background: var(--green);
        border: 1px solid var(--green);
        color: #ffffff;
        border-radius: 0.55rem;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        transition: background 220ms ease, border-color 220ms ease,
          transform 220ms ease, color 220ms ease, box-shadow 220ms ease;
      }

      .opps-cta-btn:hover {
        background: #5fc189;
        border-color: #5fc189;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.32);
      }

      .opps-cta-btn svg {
        width: 0.85rem;
        height: 0.85rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Animations ── */
      [data-animate] {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 600ms ease, transform 600ms ease;
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      @media (max-width: 860px) {
        .opps-grid { grid-template-columns: 1fr 1fr; }
        .opps-stats-inner { grid-template-columns: 1fr; }
        .opps-stat {
          border-right: none;
          border-bottom: 1px solid var(--line);
        }
        .opps-stat:last-child {
          border-bottom: none;
        }
        .opps-cta-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 560px) {
        .opps-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader
      menuToggleId="mobile-menu-toggle"
      offsetFirstSection={false}
      locale={locale}
      currentPath={Astro.url.pathname}
    />

    <!-- Hero -->
    <section class="opps-hero">
      <div class="container">
        <div class="opps-hero-inner" data-animate>
          <p class="eyebrow">{t.heroEyebrow}</p>
          <h1>{t.heroTitle}</h1>
          <p>
            {t.heroIntroBefore}<a href={`${buildLocalizedPath("/contact", locale)}#video-call`} class="opps-hero-link">{t.heroIntroLink}</a>{t.heroIntroAfter}
          </p>
        </div>
      </div>
    </section>

    <!-- Stats strip -->
    <div class="opps-stats">
      <div class="container">
        <div class="opps-stats-inner" data-animate>
          <div class="opps-stat">
            <span class="opps-stat-value">{opportunities.length}</span>
            <span class="opps-stat-label">{t.statsOppsLabel}</span>
          </div>
          <div class="opps-stat">
            <span class="opps-stat-value">€500k</span>
            <span class="opps-stat-label">{t.statsMinLabel}</span>
          </div>
          <div class="opps-stat">
            <span class="opps-stat-value">{t.statsHoldValue}</span>
            <span class="opps-stat-label">{t.statsHoldLabel}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Opportunity summary grid -->
    <section class="opps-grid-section">
      <div class="container">
        <div class="opps-grid" data-animate>
          {opportunities.map((opp) => (
            <article class="opp-card">
              <div class="opp-card-image">
                <img src={opp.image} alt={opp.name} loading="lazy" />
                <div class="opp-card-chips">
                  <span
                    class="opp-card-chip"
                    style={`background: ${opportunityStatusColour[opp.status]}`}
                  >
                    {t.statusShort[opp.status]}
                  </span>
                  <span
                    class="opp-card-chip"
                    style={`background: ${riskProfileColour[opp.riskProfile]}`}
                  >
                    {opp.riskProfile}
                  </span>
                </div>
              </div>
              <div class="opp-card-body">
                <p class="opp-card-location">{opp.parish} · Andorra</p>
                <h3 class="opp-card-name">{opp.name}</h3>

                <div class="opp-card-metrics">
                  <div class="opp-card-metric">
                    <span class="opp-card-metric-label">{t.cardRequiredInvestment}</span>
                    <span class="opp-card-metric-value is-green">{opp.equityRaise}</span>
                  </div>
                  <div class="opp-card-metric">
                    <span class="opp-card-metric-label">{t.cardHeadlineReturn}</span>
                    <span class="opp-card-metric-value">{t.cardSharedOnRequest}</span>
                  </div>
                  <div class="opp-card-metric">
                    <span class="opp-card-metric-label">{t.cardBuildableArea}</span>
                    <span class="opp-card-metric-value">{opp.sqm}</span>
                  </div>
                  <div class="opp-card-metric">
                    <span class="opp-card-metric-label">{t.cardHoldPeriod}</span>
                    <span class="opp-card-metric-value">{opp.holdPeriod}</span>
                  </div>
                </div>

                {/* Funding completion bar — hidden for now (illustrative page).
                    Keep this block to easily restore it in the future.
                <div class="opp-card-progress">
                  <div class="opp-card-progress-top">
                    <span><strong>{opp.fundingProgress}%</strong> funding complete</span>
                    <span>{opp.amountCommitted}</span>
                  </div>
                  <div class="opp-card-progress-bar">
                    <div
                      class="opp-card-progress-fill"
                      style={`width: ${opp.fundingProgress}%`}
                    ></div>
                  </div>
                  <p class="opp-card-progress-note">Illustrative figures only</p>
                </div>
                */}

                <div class="opp-card-ctas">
                  <a class="opp-card-cta" href={buildLocalizedPath(`/opportunities/${opp.slug}`, locale)}>
                    {t.cardView}
                    <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </a>
                  <a class="opp-card-cta is-secondary" href={`${buildLocalizedPath("/contact", locale)}#video-call`}>
                    {t.cardRequestCall}
                  </a>
                </div>
              </div>
            </article>
          ))}

          <!-- 6th card — Investment structures callout (Variation B) -->
          <article class="opp-card-info">
            <div class="opp-card-info-inner">
              <p class="info-eyebrow">{t.infoEyebrow}</p>
              <h3 class="info-question">{t.infoQuestion}</h3>
              <p class="info-body">{t.infoBody}</p>

              <a class="info-option" href={`${buildLocalizedPath("/invest", locale)}#structures`}>
                <span class="info-option-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </span>
                <div>
                  <p class="info-option-name">{t.infoDebtName}</p>
                  <p class="info-option-hint">{t.infoDebtHint}</p>
                </div>
              </a>

              <a class="info-option" href={`${buildLocalizedPath("/invest", locale)}#structures`}>
                <span class="info-option-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M3 17 9 11l4 4 8-8"/><path d="M14 7h7v7"/></svg>
                </span>
                <div>
                  <p class="info-option-name">{t.infoDebtEquityName}</p>
                  <p class="info-option-hint">{t.infoDebtEquityHint}</p>
                </div>
              </a>

              <a class="info-option" href={`${buildLocalizedPath("/invest", locale)}#structures`}>
                <span class="info-option-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><line x1="6" y1="20" x2="6" y2="16"/><line x1="12" y1="20" x2="12" y2="11"/><line x1="18" y1="20" x2="18" y2="6"/></svg>
                </span>
                <div>
                  <p class="info-option-name">{t.infoEquityName}</p>
                  <p class="info-option-hint">{t.infoEquityHint}</p>
                </div>
              </a>

              <a href={buildLocalizedPath("/invest", locale)} class="info-cta">
                {t.infoCta}
                <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>

            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Investment timeline -->
    <section class="timeline-v2 is-spotlight">
      <div class="container" data-animate>
        <div class="section-header">
          <p class="eyebrow">{t.timelineEyebrow}</p>
          <h2>{t.timelineTitle}</h2>
          <p class="intro">{t.timelineIntro}</p>
        </div>
        <div class="timeline-v2-card">
          <div class="timeline-v2-col">
            <span class="timeline-v2-step-num">{t.stepPrefix} 01</span>
            <div class="timeline-v2-step-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 6.5h9a2.5 2.5 0 0 1 2.5 2.5v4A2.5 2.5 0 0 1 13 15.5H9l-3.5 2v-2H4A2.5 2.5 0 0 1 1.5 13V9A2.5 2.5 0 0 1 4 6.5Z"/><path d="M15 9h5a2.5 2.5 0 0 1 2.5 2.5v3A2.5 2.5 0 0 1 20 17h-1.5v2L15 17h-1"/></svg>
            </div>
            <h3>{t.steps[0].title}</h3>
            <p>{t.steps[0].body}</p>
          </div>
          <div class="timeline-v2-col">
            <span class="timeline-v2-step-num">{t.stepPrefix} 02</span>
            <div class="timeline-v2-step-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="13" height="13" rx="2.5"/><path d="m16 10 5-3v10l-5-3"/><circle cx="9.5" cy="10.5" r="2.25"/><path d="M6.5 15.5a3.25 3.25 0 0 1 6 0"/></svg>
            </div>
            <h3>{t.steps[1].title}</h3>
            <p>{t.steps[1].body}</p>
          </div>
          <div class="timeline-v2-col">
            <span class="timeline-v2-step-num">{t.stepPrefix} 03</span>
            <div class="timeline-v2-step-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M4 12h16"/></svg>
            </div>
            <h3>{t.steps[2].title}</h3>
            <p>{t.steps[2].body}</p>
          </div>
          <div class="timeline-v2-col">
            <span class="timeline-v2-step-num">{t.stepPrefix} 04</span>
            <div class="timeline-v2-step-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h3>{t.steps[3].title}</h3>
            <p>{t.steps[3].body}</p>
          </div>
          <div class="timeline-v2-col">
            <span class="timeline-v2-step-num">{t.stepPrefix} 05</span>
            <div class="timeline-v2-step-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 16.5 10 10.5l3.5 3.5L20 7.5"/><path d="M14 7.5h6v6"/><path d="M5 19.5h14"/></svg>
            </div>
            <h3>{t.steps[4].title}</h3>
            <p>{t.steps[4].body}</p>
          </div>
        </div>
        <div class="timeline-v2-cta">
          <a class="button" href={`${buildLocalizedPath("/contact", locale)}#tab-investor`}>{t.timelineCta}</a>
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="opps-cta-banner">
      <div class="container">
        <div class="opps-cta-header" data-animate>
          <p class="opps-cta-eyebrow">{t.bannerEyebrow}</p>
        </div>

        <div class="opps-cta-card" data-animate>
          <div class="opps-cta-grid">
            <div class="opps-cta-main">
              <div class="opps-cta-headline-row">
                <span class="opps-cta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                </span>
                <h2>{t.bannerTitle}</h2>
              </div>
              <p class="opps-cta-text">
                {t.bannerText}
              </p>
              <a class="opps-cta-btn" href={`${buildLocalizedPath("/contact", locale)}#video-call`}>
                {t.bannerCta}
                <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
            <div class="opps-cta-panel">
              <p class="opps-cta-panel-title">{t.bannerPanelTitle}</p>
              <ul class="opps-cta-list">
                {t.bannerList.map((item) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId="newsletter-email-opportunities" locale={locale} />
    <SiteFooter locale={locale} />

    <script type="module">
      const targets = document.querySelectorAll("[data-animate]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
