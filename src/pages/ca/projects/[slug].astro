---
import InnerSiteHeader from "../../../components/InnerSiteHeader.astro";
import NewsletterSignup from "../../../components/NewsletterSignup.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SEO from "../../../components/SEO.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../../../lib/i18n";
import type { Locale } from "../../../lib/i18n";
import { projects } from "../../../data/projectsCa";
import { statusColour } from "../../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const locale = getLocaleFromUrl(Astro.url) ?? "ca";

const copyByLocale = {
  en: {
    breadcrumbHome: "Home",
    breadcrumbProjects: "Projects",
    metricProjectValue: "Project value",
    metricUnits: "Number of units",
    metricTotalArea: "Total area",
    metricCompletion: "Est. completion",
    imageWord: "image",
    aboutLabel: "About this project",
    aboutTitle: "Project Overview",
    whyLabel: "Why invest",
    whyTitle: "The Investment Case",
    featuresLabel: "Key features",
    featuresTitle: "Project Highlights",
    timelineLabel: "Timeline",
    timelineTitle: "Development Milestones",
    partnersLabel: "Delivery team",
    partnersTitle: "Project Partners",
    partnersText:
      "The companies we have partnered with to design, build and deliver this development.",
    partnerAria: (name: string) => `View ${name} on the partners page`,
    backLink: "Back to all projects",
    detailsTitle: "Property Details",
    detailLocation: "Location",
    detailSector: "Sector",
    detailUnits: "Units",
    detailBuildableArea: "Buildable area",
    detailParkingArea: "Parking area",
    detailCompletion: "Est. completion",
    detailStatus: "Project status",
    ctaTitle: "Interested in buying this property?",
    ctaText:
      "Speak with our team to learn more about availability, pricing and the purchase process for this development.",
    ctaBtn: "Contact our Team",
    statusLabels: {
      "Under Construction": "Under Construction",
      "Under development": "Under development",
      "Pipeline": "Pipeline",
      "Financing Open": "Financing Open",
      "Completed": "Completed",
    } as Record<string, string>,
  },
  es: {
    breadcrumbHome: "Inicio",
    breadcrumbProjects: "Proyectos",
    metricProjectValue: "Valor del proyecto",
    metricUnits: "Número de unidades",
    metricTotalArea: "Superficie total",
    metricCompletion: "Finalización prevista",
    imageWord: "imagen",
    aboutLabel: "Sobre este proyecto",
    aboutTitle: "Descripción del proyecto",
    whyLabel: "Por qué invertir",
    whyTitle: "La tesis de inversión",
    featuresLabel: "Características clave",
    featuresTitle: "Puntos destacados del proyecto",
    timelineLabel: "Calendario",
    timelineTitle: "Hitos del desarrollo",
    partnersLabel: "Equipo de ejecución",
    partnersTitle: "Socios del proyecto",
    partnersText:
      "Las empresas con las que colaboramos para diseñar, construir y entregar este desarrollo.",
    partnerAria: (name: string) => `Ver ${name} en la página de socios`,
    backLink: "Volver a todos los proyectos",
    detailsTitle: "Detalles de la propiedad",
    detailLocation: "Ubicación",
    detailSector: "Sector",
    detailUnits: "Unidades",
    detailBuildableArea: "Superficie edificable",
    detailParkingArea: "Superficie de aparcamiento",
    detailCompletion: "Finalización prevista",
    detailStatus: "Estado del proyecto",
    ctaTitle: "¿Le interesa comprar esta propiedad?",
    ctaText:
      "Hable con nuestro equipo para conocer la disponibilidad, los precios y el proceso de compra de este desarrollo.",
    ctaBtn: "Contactar con el equipo",
    statusLabels: {
      "Under Construction": "En construcción",
      "Under development": "En desarrollo",
      "Pipeline": "En cartera",
      "Financing Open": "Financiación abierta",
      "Completed": "Completado",
    } as Record<string, string>,
  },
  ca: {
    breadcrumbHome: "Inici",
    breadcrumbProjects: "Projectes",
    metricProjectValue: "Valor del projecte",
    metricUnits: "Nombre d'unitats",
    metricTotalArea: "Superfície total",
    metricCompletion: "Finalització prevista",
    imageWord: "imatge",
    aboutLabel: "Sobre aquest projecte",
    aboutTitle: "Descripció del projecte",
    whyLabel: "Per què invertir",
    whyTitle: "La tesi d'inversió",
    featuresLabel: "Característiques clau",
    featuresTitle: "Punts destacats del projecte",
    timelineLabel: "Calendari",
    timelineTitle: "Fites del desenvolupament",
    partnersLabel: "Equip d'execució",
    partnersTitle: "Socis del projecte",
    partnersText:
      "Les empreses amb què col·laborem per dissenyar, construir i lliurar aquest desenvolupament.",
    partnerAria: (name: string) => `Veure ${name} a la pàgina de socis`,
    backLink: "Tornar a tots els projectes",
    detailsTitle: "Detalls de la propietat",
    detailLocation: "Ubicació",
    detailSector: "Sector",
    detailUnits: "Unitats",
    detailBuildableArea: "Superfície edificable",
    detailParkingArea: "Superfície d'aparcament",
    detailCompletion: "Finalització prevista",
    detailStatus: "Estat del projecte",
    ctaTitle: "Li interessa comprar aquesta propietat?",
    ctaText:
      "Parli amb el nostre equip per conèixer la disponibilitat, els preus i el procés de compra d'aquest desenvolupament.",
    ctaBtn: "Contacta amb l'equip",
    statusLabels: {
      "Under Construction": "En construcció",
      "Under development": "En desenvolupament",
      "Pipeline": "En cartera",
      "Financing Open": "Finançament obert",
      "Completed": "Completat",
    } as Record<string, string>,
  },
} satisfies Record<Locale, unknown>;

const copy = copyByLocale[locale];

const partnerSlug = (name: string): string =>
  name
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={`${project.name} | Equity Partners`}
      description={project.tagline}
      locale={locale}
      path={Astro.url.pathname}
      breadcrumb={[
        { name: copy.breadcrumbHome, path: "/" },
        { name: copy.breadcrumbProjects, path: "/projects" },
        { name: project.name, path: `/projects/${project.slug}` },
      ]}
    />
    <link rel="icon" type="image/png" href="/EP favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --navy: #0f1a2a;
        --green: #53b27f;
        --green-dark: #3f9568;
        --line: #dce3ee;
        --text: #172235;
        --muted: #5a667a;
        --font: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: #ffffff;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
      }

      /* ── Hero ── */
      .project-hero {
        position: relative;
        background: var(--navy);
        padding: 0;
        overflow: hidden;
        min-height: 520px;
        display: flex;
        flex-direction: column;
      }

      .project-hero-image {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .project-hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .project-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(15, 26, 42, 0.55) 0%,
          rgba(15, 26, 42, 0.72) 60%,
          rgba(15, 26, 42, 0.92) 100%
        );
        z-index: 1;
      }

      .project-hero-content {
        position: relative;
        z-index: 2;
        margin-top: auto;
        padding: 9rem 0 3.5rem;
      }

      .project-hero-meta {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .project-hero-eyebrow {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--green);
      }

      .project-hero-status {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: #ffffff;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        line-height: 1;
      }

      .project-hero h1 {
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 0.8rem;
        line-height: 1.08;
        letter-spacing: -0.01em;
        max-width: 720px;
      }

      .project-hero-tagline {
        font-size: 1rem;
        color: rgba(214, 224, 240, 0.8);
        margin: 0;
        max-width: 600px;
        line-height: 1.65;
      }

      /* ── Key Metrics Strip ── */
      .project-metrics-strip {
        background: #f2f5fa;
        border-bottom: 1px solid var(--line);
        padding: 1.6rem 0;
      }

      .project-metrics-inner {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
      }

      .project-metric-item {
        flex: 1;
        min-width: 130px;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0.4rem 1.6rem;
      }

      .project-metric-item:first-child {
        padding-left: 0;
      }

      .project-metric-item:last-child {
        padding-right: 0;
      }

      .project-metric-value {
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--navy);
        line-height: 1;
      }

      .project-metric-value.is-green {
        color: var(--green);
      }

      .project-metric-label {
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ── Breadcrumb ── */
      .project-breadcrumb {
        padding: 1.2rem 0;
        border-bottom: 1px solid var(--line);
      }

      .project-breadcrumb-inner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        color: var(--muted);
      }

      .project-breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 180ms ease;
      }

      .project-breadcrumb a:hover {
        color: var(--green);
      }

      .project-breadcrumb-sep {
        color: var(--line);
      }

      .project-breadcrumb-current {
        color: var(--text);
        font-weight: 600;
      }

      /* ── Main layout ── */
      .project-body {
        padding: 4rem 0 6rem;
      }

      .project-body-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 3rem;
        align-items: start;
      }

      /* ── Left column ── */
      .project-section {
        margin-bottom: 3rem;
      }

      .project-section:last-child {
        margin-bottom: 0;
      }

      .project-section-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--green);
        margin: 0 0 0.8rem;
      }

      .project-section h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 1rem;
        line-height: 1.25;
      }

      .project-section p {
        font-size: 0.93rem;
        color: var(--muted);
        line-height: 1.75;
        margin: 0 0 1rem;
      }

      .project-section p:last-child {
        margin-bottom: 0;
      }

      /* ── Highlights ── */
      .project-highlights {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .project-highlights li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.88rem;
        color: var(--text);
        line-height: 1.5;
      }

      .project-highlights li::before {
        content: "";
        display: block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--green);
        flex-shrink: 0;
        margin-top: 0.45em;
      }

      /* ── Milestones ── */
      .project-milestones {
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
      }

      .project-milestone {
        display: flex;
        gap: 1.2rem;
        align-items: flex-start;
        padding-bottom: 1.6rem;
        position: relative;
      }

      .project-milestone:last-child {
        padding-bottom: 0;
      }

      .project-milestone-track {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        width: 20px;
      }

      .project-milestone-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--line);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        z-index: 1;
        transition: border-color 200ms, background 200ms;
      }

      .project-milestone-dot.is-done {
        background: var(--green);
        border-color: var(--green);
      }

      .project-milestone-dot.is-done svg {
        display: block;
      }

      .project-milestone-dot svg {
        display: none;
        width: 10px;
        height: 10px;
        stroke: #fff;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .project-milestone-line {
        flex: 1;
        width: 2px;
        background: var(--line);
        margin-top: 2px;
      }

      .project-milestone:last-child .project-milestone-line {
        display: none;
      }

      .project-milestone-content {
        padding-top: 0.1rem;
        flex: 1;
      }

      .project-milestone-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--navy);
        margin: 0 0 0.15rem;
      }

      .project-milestone-label.is-done {
        color: var(--muted);
        text-decoration: line-through;
        text-decoration-color: rgba(90, 102, 122, 0.4);
      }

      .project-milestone-date {
        font-size: 0.72rem;
        color: var(--muted);
        font-weight: 500;
      }

      /* ── Project Partners ── */
      .project-partners {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-top: 0.5rem;
      }

      .project-partner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        padding: 1.4rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.85rem;
        background: #ffffff;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
      }

      .project-partner:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 32px rgba(15, 26, 42, 0.08);
        border-color: #c8d3e3;
      }

      .project-partner-logo {
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
      }

      .project-partner-logo img {
        max-height: 56px;
        max-width: 100%;
        width: auto;
        object-fit: contain;
        display: block;
      }

      .project-partner-name {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--navy);
        margin: 0;
        text-align: center;
        line-height: 1.3;
      }

      @media (max-width: 720px) {
        .project-partners {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      /* ── Gallery ── */
      .project-gallery {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
      }

      .project-gallery img {
        width: 100%;
        aspect-ratio: 4/3;
        object-fit: cover;
        border-radius: 0.7rem;
        display: block;
      }

      .project-gallery img:first-child {
        grid-column: 1 / -1;
        aspect-ratio: 16/7;
      }

      /* ── Right sidebar ── */
      .project-sidebar {
        position: sticky;
        top: 8rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .project-sidebar-card {
        border: 1px solid var(--line);
        border-radius: 1rem;
        overflow: hidden;
        background: #fff;
      }

      .project-sidebar-card-header {
        padding: 1.2rem 1.4rem;
        border-bottom: 1px solid var(--line);
        background: #f8fafd;
      }

      .project-sidebar-card-header h3 {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--navy);
        margin: 0;
      }

      .project-sidebar-card-body {
        padding: 1.2rem 1.4rem;
      }

      .project-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f0f4fa;
        font-size: 0.8rem;
      }

      .project-detail-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .project-detail-row:first-child {
        padding-top: 0;
      }

      .project-detail-key {
        color: var(--muted);
        font-weight: 500;
        white-space: nowrap;
      }

      .project-detail-val {
        color: var(--navy);
        font-weight: 700;
        text-align: right;
      }

      .project-detail-val.is-green {
        color: var(--green);
      }

      /* ── CTA card ── */
      .project-cta-card {
        background: var(--navy);
        border-radius: 1rem;
        padding: 1.8rem 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .project-cta-card h3 {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        line-height: 1.3;
      }

      .project-cta-card p {
        font-size: 0.8rem;
        color: rgba(214, 224, 240, 0.7);
        margin: 0;
        line-height: 1.6;
      }

      .project-cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1.4rem;
        background: var(--green);
        border: 1px solid var(--green);
        color: #fff;
        border-radius: 0.55rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
      }

      .project-cta-btn:hover {
        background: var(--green-dark);
        border-color: var(--green-dark);
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(15, 60, 35, 0.28);
      }

      .project-cta-btn svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Regulatory note ── */
      .project-reg-note {
        background: #f8fafd;
        border: 1px solid var(--line);
        border-radius: 0.8rem;
        padding: 1rem 1.2rem;
        font-size: 0.75rem;
        color: var(--muted);
        line-height: 1.6;
      }

      /* ── Back link ── */
      .project-back-section {
        padding: 3rem 0 0;
        border-top: 1px solid var(--line);
        margin-top: 3rem;
      }

      .project-back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green);
        text-decoration: none;
        transition: gap 180ms ease;
      }

      .project-back-link:hover {
        gap: 0.75rem;
      }

      .project-back-link svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Animations ── */
      [data-animate] {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 580ms ease, transform 580ms ease;
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* ── Responsive ── */
      @media (max-width: 900px) {
        .project-body-grid {
          grid-template-columns: 1fr;
        }

        .project-sidebar {
          position: static;
        }

        .project-metrics-inner {
          gap: 1rem;
        }

        .project-metric-item {
          padding: 0.6rem 0;
          min-width: calc(50% - 0.5rem);
          flex: none;
          width: calc(50% - 0.5rem);
        }

        .project-metric-item:first-child,
        .project-metric-item:last-child {
          padding-left: 0;
          padding-right: 0;
        }
      }

      /* ────────────────────────────────────────────────────────────
         Variation 1 redesign — matches the stats card on the
         opportunities listing page and opportunity detail pages.
         ──────────────────────────────────────────────────────────── */
      .project-metrics-strip.is-redesign {
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        padding: 2.2rem 0;
        border-bottom: none;
      }

      .project-metrics-strip.is-redesign .project-metrics-inner {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
      }

      .project-metrics-strip.is-redesign .project-metric-item {
        flex: none;
        min-width: 0;
        width: auto;
        padding: 1.4rem 1.6rem;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.35rem;
        border-right: 1px solid var(--line);
        border-bottom: none;
        transition: background 320ms ease;
      }

      .project-metrics-strip.is-redesign .project-metric-item:first-child {
        padding-left: 1.6rem;
      }

      .project-metrics-strip.is-redesign .project-metric-item:last-child {
        border-right: none;
        padding-left: 1.6rem;
        padding-right: 1.6rem;
      }

      .project-metrics-strip.is-redesign .project-metric-item:hover {
        background: rgba(83, 178, 127, 0.05);
      }

      .project-metrics-strip.is-redesign .project-metric-value {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1;
      }

      .project-metrics-strip.is-redesign .project-metric-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.18em;
      }

      @media (max-width: 820px) {
        .project-metrics-strip.is-redesign .project-metrics-inner {
          grid-template-columns: 1fr 1fr;
        }
        .project-metrics-strip.is-redesign .project-metric-item {
          border-bottom: 1px solid var(--line);
        }
        .project-metrics-strip.is-redesign .project-metric-item:nth-child(2n) {
          border-right: none;
        }
        .project-metrics-strip.is-redesign .project-metric-item:nth-last-child(-n+2) {
          border-bottom: none;
        }
      }

      @media (max-width: 560px) {
        .project-metrics-strip.is-redesign .project-metrics-inner {
          grid-template-columns: 1fr;
        }
        .project-metrics-strip.is-redesign .project-metric-item {
          border-right: none !important;
          border-bottom: 1px solid var(--line);
          width: 100%;
        }
        .project-metrics-strip.is-redesign .project-metric-item:last-child {
          border-bottom: none;
        }
      }

      /* Darker section-separator borders (currently scoped to ordino-heights for review) */
      .project-metrics-strip.has-dark-borders {
        border-bottom: 1px solid rgba(15, 26, 42, 0.2);
      }

      .project-breadcrumb.has-dark-borders {
        border-bottom-color: rgba(15, 26, 42, 0.2);
      }

      @media (max-width: 560px) {
        .project-gallery {
          grid-template-columns: 1fr;
        }

        .project-gallery img:first-child {
          aspect-ratio: 4/3;
        }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader menuToggleId="mobile-menu-toggle" offsetFirstSection={false} locale={locale} currentPath={Astro.url.pathname} />

    <!-- Hero -->
    <section class="project-hero">
      <div class="project-hero-image">
        <img src={project.image} alt={project.name} />
      </div>
      <div class="project-hero-overlay"></div>
      <div class="project-hero-content">
        <div class="container">
          <div class="project-hero-meta">
            <span class="project-hero-eyebrow">{project.parish} · Andorra</span>
            <span
              class="project-hero-status"
              style={`background: ${statusColour[project.status]}`}
            >
              {copy.statusLabels[project.status]}
            </span>
          </div>
          <h1>{project.name}</h1>
          <p class="project-hero-tagline">{project.tagline}</p>
        </div>
      </div>
    </section>

    <!-- Key metrics strip -->
    <div class="project-metrics-strip is-redesign has-dark-borders">
      <div class="container">
        <div class="project-metrics-inner">
          <div class="project-metric-item">
            <span class="project-metric-value is-green">{project.value}</span>
            <span class="project-metric-label">{copy.metricProjectValue}</span>
          </div>
          <div class="project-metric-item">
            <span class="project-metric-value">{project.units}</span>
            <span class="project-metric-label">{copy.metricUnits}</span>
          </div>
          <div class="project-metric-item">
            <span class="project-metric-value">{project.sqm}</span>
            <span class="project-metric-label">{copy.metricTotalArea}</span>
          </div>
          <div class="project-metric-item">
            <span class="project-metric-value">{project.completionDate}</span>
            <span class="project-metric-label">{copy.metricCompletion}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Breadcrumb -->
    <div class="project-breadcrumb has-dark-borders">
      <div class="container">
        <div class="project-breadcrumb-inner">
          <a href={buildLocalizedPath("/", locale)}>{copy.breadcrumbHome}</a>
          <span class="project-breadcrumb-sep">/</span>
          <a href={buildLocalizedPath("/projects", locale)}>{copy.breadcrumbProjects}</a>
          <span class="project-breadcrumb-sep">/</span>
          <span class="project-breadcrumb-current">{project.name}</span>
        </div>
      </div>
    </div>

    <!-- Body -->
    <section class="project-body">
      <div class="container">
        <div class="project-body-grid">

          <!-- Left column -->
          <div class="project-main">

            <!-- Gallery -->
            <div class="project-section" data-animate>
              <div class="project-gallery">
                {project.gallery.map((src, i) => (
                  <img src={src} alt={`${project.name} — ${copy.imageWord} ${i + 1}`} loading={i === 0 ? "eager" : "lazy"} />
                ))}
              </div>
            </div>

            <!-- Description -->
            <div class="project-section" data-animate>
              <p class="project-section-label">{copy.aboutLabel}</p>
              <h2>{copy.aboutTitle}</h2>
              <p>{project.description}</p>
            </div>

            <!-- Investment Case -->
            <div class="project-section" data-animate>
              <p class="project-section-label">{copy.whyLabel}</p>
              <h2>{copy.whyTitle}</h2>
              <p>{project.investmentCase}</p>
            </div>

            <!-- Highlights -->
            <div class="project-section" data-animate>
              <p class="project-section-label">{copy.featuresLabel}</p>
              <h2>{copy.featuresTitle}</h2>
              <ul class="project-highlights">
                {project.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>

            <!-- Milestones -->
            <div class="project-section" data-animate>
              <p class="project-section-label">{copy.timelineLabel}</p>
              <h2>{copy.timelineTitle}</h2>
              <div class="project-milestones">
                {project.milestones.map((m) => (
                  <div class="project-milestone">
                    <div class="project-milestone-track">
                      <div class={`project-milestone-dot${m.done ? " is-done" : ""}`}>
                        <svg viewBox="0 0 12 12">
                          <polyline points="2,6 5,9 10,3"/>
                        </svg>
                      </div>
                      <div class="project-milestone-line"></div>
                    </div>
                    <div class="project-milestone-content">
                      <p class={`project-milestone-label${m.done ? " is-done" : ""}`}>{m.label}</p>
                      <span class="project-milestone-date">{m.date}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Project partners -->
            {project.partners && project.partners.length > 0 && (
              <div class="project-section" data-animate>
                <p class="project-section-label">{copy.partnersLabel}</p>
                <h2>{copy.partnersTitle}</h2>
                <p>{copy.partnersText}</p>
                <div class="project-partners">
                  {project.partners.map((partner) => (
                    <a
                      class="project-partner"
                      href={`${buildLocalizedPath("/partners", locale)}#${partnerSlug(partner.name)}`}
                      aria-label={copy.partnerAria(partner.name)}
                    >
                      <div class="project-partner-logo">
                        <img src={partner.logo} alt={partner.name} loading="lazy" />
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Regulatory note -->
            <div class="project-section" data-animate>
              <p class="project-reg-note">{project.regulatoryNote}</p>
            </div>

            <!-- Back link -->
            <div class="project-back-section" data-animate>
              <a class="project-back-link" href={buildLocalizedPath("/projects", locale)}>
                <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
                {copy.backLink}
              </a>
            </div>

          </div>

          <!-- Right sidebar -->
          <aside class="project-sidebar">

            <!-- Property details card -->
            <div class="project-sidebar-card" data-animate>
              <div class="project-sidebar-card-header">
                <h3>{copy.detailsTitle}</h3>
              </div>
              <div class="project-sidebar-card-body">
                <div class="project-detail-row">
                  <span class="project-detail-key">{copy.detailLocation}</span>
                  <span class="project-detail-val">{project.location}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">{copy.detailSector}</span>
                  <span class="project-detail-val">{project.sector}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">{copy.detailUnits}</span>
                  <span class="project-detail-val">{project.units}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">{copy.detailBuildableArea}</span>
                  <span class="project-detail-val">{project.sqm}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">{copy.detailParkingArea}</span>
                  <span class="project-detail-val">{project.parking}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">{copy.detailCompletion}</span>
                  <span class="project-detail-val">{project.completionDate}</span>
                </div>
                <div class="project-detail-row">
                  <span class="project-detail-key">{copy.detailStatus}</span>
                  <span class="project-detail-val" style="font-size:0.72rem">{project.planningStatus}</span>
                </div>
              </div>
            </div>

            <!-- CTA card -->
            <div class="project-cta-card" data-animate>
              <h3>{copy.ctaTitle}</h3>
              <p>{copy.ctaText}</p>
              <a class="project-cta-btn" href={buildLocalizedPath("/contact", locale)}>
                {copy.ctaBtn}
                <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>

          </aside>

        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId={`newsletter-email-${project.slug}`} locale={locale} />
    <SiteFooter locale={locale} />

    <script type="module">
      const targets = document.querySelectorAll("[data-animate]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.06 }
      );
      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
