  </style>

  <div class="tabrow">
  <div class="seg" data-seg="tabs">
    <span class="seg-thumb no-anim"></span>
    <a href={`/admin/projects/${slug}`} class:list={["seg-btn", { active: tab === "overview" }]}>Overview</a>
    <a href={`/admin/projects/${slug}?tab=units`} class:list={["seg-btn", { active: tab === "units" }]}>Units</a>
    <a href={inboxHref({ seg: "needs" })} class:list={["seg-btn", { active: tab === "inbox" }]}>
      Inbox {attention.length > 0 && <span class="count">{attention.length}</span>}
    </a>
    <span class="seg-btn off">Documents</span>
    <a href={`/admin/projects/${slug}?tab=settings`} class:list={["seg-btn", { active: tab === "settings" }]}>Settings</a>
  </div>

  {/* Not on Settings: that tab has its own Sync now, beside Disconnect, where
      the pair belongs. Two identical buttons on one screen is worse than one. */}
  {mailboxConnected && tab !== "settings" && (
    <form class="syncform" method="post" action="/api/admin/project-mail-sync">
