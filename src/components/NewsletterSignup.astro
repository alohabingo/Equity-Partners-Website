---
interface Props {
  emailInputId?: string;
}

const { emailInputId = "newsletter-email" } = Astro.props;
const hubspotPortalId = "147782273";
const hubspotFormId = "a116bad8-2680-4003-9b71-2361e9997673";
const newsletterFormId = `${emailInputId}-form`;
const newsletterMessageId = `${emailInputId}-message`;
---

<section class="newsletter" id="newsletter">
  <div class="container">
    <p class="eyebrow">Newsletter</p>
    <div class="newsletter-wrap">
      <div class="newsletter-copy">
        <h2>Stay informed on Andorra opportunities.</h2>
      </div>
      <div class="newsletter-form-group">
        <form
          class="newsletter-form"
          id={newsletterFormId}
          name="newsletter-signup"
          action={`https://api.hsforms.com/submissions/v3/integration/submit/${hubspotPortalId}/${hubspotFormId}`}
          method="post"
          novalidate
        >
          <label class="sr-only" for={emailInputId}>Email address</label>
          <input
            class="newsletter-input"
            id={emailInputId}
            name="email"
            type="email"
            placeholder="Enter your email"
            required
          />
          <button class="newsletter-button" type="submit">Subscribe</button>
        </form>
        <p class="newsletter-status" id={newsletterMessageId} aria-live="polite"></p>
      </div>
    </div>
    <p class="newsletter-note">We send selective updates only. No spam.</p>
  </div>
</section>

<script define:vars={{ newsletterFormId, newsletterMessageId, hubspotPortalId, hubspotFormId }}>
  const form = document.getElementById(newsletterFormId);
  const message = document.getElementById(newsletterMessageId);

  const getCookie = (name) => {
    const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : "";
  };

  if (form instanceof HTMLFormElement && message instanceof HTMLElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]');
      const emailInput = form.querySelector('input[name="email"]');

      if (!(emailInput instanceof HTMLInputElement) || !emailInput.value.trim()) {
        message.textContent = "Please enter a valid email address.";
        message.dataset.state = "error";
        return;
      }

      submitButton?.setAttribute("disabled", "true");
      message.textContent = "Submitting...";
      message.dataset.state = "pending";

      const payload = {
        submittedAt: Date.now(),
        fields: [
          {
            name: "email",
            value: emailInput.value.trim(),
          },
        ],
        context: {
          hutk: getCookie("hubspotutk"),
          pageUri: window.location.href,
          pageName: document.title,
        },
      };

      try {
        const response = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${hubspotPortalId}/${hubspotFormId}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          }
        );

        if (!response.ok) {
          throw new Error("HubSpot submission failed");
        }

        form.reset();
        message.textContent = "Thanks for subscribing.";
        message.dataset.state = "success";
      } catch (error) {
        message.textContent = "Something went wrong. Please try again.";
        message.dataset.state = "error";
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  }
</script>

<style>
  .newsletter,
  .newsletter *,
  .newsletter *::before,
  .newsletter *::after {
    box-sizing: border-box;
  }

  .newsletter {
    background: linear-gradient(180deg, #f4f6fa, #eef2f8);
    border-top: 1px solid #dbe1ea;
    border-bottom: 1px solid #dbe1ea;
    padding: 2.5rem 0;
  }

  .container {
    width: min(1120px, 92vw);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8293ae;
  }

  .newsletter-wrap {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.4rem;
    align-items: center;
    width: 100%;
    max-width: 100%;
    background: #ffffff;
    border: 1px solid #d7deea;
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .newsletter-copy h2 {
    margin: 0;
    color: #1f2835;
    font-size: clamp(1.55rem, 3vw, 2.45rem);
    line-height: 1.12;
  }

  .newsletter-copy p {
    margin: 0.7rem 0 0;
    color: #5a667a;
    max-width: 34rem;
  }

  .newsletter-form {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    justify-content: flex-end;
    width: 100%;
    min-width: 0;
  }

  .newsletter-form-group {
    width: 100%;
    min-width: 0;
  }

  .newsletter-input {
    flex: 0 1 360px;
    width: min(360px, 100%);
    max-width: 100%;
    min-width: 0;
    height: 44px;
    border-radius: 0.55rem;
    border: 1px solid #cfd9e7;
    background: #f9fbff;
    padding: 0 0.85rem;
    font-size: 0.92rem;
    color: #1a2433;
    outline: none;
    font-family: inherit;
  }

  .newsletter-input:focus {
    border-color: #9eb0ca;
    box-shadow: 0 0 0 2px rgba(130, 147, 174, 0.18);
  }

  .newsletter-button {
    flex: 0 0 auto;
    height: 44px;
    border: 1px solid #53b27f;
    background: #53b27f;
    color: #ffffff;
    border-radius: 0.55rem;
    padding: 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease, transform 180ms ease, border-color 180ms ease;
  }

  .newsletter-button:hover {
    background: #3f9568;
    border-color: #3f9568;
    transform: translateY(-1px);
  }

  .newsletter-button[disabled] {
    opacity: 0.72;
    cursor: wait;
    transform: none;
  }

  .newsletter-status {
    width: min(360px, 100%);
    margin: 0.35rem 0 0 auto;
    color: #7a889e;
    font-size: 0.78rem;
    min-height: 1.1rem;
    text-align: left;
  }

  .newsletter-status[data-state="success"] {
    color: #3f9568;
  }

  .newsletter-status[data-state="error"] {
    color: #b33a3a;
  }

  .newsletter-note {
    margin: 0.5rem 0 0;
    color: #7a889e;
    font-size: 0.72rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 980px) {
    .newsletter-wrap {
      grid-template-columns: 1fr;
    }

    .newsletter-status {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 680px) {
    .container {
      width: 100%;
      max-width: none;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .newsletter-form {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .newsletter-input {
      flex-basis: auto;
      width: 100%;
      font-size: 16px;
    }

    .newsletter-button {
      width: 100%;
    }
  }
</style>
