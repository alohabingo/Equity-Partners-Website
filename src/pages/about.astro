---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/SEO.astro";
import WhyEquitySection from "../components/WhyEquitySection.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../lib/i18n";
import { getContentTranslations } from "../i18n/content";
import { getPageTitle } from "../i18n/ui";
const aboutLogoStrip = [
  { name: "Andorra Resident", logo: "/images/partners/AR%20Logo%20EP.png" },
  { name: "Emindset Law", logo: "/images/partners/Emindset LAW LOGO.png" },
  { name: "DATA", logo: "/images/partners/DATA LOGO.png" },
  { name: "MoraBanc", logo: "/images/partners/mora bank.png" },
];
const teamMembers = [
  {
    name: "Bing Voorham",
    role: "",
    image: "/images/Team/Bing Sr EP.png",
    description: "",
  },
  {
    name: "Oriol Giro",
    role: "",
    image: "/images/Team/Oriol Giro EP.jpg",
    description: "",
  },
  {
    name: "Carlos Ayete",
    role: "",
    image: "/images/Team/Calors EP.jpg",
    description: "",
  },
  {
    name: "Bing Jr",
    role: "",
    image: "/images/Team/Bing Jr EP.png",
    description: "",
  },
  {
    name: "Tekke Voorham",
    role: "",
    image: "/images/Team/Tekke EP.png",
    description: "",
  },
  {
    name: "Laia Bertran",
    role: "",
    image: "/images/Team/Laia EP.jpg?v=20260330",
    description: "",
  },
  {
    name: "Future Team Member",
    role: "",
    image: "",
    description: "",
    placeholder: true,
  },
];
const locale = getLocaleFromUrl(Astro.url);
const content = getContentTranslations(locale).about;
const localizedTeamMembers = teamMembers.map((member, index) => ({
  ...member,
  role: content.team.members[index]?.role ?? member.role,
  description: content.team.members[index]?.description ?? member.description,
}));
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO
      title={getPageTitle(locale, "about")}
      description="Equity Partners is an Andorra-based real estate investment group bridging international capital into the Principality's high-barrier property market."
      locale={locale}
      path={Astro.url.pathname}
    />
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --navy: #0f1a2a;
        --navy-soft: #1f2f46;
        --slate: #5f7087;
        --slate-light: #8da0b9;
        --paper: #f4f6fa;
        --white: #ffffff;
        --line: #dbe3ee;
        --max-width: 1120px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--navy-soft);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--paper) 50%);
        line-height: 1.55;
      }

      h1, h2, h3, p { margin: 0; }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 1.8rem;
        padding-top: 2.15rem;
        padding-bottom: 0.15rem;
        padding-left: calc((100vw - min(var(--max-width), 92vw)) / 2);
        padding-right: calc((100vw - min(var(--max-width), 92vw)) / 2);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: none;
        width: 100%;
        z-index: 220;
        background: rgba(15, 26, 42, 0.92) !important;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        transition: padding-top 320ms ease, padding-bottom 320ms ease, background-color 320ms ease,
          backdrop-filter 320ms ease, -webkit-backdrop-filter 320ms ease, border-color 320ms ease,
          box-shadow 320ms ease;
      }

      body.is-scrolled .site-header {
        background: rgba(15, 26, 42, 0.6) !important;
        padding-top: 1.25rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom-color: rgba(220, 231, 246, 0.2);
        box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
      }

      body.is-scrolled .menu-cta {
        background: #53b27f;
        border-color: #53b27f;
      }

      body.is-scrolled .logo {
        top: -5px;
      }

      body.is-scrolled .main-nav {
        top: -4px;
      }

      @supports not ((backdrop-filter: blur(1px))) {
        body.is-scrolled .site-header {
          background: rgba(15, 26, 42, 0.84) !important;
        }
      }

      .logo {
        width: 180px;
        height: auto;
        position: relative;
        top: -12px;
        filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
          drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
        transition: top 320ms ease, margin-top 320ms ease;
      }

      .main-nav {
        display: flex;
        align-items: center;
        margin-left: auto;
        flex-wrap: nowrap;
        gap: 1.3rem;
        position: relative;
        top: -11px;
        z-index: 121;
        transition: top 320ms ease;
      }

      .menu-toggle-input { display: none; }

      .menu-toggle {
        display: none;
        width: 38px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 0.45rem;
        background: transparent;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }

      .menu-toggle-bars,
      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        width: 18px;
        height: 2px;
        background: #ffffff;
      }

      .menu-toggle-bars {
        display: block;
        position: relative;
        transition: background 220ms ease;
      }

      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        transition: transform 220ms ease, top 220ms ease;
      }

      .menu-toggle-bars::before { top: -6px; }
      .menu-toggle-bars::after { top: 6px; }

      .menu-list {
        list-style: none;
        display: flex;
        align-items: center;
        white-space: nowrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
      }

      .menu-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }

      .menu-link:hover,
      .menu-link.is-active { color: #d7e3f5; }

      .menu-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: 1px;
        flex: 0 0 auto;
        min-width: 126px;
        color: #ffffff;
        background: #53b27f;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid #53b27f;
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, top 320ms ease;
      }

      .menu-cta:hover {
        background: #3f9568;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
      }

      .menu-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.9);
        outline-offset: 2px;
      }

      .journey-hero {
        padding: clamp(7.25rem, 10.5vw, 8.75rem) 0 2.35rem;
      }

      .journey-hero-head {
        width: 100%;
        max-width: none;
        margin: 0 auto;
        text-align: center;
      }

      .journey-hero-title {
        color: var(--navy);
        font-size: clamp(2.1rem, 4.7vw, 4rem);
        line-height: 1.04;
        letter-spacing: -0.02em;
        max-width: none;
        margin: 0 auto;
      }

      .journey-hero-title::after {
        content: "";
        display: block;
        width: 72px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin: 1.2rem auto 0;
        border-radius: 2px;
      }

      .journey-hero-copy {
        margin: 1.1rem auto 0;
        color: var(--slate);
        font-size: 1rem;
        line-height: 1.65;
        width: 100%;
        max-width: none;
      }

      .journey-hero-grid {
        margin-top: 2.35rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .journey-hero-card {
        min-height: 24rem;
        border-radius: 1.25rem;
        overflow: hidden;
        border: 1px solid #dfe7f1;
        background: #f7f9fc;
        box-shadow: 0 18px 36px rgba(15, 26, 42, 0.08);
      }

      .journey-hero-portrait {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        display: block;
      }

      .journey-proof {
        background: #172235;
        padding: 4.2rem 0;
      }

      .journey-proof-shell {
        border: 0;
        border-radius: 0;
        background: transparent;
        padding: 0;
        box-shadow: none;
      }

      .journey-proof-logos {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1rem;
        align-items: center;
      }

      .journey-proof-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 2.4rem;
        opacity: 0.42;
      }

      .journey-proof-logo img {
        max-width: 7rem;
        max-height: 1.6rem;
        width: auto;
        height: auto;
        filter: grayscale(100%);
      }

      .journey-proof-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
        gap: 1.6rem;
        align-items: center;
      }

      .journey-proof-copy {
        align-self: start;
        padding: 0;
      }

      .journey-proof-label {
        margin: 0 0 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: #6ec595;
      }

      .journey-proof-label::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      .journey-proof-copy h2 {
        margin-top: 1rem;
        color: #f3f7fc;
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.012em;
        max-width: none;
      }

      .journey-proof-copy h2::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .journey-proof-copy p + h2 + p {
        margin-top: 0.95rem;
        width: 100%;
        max-width: none;
        color: #ffffff;
        font-size: 1.1rem;
        line-height: 1.6;
      }

      .journey-proof-metrics {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        padding: 0.35rem 0;
      }

      .journey-proof-metric {
        background: #22324a;
        border: 1px solid rgba(216, 227, 242, 0.1);
        border-radius: 1.1rem;
        padding: 1.4rem 1.2rem;
        min-height: 10.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .journey-proof-metric-label {
        color: #b7c7de;
        font-size: 0.73rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        line-height: 1.45;
        max-width: none;
        width: 100%;
      }

      .journey-proof-metric-value {
        color: #ffffff;
        font-size: clamp(2rem, 4vw, 2.7rem);
        line-height: 1;
        width: 100%;
      }

      .journey-proof-metric-value + .journey-proof-metric-label {
        margin-top: 0.9rem;
      }

      .why-equity {
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--paper) 50%);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .why-equity-body {
        margin-top: 3rem;
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 1.4rem;
        align-items: stretch;
      }

      .why-equity-media {
        min-height: 34rem;
        border-radius: 1.2rem;
        overflow: hidden;
        border: 1px solid var(--line);
        background: #dde6f2;
        box-shadow: 0 18px 40px rgba(15, 26, 42, 0.07);
      }

      .why-equity-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .why-equity-points {
        display: grid;
        gap: 1.1rem;
      }

      .why-equity-point {
        position: relative;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        padding: 1.7rem 1.7rem 1.6rem;
        display: grid;
        grid-template-columns: 3.75rem minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
        overflow: hidden;
        isolation: isolate;
        box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
        transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
          border-color 360ms ease, box-shadow 360ms ease;
      }

      .why-equity-point::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 90% 0%, rgba(83, 178, 127, 0.14), transparent 60%);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: -1;
        pointer-events: none;
      }

      .why-equity-point::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
        opacity: 0;
        transition: opacity 360ms ease;
      }

      .why-equity-point:hover {
        transform: translateY(-6px);
        border-color: rgba(83, 178, 127, 0.42);
        box-shadow: 0 26px 48px rgba(15, 26, 42, 0.12),
          0 0 0 1px rgba(83, 178, 127, 0.16) inset;
      }

      .why-equity-point:hover::before,
      .why-equity-point:hover::after {
        opacity: 1;
      }

      .why-equity-point-icon {
        width: 3.75rem;
        height: 3.75rem;
        border-radius: 1.1rem;
        background: #53b27f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .why-equity-point-icon img {
        width: 1.85rem;
        height: 1.85rem;
        object-fit: contain;
        display: block;
        filter: brightness(0) invert(1);
      }

      .why-equity-point-copy h3 {
        margin: 0;
        color: var(--navy);
        font-size: 1.15rem;
      }

      .why-equity-point-copy p {
        margin-top: 0.55rem;
        color: var(--slate);
        font-size: 0.96rem;
        line-height: 1.46;
      }

      .why-equity .section-header h2,
      .team-variant-circles .section-header h2 {
        margin-top: 1rem;
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.05;
      }

      .why-equity .section-header h2::after,
      .team-variant-circles .section-header h2::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .why-equity .section-header .eyebrow,
      .team-variant-circles .section-header .eyebrow {
        margin-bottom: 0;
      }

      .section {
        padding: 4.2rem 0;
      }

      .section-header {
        max-width: none;
        width: 100%;
      }

      .intro {
        margin-top: 0.9rem;
        width: 100%;
        max-width: none;
        color: var(--slate);
      }

      .philosophy {
        text-align: center;
        background: #ffffff;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: #3f9568;
      }

      .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      .philosophy h2 {
        margin-top: 0.6rem;
        color: var(--navy);
        font-size: clamp(1.7rem, 3vw, 2.55rem);
        line-height: 1.15;
      }

      .philosophy-copy {
        margin: 1rem auto 0;
        max-width: 64ch;
        color: var(--slate);
      }

      .philosophy-copy p + p {
        margin-top: 0.95rem;
      }

      .advantage {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .advantage-grid {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .advantage-card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.3rem;
      }

      .advantage-icon {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid #cfd8e8;
        color: #4f6079;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .advantage-card h3 {
        margin-top: 0.7rem;
        color: var(--navy);
        font-size: 1.15rem;
      }

      .advantage-card p {
        margin-top: 0.6rem;
        color: var(--slate);
      }

      .methodology {
        background: #ffffff;
      }

      .timeline {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.7rem;
        align-items: start;
      }

      .timeline-step {
        position: relative;
        padding-top: 1.35rem;
      }

      .timeline-step::before {
        content: "";
        position: absolute;
        top: 0.45rem;
        left: 0;
        right: 0;
        height: 1px;
        background: #d4ddea;
      }

      .timeline-step:first-child::before {
        left: 22px;
      }

      .timeline-step:last-child::before {
        right: 22px;
      }

      .timeline-dot {
        width: 12px;
        height: 12px;
        border-radius: 999px;
        background: var(--navy);
        margin-bottom: 0.75rem;
      }

      .timeline-step h3 {
        color: var(--navy);
        font-size: 1.05rem;
      }

      .timeline-step p {
        margin-top: 0.5rem;
        color: var(--slate);
        font-size: 0.92rem;
      }

      .about-cta {
        background: #0f1a2a;
        color: #eef4fb;
        text-align: center;
        border-top: 1px solid rgba(219, 227, 240, 0.12);
        border-bottom: 1px solid rgba(219, 227, 240, 0.12);
      }

      .team-role {
        margin-top: 0.4rem;
        color: #8293ae;
        font-size: 0.76rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .team-description {
        margin-top: 0.6rem;
        color: var(--slate);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .team-variant-circles {
        background: #ffffff;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .team-variant-circles-dark {
        background: #0f1a2a;
        border-top: 1px solid #24354d;
        border-bottom: 1px solid #24354d;
      }

      .team-variant-circles-dark .eyebrow {
        color: #9fb4d2;
      }

      .team-variant-circles-dark h2,
      .team-variant-circles-dark .team-circle-card h3 {
        color: #ffffff;
      }

      .team-variant-circles-dark .intro,
      .team-variant-circles-dark .team-role {
        color: #c7d3e5;
      }

      .team-variant-circles-dark .team-description {
        color: #ffffff;
      }

      .team-variant-circles-dark .team-circle-card img {
        border-color: rgba(255, 255, 255, 0.22);
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
      }

      .team-variant-circles .team-circle-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(215, 226, 241, 0.14);
        border-radius: 1rem;
        padding: 1.15rem 0.9rem 1.2rem;
        box-shadow: 0 16px 30px rgba(0, 0, 0, 0.16);
      }

      .team-variant-cards .team-circle-grid {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      .team-variant-circles-dark .team-circle-placeholder {
        border-color: rgba(255, 255, 255, 0.26);
        background: rgba(255, 255, 255, 0.03);
      }

      .team-circle-grid {
        margin-top: 1.9rem;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1rem;
      }

      .team-circle-card {
        text-align: center;
        padding: 1rem 0.6rem;
      }

      .team-circle-card img {
        width: 148px;
        height: 148px;
        border-radius: 999px;
        object-fit: cover;
        display: block;
        margin: 0 auto;
        border: 2px solid #2a3a50;
        box-shadow: 0 10px 24px rgba(15, 26, 42, 0.12);
        filter: grayscale(100%);
      }

      .team-circle-card .team-circle-placeholder {
        width: 148px;
        height: 148px;
        border-radius: 999px;
        margin: 0 auto;
        border: 2px dashed rgba(42, 58, 80, 0.5);
        background: rgba(42, 58, 80, 0.04);
      }

      .team-circle-card h3 {
        margin-top: 1rem;
        color: var(--navy);
        font-size: 1.08rem;
      }



      .team-circle-card .team-role {
        margin-top: 0.45rem;
      }

      .team-circle-card .team-description {
        margin-top: 0.65rem;
      }

      .about-cta h2 {
        font-size: clamp(1.45rem, 3vw, 2.2rem);
        line-height: 1.16;
        color: #f2f6fc;
      }

      .about-cta .cta-button {
        margin-top: 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #d8e3f2;
        color: #132238;
        text-decoration: none;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(216, 227, 242, 0.96);
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease;
      }

      .about-cta .cta-button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-1px);
      }

      .newsletter {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 2.5rem 0;
      }

      .newsletter-wrap {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 1.4rem;
        align-items: center;
        background: #ffffff;
        border: 1px solid #d7deea;
        border-radius: 1rem;
        padding: 1.5rem;
      }

      .newsletter-copy p {
        margin-top: 0.7rem;
        color: var(--slate);
        max-width: 34rem;
      }

      .newsletter-copy h2 {
        font-size: clamp(1.55rem, 3vw, 2.45rem);
        line-height: 1.12;
        color: var(--navy-soft);
      }

      .newsletter-form {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        justify-content: flex-end;
      }

      .newsletter-input {
        width: min(360px, 100%);
        height: 44px;
        border-radius: 0.55rem;
        border: 1px solid #cfd9e7;
        background: #f9fbff;
        padding: 0 0.85rem;
        font-size: 0.92rem;
        color: #1a2433;
        outline: none;
        font-family: inherit;
      }

      .newsletter-input:focus {
        border-color: #9eb0ca;
        box-shadow: 0 0 0 2px rgba(130, 147, 174, 0.18);
      }

      .newsletter-button {
        height: 44px;
        border: 1px solid #53b27f;
        background: #53b27f;
        color: #ffffff;
        border-radius: 0.55rem;
        padding: 0 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 180ms ease, transform 180ms ease, border-color 180ms ease;
      }

      .newsletter-button:hover {
        background: #3f9568;
        border-color: #3f9568;
        transform: translateY(-1px);
      }

      .newsletter-note {
        margin-top: 0.5rem;
        color: #7a889e;
        font-size: 0.72rem;
      }

      @media (max-width: 980px) {
        .journey-proof-logos,
        .journey-proof-body,
        .why-equity-body,
        .advantage-grid,
        .team-circle-grid,
        .timeline,
        .newsletter-wrap {
          grid-template-columns: 1fr;
        }

        .journey-hero-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .journey-hero-grid .journey-hero-card:nth-child(3) {
          display: none;
        }

        .journey-hero-head {
          max-width: 36rem;
        }

        .journey-proof-metrics {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .team-variant-cards .team-circle-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

      }

      @media (max-width: 680px) {
        .site-header {
          gap: 0.45rem;
          min-height: 44px;
          padding-bottom: 0.45rem;
        }

        body.is-scrolled .site-header {
          padding-top: 2.15rem;
          padding-bottom: 0.75rem;
        }

        .main-nav {
          position: static;
          gap: 0.55rem;
        }

        .menu-toggle {
          display: inline-flex;
          position: relative;
          top: -7px;
          border: 0;
          box-shadow: none;
        }

        .menu-cta {
          display: inline-flex;
          top: -7px;
          min-width: 102px;
          padding: 0.58rem 0.8rem;
          font-size: 0.68rem;
        }

        .menu-list {
          position: absolute;
          top: calc(100% + 0.5rem);
          left: 0.8rem;
          right: auto;
          min-width: min(190px, calc(100vw - 2rem));
          flex-direction: column;
          align-items: flex-start;
          gap: 0.55rem;
          padding: 0;
          max-height: 0;
          opacity: 0;
          overflow: hidden;
          transform: translateY(-8px);
          pointer-events: none;
          background: rgba(255, 255, 255, 0.96);
          border: 1px solid #d3ddea;
          border-radius: 0.6rem;
          transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
          z-index: 220;
        }

        .menu-toggle-input:checked ~ .main-nav .menu-list {
          max-height: 320px;
          opacity: 1;
          transform: translateY(0);
          pointer-events: auto;
          padding: 0.7rem;
        }

        .menu-list .menu-link {
          color: #172235;
          text-shadow: none;
        }

        .menu-list .menu-link:hover,
        .menu-list .menu-link.is-active {
          color: #5e7393;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars { background: transparent; }
        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::before {
          top: 0;
          transform: rotate(45deg);
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::after {
          top: 0;
          transform: rotate(-45deg);
        }

        .logo {
          width: min(34vw, 170px);
          height: auto;
          position: static;
          top: auto;
          transform: none;
          margin-left: 0.9rem;
          margin-top: -17px;
        }

        .newsletter-form {
          flex-direction: column;
          align-items: stretch;
          justify-content: flex-start;
        }

        .newsletter-input {
          font-size: 16px;
        }

        .newsletter-input {
          width: 100%;
        }

        .newsletter-button {
          width: 100%;
        }

        .journey-hero-grid {
          grid-template-columns: 1fr;
        }

        .journey-hero-grid .journey-hero-card:nth-child(2) {
          display: none;
        }

        .journey-hero {
          padding: 8rem 0 1.7rem;
        }

        .journey-proof,
        .why-equity,
        .team-variant-circles {
          padding-top: 2.3rem;
        }

        .journey-hero-title {
          font-size: clamp(1.8rem, 9vw, 2.6rem);
          max-width: none;
        }

        .journey-hero-copy {
          max-width: 100%;
        }

        .journey-hero-card {
          min-height: 16rem;
          border-radius: 1rem;
        }

        .journey-proof-shell {
          padding: 0.4rem 1.1rem 1.1rem;
          border-radius: 1.15rem;
        }

        .journey-proof-body {
          margin-top: 1.3rem;
          gap: 1rem;
        }

        .journey-proof-copy h2 {
          max-width: none;
          font-size: clamp(1.7rem, 8vw, 2.35rem);
        }

        .journey-proof-metric {
          min-height: 7.6rem;
        }


        .team-variant-cards .team-circle-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
      }

      @media (max-width: 520px) {
        .team-variant-cards .team-circle-grid {
          grid-template-columns: 1fr !important;
        }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader active="about" menuToggleId="mobile-menu-toggle-about" locale={locale} currentPath={Astro.url.pathname} />

    <section class="journey-hero">
      <div class="container">
        <div class="journey-hero-head">
          <h1 class="journey-hero-title">{content.hero.title}</h1>
          <p class="journey-hero-copy">{content.hero.copy}</p>
        </div>
        <div class="journey-hero-grid" aria-label="Equity Partners team">
          <article class="journey-hero-card">
            <img class="journey-hero-portrait" src="/Ordino AND IMG day snow.webp" alt="Ordino landscape" />
          </article>
          <article class="journey-hero-card">
            <img class="journey-hero-portrait" src="/04c copy.jpg" alt="Equity Partners development" />
          </article>
          <article class="journey-hero-card">
            <img class="journey-hero-portrait" src="/Andorra-la-Vella.webp" alt="Andorra la Vella" />
          </article>
        </div>
      </div>
    </section>

    <section class="journey-proof">
      <div class="container">
        <div class="journey-proof-shell">
          <div class="journey-proof-body">
            <div class="journey-proof-copy">
              <p class="journey-proof-label">{content.proof.label}</p>
              <h2>{content.proof.title}</h2>
              <p>{content.proof.subtitle}</p>
            </div>
            <div class="journey-proof-metrics">
              <article class="journey-proof-metric">
                <p class="journey-proof-metric-value">20+</p>
                <p class="journey-proof-metric-label">{content.proof.metrics[0].label}</p>
              </article>
              <article class="journey-proof-metric">
                <p class="journey-proof-metric-value">€1B+</p>
                <p class="journey-proof-metric-label">{content.proof.metrics[1].label}</p>
              </article>
              <article class="journey-proof-metric">
                <p class="journey-proof-metric-value">100k+</p>
                <p class="journey-proof-metric-label">{content.proof.metrics[2].label}</p>
              </article>
              <article class="journey-proof-metric">
                <p class="journey-proof-metric-value">10+</p>
                <p class="journey-proof-metric-label">{content.proof.metrics[3].label}</p>
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <WhyEquitySection locale={locale} />

    <section class="section team-variant-circles team-variant-circles-dark team-variant-cards" id="team">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{content.team.eyebrow}</p>
          <h2>{content.team.title}</h2>
          <p class="intro">{content.team.intro}</p>
        </div>
        <div class="team-circle-grid">
          {
            localizedTeamMembers.map((member) => (
              <article class="team-circle-card">
                <img src={member.image} alt={member.name} loading="lazy" />
                <h3>{member.name}</h3>
                <p class="team-role">{member.role}</p>
                <p class="team-description">{member.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId="newsletter-email-about" locale={locale} />

    <SiteFooter locale={locale} />

    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>
  </body>
</html>
