        text-transform: uppercase;
        color: #9fb4d2;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      .wwo-features {
        list-style: none;
        margin: 0 0 2.2rem;
        padding: 0;
        display: grid;
        gap: 0.75rem;
      }

      .wwo-features li {
        display: grid;
        grid-template-columns: 1.1rem 1fr;
        gap: 0.65rem;
        align-items: start;
        color: #d6e0ef;
        font-size: 0.9rem;
        line-height: 1.5;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      .wwo-check {
        width: 1.1rem;
        height: 1.1rem;
        margin-top: 0.15rem;
        color: #53b27f;
        flex-shrink: 0;
      }

      .wwo-check svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .wwo-cta {
        margin-top: auto;
      }

      .wwo-cta a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1.5rem;
        border-radius: 0.45rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        text-decoration: none;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
      }

      .wwo-card.is-fund .wwo-cta a {
        background: rgba(214, 225, 244, 0.12);
        color: #f4f8ff;
      }

      .wwo-card.is-fund .wwo-cta a:hover {
        background: rgba(214, 225, 244, 0.2);
        transform: translateY(-1px);
      }

      .wwo-card.is-direct .wwo-cta a {
        background: #53b27f;
        color: #ffffff;
      }

      .wwo-card.is-direct .wwo-cta a:hover {
        background: #3f9568;
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(12, 24, 18, 0.3);
      }

      @media (max-width: 760px) {
        .what-we-offer-grid {
          grid-template-columns: 1fr;
        }
      }

      /* ── Andorra Advantage V2 ── */
      .andorra-adv-v2 {
        background: #f2f5fa;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 5rem 0 4.5rem;
      }

      .andorra-adv-v2-header {
        margin-bottom: 3rem;
      }

      .andorra-adv-v2-header .eyebrow {
        color: var(--accent);
      }

      .andorra-adv-v2-header .focus-title {
        color: #0f1a2a;
        margin-bottom: 0.6rem;
      }

      .andorra-adv-v2-header .focus-intro {
        color: #5a667a;
        max-width: none;
      }

      .andorra-adv-v2-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        border: 1px solid #d7deea;
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
      }

      .andorra-adv-v2-item {
        padding: 2.4rem 2.2rem;
        border-right: 1px solid #e4eaf3;
        border-bottom: 1px solid #e4eaf3;
        transition: background 200ms ease;
      }

      .andorra-adv-v2-item:nth-child(even) {
        border-right: none;
      }

      .andorra-adv-v2-item:nth-child(3),
      .andorra-adv-v2-item:nth-child(4) {
        border-bottom: none;
      }

      .andorra-adv-v2-item:hover {
        background: #f6f9fd;
      }

      .andorra-adv-v2-num {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #53b27f;
        margin-bottom: 0.85rem;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      .andorra-adv-v2-flag {
        width: 1.2rem;
        height: 1.2rem;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        display: block;
      }

      .andorra-adv-v2-item h3 {
        color: #0f1a2a;
        font-size: 1.1rem;
        margin: 0 0 0.6rem;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-weight: 600;
      }

      .andorra-adv-v2-item p {
        color: #5a667a;
        font-size: 0.93rem;
        line-height: 1.6;
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      @media (max-width: 640px) {
        .andorra-adv-v2-grid {
          grid-template-columns: 1fr;
        }

        .andorra-adv-v2-item {
          border-right: none;
          border-bottom: 1px solid #e4eaf3;
        }

        .andorra-adv-v2-item:last-child {
          border-bottom: none;
        }

        .andorra-adv-v2-item:nth-child(3) {
          border-bottom: 1px solid #e4eaf3;
        }
      }

      /* ── Scroll entrance animations ── */
      [data-animate] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 650ms ease, transform 650ms ease;
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      [data-animate="delay-1"] { transition-delay: 100ms; }
      [data-animate="delay-2"] { transition-delay: 200ms; }
      [data-animate="delay-3"] { transition-delay: 300ms; }
      [data-animate="delay-4"] { transition-delay: 400ms; }

    </style>
  </head>
  <body>
