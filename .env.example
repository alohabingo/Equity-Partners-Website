# Supabase — copy this file to .env and fill in real values
# Find them: Supabase Dashboard → Project Settings → API Keys
PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server only. Never expose in client code or commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# Newsletter ESP — set to "none" (or leave empty) to store subscribers
# in the database only. Swap provider anytime: brevo | mailchimp | none
ESP_PROVIDER=none
ESP_API_KEY=
ESP_LIST_ID=

# Zoho Mail (two-way email on leads) — see zoho-setup-guide.md.
# Leave empty to disable; the portal falls back to mailto links.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=
ZOHO_API_BASE=https://mail.zoho.eu

# --- Zoho OAuth application (one-off, replaces the per-mailbox Self Client) ---
# Registered once at https://api-console.zoho.eu as a Server-based Application.
# Each project mailbox is then connected with a button in the portal, and its
# refresh token is stored per project in the database rather than here.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
