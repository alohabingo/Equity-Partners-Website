---
const advantages = [
  {
    title: "Local Network",
    description:
      "Direct relationships with landowners, advisors, and Andorran operators unlock faster access to qualified opportunities.",
  },
  {
    title: "Regulatory Expertise",
    description:
      "We navigate planning, approvals, and compliance in the Principality with disciplined local execution.",
  },
  {
    title: "Lifecycle Management",
    description:
      "From sourcing through delivery, we manage project decisions end-to-end with investor clarity at every stage.",
  },
];

const projects = [
  {
    name: "Nanta Alta Luxury villas",
    status: "Under Construction",
    value: "€50M",
    sector: "Luxury Residential",
    image: "/04c%20copy.jpg",
  },
  {
    name: "Ordino Heights",
    status: "Pipeline",
    value: "€18M",
    sector: "Residential Development",
    image: "/ordino%20heights.jpg",
  },
  {
    name: "Funicamp ski Residencies",
    status: "Pipeline",
    value: "€22M",
    sector: "Mixed-Use",
    image: "/funicamp%20ski.jpg",
  },
];

const localPartners = [
  { name: "AR Team", logo: "/images/partners/AR%20logo%20EP.png" },
  { name: "DATA", logo: "/images/partners/DATA LOGO.png" },
  { name: "Emindset Law", logo: "/images/partners/Emindset LAW LOGO.png" },
  { name: "Govern d'Andorra", logo: "/images/partners/Govern d'Andorra logo.png" },
  { name: "Creand", logo: "/images/partners/creand.webp" },
  { name: "Engel & Volkers", logo: "/images/partners/engel volkers logo.png" },
  { name: "Heracles", logo: "/images/partners/heracles%20logo.png" },
  { name: "Pret a Porter Casas", logo: "/images/partners/pret%20a%20porter%20casas%20logo.svg" },
  { name: "Hormipresa", logo: "/images/partners/hormipresa%20.webp" },
  { name: "MoraBank", logo: "/images/partners/mora%20bank.png" },
];

const localPartnersLoop = [...localPartners, ...localPartners, ...localPartners, ...localPartners];
const currentYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Equity Partners | Andorra Property Group</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@700&display=swap");

      :root {
        --bg-night: #06080c;
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --text-primary: #1f2835;
        --text-muted: #5a667a;
        --text-light: #e8edf5;
        --accent: #8293ae;
        --line: #dbe1ea;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
        color: var(--text-primary);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.5;
      }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .hero {
        min-height: 84vh;
        padding: 2rem 0 2.1rem;
        background: linear-gradient(
            to bottom,
            rgba(6, 8, 12, 0.4) 0%,
            rgba(6, 8, 12, 0.26) 18%,
            rgba(6, 8, 12, 0.18) 34%,
            rgba(6, 8, 12, 0.3) 100%
          ),
          url("/hero-andorra-R2PtlkD-.jpg")
            center / cover no-repeat;
        color: var(--text-light);
        display: flex;
        flex-direction: column;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 1.8rem;
        padding-top: 2.15rem;
        padding-bottom: 0.15rem;
        padding-left: calc((100vw - min(var(--max-width), 92vw)) / 2);
        padding-right: calc((100vw - min(var(--max-width), 92vw)) / 2);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: none;
        width: 100%;
        z-index: 220;
        background: transparent !important;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        transition: padding-top 320ms ease, padding-bottom 320ms ease, background-color 320ms ease,
          backdrop-filter 320ms ease, -webkit-backdrop-filter 320ms ease, border-color 320ms ease,
          box-shadow 320ms ease;
      }

      body.is-scrolled .site-header {
        background: rgba(15, 26, 42, 0.6) !important;
        padding-top: 1.25rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom-color: rgba(220, 231, 246, 0.2);
        box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
      }

      body.is-scrolled .menu-cta {
        background: rgba(255, 255, 255, 0.96);
        border-color: rgba(255, 255, 255, 0.95);
      }

      @supports not ((backdrop-filter: blur(1px))) {
        body.is-scrolled .site-header {
          background: rgba(15, 26, 42, 0.84) !important;
        }
      }

      .logo {
        width: 180px;
        height: auto;
        position: relative;
        top: -5px;
        filter: brightness(0) invert(1);
        filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
          drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
      }

      .main-nav {
        display: flex;
        align-items: center;
        margin-left: auto;
        flex-wrap: nowrap;
        gap: 1.3rem;
        position: relative;
        top: -4px;
        z-index: 121;
      }

      .menu-toggle-input {
        display: none;
      }

      .menu-toggle {
        display: none;
        width: 38px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 0.45rem;
        background: transparent;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }

      .menu-toggle-bars {
        display: block;
        width: 18px;
        height: 2px;
        background: #ffffff;
        position: relative;
        transition: background 220ms ease;
      }

      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        background: #ffffff;
        transition: transform 220ms ease, top 220ms ease;
      }

      .menu-toggle-bars::before {
        top: -6px;
      }

      .menu-toggle-bars::after {
        top: 6px;
      }

      .menu-list {
        list-style: none;
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        white-space: nowrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
      }

      .menu-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }

      .menu-link:hover {
        color: #d7e3f5;
      }

      .menu-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: 1px;
        flex: 0 0 auto;
        min-width: 126px;
        color: #172235;
        background: rgba(255, 255, 255, 0.96);
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(255, 255, 255, 0.95);
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease;
      }

      .menu-cta:hover {
        background: rgba(224, 233, 246, 0.96);
        color: #101b2c;
        transform: translateY(-1px);
      }

      .menu-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.9);
        outline-offset: 2px;
      }

      .hero-content {
        margin-top: auto;
        max-width: 50rem;
        padding-top: 10rem;
        padding-bottom: 0;
        transform: translateY(4.5rem);
        animation: rise 900ms 120ms ease both;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1 {
        margin: 0;
        font-family: "Open Sans", "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 5vw, 4rem);
        letter-spacing: 0.02em;
        line-height: 1.08;
      }

      .subline {
        margin-top: 0.9rem;
        max-width: 42rem;
        color: rgba(255, 255, 255, 0.96);
        font-size: clamp(1rem, 1.8vw, 1.2rem);
      }

      .hero-kicker {
        margin-top: 0;
        margin-bottom: 1.1rem;
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        background: rgba(15, 26, 42, 0.42);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 10px 24px rgba(7, 12, 20, 0.18);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        font-size: 0.78rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: #eef4fb;
      }

      .section {
        padding: 4rem 0;
      }

      .partners-wrap {
        background: #ffffff;
        border-bottom: 1px solid var(--line);
        padding: 2.2rem 0 2rem;
        overflow: hidden;
      }

      .partners-link {
        display: block;
        color: inherit;
        text-decoration: none;
      }

      .partners-link:focus-visible {
        outline: 2px solid rgba(130, 147, 174, 0.45);
        outline-offset: 3px;
      }

      .partners-title {
        margin: 0 0 1.4rem;
        text-align: left;
        font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        font-weight: 400;
        text-decoration: none;
      }

      .partners-divider {
        width: 110px;
        height: 1px;
        margin: 0.85rem auto 1.3rem;
        background: #d8dee9;
      }

      .partners-marquee {
        position: relative;
        overflow: hidden;
        width: 100%;
      }

      .partners-track {
        display: flex;
        width: max-content;
        gap: 3rem;
        animation: partners-scroll 46s linear infinite;
      }

      .partner-logo-box {
        flex: 0 0 auto;
        width: 145px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.2rem 0.45rem;
      }

      .partner-logo-box img {
        width: 100%;
        height: 48px;
        display: block;
        object-fit: contain;
        object-position: center;
        filter: grayscale(100%) brightness(0.88);
        opacity: 0.9;
        transition: filter 200ms ease, opacity 200ms ease, transform 200ms ease;
      }

      .partner-logo-box img.is-morabanc {
        filter: grayscale(100%) brightness(0.34) contrast(1.18);
        opacity: 1;
      }

      .partner-logo-box:hover img {
        filter: grayscale(0%) brightness(0.98);
        opacity: 1;
        transform: translateY(-1px);
      }

      .partner-logo-box:hover img.is-morabanc {
        filter: grayscale(100%) brightness(0.34) contrast(1.18);
      }

      .advantage-home {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .advantage-home-grid {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        width: 100%;
        align-items: stretch;
      }

      .advantage-home-card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.3rem;
        height: 100%;
      }

      .advantage-home-icon {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
      }

      .advantage-home-icon img {
        width: 46px;
        height: 46px;
        object-fit: contain;
        display: block;
      }

      .advantage-home-card h3 {
        margin-top: 0.45rem;
        color: var(--text-strong);
        font-size: 1.15rem;
      }

      .advantage-home-kicker {
        margin-top: 0.7rem;
        color: #5a667a;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .advantage-home-card p {
        margin-top: 0.6rem;
        color: var(--text-muted);
      }

      .advantage-home .focus-intro {
        max-width: none;
        width: 100%;
      }


      @keyframes partners-scroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-25%);
        }
      }

      .focus-section {
        padding: 2.4rem 0 3rem;
        background: #f2f5fa;
        border-top: 1px solid #dce3ee;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-layout {
        display: grid;
        grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.25fr);
        gap: 2.6rem;
        align-items: start;
      }

      .focus-label {
        margin: 0;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #8a99ae;
      }

      .focus-title {
        margin-top: 0.55rem;
        font-size: clamp(1.9rem, 3.3vw, 3rem);
        line-height: 1.06;
        color: #1f2b3c;
      }

      .focus-intro {
        margin-top: 0.9rem;
        max-width: 37ch;
        color: #5e6c82;
      }

      .focus-list {
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid #dce3ee;
      }

      .focus-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        column-gap: 0.95rem;
        row-gap: 0.35rem;
        padding: 1.18rem 0 1.24rem;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-index {
        font-size: 0.73rem;
        letter-spacing: 0.09em;
        color: #8f9db1;
        margin-top: 0.2rem;
      }

      .focus-item-title {
        font-size: 1.18rem;
        line-height: 1.22;
        color: #24344c;
      }

      .focus-item-copy {
        grid-column: 2;
        margin: 0;
        color: #66758a;
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .focus-section-f {
        padding: 2.4rem 0 3rem;
        background: #f2f5fa;
        border-top: 1px solid #dce3ee;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-f-header {
        margin-bottom: 0.9rem;
      }

      .focus-f-header .focus-label {
        color: #5a667a;
      }

      .focus-f-header .focus-title {
        color: #0f1a2a;
      }

      .focus-f-header .focus-intro {
        color: #5a667a;
        max-width: none;
        width: 100%;
      }

      .focus-f-body {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 1rem;
        align-items: stretch;
      }

      .focus-f-body .focus-c-panels {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.8rem;
      }

      .focus-c-kpi {
        background: #ffffff;
        border: 1px solid #c4cedd;
        border-radius: 0.9rem;
        padding: 1rem;
      }

      .focus-c-kpi-value {
        color: #0f1a2a;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .focus-c-kpi h3 {
        margin-top: 0.45rem;
        color: #0f1a2a;
        font-size: 1.06rem;
      }

      .focus-c-kpi p {
        margin-top: 0.5rem;
        color: #5a667a;
        font-size: 0.88rem;
      }

      .focus-f-body .focus-c-media {
        border-radius: 1rem;
        min-height: 0;
        height: 100%;
        background:
          linear-gradient(180deg, rgba(9, 15, 25, 0.12), rgba(9, 15, 25, 0.18)),
          url("/Ordino%20AND%20IMG%20day%20snow.webp") center / cover no-repeat;
      }

      .section-header {
        max-width: 48rem;
      }

      .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.85rem;
      }

      h2 {
        font-size: clamp(1.55rem, 3vw, 2.45rem);
        line-height: 1.12;
      }

      .intro {
        margin-top: 0.9rem;
        color: var(--text-muted);
      }

      .adv-grid {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .adv-card {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.4rem;
      }

      .adv-number {
        font-size: 0.8rem;
        color: var(--accent);
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .adv-card h3 {
        margin-top: 0.5rem;
        font-size: 1.25rem;
      }

      .adv-card p {
        margin-top: 0.7rem;
        color: var(--text-muted);
      }

      .projects {
        background: linear-gradient(180deg, #f4f6fa, #edf1f7);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .project-grid {
        margin-top: 1.9rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .project-card {
        position: relative;
        border-radius: 1rem;
        overflow: hidden;
        min-height: 23rem;
        display: flex;
        align-items: flex-end;
        border: 1px solid #d7deea;
      }

      .project-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .project-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(10, 15, 24, 0.15), rgba(10, 15, 24, 0.86));
      }

      .project-meta {
        position: relative;
        z-index: 1;
        padding: 1.2rem;
        color: #eff4fb;
      }

      .project-meta h3 {
        font-size: 1.2rem;
      }

      .metrics {
        margin-top: 0.7rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .pill {
        font-size: 0.75rem;
        padding: 0.28rem 0.56rem;
        border: 1px solid rgba(231, 237, 245, 0.36);
        border-radius: 999px;
        background: rgba(11, 20, 34, 0.32);
      }

      .cta-link {
        display: inline-flex;
        margin-top: 1.4rem;
        font-size: 0.84rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-primary);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
        padding-bottom: 0.2rem;
      }

      .test-image-break {
        position: relative;
        width: 100%;
        height: 33vh;
        min-height: 220px;
        background:
          linear-gradient(rgba(7, 13, 22, 0.4), rgba(7, 13, 22, 0.4)),
          url("/AND IMG night snow lights.jpeg") center / cover no-repeat fixed;
        background-color: #0f1a2a;
        overflow: hidden;
      }

      .test-image-title-wrap {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .test-image-title {
        width: min(var(--max-width), 92vw);
        text-align: left;
        color: #ffffff;
        font-family: "Montserrat", "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(1.55rem, 3vw, 2.3rem);
        line-height: 1.12;
        text-shadow: 0 2px 10px rgba(2, 6, 12, 0.5);
      }

      .leaders {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 1.2rem;
        align-items: stretch;
      }

      .leaders-image {
        border-radius: 1rem;
        overflow: hidden;
        min-height: 21rem;
        border: 1px solid var(--line);
      }

      .leaders-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .leaders-copy {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      blockquote {
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.35;
      }

      .leaders-note {
        margin-top: 0.9rem;
        color: var(--text-muted);
      }

      .gateway {
        background: #0f1a2a;
        color: #e8edf6;
        border-top: 1px solid rgba(220, 228, 240, 0.15);
      }

      .gateway .intro {
        color: #c9d4e3;
      }

      .gateway-box {
        margin-top: 1.6rem;
        border: 1px solid rgba(219, 229, 241, 0.28);
        border-radius: 1rem;
        padding: 1.5rem;
        background: rgba(8, 14, 23, 0.46);
      }

      .button {
        margin-top: 1.2rem;
        display: inline-block;
        color: #132238;
        background: #d8e3f2;
        text-decoration: none;
        font-weight: 600;
        border-radius: 999px;
        padding: 0.7rem 1.2rem;
      }

      .footer {
        background: #0f1a2a;
        color: #d9e3f2;
      }

      .newsletter {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 2.5rem 0;
      }

      .newsletter-wrap {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 1.4rem;
        align-items: center;
        background: #ffffff;
        border: 1px solid #d7deea;
        border-radius: 1rem;
        padding: 1.5rem;
      }

      .newsletter-copy p {
        margin-top: 0.7rem;
        color: var(--text-muted);
        max-width: 34rem;
      }

      .newsletter-form {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        justify-content: flex-end;
      }

      .newsletter-input {
        width: min(360px, 100%);
        height: 44px;
        border-radius: 0.55rem;
        border: 1px solid #cfd9e7;
        background: #f9fbff;
        padding: 0 0.85rem;
        font-size: 0.92rem;
        color: #1a2433;
        outline: none;
      }

      .newsletter-input:focus {
        border-color: #9eb0ca;
        box-shadow: 0 0 0 2px rgba(130, 147, 174, 0.18);
      }

      .newsletter-button {
        height: 44px;
        border: 1px solid rgba(14, 24, 39, 0.18);
        background: #1b2a3f;
        color: #eaf1fb;
        border-radius: 0.55rem;
        padding: 0 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 180ms ease, transform 180ms ease;
      }

      .newsletter-button:hover {
        background: #253750;
        transform: translateY(-1px);
      }

      .newsletter-note {
        margin-top: 0.5rem;
        color: #7a889e;
        font-size: 0.72rem;
      }

      .footer-top {
        padding: 3rem 0 2.7rem;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.2fr repeat(3, minmax(0, 1fr));
        gap: 1.7rem;
        align-items: start;
      }

      .footer-grid > div:not(:first-child) {
        justify-self: start;
        text-align: left;
        margin-left: 1.6rem;
      }

      .footer-grid > div:not(:first-child) .footer-list {
        justify-items: start;
      }

      .footer-logo {
        display: block;
        width: 220px;
        max-width: 100%;
        height: auto;
        margin-top: -6px;
        filter: brightness(0) invert(1);
      }

      .footer-cta {
        margin-top: 1.6rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #172235;
        background: rgba(204, 215, 232, 0.92);
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(255, 255, 255, 0.15);
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease,
          box-shadow 180ms ease;
      }

      .footer-cta:hover {
        background: rgba(224, 233, 246, 1);
        color: #101b2c;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(6, 12, 20, 0.22);
      }

      .footer-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.92);
        outline-offset: 2px;
      }

      .footer-heading {
        margin: 0 0 0.75rem;
        color: #f2f6fc;
        font-size: 0.76rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .footer-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.65rem;
      }

      .footer-link {
        color: #c9d4e7;
        text-decoration: none;
        font-size: 0.75rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .footer-link:hover {
        color: #ffffff;
      }

      .footer-meta {
        margin: 0;
        color: #c9d4e7;
        font-size: 0.74rem;
        line-height: 1.9;
      }

      .footer-divider {
        border-top: 1px solid rgba(205, 219, 238, 0.2);
      }

      .footer-bottom {
        padding: 1.3rem 0 1.45rem;
      }

      .footer-bottom-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
      }

      .footer-copy {
        margin: 0;
        color: #aebcd4;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .footer-legal {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .footer-legal a {
        color: #c1cee3;
        text-decoration: none;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .footer-social {
        display: flex;
        justify-content: flex-end;
        gap: 0.45rem;
      }

      .social-pill {
        width: 30px;
        height: 30px;
        border-radius: 999px;
        border: 1px solid rgba(220, 231, 246, 0.34);
        color: #e3ebf8;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
      }


      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 980px) {
        .adv-grid,
        .project-grid,
        .leaders,
        .newsletter-wrap,
        .advantage-home-grid,
        .focus-f-body {
          grid-template-columns: 1fr;
        }

        .focus-layout {
          grid-template-columns: 1fr;
          gap: 1.35rem;
        }

        .advantage-home .focus-intro {
          max-width: 100%;
        }
      }

      @media (max-width: 680px) {
        .site-header {
          gap: 0.45rem;
          min-height: 44px;
        }

        body.is-scrolled .site-header {
          padding-top: 2.15rem;
          padding-bottom: 0.65rem;
        }

        .main-nav {
          position: static;
          gap: 0.55rem;
        }

        .menu-toggle {
          display: inline-flex;
          position: relative;
          top: -4px;
          border: 0;
          box-shadow: none;
        }

        .menu-list {
          position: absolute;
          top: calc(100% + 0.5rem);
          left: 0.8rem;
          right: auto;
          min-width: min(190px, calc(100vw - 2rem));
          flex-direction: column;
          align-items: flex-start;
          gap: 0.55rem;
          padding: 0;
          max-height: 0;
          opacity: 0;
          overflow: hidden;
          transform: translateY(-8px);
          pointer-events: none;
          background: rgba(255, 255, 255, 0.96);
          border: 1px solid #d3ddea;
          border-radius: 0.6rem;
          transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
          z-index: 220;
        }

        .menu-toggle-input:checked ~ .main-nav .menu-list {
          max-height: 320px;
          opacity: 1;
          transform: translateY(0);
          pointer-events: auto;
          padding: 0.7rem;
        }

        .menu-list .menu-link {
          color: #172235;
          text-shadow: none;
        }

        .menu-list .menu-link:hover,
        .menu-list .menu-link.is-active {
          color: #5e7393;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars {
          background: transparent;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::before {
          top: 0;
          transform: rotate(45deg);
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::after {
          top: 0;
          transform: rotate(-45deg);
        }

        .menu-link {
          font-size: 0.7rem;
        }

        .menu-cta {
          display: inline-flex;
          top: -4px;
          min-width: 102px;
          padding: 0.58rem 0.8rem;
          font-size: 0.68rem;
        }

        .logo {
          width: min(34vw, 170px);
          height: auto;
          position: static;
          top: auto;
          transform: none;
          margin-left: 0.9rem;
          margin-top: -14px;
        }

        .hero {
          min-height: 72vh;
          padding-bottom: 1.55rem;
        }
        .hero-content {
          max-width: 100%;
          padding-top: 5.4rem;
          padding-bottom: 0;
          transform: translateY(2.6rem);
        }

        h1 {
          font-size: clamp(1.75rem, 8.6vw, 2.45rem);
          line-height: 1.06;
        }

        .hero-kicker {
          margin-bottom: 0.8rem;
          font-size: 0.7rem;
          letter-spacing: 0.18em;
        }

        .subline {
          margin-top: 0.75rem;
          max-width: 28rem;
          font-size: 0.96rem;
          line-height: 1.45;
        }

        .partners-wrap {
          padding: 1.8rem 0 1.6rem;
        }

        .partners-track {
          gap: 2rem;
          animation-duration: 36s;
        }

        .focus-item {
          padding: 0.95rem 0 1rem;
        }

        .focus-item-title {
          font-size: 1.02rem;
        }

        .focus-item-copy {
          font-size: 0.84rem;
        }

        .newsletter-form {
          flex-direction: column;
          align-items: stretch;
          justify-content: flex-start;
        }

        .newsletter-input {
          width: 100%;
        }

        .newsletter-button {
          width: 100%;
        }

        .partner-logo-box {
          width: 104px;
          height: 48px;
        }

        .partner-logo-box img {
          height: 32px;
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: 1.2rem;
        }

        .footer-grid > div:not(:first-child) {
          justify-self: start;
          text-align: left;
          margin-left: 0;
        }

        .footer-grid > div:not(:first-child) .footer-list {
          justify-items: start;
        }

        .footer-bottom-row {
          grid-template-columns: 1fr;
          text-align: left;
        }

        .footer-legal {
          justify-content: flex-start;
        }

        .footer-social {
          justify-content: flex-start;
        }

      }
    </style>
  </head>
  <body>
    <section class="hero">
      <div class="container">
        <header class="site-header" id="home">
          <input class="menu-toggle-input" type="checkbox" id="mobile-menu-toggle" />
          <label class="menu-toggle" for="mobile-menu-toggle" aria-label="Toggle navigation menu">
            <span class="menu-toggle-bars"></span>
          </label>
          <a href="/" aria-label="Go to homepage">
            <img
              class="logo"
              src="/images/branding/equity-partners-logo-light%20small.png"
              alt="Equity Partners logo"
            />
          </a>
          <nav class="main-nav" aria-label="Primary">
            <ul class="menu-list">
              <li><a class="menu-link" href="/">Home</a></li>
              <li><a class="menu-link" href="/#team">Services</a></li>
              <li><a class="menu-link" href="/about">About</a></li>
              <li><a class="menu-link" href="/partners">Partners</a></li>
              <li><a class="menu-link" href="/blog">Blog</a></li>
              <li><a class="menu-link" href="/test">Test</a></li>
            </ul>
            <a class="menu-cta" href="/contact">Contact Us</a>
          </nav>
        </header>
        <div class="hero-content">
          <p class="hero-kicker">ANDORRA • INVESTMENT • EXCELLENCE</p>
          <h1>Your strategic partner for Andorra real estate investments.</h1>
          <p class="subline">
            Equity Partners connects investor capital to disciplined Andorran real estate execution.
          </p>
        </div>
      </div>
    </section>

    <section class="partners-wrap" id="partners-local">
      <a class="partners-link" href="/partners" aria-label="View all local partners">
        <div class="container">
          <h2 class="partners-title">OUR LOCAL PARTNERS</h2>
        </div>
        <div class="partners-marquee" aria-label="Local partner logos">
          <div class="partners-track">
            {
              localPartnersLoop.map((partner) => (
                <div class="partner-logo-box">
                  <img
                    src={partner.logo}
                    alt={partner.name}
                    loading="lazy"
                    class:list={{
                      "is-morabanc": partner.name === "MoraBank",
                    }}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </a>
    </section>

    <section class="section advantage-home">
      <div class="container">
        <p class="focus-label">Andorra Advantage</p>
        <h2 class="focus-title">What we do</h2>
        <p class="focus-intro">
          We open the doors to Andorra’s exclusive investment landscape by providing a structural bridge that allows international firms to deploy capital into Andorra without compromising on institutional standards.
        </p>
        <div class="advantage-home-grid">
          <article class="advantage-home-card">
            <span class="advantage-home-icon" aria-hidden="true"><img src="/images/Icons/project%20development.png" alt="" /></span>
            <p class="advantage-home-kicker">01 | Development</p>
            <h3>Full-Cycle Project Development</h3>
            <p>From initial feasibility to final delivery, we provide end-to-end execution that transforms strategic land acquisitions into institutional-grade assets.</p>
          </article>
          <article class="advantage-home-card">
            <span class="advantage-home-icon" aria-hidden="true"><img src="/images/Icons/local%20network.png" alt="" /></span>
            <p class="advantage-home-kicker">02 | Access</p>
            <h3>Local Network &amp; Exclusive Access</h3>
            <p>Direct relationships with landowners, advisors, and Andorran operators unlock secure high-value, off-market opportunities before they reach the public sector.</p>
          </article>
          <article class="advantage-home-card">
            <span class="advantage-home-icon" aria-hidden="true"><img src="/images/Icons/regulatory%20expertise.png" alt="" /></span>
            <p class="advantage-home-kicker">03 | Compliance</p>
            <h3>Regulatory Expertise</h3>
            <p>We navigate the Principality’s compliance landscape, translating local regulations into executable investment strategies through deep-rooted jurisdictional expertise.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="focus-section-f">
      <div class="container">
        <div class="focus-f-header">
          <p class="focus-label">Our Focus Concept F</p>
          <h2 class="focus-title">What we do</h2>
          <p class="focus-intro">We open the doors to Andorra’s exclusive investment landscape by providing a structural bridge that allows international firms to deploy capital into Andorra without compromising on institutional standards.</p>
        </div>
        <div class="focus-f-body">
          <div class="focus-c-panels">
            <article class="focus-c-kpi">
              <p class="focus-c-kpi-value">01 | Development</p>
              <h3>Full-Cycle Project Development</h3>
              <p>From initial feasibility to final delivery, we provide end-to-end execution that transforms strategic land acquisitions into institutional-grade assets.</p>
            </article>
            <article class="focus-c-kpi">
              <p class="focus-c-kpi-value">02 | Access</p>
              <h3>Local Network &amp; Exclusive Access</h3>
              <p>Direct relationships with landowners, advisors, and Andorran operators unlock secure high-value, off-market opportunities before they reach the public sector.</p>
            </article>
            <article class="focus-c-kpi">
              <p class="focus-c-kpi-value">03 | Compliance</p>
              <h3>Regulatory Expertise</h3>
              <p>We navigate the Principality’s compliance landscape, translating local regulations into executable investment strategies through deep-rooted jurisdictional expertise.</p>
            </article>
            <article class="focus-c-kpi">
              <p class="focus-c-kpi-value">04 | Capital</p>
              <h3>Institutional Capital Bridging</h3>
              <p>We provide the structural bridge that allows international firms to deploy capital into Andorra without compromising on institutional standards.</p>
            </article>
          </div>
          <div class="focus-c-media" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <section class="test-image-break" aria-label="Andorra night landscape">
      <div class="test-image-title-wrap">
        <h2 class="test-image-title">
          We open the door to Andorra’s high-barrier investment landscape, bridging the gap between global capital and Andorran opportunity.
        </h2>
      </div>
    </section>

    <section class="section projects" id="partners">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">Featured Developments</p>
          <h2>View our current property developments</h2>
          <p class="intro">Balanced proof architecture: demonstrated execution plus visible momentum.</p>
        </div>
        <div class="project-grid">
          {
            projects.map((project) => (
              <article class="project-card">
                <img src={project.image} alt={project.name} />
                <div class="project-meta">
                  <h3>{project.name}</h3>
                  <div class="metrics">
                    <span class="pill">Value: {project.value}</span>
                    <span class="pill">Status: {project.status}</span>
                    <span class="pill">Sector: {project.sector}</span>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <a class="cta-link" href="#">View All Projects</a>
      </div>
    </section>

    <section class="section" id="team">
      <div class="container">
        <p class="eyebrow">Leadership Bench</p>
        <div class="leaders">
          <div class="leaders-image">
            <img
              src="/01_stone%20copy.jpg"
              alt="Equity Partners leadership"
            />
          </div>
          <div class="leaders-copy">
            <blockquote>
              "In Andorra, trust and execution move together. Our commitment is to deliver projects that strengthen the Principality while protecting investor confidence."
            </blockquote>
            <p class="leaders-note">Equity Partners core leadership team</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section gateway" id="contact">
      <div class="container">
        <p class="eyebrow">Investor Gateway</p>
        <h2>Ready to invest in Andorra?</h2>
        <p class="intro">
          Schedule a confidential consultation with our team to explore aligned opportunities in the Principality.
        </p>
        <div class="gateway-box">
          <p>
            Additional opportunities and detailed project materials are shared directly during private investor conversations.
          </p>
          <a class="button" href="#">Schedule Confidential Consultation</a>
        </div>
      </div>
    </section>

    <section class="section newsletter" id="newsletter">
      <div class="container">
        <p class="eyebrow">Newsletter</p>
        <div class="newsletter-wrap">
          <div class="newsletter-copy">
            <h2>Stay informed on Andorra opportunities.</h2>
            <p>Get concise updates on market shifts, pipeline milestones, and investor-relevant developments.</p>
          </div>
          <form
            class="newsletter-form"
            name="newsletter-signup"
            data-netlify="true"
            action="#"
            method="post"
          >
            <input type="hidden" name="form-name" value="newsletter-signup" />
            <label class="sr-only" for="newsletter-email">Email address</label>
            <input
              class="newsletter-input"
              id="newsletter-email"
              name="email"
              type="email"
              placeholder="Enter your email"
              required
            />
            <button class="newsletter-button" type="submit">Subscribe</button>
          </form>
        </div>
        <p class="newsletter-note">We send selective updates only. No spam.</p>
      </div>
    </section>

    <footer class="footer">
      <div class="footer-top">
        <div class="container footer-grid">
          <div>
            <img
              class="footer-logo"
              src="/images/branding/equity-partners-logo-light%20small.png"
              alt="Equity Partners Andorra Property Group"
            />
            <a class="footer-cta" href="/contact">Explore Opportunities</a>
          </div>

          <div>
            <h3 class="footer-heading">Equity Partners</h3>
            <ul class="footer-list">
              <li><a class="footer-link" href="/#about">About</a></li>
              <li><a class="footer-link" href="/#team">Team</a></li>
              <li><a class="footer-link" href="/partners">Partners</a></li>
              <li><a class="footer-link" href="/#partners">Projects</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer-heading">Resources</h3>
            <ul class="footer-list">
              <li><a class="footer-link" href="/blog">Blog</a></li>
              <li><a class="footer-link" href="#">Market Reports</a></li>
              <li><a class="footer-link" href="#">Investment Guides</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer-heading">Contact</h3>
            <p class="footer-meta">
              Av. Meritxell 95, AD500 Andorra la Vella<br />
              +376 000 000<br />
              info@equitypartnersandorra.com<br />
              SL Reg. No. L-12345-6
            </p>
          </div>
        </div>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-bottom">
        <div class="container footer-bottom-row">
          <p class="footer-copy">© {currentYear} EQUITY PARTNERS. All rights reserved.</p>
          <div class="footer-legal">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Use</a>
            <a href="#">Disclaimer</a>
          </div>
          <div class="footer-social">
            <a class="social-pill" href="#" aria-label="LinkedIn">in</a>
            <a class="social-pill" href="#" aria-label="X">X</a>
            <a class="social-pill" href="#" aria-label="YouTube">▶</a>
            <a class="social-pill" href="#" aria-label="Instagram">IG</a>
          </div>
        </div>
      </div>
    </footer>
    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>

  </body>
</html>
