    .seg-thumb { view-transition-name: tab-thumb; }
    /* The active label is named too, and comes later in the DOM, so its snapshot
       is painted ABOVE the thumb's. Without this the sliding pill passes over
       the white label instead of carrying it. */
    .seg-btn.active { view-transition-name: tab-label; }
    .seg-btn {
