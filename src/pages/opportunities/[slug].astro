const t = copy[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={`${opp.name} | ${t.seoTitleMid} | Equity Partners`}
      description={opp.tagline}
      locale={locale}
      path={Astro.url.pathname}
      breadcrumb={[
        { name: t.breadcrumbHome, path: "/" },
        { name: t.breadcrumbOpportunities, path: "/opportunities" },
        { name: opp.name, path: `/opportunities/${opp.slug}` },
      ]}
    />
    <link rel="icon" type="image/png" href="/EP favicon.png" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --navy: #0f1a2a;
        --green: #53b27f;
        --green-dark: #3f9568;
        --amber: #d97447;
        --blue: #4a90d9;
        --line: #dce3ee;
        --text: #172235;
        --muted: #5a667a;
        --surface: #f7f9fc;
        --font: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: #fff;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
      }

      /* ── Hero ── */
      .opp-hero {
        position: relative;
        background: var(--navy);
        overflow: hidden;
        min-height: 520px;
        display: flex;
        flex-direction: column;
      }

      .opp-hero-image {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .opp-hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .opp-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(15, 26, 42, 0.55) 0%,
          rgba(15, 26, 42, 0.72) 60%,
          rgba(15, 26, 42, 0.92) 100%
        );
        z-index: 1;
      }

      .opp-hero-content {
        position: relative;
        z-index: 2;
        margin-top: auto;
        padding: 9rem 0 3.5rem;
      }

      .opp-hero-meta {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }

      .opp-hero-eyebrow {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--green);
      }

      .opp-hero-chip {
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: #fff;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        line-height: 1;
      }

      .opp-hero-chip.is-muted {
        color: #d9e3f2;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      .opp-hero h1 {
        font-size: clamp(2rem, 4.5vw, 3.4rem);
        font-weight: 800;
        color: #fff;
        margin: 0 0 0.8rem;
        line-height: 1.08;
        letter-spacing: -0.01em;
        max-width: 760px;
      }

      .opp-hero-tagline {
        font-size: 1rem;
        color: rgba(214, 224, 240, 0.8);
        margin: 0;
        max-width: 640px;
        line-height: 1.65;
      }

      /* ── Key metrics strip ── */
      .opp-metrics-strip {
        background: #f2f5fa;
        border-bottom: 1px solid var(--line);
        padding: 1.6rem 0;
      }

      .opp-metrics-inner {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
      }

      .opp-metric-item {
        flex: 1;
        min-width: 130px;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0.4rem 1.6rem 0.4rem 0;
      }

      .opp-metric-item:last-child {
        padding-right: 0;
        padding-left: 1.6rem;
      }

      .opp-metric-item:first-child {
        padding-left: 0;
      }

      .opp-metric-value {
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--navy);
        line-height: 1.1;
      }

      .opp-metric-value.is-green {
        color: var(--green);
      }

      .opp-metric-label {
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ── Breadcrumb ── */
      .opp-breadcrumb {
        padding: 1.2rem 0;
        border-bottom: 1px solid var(--line);
      }

      .opp-breadcrumb-inner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        color: var(--muted);
      }

      .opp-breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        transition: color 180ms ease;
      }

      .opp-breadcrumb a:hover {
        color: var(--green);
      }

      .opp-breadcrumb-sep {
        color: var(--line);
      }

      .opp-breadcrumb-current {
        color: var(--text);
        font-weight: 600;
      }

      /* ── Main layout ── */
      .opp-body {
        padding: 4rem 0 6rem;
      }

      .opp-body-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 3rem;
        align-items: start;
      }

      .opp-section {
        margin-bottom: 3rem;
      }

      .opp-section:last-child {
        margin-bottom: 0;
      }

      .opp-section-label {
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--green);
        margin: 0 0 0.8rem;
      }

      .opp-section h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 1rem;
        line-height: 1.25;
      }

      .opp-section p {
        font-size: 0.93rem;
        color: var(--muted);
        line-height: 1.75;
        margin: 0 0 1rem;
      }

      .opp-section p:last-child {
        margin-bottom: 0;
      }

      /* ── Highlights ── */
      .opp-highlights {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .opp-highlights li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: var(--text);
        line-height: 1.55;
      }

      .opp-highlights li::before {
        content: "";
        display: block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--green);
        flex-shrink: 0;
        margin-top: 0.5em;
      }

      /* ── Risks ── */
      .opp-risks {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
      }

      .opp-risks li {
        position: relative;
        padding-left: 1.7rem;
        font-size: 0.88rem;
        color: var(--text);
        line-height: 1.6;
      }

      .opp-risks li::before {
        content: "!";
        position: absolute;
        left: 0;
        top: 0.1rem;
        width: 1.1rem;
        height: 1.1rem;
        font-size: 0.65rem;
        font-weight: 800;
        color: #fff;
        background: var(--amber);
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      /* ── DD pack ── */
      .opp-doc-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
      }

      .opp-doc-grid li {
        font-size: 0.85rem;
        padding: 0.7rem 0.95rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 0.6rem;
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      .opp-doc-grid li::before {
        content: "";
        width: 0.85rem;
        height: 1.05rem;
        background: var(--green);
        clip-path: polygon(0 0, 70% 0, 100% 30%, 100% 100%, 0 100%);
        flex-shrink: 0;
      }

      /* ── Breakdown (use of funds, capital stack) ── */
      .opp-breakdown {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }

      .opp-breakdown-row {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }

      .opp-breakdown-top {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
      }

      .opp-breakdown-top .label {
        color: var(--text);
        font-weight: 600;
      }

      .opp-breakdown-top .pct {
        color: var(--muted);
        font-weight: 700;
      }

      .opp-breakdown-bar {
        width: 100%;
        height: 6px;
        background: #ecf1f7;
        border-radius: 999px;
        overflow: hidden;
      }

      .opp-breakdown-fill {
        height: 100%;
        border-radius: 999px;
      }

      .opp-breakdown-note {
        font-size: 0.75rem;
        color: var(--muted);
        font-style: italic;
        margin-top: 0.2rem;
      }

      /* ── Milestones (reuse project pattern) ── */
      .opp-milestones {
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
      }

      .opp-milestone {
        display: flex;
        gap: 1.2rem;
        align-items: flex-start;
        padding-bottom: 1.6rem;
        position: relative;
      }

      .opp-milestone:last-child {
        padding-bottom: 0;
      }

      .opp-milestone-track {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        width: 20px;
      }

      .opp-milestone-dot {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--line);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        z-index: 1;
      }

      .opp-milestone-dot.is-done {
        background: var(--green);
        border-color: var(--green);
      }

      .opp-milestone-dot.is-done svg {
        display: block;
      }

      .opp-milestone-dot svg {
        display: none;
        width: 10px;
        height: 10px;
        stroke: #fff;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .opp-milestone-line {
        flex: 1;
        width: 2px;
        background: var(--line);
        margin-top: 2px;
      }

      .opp-milestone:last-child .opp-milestone-line {
        display: none;
      }

      .opp-milestone-content {
        padding-top: 0.1rem;
        flex: 1;
      }

      .opp-milestone-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--navy);
        margin: 0 0 0.15rem;
      }

      .opp-milestone-label.is-done {
        color: var(--muted);
        text-decoration: line-through;
        text-decoration-color: rgba(90, 102, 122, 0.4);
      }

      .opp-milestone-date {
        font-size: 0.72rem;
        color: var(--muted);
        font-weight: 500;
      }

      /* ── Gallery ── */
      .opp-gallery {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
      }

      .opp-gallery img {
        width: 100%;
        aspect-ratio: 4/3;
        object-fit: cover;
        border-radius: 0.7rem;
        display: block;
      }

      .opp-gallery img:first-child {
        grid-column: 1 / -1;
        aspect-ratio: 16/7;
      }

      /* ── Sidebar ── */
      .opp-sidebar {
        position: sticky;
        top: 5.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .opp-sidebar-card {
        border: 1px solid var(--line);
        border-radius: 1rem;
        overflow: hidden;
        background: #fff;
      }

      .opp-sidebar-card-header {
        padding: 1.2rem 1.4rem;
        border-bottom: 1px solid var(--line);
        background: #f8fafd;
      }

      .opp-sidebar-card-header h3 {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--navy);
        margin: 0;
      }

      .opp-sidebar-card-body {
        padding: 1.2rem 1.4rem;
      }

      .opp-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f0f4fa;
        font-size: 0.8rem;
      }

      .opp-detail-row:first-child {
        padding-top: 0;
      }

      .opp-detail-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }

      .opp-detail-key {
        color: var(--muted);
        font-weight: 500;
        white-space: nowrap;
      }

      .opp-detail-val {
        color: var(--navy);
        font-weight: 700;
        text-align: right;
      }

      .opp-detail-val.is-green {
        color: var(--green);
      }

      .opp-detail-val.is-small {
        font-size: 0.72rem;
      }

      /* Funding progress inside sidebar */
      .opp-sidebar-progress {
        padding: 1.2rem 1.4rem;
        border-top: 1px solid var(--line);
        background: #f8fafd;
      }

      .opp-sidebar-progress-top {
        display: flex;
        justify-content: space-between;
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 0.5rem;
      }

      .opp-sidebar-progress-top strong {
        color: var(--navy);
      }

      .opp-sidebar-progress-bar {
        width: 100%;
        height: 6px;
        background: #e6ecf4;
        border-radius: 999px;
        overflow: hidden;
      }

      .opp-sidebar-progress-fill {
        height: 100%;
        background: var(--green);
        border-radius: 999px;
      }

      .opp-sidebar-progress-meta {
        margin-top: 0.5rem;
        font-size: 0.7rem;
        color: var(--muted);
      }

      /* ── CTA card ── */
      .opp-cta-card {
        background: var(--navy);
        border-radius: 1rem;
        padding: 1.8rem 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .opp-cta-card h3 {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        line-height: 1.3;
      }

      .opp-cta-card p {
        font-size: 0.8rem;
        color: rgba(214, 224, 240, 0.7);
        margin: 0;
        line-height: 1.6;
      }

      .opp-cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1.4rem;
        background: var(--green);
        border: 1px solid var(--green);
        color: #fff;
        border-radius: 0.55rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
      }

      .opp-cta-btn:hover {
        background: var(--green-dark);
        border-color: var(--green-dark);
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(15, 60, 35, 0.28);
      }

      .opp-cta-btn svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Regulatory note ── */
      .opp-reg-note {
        background: #fff7ec;
        border-left: 3px solid var(--amber);
        border-radius: 0.5rem;
        padding: 1rem 1.2rem;
        font-size: 0.82rem;
        color: var(--text);
        line-height: 1.65;
      }

      .opp-reg-note strong {
        color: var(--navy);
      }

      /* ── Back link ── */
      .opp-back-section {
        padding: 3rem 0 0;
        border-top: 1px solid var(--line);
        margin-top: 3rem;
      }

      .opp-back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green);
        text-decoration: none;
        transition: gap 180ms ease;
      }

      .opp-back-link:hover {
        gap: 0.75rem;
      }

      .opp-back-link svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Animations ── */
      [data-animate] {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 580ms ease, transform 580ms ease;
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* ── Responsive ── */
      @media (max-width: 900px) {
        .opp-body-grid { grid-template-columns: 1fr; }
        .opp-sidebar { position: static; }

        .opp-metrics-inner { gap: 1rem; }
        .opp-metric-item {
          border-right: none;
          padding: 0.6rem 0;
          border-bottom: 1px solid var(--line);
          min-width: calc(50% - 0.5rem);
          flex: none;
          width: calc(50% - 0.5rem);
        }

        .opp-metric-item:last-child {
          border-bottom: none;
          padding-left: 0;
        }

        .opp-metric-item:first-child {
          padding-left: 0;
        }

        .opp-doc-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 560px) {
        .opp-gallery { grid-template-columns: 1fr; }
        .opp-gallery img:first-child { aspect-ratio: 4/3; }
        .opp-metric-item { width: 100%; min-width: 100%; }
      }

      /* ────────────────────────────────────────────────────────────
         Variation 1 — Redesign of the metrics strip (currently scoped
         to ordino-lodge-resort for review). Matches the styling of
         the stats card on the opportunities listing page.
         ──────────────────────────────────────────────────────────── */
      .opp-metrics-strip.is-redesign {
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        padding: 2.2rem 0;
        border-bottom: none;
      }

      .opp-metrics-strip.is-redesign .opp-metrics-inner {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
      }

      .opp-metrics-strip.is-redesign .opp-metric-item {
        flex: none;
        min-width: 0;
        width: auto;
        padding: 1.4rem 1.6rem;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 0.35rem;
        border-right: 1px solid var(--line);
        border-bottom: none;
        transition: background 320ms ease;
      }

      .opp-metrics-strip.is-redesign .opp-metric-item:first-child {
        padding-left: 1.6rem;
      }

      .opp-metrics-strip.is-redesign .opp-metric-item:last-child {
        border-right: none;
        padding-left: 1.6rem;
        padding-right: 1.6rem;
      }

      .opp-metrics-strip.is-redesign .opp-metric-item:hover {
        background: rgba(83, 178, 127, 0.05);
      }

      .opp-metrics-strip.is-redesign .opp-metric-value {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1;
      }

      .opp-metrics-strip.is-redesign .opp-metric-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.18em;
      }

      @media (max-width: 820px) {
        .opp-metrics-strip.is-redesign .opp-metrics-inner {
          grid-template-columns: 1fr 1fr;
        }
        .opp-metrics-strip.is-redesign .opp-metric-item {
          border-bottom: 1px solid var(--line);
        }
        .opp-metrics-strip.is-redesign .opp-metric-item:nth-child(2n) {
          border-right: none;
        }
        .opp-metrics-strip.is-redesign .opp-metric-item:nth-last-child(-n+2) {
          border-bottom: none;
        }
      }

      @media (max-width: 560px) {
        .opp-metrics-strip.is-redesign .opp-metrics-inner {
          grid-template-columns: 1fr;
        }
        .opp-metrics-strip.is-redesign .opp-metric-item {
          border-right: none !important;
          border-bottom: 1px solid var(--line);
          width: 100%;
        }
        .opp-metrics-strip.is-redesign .opp-metric-item:last-child {
          border-bottom: none;
        }
      }

      /* Darker section-separator borders — applied to all detail pages */
      .opp-metrics-strip.has-dark-borders {
        border-bottom: 1px solid rgba(15, 26, 42, 0.2);
      }

      .opp-breadcrumb.has-dark-borders {
        border-bottom-color: rgba(15, 26, 42, 0.2);
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader
      menuToggleId="mobile-menu-toggle"
      offsetFirstSection={false}
      locale={locale}
      currentPath={Astro.url.pathname}
    />

    <!-- Hero -->
    <section class="opp-hero">
      <div class="opp-hero-image">
        <img src={opp.image} alt={opp.name} fetchpriority="high" />
      </div>
      <div class="opp-hero-overlay"></div>
      <div class="opp-hero-content">
        <div class="container">
          <div class="opp-hero-meta">
            <span class="opp-hero-eyebrow">{opp.parish} · Andorra</span>
            <span
              class="opp-hero-chip"
              style={`background: ${opportunityStatusColour[opp.status]}`}
            >
              {t.statusFull[opp.status]}
            </span>
            <span
              class="opp-hero-chip"
              style={`background: ${riskProfileColour[opp.riskProfile]}`}
            >
              {opp.riskProfile}
            </span>
            <span class="opp-hero-chip is-muted">{opp.sector}</span>
          </div>
          <h1>{opp.name}</h1>
          <p class="opp-hero-tagline">{opp.tagline}</p>
        </div>
      </div>
    </section>

    <!-- Key metrics strip -->
    <div class="opp-metrics-strip is-redesign has-dark-borders">
      <div class="container">
        <div class="opp-metrics-inner">
          <div class="opp-metric-item">
            <span class="opp-metric-value is-green">{opp.equityRaise}</span>
            <span class="opp-metric-label">{t.metricEquityRaise}</span>
          </div>
          <div class="opp-metric-item">
            <span class="opp-metric-value">{opp.totalProjectValue}</span>
            <span class="opp-metric-label">{t.metricProjectValue}</span>
          </div>
          <div class="opp-metric-item">
            <span class="opp-metric-value">{opp.sqm}</span>
            <span class="opp-metric-label">{t.metricBuildableArea}</span>
          </div>
          <div class="opp-metric-item">
            <span class="opp-metric-value">{opp.holdPeriod}</span>
            <span class="opp-metric-label">{t.metricHoldPeriod}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Breadcrumb -->
    <div class="opp-breadcrumb has-dark-borders">
      <div class="container">
        <div class="opp-breadcrumb-inner">
          <a href={buildLocalizedPath("/", locale)}>{t.breadcrumbHome}</a>
          <span class="opp-breadcrumb-sep">/</span>
          <a href={buildLocalizedPath("/opportunities", locale)}>{t.breadcrumbOpportunities}</a>
          <span class="opp-breadcrumb-sep">/</span>
          <span class="opp-breadcrumb-current">{opp.name}</span>
        </div>
      </div>
    </div>

    <!-- Body -->
    <section class="opp-body">
      <div class="container">
        <div class="opp-body-grid">

          <!-- Left column -->
          <div class="opp-main">

            <!-- Gallery -->
            <div class="opp-section" data-animate>
              <div class="opp-gallery">
                {opp.gallery.map((src, i) => (
                  <img
                    src={src}
                    alt={`${opp.name} — ${t.galleryImageWord} ${i + 1}`}
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                ))}
              </div>
            </div>

            <!-- Description -->
            <div class="opp-section" data-animate>
              <p class="opp-section-label">{t.overviewLabel}</p>
              <h2>{t.overviewTitle}</h2>
              <p>{opp.description}</p>
            </div>

            <!-- Investment thesis -->
            <div class="opp-section" data-animate>
              <p class="opp-section-label">{t.thesisLabel}</p>
              <h2>{t.thesisTitle}</h2>
              <p>{opp.investmentThesis}</p>
            </div>

            <!-- Highlights -->
            <div class="opp-section" data-animate>
              <p class="opp-section-label">{t.highlightsLabel}</p>
              <h2>{t.highlightsTitle}</h2>
              <ul class="opp-highlights">
                {opp.highlights.map((h) => <li>{h}</li>)}
              </ul>
            </div>

            <!-- Use of funds -->
            <div class="opp-section" data-animate>
              <p class="opp-section-label">{t.useOfFundsLabel}</p>
              <h2>{t.useOfFundsTitle}</h2>
              <div class="opp-breakdown">
                {opp.useOfFunds.map((entry) => (
                  <div class="opp-breakdown-row">
                    <div class="opp-breakdown-top">
                      <span class="label">{entry.label}</span>
                      <span class="pct">{entry.percentage}%</span>
                    </div>
                    <div class="opp-breakdown-bar">
                      <div
                        class="opp-breakdown-fill"
                        style={`width: ${entry.percentage}%; background: var(--green);`}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Capital structure / Capital stack — hidden for now (easy to restore).
            <div class="opp-section" data-animate>
              <p class="opp-section-label">Capital structure</p>
              <h2>Capital stack</h2>
              <div class="opp-breakdown">
                {opp.capitalStack.map((entry) => (
                  <div class="opp-breakdown-row">
                    <div class="opp-breakdown-top">
                      <span class="label">{entry.label}</span>
                      <span class="pct">{entry.percentage}%</span>
                    </div>
                    <div class="opp-breakdown-bar">
                      <div
                        class="opp-breakdown-fill"
                        style={`width: ${entry.percentage}%; background: var(--navy);`}
                      ></div>
                    </div>
                    {entry.note && <p class="opp-breakdown-note">{entry.note}</p>}
                  </div>
                ))}
              </div>
            </div>
            */}

            <!-- Milestones -->
            <div class="opp-section" data-animate>
              <p class="opp-section-label">{t.milestonesLabel}</p>
              <h2>{t.milestonesTitle}</h2>
              <div class="opp-milestones">
                {opp.milestones.map((m) => (
                  <div class="opp-milestone">
                    <div class="opp-milestone-track">
                      <div class={`opp-milestone-dot${m.done ? " is-done" : ""}`}>
                        <svg viewBox="0 0 12 12">
                          <polyline points="2,6 5,9 10,3" />
                        </svg>
                      </div>
                      <div class="opp-milestone-line"></div>
                    </div>
                    <div class="opp-milestone-content">
                      <p class={`opp-milestone-label${m.done ? " is-done" : ""}`}>{m.label}</p>
                      <span class="opp-milestone-date">{m.date}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Exit strategy -->
            <div class="opp-section" data-animate>
              <p class="opp-section-label">{t.exitLabel}</p>
              <h2>{t.exitTitle}</h2>
              <p>{opp.exitStrategy}</p>
            </div>

            <!-- Regulatory note -->
            <div class="opp-section" data-animate>
              <p class="opp-reg-note">
                <strong>{t.regNoteStrong}</strong> {opp.regulatoryNote}
              </p>
            </div>

            <!-- Back link -->
            <div class="opp-back-section" data-animate>
              <a class="opp-back-link" href={buildLocalizedPath("/opportunities", locale)}>
                <svg viewBox="0 0 24 24"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
                {t.backLink}
              </a>
            </div>

          </div>

          <!-- Right sidebar -->
          <aside class="opp-sidebar">

            <!-- Deal terms card -->
            <div class="opp-sidebar-card" data-animate>
              <div class="opp-sidebar-card-header">
                <h3>{t.dealTermsTitle}</h3>
              </div>
              <div class="opp-sidebar-card-body">
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.suggestedType}</span>
                  <span class="opp-detail-val is-green">{t.structureLabels[opp.structure]}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.headlineReturn}</span>
                  <span class="opp-detail-val">{opp.headlineReturn}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.metricHoldPeriod}</span>
                  <span class="opp-detail-val">{opp.holdPeriod}</span>
                </div>
              </div>

              {/* Funding progress — hidden for now. Keep this block to
                  easily restore it in the future.
              <div class="opp-sidebar-progress">
                <div class="opp-sidebar-progress-top">
                  <span>Funding progress</span>
                  <strong>{opp.fundingProgress}%</strong>
                </div>
                <div class="opp-sidebar-progress-bar">
                  <div
                    class="opp-sidebar-progress-fill"
                    style={`width: ${opp.fundingProgress}%`}
                  ></div>
                </div>
                <p class="opp-sidebar-progress-meta">
                  {opp.amountCommitted} · Closes {opp.fundingDeadline}
                </p>
              </div>
              */}
            </div>

            <!-- Capital raise card -->
            <div class="opp-sidebar-card" data-animate>
              <div class="opp-sidebar-card-header">
                <h3>{t.capitalRaiseTitle}</h3>
              </div>
              <div class="opp-sidebar-card-body">
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.metricProjectValue}</span>
                  <span class="opp-detail-val">{opp.totalProjectValue}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.metricEquityRaise}</span>
                  <span class="opp-detail-val">{opp.equityRaise}</span>
                </div>
                {/* Committed row — hidden for now (easy to restore).
                <div class="opp-detail-row">
                  <span class="opp-detail-key">Committed</span>
                  <span class="opp-detail-val is-small">{opp.amountCommitted}</span>
                </div>
                */}
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.minInvestment}</span>
                  <span class="opp-detail-val">{opp.minInvestment}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.riskProfile}</span>
                  <span class="opp-detail-val">{opp.riskProfile}</span>
                </div>
              </div>
            </div>

            <!-- Asset details card -->
            <div class="opp-sidebar-card" data-animate>
              <div class="opp-sidebar-card-header">
                <h3>{t.assetDetailsTitle}</h3>
              </div>
              <div class="opp-sidebar-card-body">
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.location}</span>
                  <span class="opp-detail-val">{opp.location}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.sector}</span>
                  <span class="opp-detail-val">{opp.sector}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.units}</span>
                  <span class="opp-detail-val is-small">{opp.units}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.grossArea}</span>
                  <span class="opp-detail-val">{opp.sqm}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.storeys}</span>
                  <span class="opp-detail-val">{opp.floors}</span>
                </div>
                <div class="opp-detail-row">
                  <span class="opp-detail-key">{t.planning}</span>
                  <span class="opp-detail-val is-small">{opp.planningStatus}</span>
                </div>
              </div>
            </div>

            <!-- CTA card -->
            <div class="opp-cta-card" data-animate>
              <h3>{t.ctaTitle}</h3>
              <p>{t.ctaBody}</p>
              <a class="opp-cta-btn" href={buildLocalizedPath("/contact", locale)}>
                {t.ctaButton}
                <svg viewBox="0 0 24 24"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              </a>
            </div>
          </aside>

        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId="newsletter-email-opp-detail" locale={locale} />
    <SiteFooter locale={locale} />

    <script type="module">
      const targets = document.querySelectorAll("[data-animate]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
