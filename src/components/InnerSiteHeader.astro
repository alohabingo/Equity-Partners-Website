---
interface Props {
  active?: "about" | "partners" | "blog";
  menuToggleId: string;
}

const { active, menuToggleId } = Astro.props;
---

<header class="site-header">
  <input class="menu-toggle-input" type="checkbox" id={menuToggleId} />
  <label class="menu-toggle" for={menuToggleId} aria-label="Toggle navigation menu">
    <span class="menu-toggle-bars"></span>
  </label>
  <a href="/" aria-label="Go to homepage">
    <img
      class="logo"
      src="/images/branding/equity-partners-logo-light%20small.png"
      alt="Equity Partners logo"
    />
  </a>
  <nav class="main-nav" aria-label="Primary">
    <ul class="menu-list">
      <li><a class="menu-link" href="/">Home</a></li>
      <li><a class="menu-link" href="/#team">Services</a></li>
      <li><a class:list={["menu-link", active === "about" && "is-active"]} href="/about">About</a></li>
      <li><a class:list={["menu-link", active === "partners" && "is-active"]} href="/partners">Partners</a></li>
      <li><a class:list={["menu-link", active === "blog" && "is-active"]} href="/blog">Blog</a></li>
      <li><a class="menu-link" href="/test">Test</a></li>
    </ul>
    <a class="menu-cta" href="/contact">Contact Us</a>
  </nav>
</header>

<style>
  :global(:root) {
    --inner-page-offset: clamp(5.5rem, 7vw, 6.5rem);
  }

  .site-header,
  .site-header *,
  .site-header *::before,
  .site-header *::after {
    box-sizing: border-box;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 1.8rem;
    padding-top: 2.15rem;
    padding-bottom: 0.15rem;
    padding-left: calc((100vw - min(1120px, 92vw)) / 2);
    padding-right: calc((100vw - min(1120px, 92vw)) / 2);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    transform: none;
    width: 100%;
    z-index: 220;
    background: rgba(15, 26, 42, 0.92);
    border-bottom: 1px solid transparent;
    border-radius: 0;
    transition:
      padding-top 320ms ease,
      padding-bottom 320ms ease,
      background-color 320ms ease,
      backdrop-filter 320ms ease,
      -webkit-backdrop-filter 320ms ease,
      border-color 320ms ease,
      box-shadow 320ms ease;
  }

  .site-header + :global(section) {
    margin-top: var(--inner-page-offset);
  }

  :global(body.is-scrolled) .site-header {
    background: rgba(15, 26, 42, 0.6);
    padding-top: 1.25rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom-color: rgba(220, 231, 246, 0.2);
    box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
  }

  :global(body.is-scrolled) .menu-cta {
    background: #53b27f;
    border-color: #53b27f;
  }

  :global(body.is-scrolled) .logo {
    top: -5px;
  }

  :global(body.is-scrolled) .main-nav {
    top: -4px;
  }

  .logo {
    width: 180px;
    height: auto;
    position: relative;
    top: -12px;
    filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
    transition: top 320ms ease, margin-top 320ms ease;
  }

  .main-nav {
    display: flex;
    align-items: center;
    margin-left: auto;
    flex-wrap: nowrap;
    gap: 1.3rem;
    position: relative;
    top: -11px;
    z-index: 121;
    transition: top 320ms ease;
  }

  .menu-toggle-input {
    display: none;
  }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0.45rem;
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: top 320ms ease;
  }

  .menu-toggle-bars {
    display: block;
    width: 18px;
    height: 2px;
    background: #ffffff;
    position: relative;
    transition: background 220ms ease;
  }

  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: #ffffff;
    transition: transform 220ms ease, top 220ms ease;
  }

  .menu-toggle-bars::before {
    top: -6px;
  }

  .menu-toggle-bars::after {
    top: 6px;
  }

  .menu-list {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    white-space: nowrap;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  .menu-link:hover,
  .menu-link.is-active {
    color: #d7e3f5;
  }

  .menu-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    top: 1px;
    flex: 0 0 auto;
    min-width: 126px;
    color: #ffffff;
    background: #53b27f;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    border-radius: 0.45rem;
    padding: 0.65rem 0.95rem;
    font-weight: 600;
    line-height: 1;
    border: 1px solid #53b27f;
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      transform 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .menu-cta:hover {
    background: #3f9568;
    border-color: #3f9568;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
  }

  .menu-cta:focus-visible {
    outline: 2px solid rgba(216, 227, 242, 0.5);
    outline-offset: 3px;
  }

  @supports not ((backdrop-filter: blur(1px))) {
    :global(body.is-scrolled) .site-header {
      background: rgba(15, 26, 42, 0.84);
    }
  }

  @media (max-width: 980px) {
    .site-header {
      gap: 0.65rem;
      min-height: 44px;
    }

    :global(body.is-scrolled) .site-header {
      padding-top: 2.15rem;
      padding-bottom: 0.65rem;
    }

    .main-nav {
      position: static;
      gap: 0.55rem;
    }

    .menu-toggle {
      display: inline-flex;
      position: relative;
      top: -4px;
      border: 0;
      box-shadow: none;
    }

    .menu-list {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: max(0.8rem, calc((100vw - min(1120px, 92vw)) / 2));
      right: auto;
      min-width: min(220px, calc(100vw - 2rem));
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      padding: 0;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-8px);
      pointer-events: none;
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid #d3ddea;
      border-radius: 0.6rem;
      transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
      z-index: 220;
    }

    .menu-toggle-input:checked ~ .main-nav .menu-list {
      max-height: 320px;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
      padding: 0.7rem;
    }

    .menu-list .menu-link {
      color: #172235;
      text-shadow: none;
    }

    .menu-list .menu-link:hover,
    .menu-list .menu-link.is-active {
      color: #5e7393;
    }

    .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars {
      background: transparent;
    }

    .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::before {
      top: 0;
      transform: rotate(45deg);
    }

    .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::after {
      top: 0;
      transform: rotate(-45deg);
    }

    .menu-link {
      font-size: 0.7rem;
    }

    .menu-cta {
      display: inline-flex;
      top: -4px;
      min-width: 102px;
      padding: 0.58rem 0.8rem;
      font-size: 0.68rem;
    }
  }

  @media (max-width: 680px) {
    .site-header {
      gap: 0.45rem;
    }

    .logo {
      width: min(34vw, 170px);
      height: auto;
      position: static;
      top: auto;
      transform: none;
      margin-left: 0.9rem;
      margin-top: -14px;
    }
  }
</style>
