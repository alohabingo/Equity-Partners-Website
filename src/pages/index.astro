      }

      .timeline-v2-step-icon svg {
        width: 2rem;
        height: 2rem;
        stroke: #ffffff;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: stroke 220ms ease;
