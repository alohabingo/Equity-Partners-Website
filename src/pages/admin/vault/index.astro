---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseServer } from "../../../lib/supabase";
import { emailLinkOrigin } from "../../../lib/siteUrl";

const supabase = supabaseServer(Astro.cookies, Astro.request);

const { data: docs } = await supabase
  .from("documents")
  .select("id, title, category, storage_path, file_size, mime_type, created_at")
  .order("created_at", { ascending: false });

const { data: links } = await supabase
  .from("document_links")
  .select("id, document_id, token, label, expires_at, max_views, view_count, revoked, created_at")
  .order("created_at", { ascending: false });

const linksByDoc = new Map<string, NonNullable<typeof links>>();
for (const l of links ?? []) {
  const arr = linksByDoc.get(l.document_id) ?? [];
  arr.push(l);
  linksByDoc.set(l.document_id, arr);
}

const CATEGORIES = [
  ["pitch_deck", "Pitch deck"],
  ["quarterly_report", "Quarterly report"],
  ["fund_summary", "Fund summary"],
  ["general", "General"],
];
const catLabel = (k: string) => CATEGORIES.find(([c]) => c === k)?.[1] ?? k;

const fmtSize = (b: number | null) =>
  b == null ? "—" : b > 1048576 ? (b / 1048576).toFixed(1) + " MB" : Math.round(b / 1024) + " KB";
const dateFmt = new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" });
// A vault link is copied out and sent to an investor, so it must be the
// public address even when this page is being served by the dev server.
const siteOrigin = emailLinkOrigin(Astro.url.origin, import.meta.env.PUBLIC_SITE_URL);

const linkState = (l: { revoked: boolean; expires_at: string; max_views: number | null; view_count: number }) =>
  l.revoked ? "revoked"
  : new Date(l.expires_at).getTime() < Date.now() ? "expired"
  : l.max_views !== null && l.view_count >= l.max_views ? "used up"
  : "active";
---

<AdminLayout title="Document Vault" active="vault">
  <div class="page-head">
    <h1>Document Vault</h1>
    <p>Confidential files, shared only through expiring trackable links.</p>
  </div>

  <form class="upload-form" method="post" action="/api/admin/vault" enctype="multipart/form-data">
    <input type="hidden" name="action" value="upload" />
    <input class="in" type="file" name="file" required />
    <input class="in grow" type="text" name="title" placeholder="Title (defaults to filename)" />
    <select class="in" name="category">
      {CATEGORIES.map(([k, label]) => <option value={k}>{label}</option>)}
    </select>
    <button class="btn" type="submit">Upload</button>
  </form>

  {(!docs || docs.length === 0) ? (
    <p class="empty">No documents yet. Upload the first one above.</p>
  ) : (
    <div class="docs">
      {docs.map((doc) => (
        <section class="doc">
          <header class="doc-head">
            <div>
              <h2>{doc.title}</h2>
              <p class="muted">
                {catLabel(doc.category)} · {fmtSize(doc.file_size)} · uploaded {dateFmt.format(new Date(doc.created_at))}
              </p>
            </div>
            <form method="post" action="/api/admin/vault" onsubmit="return confirm('Delete this document and all its links?')">
              <input type="hidden" name="action" value="delete_doc" />
              <input type="hidden" name="id" value={doc.id} />
              <button class="link-btn danger" type="submit">Delete</button>
            </form>
          </header>

          <form class="link-form" method="post" action="/api/admin/vault">
            <input type="hidden" name="action" value="create_link" />
            <input type="hidden" name="document_id" value={doc.id} />
            <input class="in grow" type="text" name="label" placeholder="Label (e.g. Sent to Marc @ AcmeVC)" />
            <label class="mini">Expires in
              <select class="in" name="expires_days">
                <option value="7">7 days</option>
                <option value="14">14 days</option>
                <option value="30">30 days</option>
                <option value="90">90 days</option>
              </select>
            </label>
            <label class="mini">Max views
              <input class="in narrow" type="number" name="max_views" min="1" placeholder="∞" />
            </label>
            <button class="btn" type="submit">Create link</button>
          </form>

          {(linksByDoc.get(doc.id) ?? []).length > 0 && (
            <table>
              <thead>
                <tr><th>Link</th><th>Label</th><th>Views</th><th>Expires</th><th>Status</th><th></th></tr>
              </thead>
              <tbody>
                {(linksByDoc.get(doc.id) ?? []).map((l) => {
                  const state = linkState(l);
                  return (
                    <tr>
                      <td>
                        <button class="copy" type="button" data-copy={`${siteOrigin}/d/${l.token}`}>Copy URL</button>
                      </td>
                      <td class="muted">{l.label ?? "—"}</td>
                      <td class="muted">{l.view_count}{l.max_views !== null ? ` / ${l.max_views}` : ""}</td>
                      <td class="muted">{dateFmt.format(new Date(l.expires_at))}</td>
                      <td><span class={`state is-${state.replace(" ", "-")}`}>{state}</span></td>
                      <td>
                        {state === "active" && (
                          <form method="post" action="/api/admin/vault">
                            <input type="hidden" name="action" value="revoke_link" />
                            <input type="hidden" name="id" value={l.id} />
                            <button class="link-btn danger" type="submit">Revoke</button>
                          </form>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </section>
      ))}
    </div>
  )}

  <style>
    .upload-form, .link-form {
      margin-top: 1.4rem; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;
      background: #ffffff; border: 1px solid #d7deea; border-radius: 1.2rem; padding: 1.15rem 1.3rem;
    }
    .link-form { margin-top: 0.9rem; background: #f8fafd; }
    .in {
      font: inherit; font-size: 0.85rem; padding: 0.5rem 0.7rem;
      border: 1px solid #d5deea; border-radius: 8px; background: #ffffff;
    }
    .in:focus { outline: none; border-color: #53b27f; }
    .grow { flex: 1; min-width: 180px; }
    .narrow { width: 6.6rem; } /* border-box: width now includes padding */
    .mini { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.76rem; font-weight: 600; color: #46586f; }
    .btn {
      font: inherit; font-size: 0.8rem; font-weight: 700; color: #ffffff;
      background: #53b27f; border: 0; border-radius: 8px; padding: 0.55rem 1rem; cursor: pointer;
    }
    .btn:hover { filter: brightness(1.07); }
    .empty { margin-top: 2rem; color: #5c6f88; font-size: 0.92rem; }
    .docs { margin-top: 1.4rem; display: grid; gap: 1.1rem; }
    .doc { background: #ffffff; border: 1px solid #d7deea; border-radius: 1.2rem; padding: 1.7rem 1.8rem; }
    .doc-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .doc-head h2 { font-size: 1.05rem; margin: 0; }
    .muted { color: #7a8ba1; font-size: 0.78rem; margin: 0.25rem 0 0; }
    .link-btn { font: inherit; font-size: 0.78rem; font-weight: 600; background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; color: #3d5a80; }
    .link-btn.danger { color: #a33d3d; }
    table { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 0.9rem; }
    th { text-align: left; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #5c6f88; padding: 0.5rem 0.6rem; border-bottom: 1px solid #e2e8f1; }
    td { padding: 0.55rem 0.6rem; border-bottom: 1px solid #eef2f7; vertical-align: middle; }
    tr:last-child td { border-bottom: 0; }
    .copy {
      font: inherit; font-size: 0.75rem; font-weight: 700; color: #2e7d54;
      background: rgba(83, 178, 127, 0.1); border: 1px solid rgba(83, 178, 127, 0.4);
      border-radius: 6px; padding: 0.3rem 0.6rem; cursor: pointer;
    }
    .copy.copied { background: #53b27f; color: #ffffff; }
    .state { font-size: 0.68rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 999px; }
    .state.is-active { background: rgba(83, 178, 127, 0.14); color: #2e7d54; }
    .state.is-expired, .state.is-used-up { background: rgba(196, 148, 58, 0.16); color: #8a6420; }
    .state.is-revoked { background: rgba(203, 76, 76, 0.12); color: #a33d3d; }
  </style>

  <script>
    document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(btn.dataset.copy || "");
        btn.textContent = "Copied ✓";
        btn.classList.add("copied");
        setTimeout(() => { btn.textContent = "Copy URL"; btn.classList.remove("copied"); }, 1600);
      });
    });
  </script>
</AdminLayout>
