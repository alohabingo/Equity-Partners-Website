---
import InnerSiteHeader from "../../components/InnerSiteHeader.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SEO from "../../components/SEO.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../../lib/i18n";
import {
  opportunityStatusColour,
  riskProfileColour,
  type Opportunity,
} from "../../data/opportunities";
import { supabaseServer } from "../../lib/supabase";

export const prerender = false;

const locale = getLocaleFromUrl(Astro.url) ?? "en";
const { slug } = Astro.params;

const supabase = supabaseServer(Astro.cookies, Astro.request);
const { data: row } = await supabase
  .from("portfolio_items")
  .select("slug, name, data")
  .eq("kind", "opportunity")
  .eq("slug", slug)
  .eq("locale", locale)
  .eq("status", "published")
  .single();

if (!row) return Astro.redirect(buildLocalizedPath("/opportunities", locale));

const opp = { slug: row.slug, name: row.name, ...(row.data as object) } as Opportunity;

