---
import { buildLocalizedPath, withLocalizedHash, type Locale } from "../lib/i18n";
import { getUiTranslations } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const currentYear = new Date().getFullYear();
const { locale } = Astro.props;
const t = getUiTranslations(locale);
---

<footer class="footer">
  <div class="footer-top">
    <div class="container footer-grid">
      <div class="footer-brand">
        <img
          class="footer-logo" loading="lazy"
          src="/images/branding/equity-partners-logo-light%20small.png"
          alt="Equity Partners Andorra Property Group"
        />
        <a class="footer-cta" href={buildLocalizedPath("/opportunities", locale)}>{t.footer.cta}</a>
      </div>

      <div>
        <h3 class="footer-heading">{t.footer.company}</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href={buildLocalizedPath("/about", locale)}>{t.footer.about}</a></li>
          <li><a class="footer-link" href={withLocalizedHash("/about", "#team", locale)}>{t.footer.team}</a></li>
          <li><a class="footer-link" href={buildLocalizedPath("/partners", locale)}>{t.nav.partners}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">{t.footer.resources}</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href={buildLocalizedPath("/projects", locale)}>{t.footer.projects}</a></li>
          <li><a class="footer-link" href={buildLocalizedPath("/opportunities", locale)}>{t.footer.marketReports}</a></li>
          <li><a class="footer-link" href={buildLocalizedPath("/blog", locale)}>{t.nav.blog}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">{t.footer.contact}</h3>
        <div class="footer-meta">
          <div class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"></path>
                <path d="m22 6-10 7L2 6"></path>
              </svg>
            </span>
            <a class="footer-contact-link" href="mailto:info@equitypartners.fund">info@equitypartners.fund</a>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
            </span>
            <a href="https://wa.me/376668842" target="_blank" rel="noopener noreferrer">+376 668 842</a>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10.5c0 6-9 12-9 12s-9-6-9-12a9 9 0 1 1 18 0Z"></path>
                <circle cx="12" cy="10.5" r="3"></circle>
              </svg>
            </span>
            <span>Av. Prat de la Creu 59-65, AD500 <span class="footer-address-city">Andorra la Vella, Andorra</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="footer-bottom">
    <div class="container footer-bottom-row">
      <p class="footer-copy">EQUITY PARTNERS © {currentYear}. {t.footer.rightsReserved}</p>
      <div class="footer-bottom-end">
        <div class="footer-legal">
          <a href={buildLocalizedPath("/privacy-policy", locale)}>{t.footer.privacyPolicy}</a>
          <a href={buildLocalizedPath("/terms-of-use", locale)}>{t.footer.termsOfUse}</a>
          <a href={buildLocalizedPath("/cookie-policy", locale)}>{t.footer.cookies}</a>
          <a class="footer-login" href="/admin/login">{t.footer.login}</a>
        </div>
        <div class="footer-social">
          <a
            class="social-pill"
            href="https://www.linkedin.com/company/equity-partners-fund/?viewAsMember=true"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >in</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0f1a2a;
    color: #d9e3f2;
    font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
  }

  .container {
    width: min(1120px, 92vw);
    margin: 0 auto;
  }

  .footer-top {
    padding: 3rem 0 2.7rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr repeat(3, minmax(0, 1fr));
    gap: 1.7rem;
    align-items: start;
  }

  .footer-grid > div:not(:first-child) {
    justify-self: start;
    text-transform: uppercase;
  }

  .footer-grid > div:not(:first-child) .footer-list {
    justify-items: start;
  }

  .footer-logo {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  .footer-brand {
    width: 220px;
    max-width: 100%;
  }

  .footer-cta {
    display: inline-flex;
    width: auto;
    margin-top: 1.1rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: #53b27f;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
    border-radius: 0.45rem;
    padding: 0.65rem 0.95rem;
    white-space: nowrap;
    border: 1px solid #53b27f;
    transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .footer-cta:hover {
    background: #3f9568;
    border-color: #3f9568;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
  }

  .footer-cta:focus-visible {
    outline: 2px solid rgba(216, 227, 242, 0.5);
    outline-offset: 3px;
  }

  .footer-heading {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #97a9c4;
    font-weight: 600;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-link {
    color: #f3f7fc;
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .footer-link:hover {
    color: #d8e3f2;
  }

  .footer-meta {
    margin: 0;
    color: #f3f7fc;
    font-size: 0.82rem;
    line-height: 1.6;
    text-transform: none;
    display: grid;
    gap: 0.7rem;
  }

  .footer-contact-item {
    display: grid;
    grid-template-columns: 16px 1fr;
    align-items: start;
    gap: 0.6rem;
  }

  .footer-contact-item a {
    color: inherit;
    text-decoration: none;
  }

  .footer-contact-item a:hover {
    text-decoration: underline;
  }

  .footer-contact-icon {
    width: 16px;
    height: 16px;
    color: #53b27f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.08rem;
  }

  .footer-contact-icon svg {
    width: 100%;
    height: 100%;
  }

  .footer-address-city {
    white-space: nowrap;
  }

  .footer-divider {
    border-top: 1px solid rgba(205, 219, 238, 0.2);
  }

  .footer-bottom {
    padding: 1.3rem 0 1.45rem;
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .footer-bottom-end {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
  }

  .footer-copy {
    margin: 0;
    color: #aebcd4;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-legal a {
    color: #c1cee3;
    text-decoration: none;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0 0.85rem;
    position: relative;
    transition: color 220ms ease;
  }

  .footer-legal a:hover {
    color: #ffffff;
  }

  .footer-legal a:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 11px;
    background: rgba(193, 206, 227, 0.35);
  }

  .footer-legal a:first-child {
    padding-left: 0;
  }

  .footer-legal a:last-child {
    padding-right: 0;
  }

  .footer-social {
    display: flex;
    gap: 0.45rem;
  }

  .social-pill {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid rgba(220, 231, 246, 0.34);
    color: #e3ebf8;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    transition: background-color 220ms ease, border-color 220ms ease,
      color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }

  .social-pill:hover {
    background: #53b27f;
    border-color: #53b27f;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(83, 178, 127, 0.32);
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-grid > div:not(:first-child) {
      justify-self: start;
      text-align: left;
      margin-left: 0;
    }

    .footer-grid > div:not(:first-child) .footer-list {
      justify-items: start;
    }

    .footer-bottom-row {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .footer-legal {
      justify-content: flex-start;
    }

    .footer-login {
      display: none;
    }

    .footer-legal a:nth-last-child(2)::after {
      display: none;
    }

    .footer-legal a:nth-last-child(2) {
      padding-right: 0;
    }
  }
</style>
