---
import type { Locale } from "../lib/i18n";
import { getContentTranslations } from "../i18n/content";

interface Props {
  emailInputId?: string;
  locale?: Locale;
}

const { emailInputId = "newsletter-email", locale = "en" } = Astro.props;
const newsletterFormId = `${emailInputId}-form`;
const newsletterMessageId = `${emailInputId}-message`;
const content = getContentTranslations(locale).newsletter;
const newsletterFormName = "newsletter-signup";
---

<section class="newsletter" id="newsletter">
  <div class="container">
    <p class="eyebrow">{content.eyebrow}</p>
    <div class="newsletter-wrap">
      <div class="newsletter-copy">
        <h2>{content.title}</h2>
      </div>
      <div class="newsletter-form-group">
        <form
          class="newsletter-form"
          id={newsletterFormId}
          novalidate
          data-msg-id={newsletterMessageId}
          data-validation-error={content.validationError}
          data-submitting={content.submitting}
          data-success={content.success}
          data-error={content.error}
        >
          <label class="sr-only" for={emailInputId}>{content.emailLabel}</label>
          <input
            class="newsletter-input"
            id={emailInputId}
            name="email"
            type="email"
            placeholder={content.emailPlaceholder}
            autocomplete="email"
            required
          />
          <button class="newsletter-button" type="submit">{content.submit}</button>
        </form>
        <p class="newsletter-status" id={newsletterMessageId} aria-live="polite"></p>
      </div>
    </div>
    <p class="newsletter-note">{content.note}</p>
  </div>
</section>

<script is:inline>
  document.querySelectorAll(".newsletter-form").forEach(function (form) {
    form.addEventListener("submit", async function (event) {
      event.preventDefault();

      var msgId = form.dataset.msgId;
      var message = document.getElementById(msgId);
      var submitButton = form.querySelector('button[type="submit"]');
      var emailInput = form.querySelector('input[name="email"]');
      var emailValue = emailInput ? emailInput.value.trim() : "";

      if (!emailInput || !emailValue || !emailInput.checkValidity()) {
        if (message) { message.textContent = form.dataset.validationError; message.dataset.state = "error"; }
        return;
      }

      if (submitButton) submitButton.setAttribute("disabled", "true");
      if (message) { message.textContent = form.dataset.submitting; message.dataset.state = "pending"; }

      try {
        var response = await fetch(
          "https://api.hsforms.com/submissions/v3/integration/submit/147782273/72429b95-5573-4fe9-a844-22f7ade6f85c",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              fields: [{ name: "email", value: emailValue }],
              context: { pageUri: window.location.href, pageName: document.title },
            }),
          }
        );

        if (!response.ok) throw new Error("status " + response.status);

        form.reset();
        if (message) { message.textContent = form.dataset.success; message.dataset.state = "success"; }
      } catch (err) {
        console.error("HubSpot submission error:", err);
        if (message) { message.textContent = form.dataset.error; message.dataset.state = "error"; }
      } finally {
        if (submitButton) submitButton.removeAttribute("disabled");
      }
    });
  });
</script>

<style>
  .newsletter,
  .newsletter *,
  .newsletter *::before,
  .newsletter *::after {
    box-sizing: border-box;
  }

  .newsletter {
    background: linear-gradient(180deg, #f4f6fa, #eef2f8);
    border-top: 1px solid #dbe1ea;
    border-bottom: 1px solid #dbe1ea;
    padding: 2.5rem 0;
  }

  .container {
    width: min(1120px, 92vw);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8293ae;
  }

  .newsletter-wrap {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.4rem;
    align-items: center;
    width: 100%;
    max-width: 100%;
    background: #ffffff;
    border: 1px solid #d7deea;
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .newsletter-copy h2 {
    margin: 0;
    color: #1f2835;
    font-size: clamp(1.55rem, 3vw, 2.45rem);
    line-height: 1.12;
  }

  .newsletter-copy p {
    margin: 0.7rem 0 0;
    color: #5a667a;
    max-width: 34rem;
  }

  .newsletter-form {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    justify-content: flex-end;
    width: 100%;
    min-width: 0;
  }

  .newsletter-form-group {
    width: 100%;
    min-width: 0;
  }

  .newsletter-input {
    flex: 0 1 360px;
    width: min(360px, 100%);
    max-width: 100%;
    min-width: 0;
    height: 44px;
    border-radius: 0.55rem;
    border: 1px solid #cfd9e7;
    background: #f9fbff;
    padding: 0 0.85rem;
    font-size: 0.92rem;
    color: #1a2433;
    outline: none;
    font-family: inherit;
  }

  .newsletter-input:focus {
    border-color: #9eb0ca;
    box-shadow: 0 0 0 2px rgba(130, 147, 174, 0.18);
  }

  .newsletter-button {
    flex: 0 0 auto;
    height: 44px;
    border: 1px solid #53b27f;
    background: #53b27f;
    color: #ffffff;
    border-radius: 0.55rem;
    padding: 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease, transform 180ms ease, border-color 180ms ease;
  }

  .newsletter-button:hover {
    background: #3f9568;
    border-color: #3f9568;
    transform: translateY(-1px);
  }

  .newsletter-button[disabled] {
    opacity: 0.72;
    cursor: wait;
    transform: none;
  }

  .newsletter-status {
    width: min(360px, 100%);
    margin: 0.35rem 0 0 auto;
    color: #7a889e;
    font-size: 0.78rem;
    min-height: 1.1rem;
    text-align: left;
  }

  .newsletter-status[data-state="success"] {
    color: #3f9568;
  }

  .newsletter-status[data-state="error"] {
    color: #b33a3a;
  }

  .newsletter-note {
    margin: 0.5rem 0 0;
    color: #7a889e;
    font-size: 0.72rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 980px) {
    .newsletter-wrap {
      grid-template-columns: 1fr;
    }

    .newsletter-status {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 680px) {
    .newsletter {
      padding-top: 2.3rem;
    }

    .container {
      width: 100%;
      max-width: none;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .newsletter-form {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .newsletter-input {
      flex-basis: auto;
      width: 100%;
      font-size: 16px;
    }

    .newsletter-button {
      width: 100%;
    }
  }
</style>
