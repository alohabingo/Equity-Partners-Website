              <section class="card">
                <div class="cardhead">
                  <h2 class="sec">{b.name} · {mine.length} unit{mine.length === 1 ? "" : "s"}</h2>
                  {mine.length > 0 && (
                    <span class="hint">{n("sold")} sold · {n("reserved")} reserved · {n("available")} available</span>
                  )}
                </div>
                {mine.length === 0 ? (
                  <p class="empty">No units in this building yet.</p>
                ) : (
                  <UnitRows units={mine} slug={project.slug} buildings={buildings} buyers={buyerOptions} />
                )}
              </section>
            );
          })}

          {unplacedUnits.length > 0 && (
            <section class="card">
              <div class="cardhead">
                <h2 class="sec">
                  {buildings.length > 0 ? "Not placed" : "Units"} · {unplacedUnits.length} unit{unplacedUnits.length === 1 ? "" : "s"}
                </h2>
                {buildings.length > 0 && <span class="hint">give each one a building below</span>}
              </div>
              <UnitRows units={unplacedUnits} slug={project.slug} buildings={buildings} buyers={buyerOptions} />
            </section>
          )}

        </>
      )}
    </div>
  )}

  {tab === "leads" && (
    <div class="tabpane" style="margin-top: 1.4rem">
      {/* One per page, shared by every stage control on it — the list's pill and
          each profile's dropdown. */}
      <LostReasonAsk />

      <LeadRows
        leads={leadRows}
        projects={[{ id: project.id, name: project.name, nav_name: project.nav_name, slug: project.slug }]}
        showProject={false}
      />

      {profiles.map((p) => (
        <LeadProfile
          lead={p.lead}
          project={{ slug: project.slug, name: project.name }}
          events={p.events}
          messages={p.messages}
          notes={p.notes}
          units={units.map((u: any) => ({ id: u.id, code: u.code, state: u.state }))}
          activity={p.activity}
          interest={p.interest.map((x: any) => x.unit_id)}
          parking={parking.map((x) => ({ id: x.id, code: x.code, state: x.state, price: x.price }))}
          parkingInterest={p.parkingInterest.map((x: any) => x.parking_id)}
          people={(profileRes.data ?? []).map((x: any) => ({ id: x.id, name: x.full_name ?? "Someone" }))}
          meId={me?.id ?? null}
          back={(() => {
            const u = new URLSearchParams(Astro.url.search);
            u.delete("lead");
            u.delete("contact_error");
            const q = u.toString();
            return Astro.url.pathname + (q ? `?${q}` : "");
          })()}
        />
      ))}
    </div>
  )}

  {tab === "inbox" && (
    <div class="split tabpane">
      <div class="listcard">
        <div class="segs">
          {SEGMENTS.map((sg) => (
            <a href={inboxHref({ seg: sg.key })} class={sg.key === segment.key ? "on" : ""}>
              {sg.label} · {sg.rows.length}
            </a>
          ))}
        </div>
        <div class="ilist">
          {inboxRows.length === 0 && <p class="nothing">Nothing in this view.</p>}
          {inboxRows.map((e) => (
            <a class:list={["item", { on: e.id === selectedId }]} href={inboxHref({ e: e.id })}>
              <div class="t">
                <b>{e.name}</b>
                <span class={bucketOf(e, now) === "overdue" ? "late" : ""}>{shortAge(e.last_activity_at)}</span>
              </div>
              <p>{plain(e.message, 70) || "—"}</p>
              <div class="tags">
                {e.triage === "pending" && <span class="chip untriaged">decide</span>}
                {e.triage === "rejected" && <span class="chip">{rejectReasonLabel(e.triage_reason).toLowerCase()}</span>}
                {e.triage === "converted" && <span class="chip">{stageLabel(e.stage)}</span>}
                {e.triage === "converted" && e.waiting_on_us === true && (
                  <span class="chip" style="background:rgba(179,38,30,.09);color:#b3261e">waiting on us</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="panel">
        {selected ? (
          <EnquiryPanel
            enquiry={selected}
            messages={messages}
            notes={notes}
            events={events}
            project={{ slug: project.slug, name: project.name, mailbox: project.mailbox }}
            currentUserName={me?.fullName ?? "You"}
            back={selfHref}
            sent={sent}
            sendError={sendError}
            templates={templates}
            documents={documents}
            sentDocs={sentDocs}
            linkViews={linkViews}
          />
        ) : (
          <p class="nothing">Select an enquiry on the left.</p>
        )}
      </div>
    </div>
  )}

  {tab === "templates" && (
    <div class="tabpane" style="margin-top: 1.4rem">
      <section class="card">
        <h2 class="sec">Saved replies</h2>
        <p class="lede">
          Picking one drops it into the composer on the Inbox — nothing is ever sent without someone
          reading it first. These belong to <b>{project.name}</b> alone; editing them changes nothing
          anywhere else. A new project starts from a standard set and then goes its own way.
        </p>
        <ul class="tphint">
          {TEMPLATE_PLACEHOLDERS.map((ph) => (
            <li><code class="tpt">{ph.token}</code> <span>{ph.describes}</span></li>
          ))}
        </ul>
        <p class="tpfoot-note">
          An enquiry with no name simply loses the gap, so a template is safe to write as though everyone
          gave one. Anything else in double braces is left sitting in the composer, where it is obvious
          enough to catch before sending.
        </p>
      </section>

      {templates.length === 0 && (
        <section class="card"><p class="lede">No templates yet. Add one below, then write it in each language.</p></section>
      )}

      {templates.map((t, i) => {
        const has = writtenIn(t);
        return (
          <section class="card">
            <form method="post" action="/api/admin/reply-templates">
              {/* `action` rides on the BUTTONS, not a hidden field, so both of
                  them post whatever is in the boxes right now. Saving as a
                  starter without first saving the edit would quietly promote the
                  previous version — the one nobody is looking at. */}
              <input type="hidden" name="id" value={t.id} />
              <input type="hidden" name="slug" value={project.slug} />

              <div class="tphead">
                <input class="in tpname" type="text" name="name" value={t.name} required aria-label="Template name" />
                <div class="tpchips">
                  {TEMPLATE_LOCALES.map((l) => (
                    <span class:list={["tchip", { on: has.includes(l) }]} title={has.includes(l)
                      ? `${TEMPLATE_LOCALE_LABEL[l]} written`
                      : `No ${TEMPLATE_LOCALE_LABEL[l]} version — English is used instead`}>{l.toUpperCase()}</span>
                  ))}
                </div>
                <div class="tptools">
                  <button class="tpico" type="submit" form={`up-${t.id}`} disabled={i === 0} title="Move up" aria-label="Move up">↑</button>
                  <button class="tpico" type="submit" form={`down-${t.id}`} disabled={i === templates.length - 1} title="Move down" aria-label="Move down">↓</button>
                  <button class="tpico danger" type="submit" form={`rm-${t.id}`} title="Remove" aria-label="Remove">×</button>
                </div>
              </div>

              <div class="tpcols">
                {TEMPLATE_LOCALES.map((l) => (
                  <label class="tpcol">
                    <span class="tplab">
                      {TEMPLATE_LOCALE_LABEL[l]}
                      {!has.includes(l) && l !== "en" && <em>falls back to English</em>}
                    </span>
                    <textarea class="in" name={`body_${l}`} rows="12"
                      placeholder={l === "en" ? "Write the reply…" : "Leave this empty to use the English version."}
                      set:text={bodyIn(t, l)}></textarea>
                  </label>
                ))}
              </div>

              <div class="tpsave">
                <button class="btn tpprimary" type="submit" name="action" value="save">Save changes</button>
                <button class="btn ghost tpstarter" type="submit" name="action" value="starter"
                  onclick={`return confirm(${JSON.stringify(
                    (t.source_id && starterIds.has(t.source_id)
                      ? "Update the starter this was copied from?"
                      : "Add this to the starter set?") +
                    "\n\nNew projects will begin with this version. Nothing changes for " +
                    "projects that already exist, including this one."
                  )})`}>
                  {t.source_id && starterIds.has(t.source_id) ? "Update starter" : "Save as starter"}
                </button>
              </div>
            </form>

            {/* Outside the editing form on purpose: a form cannot be nested in another. */}
            <form id={`up-${t.id}`} method="post" action="/api/admin/reply-templates" hidden>
              <input type="hidden" name="action" value="move" /><input type="hidden" name="id" value={t.id} /><input type="hidden" name="dir" value="up" /><input type="hidden" name="slug" value={project.slug} />
            </form>
            <form id={`down-${t.id}`} method="post" action="/api/admin/reply-templates" hidden>
              <input type="hidden" name="action" value="move" /><input type="hidden" name="id" value={t.id} /><input type="hidden" name="dir" value="down" /><input type="hidden" name="slug" value={project.slug} />
            </form>
            <form id={`rm-${t.id}`} method="post" action="/api/admin/reply-templates" hidden
              onsubmit={`return confirm('Remove this template? Replies already sent are unaffected.')`}>
              <input type="hidden" name="action" value="remove" /><input type="hidden" name="id" value={t.id} /><input type="hidden" name="slug" value={project.slug} />
            </form>
          </section>
        );
      })}

      <section class="card">
        <form class="tpadd" method="post" action="/api/admin/reply-templates">
          <input type="hidden" name="action" value="add" />
          <input type="hidden" name="slug" value={project.slug} />
          <input class="in" type="text" name="name" placeholder="Name it — “First reply”, “Invite to a viewing”…" required />
          <button class="btn ghost" type="submit">Add a template</button>
        </form>
      </section>
    </div>
  )}

  {tab === "documents" && (
    <div class="tabpane" style="margin-top: 1.4rem">
      <section class="card">
        <h2 class="sec">Documents</h2>
        <p class="lede">
          The brochure, the floor plans, the price list. Nothing is ever attached to an email — replying
          with a document mints a link that belongs to <b>that one buyer</b>, expires after {LINK_EXPIRY_DAYS} days,
          and can be withdrawn after it has gone out. That is also how you find out whether they read it.
        </p>
      </section>

      {documents.length === 0 ? (
        <section class="card"><p class="lede">Nothing uploaded yet. Add the first document below.</p></section>
      ) : (
        <section class="card">
          <div class="dcwrap">
            {documents.map((d) => {
              const stat = linkStats.get(d.id);
              const meta = [fileKind(d.mime_type), humanSize(d.file_size)].filter(Boolean).join(" · ");
              return (
                <div class="dcrow">
                  <form class="dcform" method="post" action="/api/admin/project-documents">
                    <input type="hidden" name="action" value="save" />
                    <input type="hidden" name="id" value={d.id} />
                    <input type="hidden" name="slug" value={project.slug} />
                    <input class="in dcname" type="text" name="title" value={d.title} required aria-label="Document name" />
                    <select class="in dccat" name="category" aria-label="Category">
                      {DOCUMENT_CATEGORIES.map((c) => (
                        <option value={c.value} selected={c.value === d.category}>{c.label}</option>
                      ))}
                    </select>
                    <span class="dcmeta">{meta}</span>
                    <span class="dcstat">
                      {stat
                        ? `sent ${stat.sent}× · opened by ${stat.opened}`
                        : "not sent yet"}
                    </span>
                    <button class="btn ghost dcsave" type="submit">Save</button>
                  </form>
                  <form method="post" action="/api/admin/project-documents" class="dcrm"
                    onsubmit={`return confirm(${JSON.stringify(
                      "Remove this document?\n\nEvery link already sent for it stops working immediately, " +
                      "including any a buyer is holding."
                    )})`}>
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="id" value={d.id} />
                    <input type="hidden" name="slug" value={project.slug} />
                    <button class="tpico danger" type="submit" title="Remove" aria-label="Remove">×</button>
                  </form>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <section class="card">
        <h3 class="sec">Add a document</h3>
        <form class="dcadd" method="post" action="/api/admin/project-documents" enctype="multipart/form-data">
          <input type="hidden" name="action" value="upload" />
          <input type="hidden" name="slug" value={project.slug} />
          {/* A DIV, not a LABEL. A file input nested inside its own label gets the
              click twice - once itself, once forwarded by the label - and the
              browser opens the file dialog and immediately cancels it, so the
              control looks dead. Every other file input in this portal is a bare
              sibling for the same reason. */}
          <div class="field">
            <span id="dcfile-label">File</span>
            {/* No `accept` list. On macOS Chrome an extension list is mapped to
                system file types, and anything it fails to map is greyed out in
                the dialog — so a filter meant as a convenience can leave someone
                staring at a folder of files they are not allowed to pick. The
                endpoint checks the type anyway and says so in words, which is
                the better place to be strict. */}
            <div class="dcdrop" data-drop>
              <input class="in dcfile" type="file" name="file" required aria-labelledby="dcfile-label" data-file />
              <span class="dcchosen" data-chosen>or drag a file here</span>
            </div>
          </div>
          <div class="row2">
            <label class="field">
              <span>Name <em>optional — the file name is used otherwise</em></span>
              <input class="in" type="text" name="title" placeholder={`${project.name} brochure`} />
            </label>
            <label class="field">
              <span>Category</span>
              <select class="in" name="category">
                {DOCUMENT_CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}
              </select>
            </label>
          </div>
          <button class="btn" type="submit">Upload</button>
          <p class="tpfoot-note">Up to 50 MB. PDFs, images, Office files, CSV and ZIP.</p>
        </form>
      </section>
    </div>
  )}

  {tab === "settings" && (
    <div class="tabpane" style="margin-top: 1.4rem">
      <form class="card" method="post" action="/api/admin/project-settings">
        <input type="hidden" name="slug" value={project.slug} />
        <h2 class="sec">This project</h2>
        <p class="lede">Its name in the menu, where its website lives, and which mailbox answers it.</p>

        <div class="row2">
          <label class="field">
            <span>Sidebar name <em>(how it reads in the left menu — leave blank to use "{project.name}")</em></span>
            <input
              class="in"
              type="text"
              name="nav_name"
              maxlength="40"
              value={project.nav_name ?? ""}
              placeholder={project.name}
            />
          </label>
          <span class="field-spacer"></span>
          <label class="field">
            <span>Domain <em>(no https://)</em></span>
            <input class="in" type="text" name="domain" value={project.domain ?? ""} placeholder="yourproject.com" />
          </label>
          <label class="field">
            <span>Mailbox <em>(filled in automatically when you connect)</em></span>
            <input class="in" type="email" name="mailbox" value={project.mailbox ?? ""} placeholder="sales@yourproject.com" />
          </label>
        </div>
        <button class="btn" type="submit">Save</button>
        {saved && <p class="saved">Saved ✓</p>}
      </form>

      <section class="card">
        <div class="cardhead">
          <h2 class="sec">Layout</h2>
          <button class="btn top" type="button" data-open-dialog="edit-layout">Edit</button>
        </div>

        {/* Layout messages belong HERE. They were being written to the page's
            one notice line, which is hidden on Settings — so a refusal to
            delete looked exactly like a button that did nothing. */}
        {mailboxMessage && <p class="syncmsg" style="margin-top:0.8rem"><span>{mailboxMessage}</span></p>}

        {buildings.length === 0 && unplacedUnits.length === 0 ? (
          <p class="empty">Nothing recorded yet. Press Edit to describe how this project is laid out.</p>
        ) : (
          <table class="q b-table">
            {/* Structure only. The sales split lives on the Overview and the
                Units tab, and repeating it here made a settings card look like
                a report. */}
            <tr><th>Type</th><th>Name</th><th>Unit type</th><th>Units</th></tr>
            {buildings.map((b) => (
              <tr>
                <td><span class="chip">{b.kind === "project" ? "Project" : "Building"}</span></td>
                <td><b>{b.name}</b></td>
                <td>{unitTypeOf(b.id)}</td>
                <td><b>{unitsInBuilding(b.id).length}</b></td>
              </tr>
            ))}
            {unplacedUnits.length > 0 && (
              <tr>
                <td></td>
                <td><span class="chip">Not placed yet</span></td>
                <td>{unitTypeOf(null)}</td>
                <td><b>{unplacedUnits.length}</b></td>
              </tr>
            )}
          </table>
        )}

        {/* Everything editable lives in here. The card itself is a statement of
            what the project is; changing it is a deliberate act, not something
            that can happen while reading. */}
        <dialog class="enqmodal wide" id="edit-layout">
          <div class="mhead">
            <div>
              <h3>Edit layout</h3>
              <p class="msub">Blocks or phases, and the units in each.</p>
            </div>
            <form method="dialog"><button class="mx" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6 18 18M18 6 6 18"/></svg></button></form>
          </div>

          {buildings.length > 0 && (
            <table class="q b-table">
              <tr><th>Type</th><th>Name</th><th>Units</th><th></th></tr>
              {buildings.map((b) => (
                <tr>
                  <td>
                    <form method="post" action="/api/admin/project-buildings">
                      <input type="hidden" name="slug" value={project.slug} />
                      <input type="hidden" name="id" value={b.id} />
                      <input type="hidden" name="action" value="kind" />
                      <select class="in bkind" name="kind" onchange="this.form.submit()">
                        <option value="building" selected={b.kind !== "project"}>Building</option>
                        <option value="project" selected={b.kind === "project"}>Project</option>
                      </select>
                    </form>
                  </td>
                  <td>
                    <form method="post" action="/api/admin/project-buildings" class="inline">
                      <input type="hidden" name="slug" value={project.slug} />
                      <input type="hidden" name="id" value={b.id} />
                      <input type="hidden" name="action" value="rename" />
                      <input class="in bname" type="text" name="name" value={b.name} />
                      <button class="tiny" type="submit">Save</button>
                    </form>
                  </td>
                  <td><b>{unitsInBuilding(b.id).length}</b></td>
                  <td style="text-align:right">
                    {unitsInBuilding(b.id).length === 0 ? (
                      <form method="post" action="/api/admin/project-buildings"
                            onsubmit={`return confirm('Remove ${b.name}?')`}>
                        <input type="hidden" name="slug" value={project.slug} />
                        <input type="hidden" name="id" value={b.id} />
                        <input type="hidden" name="action" value="remove" />
                        <button class="tiny danger" type="submit">Remove</button>
                      </form>
                    ) : (
                      <form method="post" action="/api/admin/project-buildings"
                            onsubmit={`return confirm('Remove ${b.name} and its ${unitsInBuilding(b.id).length} units? This cannot be undone.')`}>
                        <input type="hidden" name="slug" value={project.slug} />
                        <input type="hidden" name="id" value={b.id} />
                        <input type="hidden" name="action" value="remove_all" />
                        {/* Just "Remove". The count stays in the confirmation,
                            which is where it can still stop a mistake without
                            making the button read like a warning label. */}
                        <button class="tiny danger" type="submit">Remove</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </table>
          )}

          <div class="msep"></div>
          <h4 class="msub-h">Add a building</h4>
          <form method="post" action="/api/admin/project-buildings" class="genform modalform">
            <input type="hidden" name="slug" value={project.slug} />
            <input type="hidden" name="action" value="add" />
            <label class="field">
              <span>Type</span>
              <select class="in" name="kind">
                <option value="building">Building</option>
                <option value="project">Project</option>
              </select>
            </label>
            <label class="field">
              <span>Name</span>
              <input class="in" type="text" name="name" value={nextBlockName} placeholder="Name" required />
            </label>
            <label class="field">
              <span>Units in it <em>(optional)</em></span>
              <input class="in" type="number" name="count" min="0" max="500" placeholder="0" />
            </label>
            <label class="field">
              <span>Unit type</span>
              {/* Follows Type on its own — a building holds apartments, a
                  project of this kind holds villas — but stays a real field,
                  because the rule is a sensible default and not a law. */}
              <select class="in" name="prefix" data-follows-kind>
                <option value="Apartment" selected>Apartment</option>
                <option value="Villa">Villa</option>
              </select>
            </label>
            <button class="btn" type="submit">Add</button>
          </form>
        </dialog>
      </section>

      {/* Parking sold separately from the home. Under Layout because it is the
          same kind of fact — what this project physically consists of — and not
          in Units, where it would distort every sold-percentage on the site. */}
      <section class="card">
        <div class="cardhead">
          <h2 class="sec">Additional parking</h2>
          <button class="btn top" type="button" data-open-dialog="edit-parking">Edit</button>
        </div>

        {parkingNotice && (
          <p class="syncmsg" style="margin-top:0.8rem">
            <span>{parkingNotice}</span>
            <a class="msgx" href={selfHref} aria-label="Dismiss">×</a>
          </p>
        )}

        {parking.length === 0 ? (
          <p class="empty">
            No parking recorded. Press Edit if this project sells spaces apart from the homes.
          </p>
        ) : (
          /* The same table the Layout card above uses — headings across the
             top, one row underneath — so the two settings cards read as one
             pair. Still a summary and not an inventory: the row is the whole
             car park, not a space. The spaces themselves are on Units, where
             one actually gets sold. */
          <table class="q b-table">
            <tr>
              <th>Spaces</th>
              {PARKING_STATES.map((st) => <th>{st.label}</th>)}
            </tr>
            <tr>
              <td><b>{parkingCount.total}</b></td>
              {PARKING_STATES.map((st) => <td><b>{parkingCount[st.key]}</b></td>)}
            </tr>
          </table>
        )}

        <dialog class="enqmodal wide" id="edit-parking">
          <div class="mhead">
            <div>
              <h3>Parking</h3>
              <p class="msub">Spaces sold apart from the homes.</p>
            </div>
            <form method="dialog"><button class="mx" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6 18 18M18 6 6 18"/></svg></button></form>
          </div>

          {parking.length > 0 && (
            <table class="q b-table">
              <tr><th>Space</th><th>Price</th><th>State</th><th>Notes</th><th></th></tr>
              {parking.map((p) => (
                <tr>
                  {/* One row, one form: everything about a space saves together,
                      so a price and a state can never land half-changed. */}
                  <td>
                    <form method="post" action="/api/admin/project-parking" class="prow" id={`pk-${p.id}`}>
                      <input type="hidden" name="slug" value={project.slug} />
                      <input type="hidden" name="id" value={p.id} />
                      <input type="hidden" name="action" value="save" />
                      <input class="in pcode" type="text" name="code" value={p.code} required />
                    </form>
                  </td>
                  <td><input class="in pprice" type="text" name="price" form={`pk-${p.id}`}
                             value={p.price ?? ""} placeholder="18,000" inputmode="numeric" /></td>
                  <td>
                    <select class="in" name="state" form={`pk-${p.id}`} data-fill>
                      {PARKING_STATES.map((st) => (
                        <option value={st.key} selected={st.key === p.state}>{st.label}</option>
                      ))}
                    </select>
                  </td>
                  <td><input class="in" type="text" name="notes" form={`pk-${p.id}`}
                             value={p.notes ?? ""} placeholder="Level -1, by the lift" /></td>
                  {/* One flex row rather than a button beside a form: the form
                      is a block, so the two buttons were sitting on different
                      lines of the same cell and only looked side by side. */}
                  <td class="pacts">
                    <button class="tiny" type="submit" form={`pk-${p.id}`}>Save</button>
                    <form method="post" action="/api/admin/project-parking"
                          onsubmit={`return confirm('Remove ${p.code}?')`}>
                      <input type="hidden" name="slug" value={project.slug} />
                      <input type="hidden" name="id" value={p.id} />
                      <input type="hidden" name="action" value="remove" />
                      <button class="tiny danger" type="submit">Remove</button>
                    </form>
                  </td>
                </tr>
              ))}
            </table>
          )}

          {parking.length > 0 && (
            <p class="prowall">
              {/* The count and the sold ones are named in the confirmation, not
                  on the button: a button that reads like a warning label gets
                  ignored, while a confirmation that names what is about to go
                  can still stop the mistake. */}
              <form method="post" action="/api/admin/project-parking"
                    onsubmit={`return confirm('Remove all ${parking.length} parking space${parking.length === 1 ? "" : "s"}${parkingCount.sold + parkingCount.reserved > 0 ? `, including ${parkingCount.sold + parkingCount.reserved} that are sold or reserved` : ""}? This cannot be undone.')`}>
                <input type="hidden" name="slug" value={project.slug} />
                <input type="hidden" name="action" value="remove_all" />
                <button class="tiny danger" type="submit">Remove all spaces</button>
              </form>
            </p>
          )}

          <div class="msep"></div>
          <h4 class="msub-h">Add spaces</h4>
          {/* A batch, because that is how a car park arrives: "eighteen spaces,
              P1 to P18" is one fact, not eighteen. Numbering carries on from
              whatever is already there. */}
          <form method="post" action="/api/admin/project-parking" class="genform modalform">
            <input type="hidden" name="slug" value={project.slug} />
            <input type="hidden" name="action" value="add" />
            <label class="field">
              <span>How many</span>
              <input class="in" type="number" name="count" min="1" max="500" placeholder="18" required />
            </label>
            <label class="field">
              <span>Named</span>
              <input class="in" type="text" name="prefix" value="P" placeholder="P" />
            </label>
            <label class="field">
              <span>Price each <em>(optional)</em></span>
              <input class="in" type="text" name="price" placeholder="18,000" inputmode="numeric" />
            </label>
            <button class="btn" type="submit">Add</button>
          </form>
        </dialog>
      </section>

      <section class="card">
        <h2 class="sec">Mailbox</h2>

        {mailboxMessage && <p class="saved" style="margin-top:0">{mailboxMessage}</p>}

        {!oauthReady && (
          <p class="lede">
            The Zoho application isn't configured on this environment yet —
            <b> ZOHO_OAUTH_CLIENT_ID</b> and <b>ZOHO_OAUTH_CLIENT_SECRET</b> need to be set,
            then the server restarted. See <b>zoho-oauth-app-setup.md</b>.
          </p>
        )}

        {oauthReady && !mailboxConnected && (
          <>
            <p class="lede">
              This lets the portal read enquiries arriving in the project's inbox and reply from
              that address. You'll be sent to Zoho to sign in.
            </p>
            <p class="lede">
              <b>Sign in as the project's mailbox</b>{project.mailbox ? ` — ${project.mailbox}` : ""},
              not your own admin account. Whichever mailbox you sign in as is the one that gets
              connected, and its address is filled in here automatically afterwards.
            </p>
            <a class="btn" href={`/api/admin/zoho/connect?slug=${project.slug}`}
               style="display:inline-block;text-decoration:none">Connect mailbox</a>
          </>
        )}

        {mailboxConnected && (
          <>
            <div class="kv" style="margin-top:0.4rem">
              <div><span>Connected</span><code>{project.mailbox}</code></div>
              <div><span>Since</span><code>{new Date(project.mailbox_connected_at).toLocaleString("en-GB")}</code></div>
              <div>
                <span>Last sync</span>
                <code>{project.mailbox_last_sync_at
                  ? new Date(project.mailbox_last_sync_at).toLocaleString("en-GB")
                  : "not yet"}</code>
              </div>
            </div>

            {project.mailbox_last_error && (
              <div class="warn"><b>Last sync failed</b><div>{project.mailbox_last_error}</div></div>
            )}

            <p class="lede" style="margin-top:0.9rem">
              Mail arriving here becomes an enquiry automatically. A sender we already have
              is added to their existing thread; anyone new becomes a new enquiry in
              Needs you. Form notifications are read via their Reply-To, so the buyer is the
              contact rather than the form service.
            </p>

            <div style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center">
              <form method="post" action="/api/admin/project-mail-sync">
                <input type="hidden" name="slug" value={project.slug} />
                <button class="btn ghost" type="submit">Sync now</button>
              </form>
              {/* The routine sync reads the newest page of the INBOX only. This
                  one-off walks the whole inbox back to the beginning, then the
                  Sent folder, so replies made in Zoho before the portal existed
                  appear on the threads they belong to. */}
              <form method="post" action="/api/admin/project-mail-sync">
                <input type="hidden" name="slug" value={project.slug} />
                <input type="hidden" name="mode" value="history" />
                <button class="btn ghost" type="submit">Import mail history</button>
              </form>
              <form method="post" action="/api/admin/zoho/disconnect"
                    onsubmit="return confirm('Disconnect this mailbox? Existing enquiries are kept.')">
                <input type="hidden" name="slug" value={project.slug} />
                <button class="btn ghost" type="submit" style="color:#a33d3d;border-color:rgba(203,76,76,.4)">Disconnect</button>
              </form>
            </div>
          </>
        )}
      </section>
      <details class="adv">
        <summary>Advanced — connect the website form directly</summary>
        <p class="lede">
          Not needed once the mailbox is connected: form submissions already reach you
          as email. This exists for a project whose site cannot send email, or if you
          ever want submissions to arrive instantly rather than within ten minutes.
        </p>
      <section class="card">
        <h2 class="sec">Ingest key</h2>
        <p class="lede">
          Authenticates submissions from the project site. Stored as a hash — it can be
          replaced but never read back, so keep the copy you take now.
        </p>

        {freshKey && (
          <div class="keybox">
            <div class="kh">Your new key — copy it now</div>
            <code>{freshKey}</code>
            <p>This is the only time it will be shown. Put it in the project site's
            environment as <b>EP_INGEST_KEY</b>. Generating another key immediately
            invalidates this one.</p>
          </div>
        )}

        <form method="post" action="/api/admin/project-settings">
          <input type="hidden" name="slug" value={project.slug} />
          <input type="hidden" name="action" value="rotate_key" />
          <button class="btn ghost" type="submit">
            {hasKey ? "Generate a new key" : "Generate a key"}
          </button>
        </form>
        {hasKey && !freshKey && <p class="empty">A key is set. Generate a new one only if it has leaked or been lost.</p>}
      </section>

      <section class="card">
        <h2 class="sec">Webhook — give these to whoever runs the site</h2>
        <p class="lede">
          The site's form should POST here when it's submitted. It doesn't matter what the
          site is built with or which form service it uses — anything that can make an HTTP
          request will work.
        </p>
        <div class="kv">
          <div><span>URL</span><code>{webhookUrl}</code></div>
          <div><span>Method</span><code>POST</code></div>
          <div><span>Auth header</span><code>X-Ingest-Key: your-key</code></div>
          <div><span>Required</span><code>name, email</code></div>
          <div><span>Optional</span><code>phone, message, locale, source_page</code></div>
        </div>
        <p class="lede" style="margin-top:0.9rem">
          Field names are matched loosely — <b>Full Name</b>, <b>fullName</b> and <b>name</b>
          all work, as do Spanish and Catalan equivalents. JSON, urlencoded and multipart
          bodies are all accepted. If the form service cannot set headers, the key can go in
          the body as <b>key</b> or on the URL as <b>?key=…</b>, though the header is better
          because URLs end up in server logs.
        </p>
        <p class="lede">
          Anything rejected is logged and shown on the Overview tab with the reason and the
          field names it did receive — so a mismatch is visible rather than silent.
        </p>
      </section>

      <section class="card">
        <h2 class="sec">Example call</h2>
        <p class="lede">
          Store the key as <b>EP_INGEST_KEY</b> in the site's environment variables
          (Vercel → Settings → Environment Variables) and call this from the server, never
          from the browser — a key in page source can be read by anyone.
        </p>
        <pre class="snip">{snippet}</pre>
      </section>
      </details>
    </div>
  )}

{tab === "leads" && (
  <dialog class="enqmodal wide" id="add-lead">
    <div class="mhead">
      <div>
        <h3>Add a lead</h3>
        <p class="msub">Someone who came to you another way — a walk-in, a call, a referral.</p>
      </div>
      <form method="dialog"><button class="mx" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6 18 18M18 6 6 18"/></svg></button></form>
    </div>

    <form class="alform" method="post" action="/api/admin/project-lead" data-addlead>
      <input type="hidden" name="action" value="add" />
      <input type="hidden" name="slug" value={project.slug} />
      <input type="hidden" name="force" value="" data-force />

      <label class="field">
        <span>Name</span>
        <input class="in" type="text" name="name" required autocomplete="off" />
      </label>

      <div class="alrow">
        <label class="field">
          <span>Email</span>
          <input class="in" type="email" name="email" autocomplete="off" data-dup-email />
        </label>
        <label class="field">
          <span>Phone</span>
          <input class="in" type="tel" name="phone" autocomplete="off" data-dup-phone />
        </label>
      </div>

      <div class="alrow">
        <label class="field">
          <span>Source</span>
          <select class="in" name="source" data-fill>
            {LEAD_SOURCES.map((src) => <option value={src.value}>{src.label}</option>)}
          </select>
        </label>
        <label class="field">
          <span>Language <em>(picks the reply template)</em></span>
          <select class="in" name="locale" data-fill>
            <option value="">Not sure yet</option>
            {LOCALE_OPTIONS.map((l) => <option value={l.value}>{l.label}</option>)}
          </select>
        </label>
      </div>

      <div class="alrow">
        <label class="field">
          <span>Stage</span>
          <select class="in" name="stage">
            {BUYER_STAGES.map((st) => <option value={st.key} selected={st.key === "new"}>{st.label}</option>)}
          </select>
        </label>
        <label class="field">
          <span>First contact <em>(the day counter runs from this)</em></span>
          <input class="in" type="date" name="received" data-today />
        </label>
      </div>

      <label class="field">
        <span>What they are after <em>(optional)</em></span>
        <textarea class="in" name="message" rows="3"
          placeholder="Three bedrooms, budget around 1.2M, wants to visit on Saturday."></textarea>
      </label>

      <p class="aldup" data-dup-note></p>
      {/* Everyone already on this project, for the duplicate check. Emitted as
          data rather than fetched: the page has the list in hand already. */}
      <script type="application/json" id="known-leads" is:inline set:html={JSON.stringify(
        allRows.map((e) => ({ id: e.id, name: e.name ?? "", email: e.email ?? "", phone: (e as any).phone ?? "" })),
      ).replace(/</g, "\\u003c")} />
      <script type="application/json" id="known-slug" is:inline set:html={JSON.stringify(project.slug)} />

      <div class="alfoot">
        <button class="btn ghost" type="button" data-close>Cancel</button>
        <button class="btn" type="submit" data-submit>Add lead</button>
      </div>
    </form>
  </dialog>
)}
</AdminLayout>

<script>
  // Keep the switcher's thumb behind the active tab. The FIRST placement is done
  // by an inline script next to the markup, before paint; these re-runs are for
  // the two things that change the measurement afterwards — the web font
  // finishing loading, and the window being resized.
  function placeThumb(animate) {
    document.querySelectorAll(".seg").forEach((seg) => {
      const thumb = seg.querySelector(".seg-thumb");
      const active = seg.querySelector(".seg-btn.active");
      if (!(thumb instanceof HTMLElement) || !(active instanceof HTMLElement)) return;
      thumb.classList.toggle("no-anim", !animate);
      thumb.style.width = `${active.offsetWidth}px`;
      thumb.style.transform = `translateX(${active.offsetLeft}px)`;
      if (!animate) requestAnimationFrame(() => thumb.classList.remove("no-anim"));
    });
  }
  document.fonts?.ready.then(() => placeThumb(false));
  window.addEventListener("resize", () => placeThumb(false));

  // Dismissing a one-off message. The link already points at the clean URL, so
  // this only has to stop the navigation and do the same thing in place: drop
  // the note, and take the outcome parameters out of the address bar so a
  // refresh doesn't bring it back.
  document.querySelectorAll(".syncmsg .msgx").forEach((x) => {
    x.addEventListener("click", (ev) => {
      ev.preventDefault();
      x.closest(".syncmsg")?.remove();
      const url = new URL(window.location.href);
      ["mailbox", "notice", "parking_notice", "sent", "send_error", "units_ok", "units_error"]
        .forEach((k) => url.searchParams.delete(k));
      window.history.replaceState(null, "", url.pathname + url.search);
    });
  });

  // Open the enquiry a "See enquiry" pill belongs to. Native <dialog> gives the
  // backdrop, Esc-to-close and focus handling for free.
  document.querySelectorAll("[data-open-enq]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-open-enq");
      const dlg = id ? document.getElementById("enq-" + id) : null;
      if (dlg instanceof HTMLDialogElement) dlg.showModal();
    });
  });

  // Unit type follows Type: a Building holds apartments, a Project holds villas.
  // It stops following the moment someone sets it themselves — an automatic
  // field that overwrites a deliberate choice is worse than no automation.
  document.querySelectorAll("select[data-follows-kind]").forEach((prefix) => {
    const form = prefix.closest("form");
    const kind = form?.querySelector('select[name="kind"]');
    if (!(kind instanceof HTMLSelectElement) || !(prefix instanceof HTMLSelectElement)) return;

    let chosenByHand = false;
    prefix.addEventListener("change", () => { chosenByHand = true; });
    kind.addEventListener("change", () => {
      if (chosenByHand) return;
      prefix.value = kind.value === "project" ? "Villa" : "Apartment";
    });
  });

  // Any button that names a dialog opens it.
  document.querySelectorAll("[data-open-dialog]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-open-dialog");
      const dlg = id ? document.getElementById(id) : null;
      if (dlg instanceof HTMLDialogElement) dlg.showModal();
    });
  });

  // The add-lead form: today's date, and a duplicate check before it saves.
  const addLead = document.querySelector<HTMLFormElement>("form[data-addlead]");
  if (addLead) {
    const dialog = addLead.closest("dialog");

    // Default the date to today without hard-coding it into the HTML, which
    // would go stale the moment the page was cached.
    const dateField = addLead.querySelector<HTMLInputElement>("[data-today]");
    if (dateField && !dateField.value) {
      const d = new Date();
      dateField.value = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    }

    addLead.querySelector("[data-close]")?.addEventListener("click", () => dialog?.close());

    const known: { id: string; name: string; email: string; phone: string }[] =
      JSON.parse(document.getElementById("known-leads")?.textContent || "[]");

    // Same rule as the server uses: last nine digits, so +376 812 345 and
    // 00376812345 and 812345 are all recognised as the same person.
    const phoneKey = (v: string) => {
      const digits = (v || "").replace(/\D/g, "");
      return digits.length >= 6 ? digits.slice(-9) : "";
    };

    const note = addLead.querySelector<HTMLElement>("[data-dup-note]");
    const force = addLead.querySelector<HTMLInputElement>("[data-force]");
    const submit = addLead.querySelector<HTMLButtonElement>("[data-submit]");

    addLead.addEventListener("submit", (ev) => {
      if (force?.value === "1") return; // already warned, already decided

      const email = (addLead.querySelector<HTMLInputElement>("[data-dup-email]")?.value ?? "").trim().toLowerCase();
      const phone = phoneKey(addLead.querySelector<HTMLInputElement>("[data-dup-phone]")?.value ?? "");

      const clash = known.find(
        (k) => (email && k.email.toLowerCase() === email) || (phone && phoneKey(k.phone) === phone),
      );
      if (!clash || !note || !submit || !force) return;

      // Stop, show who it is, and let the next press through. Refusing outright
      // would be wrong — two people really do share a household address.
      ev.preventDefault();
      note.innerHTML =
        `<b>${clash.name || "Someone"}</b> is already a lead on this project. ` +
        `<a href="/admin/projects/${JSON.parse(document.getElementById("known-slug")?.textContent || '""')}/enquiry/${clash.id}">Open them instead</a>` +
        ` — or press Add lead again to record a second person.`;
      note.classList.add("on");
      force.value = "1";
      submit.textContent = "Add anyway";
    });
  }

  // Lead profiles: open in place, never navigate.
  //
  // Every profile is already in the page, closed. Clicking a name used to load a
  // whole new page before anything appeared; now it is the same instant open the
  // Add lead button has always had.
  const profiles = Array.from(document.querySelectorAll("dialog[data-profile]"));
  if (profiles.length > 0) {
    const clearLeadFromUrl = () => {
      const u = new URL(window.location.href);
      u.searchParams.delete("lead");
      u.searchParams.delete("contact_error");
      window.history.replaceState(null, "", u.pathname + (u.search || ""));
    };

    for (const el of profiles) {
      const dlg = el as HTMLDialogElement;
      dlg.querySelector("[data-close]")?.addEventListener("click", () => dlg.close());
      // Escape and a backdrop click both end in `close`, so the URL is tidied in
      // one place and every way out agrees.
      dlg.addEventListener("close", clearLeadFromUrl);
      dlg.addEventListener("click", (ev) => { if (ev.target === dlg) dlg.close(); });
    }

    document.querySelectorAll("[data-open-lead]").forEach((link) => {
      link.addEventListener("click", (ev) => {
        const e = ev as MouseEvent;
        // Leave the modifier clicks alone: cmd-click still opens a real tab.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const id = (link as HTMLElement).dataset.openLead;
        const dlg = id ? document.getElementById("lead-" + id) : null;
        if (!(dlg instanceof HTMLDialogElement)) return;
        e.preventDefault();
        dlg.showModal();
        // Keep the address bar honest, so the open profile is still copyable.
        window.history.replaceState(null, "", (link as HTMLAnchorElement).href);
      });
    });

    // Arriving with one already named — a shared link, or coming back from
    // saving a note or a stage.
    const wanted = new URL(window.location.href).searchParams.get("lead");
    const onLoad = wanted ? document.getElementById("lead-" + wanted) : null;
    if (onLoad instanceof HTMLDialogElement && !onLoad.open) onLoad.showModal();
  }

  // Dragging a file onto the upload box.
  //
  // Partly because it is nicer, and partly as a way round the browser: Chrome
  // occasionally gets into a state where the file dialog will not open at all
  // until it is restarted, and when that happens this is the only way to get a
  // file into the form. It also reports the chosen name back, so picking a file
  // is visibly acknowledged either way.
  document.querySelectorAll("[data-drop]").forEach((zone) => {
    const input = zone.querySelector("[data-file]");
    const chosen = zone.querySelector("[data-chosen]");
    if (!(input instanceof HTMLInputElement) || !chosen) return;

    const show = () => {
      const file = input.files?.[0];
      chosen.textContent = file ? file.name : "or drag a file here";
      chosen.classList.toggle("has", !!file);
    };
    input.addEventListener("change", show);

    // Both are needed: without preventDefault on dragover the browser refuses to
    // treat this as a drop target, and without it on drop the browser navigates
    // away to the file instead.
    zone.addEventListener("dragover", (ev) => {
      ev.preventDefault();
      zone.classList.add("over");
    });
    zone.addEventListener("dragleave", () => zone.classList.remove("over"));
    zone.addEventListener("drop", (ev) => {
      ev.preventDefault();
      zone.classList.remove("over");
      const dropped = (ev as DragEvent).dataTransfer?.files;
      if (dropped && dropped.length > 0) {
        input.files = dropped;
        show();
      }
    });
  });

  // Clicking the backdrop closes it. A <dialog>'s own box is what receives the
  // click when you hit the content, so comparing target to the dialog itself is
  // what distinguishes "outside" from "inside".
  document.querySelectorAll("dialog.enqmodal").forEach((dlg) => {
    dlg.addEventListener("click", (ev) => {
      if (ev.target === dlg && dlg instanceof HTMLDialogElement) dlg.close();
    });
  });
</script>
