          transform 220ms ease, color 220ms ease, box-shadow 220ms ease;
      }

      .gateway.is-spotlight .button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.32);
      }

      /* Primary variant — solid green fill with white text (Request video call) */
      .gateway.is-spotlight .button.is-primary {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
      }

      .gateway.is-spotlight .button.is-primary:hover {
        background: #5fc189;
        border-color: #5fc189;
      }

      /* Two-button row inside the leaders card */
      .gateway.is-spotlight .leaders-cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.4rem;
      }

      .gateway.is-spotlight .leaders-cta-row .button {
        margin-top: 0;
      }

      @media (max-width: 680px) {
        .gateway.is-spotlight {
          padding: 4rem 0 3.5rem;
        }

        /* Make sure both cards always fit within the screen width: the
           single grid column must be allowed to shrink, and the heavy
           drop shadow is softened so it doesn't bleed past the margins. */
        .gateway.is-spotlight .leaders-image,
        .gateway.is-spotlight .leaders-copy {
          min-width: 0;
          max-width: 100%;
          box-shadow: 0 10px 18px rgba(5, 12, 20, 0.24);
        }

        /* Keep the image as a tidy banner that fits within the screen
           instead of a tall ~21rem block. */
        .gateway.is-spotlight .leaders-image {
          min-height: 0;
          aspect-ratio: 16 / 10;
        }

        .gateway.is-spotlight .leaders-copy {
          padding: 1.6rem;
        }

        /* CTAs keep their natural width and simply wrap: the second
           button drops onto its own line when both don't fit on one row. */
        .gateway.is-spotlight .leaders-cta-row {
          gap: 0.7rem;
        }

        .gateway.is-spotlight .leaders-cta-row .button {
          flex: 0 0 auto;
          max-width: 100%;
        }
      }

      /* ────────────────────────────────────────────────────────────
         Equity Partners in numbers — Spotlight treatment (dark)
         Keeps the navy backdrop, adds the eyebrow rule and refined
         metric cards with hover glow.
         ──────────────────────────────────────────────────────────── */
      .home-proof-strip.is-spotlight {
        position: relative;
        padding: 5rem 0;
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          radial-gradient(ellipse at 88% 100%, rgba(130, 147, 174, 0.16), transparent 60%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        overflow: hidden;
      }

      .home-proof-strip.is-spotlight::before,
      .home-proof-strip.is-spotlight::after {
        content: "";
        position: absolute;
        width: 620px;
        height: 620px;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.55;
      }

      .home-proof-strip.is-spotlight::before {
        top: -180px;
        right: -160px;
        background: radial-gradient(circle, rgba(83, 178, 127, 0.18), transparent 70%);
      }

      .home-proof-strip.is-spotlight::after {
        bottom: -220px;
        left: -160px;
        background: radial-gradient(circle, rgba(130, 147, 174, 0.18), transparent 70%);
      }

      .home-proof-strip.is-spotlight .container {
        position: relative;
        z-index: 1;
      }

      .home-proof-strip.is-spotlight .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: #6ec595;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 1.8rem;
        transform: none;
      }

      .home-proof-strip.is-spotlight .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      .home-proof-strip.is-spotlight .home-proof-grid {
        margin-top: 0;
        gap: 1.4rem;
      }

      .home-proof-strip.is-spotlight .home-proof-metric {
        position: relative;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(212, 224, 241, 0.14);
        border-radius: 1.2rem;
        overflow: hidden;
        isolation: isolate;
        box-shadow: 0 18px 40px rgba(5, 12, 20, 0.22);
        transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
          border-color 360ms ease, box-shadow 360ms ease;
      }

      .home-proof-strip.is-spotlight .home-proof-metric::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 85% 0%, rgba(83, 178, 127, 0.22), transparent 60%);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: -1;
        pointer-events: none;
      }

      .home-proof-strip.is-spotlight .home-proof-metric::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
        opacity: 0;
        transition: opacity 360ms ease;
      }

      .home-proof-strip.is-spotlight .home-proof-metric:hover {
        transform: translateY(-6px);
        border-color: rgba(83, 178, 127, 0.42);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4),
          0 0 0 1px rgba(83, 178, 127, 0.18) inset;
      }

      .home-proof-strip.is-spotlight .home-proof-metric:hover::before,
      .home-proof-strip.is-spotlight .home-proof-metric:hover::after {
        opacity: 1;
      }

      .home-proof-strip.is-spotlight .home-proof-metric-value {
        position: relative;
        z-index: 1;
        color: #f3f7fc;
        font-size: clamp(2.4rem, 3.8vw, 3.2rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1;
      }

      .home-proof-strip.is-spotlight .home-proof-metric-label {
        position: relative;
        z-index: 1;
        color: rgba(220, 230, 245, 0.7);
        font-size: 0.78rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-top: 0.9rem;
      }

      @media (max-width: 680px) {
        .home-proof-strip.is-spotlight {
          padding: 4rem 0 3.5rem;
        }
      }

      /* ── Scroll entrance animations ── */
      [data-animate] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 650ms ease, transform 650ms ease;
      }

      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      [data-animate="delay-1"] { transition-delay: 100ms; }
      [data-animate="delay-2"] { transition-delay: 200ms; }
      [data-animate="delay-3"] { transition-delay: 300ms; }
      [data-animate="delay-4"] { transition-delay: 400ms; }

    </style>
  </head>
