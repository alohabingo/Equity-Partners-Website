---
import { buildLocalizedPath, type Locale } from "../lib/i18n";
import { getUiTranslations } from "../i18n/ui";

interface Props {
  active?: "home" | "about" | "partners" | "blog" | "test";
  menuToggleId: string;
  offsetFirstSection?: boolean;
  locale: Locale;
  currentPath: string;
}

const { active, menuToggleId, offsetFirstSection = true, locale, currentPath } = Astro.props;
const menuPanelId = `${menuToggleId}-panel`;
const t = getUiTranslations(locale);
const languages = [
  { code: "en", label: "EN", name: "English", flagClass: "flag-en" },
  { code: "es", label: "ES", name: "Español", flagClass: "flag-es" },
  { code: "ca", label: "CA", name: "Català", flagClass: "flag-ca" },
];
---

<header class:list={["site-header", offsetFirstSection && "offset-next-section"]}>
  <button
    class="menu-toggle"
    type="button"
    aria-label="Toggle navigation menu"
    aria-controls={menuPanelId}
    aria-expanded="false"
  >
    <span class="menu-toggle-bars"></span>
  </button>
  <a href={buildLocalizedPath("/", locale)} aria-label="Go to homepage">
    <img
      class="logo"
      src="/images/branding/equity-partners-logo-light%20small.png"
      alt="Equity Partners logo"
    />
  </a>
  <nav class="main-nav" aria-label="Primary">
    <ul class="menu-list">
      <li><a class:list={["menu-link", active === "home" && "is-active"]} href={buildLocalizedPath("/", locale)}>{t.nav.home}</a></li>
      <li><a class:list={["menu-link", active === "about" && "is-active"]} href={buildLocalizedPath("/about", locale)}>{t.nav.about}</a></li>
      <li><a class:list={["menu-link", active === "partners" && "is-active"]} href={buildLocalizedPath("/partners", locale)}>{t.nav.partners}</a></li>
      <li><a class:list={["menu-link", active === "blog" && "is-active"]} href={buildLocalizedPath("/blog", locale)}>{t.nav.blog}</a></li>
      <li><a class:list={["menu-link", active === "test" && "is-active"]} href={buildLocalizedPath("/test", locale)}>{t.nav.test}</a></li>
    </ul>
    <a class="menu-cta" href={buildLocalizedPath("/contact", locale)}>{t.nav.contactUs}</a>
    <div class="language-selector" data-language-dropdown>
      <button
        type="button"
        class="language-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={t.nav.selectLanguage}
        data-language-trigger
      >
        <span class="language-trigger-main">
          <span class="language-flag flag-en" data-current-language-flag aria-hidden="true"></span>
          <span class="language-trigger-label" data-current-language-label>EN</span>
        </span>
        <span class="language-trigger-arrow" aria-hidden="true"></span>
      </button>
      <div class="language-menu" role="menu" aria-label={t.nav.selectLanguage} data-language-menu>
        {
          languages.map((language) => (
            <a
              class:list={["language-menu-item", language.code === locale && "is-active"]}
              href={buildLocalizedPath(currentPath, language.code as Locale)}
              data-language-option
              data-language-code={language.code}
              data-language-label={language.label}
              data-language-flag={language.flagClass}
              data-language-href={buildLocalizedPath(currentPath, language.code as Locale)}
              aria-checked={language.code === locale ? "true" : "false"}
              role="menuitemradio"
              title={language.name}
            >
              <span class:list={["language-flag", language.flagClass]} aria-hidden="true"></span>
              <span class="language-menu-name">{language.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </nav>
  <div class="menu-backdrop" aria-hidden="true"></div>
  <div class="mobile-drawer" id={menuPanelId} aria-label="Mobile navigation">
    <div class="mobile-drawer-head">
      <button class="menu-close" type="button" aria-label="Close navigation menu">
        <span aria-hidden="true">×</span>
      </button>
      <a href={buildLocalizedPath("/", locale)} class="mobile-drawer-brand" aria-label="Go to homepage">
        <img
          class="mobile-drawer-logo"
          src="/images/branding/equity-partners-logo-light%20small.png"
          alt="Equity Partners logo"
        />
      </a>
    </div>
    <ul class="mobile-drawer-list">
      <li><a class:list={["mobile-drawer-link", active === "home" && "is-active"]} href={buildLocalizedPath("/", locale)}>{t.nav.home}</a></li>
      <li><a class:list={["mobile-drawer-link", active === "about" && "is-active"]} href={buildLocalizedPath("/about", locale)}>{t.nav.about}</a></li>
      <li><a class:list={["mobile-drawer-link", active === "partners" && "is-active"]} href={buildLocalizedPath("/partners", locale)}>{t.nav.partners}</a></li>
      <li><a class:list={["mobile-drawer-link", active === "blog" && "is-active"]} href={buildLocalizedPath("/blog", locale)}>{t.nav.blog}</a></li>
      <li><a class:list={["mobile-drawer-link", active === "test" && "is-active"]} href={buildLocalizedPath("/test", locale)}>{t.nav.test}</a></li>
    </ul>
    <a class="mobile-drawer-cta" href={buildLocalizedPath("/contact", locale)}>{t.nav.contactUs}</a>
    <div class="mobile-drawer-divider" aria-hidden="true"></div>
    <div class="mobile-language-selector" data-language-dropdown>
      <button
        type="button"
        class="mobile-language-trigger"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={t.nav.selectLanguage}
        data-language-trigger
      >
        <span class="language-trigger-main">
          <span class="language-flag flag-en" data-current-language-flag aria-hidden="true"></span>
          <span class="language-trigger-label" data-current-language-label>EN</span>
        </span>
        <span class="language-trigger-arrow" aria-hidden="true"></span>
      </button>
      <div class="mobile-language-menu" role="menu" aria-label={t.nav.selectLanguage} data-language-menu>
        {
          languages.map((language) => (
            <a
              class:list={["mobile-language-option", language.code === locale && "is-active"]}
              href={buildLocalizedPath(currentPath, language.code as Locale)}
              data-language-option
              data-language-code={language.code}
              data-language-label={language.label}
              data-language-flag={language.flagClass}
              data-language-href={buildLocalizedPath(currentPath, language.code as Locale)}
              aria-checked={language.code === locale ? "true" : "false"}
              role="menuitemradio"
              title={language.name}
            >
              <span class:list={["language-flag", language.flagClass]} aria-hidden="true"></span>
              <span class="language-menu-name">{language.name}</span>
            </a>
          ))
        }
      </div>
    </div>
    <div class="mobile-drawer-footer">
      <p class="mobile-drawer-footer-tagline">Andorra Investment Excellence</p>
      <div class="mobile-drawer-footer-bottom">
        <a
          href="https://www.linkedin.com/company/equity-partners-andorra"
          class="mobile-drawer-footer-social"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Equity Partners on LinkedIn"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          LinkedIn
        </a>
        <span class="mobile-drawer-footer-legal">equitypartners.fund</span>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ menuPanelId, locale }}>
  const panel = document.getElementById(menuPanelId);
  const header = panel?.closest(".site-header");
  const toggle = header?.querySelector(".menu-toggle");
  const closeButton = header?.querySelector(".menu-close");
  const backdrop = header?.querySelector(".menu-backdrop");
  const languageDropdowns = header?.querySelectorAll("[data-language-dropdown]");
  const defaultLanguage = locale;

  const applyLanguageSelection = (languageCode) => {
    document.documentElement.lang = languageCode;
    try {
      window.localStorage.setItem("equity-partners-language", languageCode);
    } catch {}

    languageDropdowns?.forEach((dropdown) => {
      if (!(dropdown instanceof HTMLElement)) return;

      const currentLabel = dropdown.querySelector("[data-current-language-label]");
      const currentFlag = dropdown.querySelector("[data-current-language-flag]");

      dropdown.querySelectorAll("[data-language-option]").forEach((option) => {
        if (!(option instanceof HTMLElement)) return;
        const isActive = option.dataset.languageCode === languageCode;
        option.classList.toggle("is-active", isActive);
        option.setAttribute("aria-checked", isActive ? "true" : "false");

        if (isActive) {
          if (currentLabel instanceof HTMLElement) {
            currentLabel.textContent = option.dataset.languageLabel || languageCode.toUpperCase();
          }

          if (currentFlag instanceof HTMLElement) {
            currentFlag.className = `language-flag ${option.dataset.languageFlag || ""}`.trim();
          }
        }
      });
    });
  };

  const closeLanguageDropdowns = () => {
    languageDropdowns?.forEach((dropdown) => {
      if (!(dropdown instanceof HTMLElement)) return;
      dropdown.classList.remove("is-open");

      const trigger = dropdown.querySelector("[data-language-trigger]");
      if (trigger instanceof HTMLButtonElement) {
        trigger.setAttribute("aria-expanded", "false");
      }
    });
  };

  if (
    panel instanceof HTMLElement &&
    header instanceof HTMLElement &&
    toggle instanceof HTMLButtonElement &&
    closeButton instanceof HTMLButtonElement &&
    backdrop instanceof HTMLDivElement
  ) {
    const closeMenu = () => {
      header.classList.remove("is-menu-open");
      document.body.classList.remove("mobile-nav-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    const openMenu = () => {
      header.classList.add("is-menu-open");
      document.body.classList.add("mobile-nav-open");
      toggle.setAttribute("aria-expanded", "true");
      closeButton.focus();
    };

    toggle.addEventListener("click", () => {
      if (window.innerWidth > 980) return;
      if (header.classList.contains("is-menu-open")) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeButton.addEventListener("click", closeMenu);
    backdrop.addEventListener("click", closeMenu);

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.classList.contains("is-menu-open")) {
        closeMenu();
        toggle.focus();
      }
      if (event.key === "Escape") {
        closeLanguageDropdowns();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 980) {
        closeMenu();
      }
    });
  }

  if (header instanceof HTMLElement && languageDropdowns?.length) {
    applyLanguageSelection(defaultLanguage);

    languageDropdowns.forEach((dropdown) => {
      if (!(dropdown instanceof HTMLElement)) return;

      const trigger = dropdown.querySelector("[data-language-trigger]");
      const options = dropdown.querySelectorAll("[data-language-option]");

      if (trigger instanceof HTMLButtonElement) {
        trigger.addEventListener("click", (event) => {
          event.stopPropagation();
          const willOpen = !dropdown.classList.contains("is-open");
          closeLanguageDropdowns();
          dropdown.classList.toggle("is-open", willOpen);
          trigger.setAttribute("aria-expanded", willOpen ? "true" : "false");
        });
      }

      options.forEach((option) => {
        if (!(option instanceof HTMLAnchorElement)) return;
        option.addEventListener("click", () => {
          const nextLanguage = option.dataset.languageCode || defaultLanguage;
          applyLanguageSelection(nextLanguage);
          closeLanguageDropdowns();
        });
      });
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) return;
      if (!header.contains(event.target)) {
        closeLanguageDropdowns();
      }
    });
  }
</script>

<style>
  :global(:root) {
    --inner-page-offset: clamp(7.75rem, 11vw, 9.25rem);
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
  }

  .site-header,
  .site-header *,
  .site-header *::before,
  .site-header *::after {
    box-sizing: border-box;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 1.8rem;
    padding-top: 2.15rem;
    padding-bottom: 0.15rem;
    padding-left: calc((100vw - min(1120px, 92vw)) / 2);
    padding-right: calc((100vw - min(1120px, 92vw)) / 2);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    transform: none;
    width: 100%;
    z-index: 220;
    background: rgba(15, 26, 42, 0.92);
    border-bottom: 1px solid transparent;
    border-radius: 0;
    transition:
      padding-top 320ms ease,
      padding-bottom 320ms ease,
      background-color 320ms ease,
      backdrop-filter 320ms ease,
      -webkit-backdrop-filter 320ms ease,
      border-color 320ms ease,
      box-shadow 320ms ease;
  }

  .site-header.offset-next-section + :global(section),
  .site-header.offset-next-section + :global(main) {
    margin-top: var(--inner-page-offset);
  }

  :global(body.is-scrolled) .site-header {
    background: rgba(15, 26, 42, 0.6);
    padding-top: 1.25rem;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom-color: rgba(220, 231, 246, 0.2);
    box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
  }

  :global(body.is-scrolled) .logo {
    top: -5px;
  }

  :global(body.is-scrolled) .main-nav {
    top: -7px;
  }

  :global(body.is-scrolled) .menu-cta {
    top: 0;
  }

  .logo {
    width: 180px;
    height: auto;
    position: relative;
    top: -12px;
    filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
      drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
    transition: top 320ms ease, margin-top 320ms ease;
  }

  .main-nav {
    display: flex;
    align-items: center;
    margin-left: auto;
    flex-wrap: nowrap;
    gap: 1.3rem;
    position: relative;
    top: -11px;
    z-index: 121;
    transition: top 320ms ease;
  }

  .menu-toggle {
    display: none;
    width: 38px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0.45rem;
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: top 320ms ease;
  }

  .menu-toggle-bars {
    display: block;
    width: 18px;
    height: 2px;
    background: #ffffff;
    position: relative;
    transition: background 220ms ease;
  }

  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    content: "";
    position: absolute;
    left: 0;
    width: 18px;
    height: 2px;
    background: #ffffff;
    transition: transform 220ms ease, top 220ms ease;
  }

  .menu-toggle-bars::before {
    top: -6px;
  }

  .menu-toggle-bars::after {
    top: 6px;
  }

  .menu-list {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    white-space: nowrap;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
  }

  .menu-link:hover,
  .menu-link.is-active {
    color: #d7e3f5;
  }

  .language-selector,
  .mobile-language-selector {
    display: inline-flex;
    align-items: center;
    position: relative;
  }

  .language-trigger,
  .mobile-language-trigger,
  .language-menu-item,
  .mobile-language-option {
    border: 0;
    cursor: pointer;
    font: inherit;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .language-trigger,
  .mobile-language-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.48rem;
    min-width: 0;
    min-height: 1rem;
    padding: 0.2rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #ffffff;
  }

  .language-trigger:hover,
  .mobile-language-trigger:hover {
    background: transparent;
  }

  .language-trigger-main {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    min-width: 0;
    line-height: 1;
    position: relative;
    top: 2px;
  }

  .language-trigger-label {
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
  }

  .language-trigger-arrow {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    flex: 0 0 auto;
    margin-top: -0.08rem;
    transition: transform 180ms ease;
  }

  .language-selector.is-open .language-trigger-arrow,
  .mobile-language-selector.is-open .language-trigger-arrow {
    transform: rotate(225deg);
  }

  .language-menu,
  .mobile-language-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 13rem;
    padding: 0.38rem;
    border-radius: 0.95rem;
    background: #ffffff;
    border: 1px solid #d9e2ee;
    box-shadow: 0 18px 40px rgba(8, 14, 23, 0.18);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    z-index: 260;
  }

  .language-selector.is-open .language-menu,
  .mobile-language-selector.is-open .mobile-language-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .language-menu-item,
  .mobile-language-option {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.7rem 0.78rem;
    border-radius: 0.7rem;
    background: transparent;
    color: #172235;
    text-align: left;
    text-decoration: none;
  }

  .language-menu-item:hover,
  .language-menu-item.is-active,
  .mobile-language-option:hover,
  .mobile-language-option.is-active {
    background: #f1f5fb;
    box-shadow: inset 0 0 0 1px #d8e1ee;
  }

  .language-menu-name {
    display: inline-flex;
    align-items: center;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    color: #172235;
    line-height: 1;
    position: relative;
    top: 0.02rem;
  }

  .language-flag {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    display: inline-flex;
    border: 1px solid rgba(23, 34, 53, 0.12);
    flex: 0 0 auto;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .flag-en {
    background-image: url("/images/branding/uk-flag.png");
  }

  .flag-es {
    background: linear-gradient(180deg, #c62828 0 28%, #f4c430 28% 72%, #c62828 72% 100%);
  }

  .flag-ca {
    background:
      linear-gradient(
        180deg,
        transparent 0 10%,
        #f4c430 10% 22%,
        #b3261e 22% 34%,
        #f4c430 34% 46%,
        #b3261e 46% 58%,
        #f4c430 58% 70%,
        #b3261e 70% 82%,
        #f4c430 82% 94%,
        transparent 94% 100%
      ),
      #f7d046;
  }

  .menu-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    top: 1px;
    flex: 0 0 auto;
    min-width: 126px;
    color: #ffffff;
    background: #53b27f;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    border-radius: 0.45rem;
    padding: 0.65rem 0.95rem;
    font-weight: 600;
    line-height: 1;
    border: 1px solid #53b27f;
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      transform 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .menu-cta:hover {
    background: #3f9568;
    border-color: #3f9568;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
  }

  .menu-cta:focus-visible {
    outline: 2px solid rgba(216, 227, 242, 0.5);
    outline-offset: 3px;
  }

  .menu-backdrop,
  .mobile-drawer {
    display: none;
  }

  @supports not ((backdrop-filter: blur(1px))) {
    :global(body.is-scrolled) .site-header {
      background: rgba(15, 26, 42, 0.84);
    }
  }

  @media (max-width: 980px) {
    .site-header {
      gap: 0.65rem;
      min-height: 44px;
    }

    .language-selector {
      display: none;
    }

    :global(body.is-scrolled) .site-header {
      padding-top: 2.15rem;
      padding-bottom: 0.15rem;
    }

    :global(body.is-scrolled) .logo {
      top: -12px;
    }

    :global(body.is-scrolled) .main-nav {
      top: -11px;
    }

    .main-nav {
      position: static;
      gap: 0.55rem;
    }

    .menu-toggle {
      display: inline-flex;
      position: relative;
      top: -10px;
      border: 0;
      box-shadow: none;
      z-index: 250;
    }

    .menu-list {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: max(0.8rem, calc((100vw - min(1120px, 92vw)) / 2));
      min-width: min(220px, calc(100vw - 2rem));
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      padding: 0;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transform: translateY(-8px);
      pointer-events: none;
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid #d3ddea;
      border-radius: 0.6rem;
      transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
      z-index: 220;
    }

    .menu-list .menu-link {
      width: 100%;
      color: #172235;
      text-shadow: none;
      font-size: 0.76rem;
      padding: 0.3rem 0;
    }

    .menu-list .menu-link:hover,
    .menu-list .menu-link.is-active {
      color: #5e7393;
    }

    .menu-cta {
      display: inline-flex;
      top: -10px;
      min-width: 102px;
      padding: 0.58rem 0.8rem;
      font-size: 0.68rem;
    }

    :global(body.is-scrolled) .menu-cta {
      top: -10px;
    }

    .menu-backdrop {
