---
import { blogPosts } from "../data/blogPosts";
import SiteFooter from "../components/SiteFooter.astro";

const advantages = [
  {
    title: "Local Network",
    description:
      "Direct relationships with landowners, advisors, and Andorran operators unlock faster access to qualified opportunities.",
  },
  {
    title: "Regulatory Expertise",
    description:
      "We navigate planning, approvals, and compliance in the Principality with disciplined local execution.",
  },
  {
    title: "Lifecycle Management",
    description:
      "From sourcing through delivery, we manage project decisions end-to-end with investor clarity at every stage.",
  },
];

const projects = [
  {
    name: "Nanta Alta Luxury villas",
    status: "Under Construction",
    value: "€50M",
    sector: "Luxury Residential",
    image: "/04c%20copy.jpg",
  },
  {
    name: "Ordino Heights",
    status: "Pipeline",
    value: "€18M",
    sector: "Residential Development",
    image: "/ordino%20heights.jpg",
  },
  {
    name: "Funicamp ski Residencies",
    status: "Pipeline",
    value: "€22M",
    sector: "Mixed-Use",
    image: "/funicamp%20ski.jpg",
  },
];

const localPartners = [
  { name: "AR Team", logo: "/images/partners/AR%20logo%20EP.png" },
  { name: "DATA", logo: "/images/partners/DATA LOGO.png" },
  { name: "Emindset Law", logo: "/images/partners/Emindset LAW LOGO.png" },
  { name: "Govern d'Andorra", logo: "/images/partners/Govern d'Andorra logo.png" },
  { name: "Creand", logo: "/images/partners/creand.webp" },
  { name: "Engel & Volkers", logo: "/images/partners/engel volkers logo.png" },
  { name: "Heracles", logo: "/images/partners/heracles%20logo.png" },
  { name: "Pret a Porter Casas", logo: "/images/partners/pret%20a%20porter%20casas%20logo.svg" },
  { name: "Hormipresa", logo: "/images/partners/hormipresa%20.webp" },
  { name: "MoraBank", logo: "/images/partners/mora%20bank.png" },
];

const localPartnersLoop = [...localPartners, ...localPartners, ...localPartners, ...localPartners];
const homepageSuggestedPosts = blogPosts.slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Equity Partners | Andorra Property Group</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@700&display=swap");

      :root {
        --bg-night: #06080c;
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --text-primary: #1f2835;
        --text-muted: #5a667a;
        --text-light: #e8edf5;
        --accent: #8293ae;
        --line: #dbe1ea;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
        color: var(--text-primary);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.5;
      }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .hero {
        min-height: 84vh;
        padding: 2rem 0 2.1rem;
        background: linear-gradient(
            to bottom,
            rgba(6, 8, 12, 0.4) 0%,
            rgba(6, 8, 12, 0.26) 18%,
            rgba(6, 8, 12, 0.18) 34%,
            rgba(6, 8, 12, 0.3) 100%
          ),
          url("/hero-andorra-R2PtlkD-.jpg")
            center / cover no-repeat;
        color: var(--text-light);
        display: flex;
        flex-direction: column;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 1.8rem;
        padding-top: 2.15rem;
        padding-bottom: 0.15rem;
        padding-left: calc((100vw - min(var(--max-width), 92vw)) / 2);
        padding-right: calc((100vw - min(var(--max-width), 92vw)) / 2);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: none;
        width: 100%;
        z-index: 220;
        background: transparent !important;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        transition: padding-top 320ms ease, padding-bottom 320ms ease, background-color 320ms ease,
          backdrop-filter 320ms ease, -webkit-backdrop-filter 320ms ease, border-color 320ms ease,
          box-shadow 320ms ease;
      }

      body.is-scrolled .site-header {
        background: rgba(15, 26, 42, 0.6) !important;
        padding-top: 1.25rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom-color: rgba(220, 231, 246, 0.2);
        box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
      }

      body.is-scrolled .menu-cta {
        background: rgba(255, 255, 255, 0.96);
        border-color: rgba(255, 255, 255, 0.95);
      }

      @supports not ((backdrop-filter: blur(1px))) {
        body.is-scrolled .site-header {
          background: rgba(15, 26, 42, 0.84) !important;
        }
      }

      .logo {
        width: 180px;
        height: auto;
        position: relative;
        top: -5px;
        filter: brightness(0) invert(1);
        filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
          drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
      }

      .main-nav {
        display: flex;
        align-items: center;
        margin-left: auto;
        flex-wrap: nowrap;
        gap: 1.3rem;
        position: relative;
        top: -4px;
        z-index: 121;
      }

      .menu-toggle-input {
        display: none;
      }

      .menu-toggle {
        display: none;
        width: 38px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 0.45rem;
        background: transparent;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }

      .menu-toggle-bars {
        display: block;
        width: 18px;
        height: 2px;
        background: #ffffff;
        position: relative;
        transition: background 220ms ease;
      }

      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        background: #ffffff;
        transition: transform 220ms ease, top 220ms ease;
      }

      .menu-toggle-bars::before {
        top: -6px;
      }

      .menu-toggle-bars::after {
        top: 6px;
      }

      .menu-list {
        list-style: none;
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        white-space: nowrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
      }

      .menu-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }

      .menu-link:hover {
        color: #d7e3f5;
      }

      .menu-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: 1px;
        flex: 0 0 auto;
        min-width: 126px;
        color: #172235;
        background: rgba(255, 255, 255, 0.96);
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(255, 255, 255, 0.95);
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease;
      }

      .menu-cta:hover {
        background: rgba(224, 233, 246, 0.96);
        color: #101b2c;
        transform: translateY(-1px);
      }

      .menu-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.9);
        outline-offset: 2px;
      }

      .hero-content {
        margin-top: auto;
        max-width: 50rem;
        padding-top: 10rem;
        padding-bottom: 0;
        transform: translateY(4.5rem);
        animation: rise 900ms 120ms ease both;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1 {
        margin: 0;
        font-family: "Open Sans", "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 5vw, 4rem);
        letter-spacing: 0.02em;
        line-height: 1.08;
      }

      .subline {
        margin-top: 0.9rem;
        max-width: 42rem;
        color: rgba(255, 255, 255, 0.96);
        font-size: clamp(1rem, 1.8vw, 1.2rem);
      }

      .hero-kicker {
        margin-top: 0;
        margin-bottom: 1.1rem;
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 0.9rem;
        border-radius: 0.45rem;
        background: rgba(15, 26, 42, 0.42);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 10px 24px rgba(7, 12, 20, 0.18);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        font-size: 0.78rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: #eef4fb;
      }

      .section {
        padding: 4rem 0;
      }

      .partners-wrap {
        background: #ffffff;
        border-bottom: 1px solid var(--line);
        padding: 2.2rem 0 2rem;
        overflow: hidden;
      }

      .partners-link {
        display: block;
        color: inherit;
        text-decoration: none;
      }

      .partners-link:focus-visible {
        outline: 2px solid rgba(130, 147, 174, 0.45);
        outline-offset: 3px;
      }

      .partners-title {
        margin: 0 0 1.4rem;
        text-align: center;
        font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        font-weight: 400;
        text-decoration: none;
      }

      .partners-divider {
        width: 110px;
        height: 1px;
        margin: 0.85rem auto 1.3rem;
        background: #d8dee9;
      }

      .partners-marquee {
        position: relative;
        overflow: hidden;
        width: 100%;
      }

      .partners-track {
        display: flex;
        width: max-content;
        gap: 3rem;
        animation: partners-scroll 46s linear infinite;
      }

      .partner-logo-box {
        flex: 0 0 auto;
        width: 145px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.2rem 0.45rem;
      }

      .partner-logo-box img {
        width: 100%;
        height: 48px;
        display: block;
        object-fit: contain;
        object-position: center;
        filter: grayscale(100%) brightness(0.88);
        opacity: 0.9;
        transition: filter 200ms ease, opacity 200ms ease, transform 200ms ease;
      }

      .partner-logo-box img.is-morabanc {
        filter: grayscale(100%) brightness(0.34) contrast(1.18);
        opacity: 1;
      }

      .partner-logo-box:hover img {
        filter: grayscale(0%) brightness(0.98);
        opacity: 1;
        transform: translateY(-1px);
      }

      .partner-logo-box:hover img.is-morabanc {
        filter: grayscale(100%) brightness(0.34) contrast(1.18);
      }

      .advantage-home {
        padding-bottom: 3rem;
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .advantage-home-grid {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        width: 100%;
        align-items: stretch;
      }

      .advantage-home-card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.3rem;
        height: 100%;
      }

      .advantage-home-icon {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
      }

      .advantage-home-icon img {
        width: 46px;
        height: 46px;
        object-fit: contain;
        display: block;
      }

      .advantage-home-card h3 {
        margin-top: 0.45rem;
        color: var(--text-strong);
        font-size: 1.15rem;
      }

      .advantage-home-kicker {
        margin-top: 0.7rem;
        color: #5a667a;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .advantage-home-card p {
        margin-top: 0.6rem;
        color: var(--text-muted);
      }

      .advantage-home-list {
        list-style: none;
        margin: 0.75rem 0 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .advantage-home-list li {
        display: grid;
        grid-template-columns: 1.5rem 1fr;
        gap: 0.7rem;
        align-items: start;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.46;
      }

      .advantage-home-check {
        width: 1.5rem;
        height: 1.5rem;
        color: #48a86f;
        margin-top: 0.04rem;
      }

      .advantage-home-check svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.15;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .advantage-home-grid.is-test .advantage-home-card-head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.45rem;
      }

      .advantage-home-grid.is-test .advantage-home-icon {
        width: 3.6rem;
        height: 3.6rem;
        border-radius: 1.1rem;
        background: #eef3f9;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
      }

      .advantage-home-grid.is-test .advantage-home-icon img {
        width: 1.8rem;
        height: 1.8rem;
      }

      .advantage-home:not(.is-dark-cards) .advantage-home-grid.is-test .advantage-home-icon {
        background: #53b27f;
      }

      .advantage-home:not(.is-dark-cards) .advantage-home-grid.is-test .advantage-home-icon img {
        filter: brightness(0) invert(1);
      }

      .advantage-home-grid.is-test .advantage-home-card h3 {
        margin-top: 0;
      }

      .advantage-home-grid.is-test .advantage-home-card p {
        margin-top: 0;
      }

      .advantage-home .focus-intro {
        max-width: none;
        width: 100%;
      }

      .advantage-home.is-dark-cards .advantage-home-card {
        background: #eef2f8;
        border: 1px solid rgba(18, 33, 56, 0.28);
        box-shadow: 0 16px 30px rgba(10, 18, 31, 0.08);
      }

      .advantage-home.is-dark-cards {
        background: #0f1a2a;
        border-top: 1px solid rgba(220, 228, 240, 0.15);
        border-bottom: 1px solid rgba(220, 228, 240, 0.15);
      }

      .advantage-home.is-dark-cards .focus-label,
      .advantage-home.is-dark-cards .focus-title {
        color: #f3f7fc;
      }

      .advantage-home.is-dark-cards .focus-intro {
        color: rgba(230, 238, 247, 0.78);
      }

      .advantage-home.is-dark-cards .advantage-home-card h3 {
        color: #172235;
      }

      .advantage-home.is-dark-cards .advantage-home-card p {
        color: #5a667a;
      }

      .advantage-home.is-dark-cards .advantage-home-grid.is-test .advantage-home-icon {
        background: #53b27f;
      }

      .advantage-home.is-dark-cards .advantage-home-grid.is-test .advantage-home-icon img {
        filter: brightness(0) invert(1);
      }

      .advantage-home.is-dark-cards .cta-link {
        color: #f3f7fc;
      }

      @keyframes partners-scroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-25%);
        }
      }

      .focus-section {
        padding: 2.4rem 0 3rem;
        background: #f2f5fa;
        border-top: 1px solid #dce3ee;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-layout {
        display: grid;
        grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.25fr);
        gap: 2.6rem;
        align-items: start;
      }

      .focus-label {
        margin: 0;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #8a99ae;
      }

      .focus-label.is-partners-title {
        font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        font-weight: 400;
        color: var(--accent);
        margin-bottom: 0.85rem;
      }

      .focus-title {
        margin-top: 0;
        font-size: clamp(1.9rem, 3.4vw, 3rem);
        line-height: 1.08;
        color: #1f2b3c;
      }

      .focus-intro {
        margin-top: 0.9rem;
        width: 100%;
        max-width: none;
        color: var(--text-muted);
      }

      .focus-list {
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid #dce3ee;
      }

      .focus-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        column-gap: 0.95rem;
        row-gap: 0.35rem;
        padding: 1.18rem 0 1.24rem;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-index {
        font-size: 0.73rem;
        letter-spacing: 0.09em;
        color: #8f9db1;
        margin-top: 0.2rem;
      }

      .focus-item-title {
        font-size: 1.18rem;
        line-height: 1.22;
        color: #24344c;
      }

      .focus-item-copy {
        grid-column: 2;
        margin: 0;
        color: #66758a;
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .focus-section-f {
        padding: 4rem 0;
        background: #f2f5fa;
        border-top: 1px solid #dce3ee;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-f-header {
        margin-bottom: 0.9rem;
      }

      .focus-f-header .focus-label {
        color: #5a667a;
      }

      .focus-f-header .focus-title {
        color: #0f1a2a;
      }

      .focus-f-header .focus-intro {
        color: #5a667a;
        max-width: none;
        width: 100%;
      }

      .focus-f-body {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 1rem;
        align-items: stretch;
      }

      .focus-f-body .focus-c-panels {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.8rem;
      }

      .focus-c-kpi {
        background: #ffffff;
        border: 1px solid #c4cedd;
        border-radius: 0.9rem;
        padding: 1rem;
      }

      .focus-c-kpi-value {
        color: #0f1a2a;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .focus-c-kpi h3 {
        margin-top: 0.45rem;
        color: #0f1a2a;
        font-size: 1.06rem;
      }

      .focus-c-kpi p {
        margin-top: 0.5rem;
        color: #5a667a;
        font-size: 0.88rem;
      }

      .focus-f-body .focus-c-media {
        border-radius: 1rem;
        min-height: 0;
        height: 100%;
        background:
          linear-gradient(180deg, rgba(9, 15, 25, 0.12), rgba(9, 15, 25, 0.18)),
          url("/Ordino%20AND%20IMG%20day%20snow.webp") center / cover no-repeat;
      }

      .focus-f-body .focus-c-media.is-canillo {
        background:
          linear-gradient(180deg, rgba(9, 15, 25, 0.12), rgba(9, 15, 25, 0.18)),
          url("/Andorra%20Canillo.jpg") center / cover no-repeat;
      }

      .focus-section-f.is-concept-f {
        background: #0f1a2a;
        border-top: 1px solid rgba(214, 225, 244, 0.2);
        border-bottom: 1px solid rgba(214, 225, 244, 0.2);
      }

      .focus-section-f.is-concept-f .focus-f-header .focus-label {
        color: #9fb4d2;
      }

      .focus-section-f.is-concept-f .focus-f-header .focus-title {
        color: #ffffff;
      }

      .focus-section-f.is-concept-f .focus-f-header .focus-intro {
        color: #d6e0ef;
      }

      .focus-section-f.is-concept-f .focus-c-kpi {
        background: rgba(246, 251, 255, 0.08);
        border: 1px solid rgba(214, 225, 244, 0.2);
      }

      .focus-section-f.is-concept-f .focus-c-kpi-value {
        color: #9fb4d2;
      }

      .focus-section-f.is-concept-f .focus-c-kpi h3 {
        color: #f4f8ff;
      }

      .focus-section-f.is-concept-f .focus-c-kpi p {
        color: #d6e0ef;
      }

      .focus-section-f.is-concept-f .focus-c-media {
        background: url("/Ordino%20AND%20IMG%20day%20snow.webp") center / cover no-repeat;
      }

      .focus-section-f.is-concept-f .focus-c-media.is-canillo {
        background: url("/Andorra%20Canillo.jpg") center / cover no-repeat;
      }

      .focus-section-f.is-concept-f .cta-link {
        color: #f3f7fc;
      }

      .why-equity-home {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        font-family: "Montserrat", "Avenir Next", "Segoe UI", Arial, sans-serif;
      }

      .why-equity-home-body {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
