---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const aboutLogoStrip = [
  { name: "Andorra Resident", logo: "/images/partners/AR%20Logo%20EP.png" },
  { name: "Emindset Law", logo: "/images/partners/Emindset LAW LOGO.png" },
  { name: "DATA", logo: "/images/partners/DATA LOGO.png" },
  { name: "Creand", logo: "/images/partners/creand.webp" },
  { name: "MoraBanc", logo: "/images/partners/mora bank.png" },
];
const teamMembers = [
  {
    name: "Bing Voorham",
    role: "CEO & Co-founder",
    image: "/images/Team/Bing Sr EP.png",
    description:
      "International investor with over 30 years of experience in sales and marketing real estate projects across Europe, providing strategic capital and access to high-net-worth networks",
  },
  {
    name: "Oriol Giro",
    role: "Lawyer & co-founder",
    image: "/images/Team/Oriol Giro EP.jpg",
    description:
      "Expert in investment structuring and projects financing. Oriol leads the project legal and financing strategy, as well as overseeing transaction structuring, financial modeling and investor relations.",
  },
  {
    name: "Carlos Ayete",
    role: "Technical Architect",
    image: "/images/Team/Calors EP.jpg",
    description:
      "With over 25 years of extensive expertise in real estate investment, land acquisition and strategic development. Carlos combines his deep knowledge of the Andorrean maket with a strong internatinoal outlook.",
  },
  {
    name: "Bing Jr",
    role: "Partnerships & Sales",
    image: "/images/Team/Bing Jr EP.png",
    description:
      "With a Master degree in Digital Business from the University of Amsterdam and 4 years of experience at Salesforce, Bing's international past and results-oriented mindset brings deep knowledge of digital acquisition.",
  },
  {
    name: "Tekke Voorham",
    role: "Ditigal Marketing",
    image: "/images/Team/Tekke EP.png",
    description:
      "Directing our creative strategy, Tekke translates our institutional values into a world-class visual identity and seamless digital experience for our investors.",
  },
  {
    name: "Laia Bertran",
    role: "Legal Analyst",
    image: "/images/Team/Laia EP.jpg?v=20260330",
    description:
      "Laia oversees the intersection of legal framework and investor onboarding, ensuring every transaction adheres to the highest standards of Andorran compliance.",
  },
  {
    name: "Future Team Member",
    role: "Strategic Role",
    image: "",
    description:
      "Placeholder profile text for a future team member card. This can be updated with real biography details later.",
    placeholder: true,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>About Us | Equity Partners</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --navy: #0f1a2a;
        --navy-soft: #1f2f46;
        --slate: #5f7087;
        --slate-light: #8da0b9;
        --paper: #f4f6fa;
        --white: #ffffff;
        --line: #dbe3ee;
        --max-width: 1120px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--navy-soft);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--paper) 50%);
        line-height: 1.55;
      }

      h1, h2, h3, p { margin: 0; }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 1.8rem;
        padding-top: 2.15rem;
        padding-bottom: 0.15rem;
        padding-left: calc((100vw - min(var(--max-width), 92vw)) / 2);
        padding-right: calc((100vw - min(var(--max-width), 92vw)) / 2);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: none;
        width: 100%;
        z-index: 220;
        background: rgba(15, 26, 42, 0.92) !important;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        transition: padding-top 320ms ease, padding-bottom 320ms ease, background-color 320ms ease,
          backdrop-filter 320ms ease, -webkit-backdrop-filter 320ms ease, border-color 320ms ease,
          box-shadow 320ms ease;
      }

      body.is-scrolled .site-header {
        background: rgba(15, 26, 42, 0.6) !important;
        padding-top: 1.25rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom-color: rgba(220, 231, 246, 0.2);
        box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
      }

      body.is-scrolled .menu-cta {
        background: #53b27f;
        border-color: #53b27f;
      }

      body.is-scrolled .logo {
        top: -5px;
      }

      body.is-scrolled .main-nav {
        top: -4px;
      }

      @supports not ((backdrop-filter: blur(1px))) {
        body.is-scrolled .site-header {
          background: rgba(15, 26, 42, 0.84) !important;
        }
      }

      .logo {
        width: 180px;
        height: auto;
        position: relative;
        top: -12px;
        filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
          drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
        transition: top 320ms ease, margin-top 320ms ease;
      }

      .main-nav {
        display: flex;
        align-items: center;
        margin-left: auto;
        flex-wrap: nowrap;
        gap: 1.3rem;
        position: relative;
        top: -11px;
        z-index: 121;
        transition: top 320ms ease;
      }

      .menu-toggle-input { display: none; }

      .menu-toggle {
        display: none;
        width: 38px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 0.45rem;
        background: transparent;
        align-items: center;
        justify-content: center;
        cursor: pointer;
      }

      .menu-toggle-bars,
      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        width: 18px;
        height: 2px;
        background: #ffffff;
      }

      .menu-toggle-bars {
        display: block;
        position: relative;
        transition: background 220ms ease;
      }

      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        transition: transform 220ms ease, top 220ms ease;
      }

      .menu-toggle-bars::before { top: -6px; }
      .menu-toggle-bars::after { top: 6px; }

      .menu-list {
        list-style: none;
        display: flex;
        align-items: center;
        white-space: nowrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
      }

      .menu-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }

      .menu-link:hover,
      .menu-link.is-active { color: #d7e3f5; }

      .menu-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: 1px;
        flex: 0 0 auto;
        min-width: 126px;
        color: #ffffff;
        background: #53b27f;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid #53b27f;
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, top 320ms ease;
      }

      .menu-cta:hover {
        background: #3f9568;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
      }

      .menu-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.9);
        outline-offset: 2px;
      }

      .journey-hero {
        padding: 3.1rem 0 2.35rem;
      }

      .journey-hero-head {
        width: 100%;
        max-width: none;
        margin: 0 auto;
        text-align: center;
      }

      .journey-hero-title {
        color: var(--navy);
        font-size: clamp(2.1rem, 4.7vw, 4rem);
        line-height: 1.04;
        letter-spacing: -0.02em;
        max-width: none;
        margin: 0 auto;
      }

      .journey-hero-copy {
        margin: 1.1rem auto 0;
        color: var(--slate);
        font-size: 1rem;
        line-height: 1.65;
        width: 100%;
        max-width: none;
      }

      .journey-hero-grid {
        margin-top: 2.35rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .journey-hero-card {
        min-height: 24rem;
        border-radius: 1.25rem;
        overflow: hidden;
        border: 1px solid #dfe7f1;
        background: #f7f9fc;
        box-shadow: 0 18px 36px rgba(15, 26, 42, 0.08);
      }

      .journey-hero-portrait {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        display: block;
      }

      .journey-proof {
        background: #172235;
        padding: 4.2rem 0;
      }

      .journey-proof-shell {
        border: 0;
        border-radius: 0;
        background: transparent;
        padding: 0;
        box-shadow: none;
      }

      .journey-proof-logos {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1rem;
        align-items: center;
      }

      .journey-proof-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 2.4rem;
        opacity: 0.42;
      }

      .journey-proof-logo img {
        max-width: 7rem;
        max-height: 1.6rem;
        width: auto;
        height: auto;
        filter: grayscale(100%);
      }

      .journey-proof-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
        gap: 1.6rem;
        align-items: center;
      }

      .journey-proof-copy {
        align-self: start;
        padding: 0;
      }

      .journey-proof-label {
        margin: 0 0 0.85rem;
        font-size: 0.74rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #9fb4d2;
      }

      .journey-proof-copy h2 {
        margin-top: 0;
        color: #ffffff;
        font-size: clamp(1.9rem, 3.4vw, 3rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
        max-width: 20ch;
      }

      .journey-proof-copy p + h2 + p {
        margin-top: 0.95rem;
        width: 100%;
        max-width: none;
        color: #ffffff;
        font-size: 1.1rem;
        line-height: 1.6;
      }

      .journey-proof-metrics {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
        padding: 0.35rem 0;
      }

      .journey-proof-metric {
        background: #22324a;
        border: 1px solid rgba(216, 227, 242, 0.1);
        border-radius: 1.1rem;
        padding: 1.4rem 1.2rem;
        min-height: 10.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .journey-proof-metric-label {
        color: #b7c7de;
        font-size: 0.73rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        line-height: 1.45;
        max-width: none;
        width: 100%;
      }

      .journey-proof-metric-value {
        color: #ffffff;
        font-size: clamp(2rem, 4vw, 2.7rem);
        line-height: 1;
        width: 100%;
      }

      .journey-proof-metric-value + .journey-proof-metric-label {
        margin-top: 0.9rem;
      }

      .why-equity {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .why-equity-body {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 1.25rem;
        align-items: stretch;
      }

      .why-equity-media {
        min-height: 34rem;
        border-radius: 1.25rem;
        overflow: hidden;
        border: 1px solid var(--line);
        background: #dde6f2;
      }

      .why-equity-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .why-equity-points {
        display: grid;
        gap: 0.9rem;
      }

      .why-equity-point {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.4rem 1.5rem;
        display: grid;
        grid-template-columns: 3.75rem minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
      }

      .why-equity-point-icon {
        width: 3.75rem;
        height: 3.75rem;
        border-radius: 1.1rem;
        background: #53b27f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .why-equity-point-icon img {
        width: 1.85rem;
        height: 1.85rem;
        object-fit: contain;
        display: block;
        filter: brightness(0) invert(1);
      }

      .why-equity-point-copy h3 {
        margin: 0;
        color: var(--navy);
        font-size: 1.15rem;
      }

      .why-equity-point-copy p {
        margin-top: 0.55rem;
        color: var(--slate);
        font-size: 0.96rem;
        line-height: 1.46;
      }

      .why-equity .section-header h2 {
        margin-top: 0;
        font-size: clamp(1.9rem, 3.3vw, 3rem);
        line-height: 1.06;
      }

      .team-variant-circles .section-header .eyebrow {
        margin-bottom: 0.85rem;
      }

      .team-variant-circles .section-header h2 {
        margin-top: 0;
        font-size: clamp(1.9rem, 3.3vw, 3rem);
        line-height: 1.06;
      }

      .section {
        padding: 4.2rem 0;
      }

      .section-header {
        max-width: none;
        width: 100%;
      }

      .intro {
        margin-top: 0.9rem;
        width: 100%;
        max-width: none;
        color: var(--slate);
      }

      .philosophy {
        text-align: center;
        background: #ffffff;
      }

      .eyebrow {
        font-size: 0.74rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--slate-light);
      }

      .philosophy h2 {
        margin-top: 0.6rem;
        color: var(--navy);
        font-size: clamp(1.7rem, 3vw, 2.55rem);
        line-height: 1.15;
      }

      .philosophy-copy {
        margin: 1rem auto 0;
        max-width: 64ch;
        color: var(--slate);
      }

      .philosophy-copy p + p {
        margin-top: 0.95rem;
      }

      .advantage {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .advantage-grid {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .advantage-card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.3rem;
      }

      .advantage-icon {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid #cfd8e8;
        color: #4f6079;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .advantage-card h3 {
        margin-top: 0.7rem;
        color: var(--navy);
        font-size: 1.15rem;
      }

      .advantage-card p {
        margin-top: 0.6rem;
        color: var(--slate);
      }

      .methodology {
        background: #ffffff;
      }

      .timeline {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.7rem;
        align-items: start;
      }

      .timeline-step {
        position: relative;
        padding-top: 1.35rem;
      }

      .timeline-step::before {
        content: "";
        position: absolute;
        top: 0.45rem;
        left: 0;
        right: 0;
        height: 1px;
        background: #d4ddea;
      }

      .timeline-step:first-child::before {
        left: 22px;
      }

      .timeline-step:last-child::before {
        right: 22px;
      }

      .timeline-dot {
        width: 12px;
        height: 12px;
        border-radius: 999px;
        background: var(--navy);
        margin-bottom: 0.75rem;
      }

      .timeline-step h3 {
        color: var(--navy);
        font-size: 1.05rem;
      }

      .timeline-step p {
        margin-top: 0.5rem;
        color: var(--slate);
        font-size: 0.92rem;
      }

      .about-cta {
        background: #0f1a2a;
        color: #eef4fb;
        text-align: center;
        border-top: 1px solid rgba(219, 227, 240, 0.12);
        border-bottom: 1px solid rgba(219, 227, 240, 0.12);
      }

      .team-role {
        margin-top: 0.4rem;
        color: #8293ae;
        font-size: 0.76rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .team-description {
        margin-top: 0.6rem;
        color: var(--slate);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .team-variant-circles {
        background: #ffffff;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .team-variant-circles-dark {
        background: #0f1a2a;
        border-top: 1px solid #24354d;
        border-bottom: 1px solid #24354d;
      }

      .team-variant-circles-dark .eyebrow {
        color: #9fb4d2;
      }

      .team-variant-circles-dark h2,
      .team-variant-circles-dark .team-circle-card h3 {
        color: #ffffff;
      }

      .team-variant-circles-dark .intro,
      .team-variant-circles-dark .team-role {
        color: #c7d3e5;
      }

      .team-variant-circles-dark .team-description {
        color: #ffffff;
      }

      .team-variant-circles-dark .team-circle-card img {
        border-color: rgba(255, 255, 255, 0.22);
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
      }

      .team-variant-circles .team-circle-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(215, 226, 241, 0.14);
        border-radius: 1rem;
        padding: 1.15rem 0.9rem 1.2rem;
        box-shadow: 0 16px 30px rgba(0, 0, 0, 0.16);
      }

      .team-variant-cards .team-circle-grid {
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      .team-variant-circles-dark .team-circle-placeholder {
        border-color: rgba(255, 255, 255, 0.26);
        background: rgba(255, 255, 255, 0.03);
      }

      .team-circle-grid {
        margin-top: 1.9rem;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1rem;
      }

      .team-circle-card {
        text-align: center;
        padding: 1rem 0.6rem;
      }

      .team-circle-card img {
        width: 148px;
        height: 148px;
        border-radius: 999px;
        object-fit: cover;
        display: block;
        margin: 0 auto;
        border: 2px solid #2a3a50;
        box-shadow: 0 10px 24px rgba(15, 26, 42, 0.12);
        filter: grayscale(100%);
      }

      .team-circle-card .team-circle-placeholder {
        width: 148px;
        height: 148px;
        border-radius: 999px;
        margin: 0 auto;
        border: 2px dashed rgba(42, 58, 80, 0.5);
        background: rgba(42, 58, 80, 0.04);
      }

      .team-circle-card h3 {
        margin-top: 1rem;
        color: var(--navy);
        font-size: 1.08rem;
      }



      .team-circle-card .team-role {
        margin-top: 0.45rem;
      }

      .team-circle-card .team-description {
        margin-top: 0.65rem;
      }

      .about-cta h2 {
        font-size: clamp(1.45rem, 3vw, 2.2rem);
        line-height: 1.16;
        color: #f2f6fc;
      }

      .about-cta .cta-button {
        margin-top: 1.1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #d8e3f2;
        color: #132238;
        text-decoration: none;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(216, 227, 242, 0.96);
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease;
      }

      .about-cta .cta-button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-1px);
      }

      @media (max-width: 980px) {
        .journey-hero-grid,
        .journey-proof-logos,
        .journey-proof-body,
        .journey-proof-metrics,
        .why-equity-body,
        .advantage-grid,
        .team-circle-grid,
        .timeline,

        .journey-hero-head {
          max-width: 36rem;
        }

        .team-variant-cards .team-circle-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

      }

      @media (max-width: 680px) {
        .site-header {
          gap: 0.45rem;
          min-height: 44px;
          padding-bottom: 0.45rem;
        }

        body.is-scrolled .site-header {
          padding-top: 2.15rem;
          padding-bottom: 0.75rem;
        }

        .main-nav {
          position: static;
          gap: 0.55rem;
        }

        .menu-toggle {
          display: inline-flex;
          position: relative;
          top: -7px;
          border: 0;
          box-shadow: none;
        }

        .menu-cta {
