---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getLocaleFromUrl } from "../lib/i18n";
import { getContentTranslations } from "../i18n/content";
import { getPageTitle } from "../i18n/ui";

const partners = [
  {
    name: "Andorra Resident",
    role: "",
    summary: "",
    logo: "/images/partners/AR%20Logo%20EP.png",
  },
  {
    name: "Emindset Law",
    role: "",
    summary: "",
    logo: "/images/partners/Emindset LAW LOGO.png",
  },
  {
    name: "Govern d'Andorra",
    role: "",
    summary: "",
    logo: "/images/partners/Govern d'Andorra logo.png",
  },
  {
    name: "DATA Architects",
    role: "",
    summary: "",
    logo: "/images/partners/DATA LOGO.png",
  },
  {
    name: "Engel & Völkers",
    role: "",
    summary: "",
    logo: "/images/partners/engel volkers logo.png",
  },
  {
    name: "MoraBank",
    role: "",
    summary: "",
    logo: "/images/partners/mora%20bank.png",
  },
  {
    name: "Pret a Porter Casas",
    role: "",
    summary: "",
    logo: "/images/partners/pret%20a%20porter%20casas%20logo.svg",
  },
  {
    name: "Heracles",
    role: "",
    summary: "",
    logo: "/images/partners/heracles%20logo.png",
  },
  {
    name: "Hormipresa",
    role: "",
    summary: "",
    logo: "/images/partners/hormipresa%20.webp",
  },
  {
    name: "Mariné Construccions",
    role: "",
    summary: "",
    logo: "/images/partners/marine.png",
  },
];
const locale = getLocaleFromUrl(Astro.url);
const content = getContentTranslations(locale).partners;
const partnerSlug = (name: string): string =>
  name
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
const localizedPartners = partners.map((partner, index) => ({
  ...partner,
  slug: partnerSlug(partner.name),
  role: content.entries[index]?.role ?? partner.role,
  summary: content.entries[index]?.summary ?? partner.summary,
}));

---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{getPageTitle(locale, "partners")}</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --text-primary: #1f2835;
        --text-muted: #5a667a;
        --text-light: #e8edf5;
        --accent: #8293ae;
        --line: #dbe1ea;
        --max-width: 1120px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--text-primary);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.5;
      }

      h1, h2, h3, p { margin: 0; }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 1.8rem;
        padding-top: 2.15rem;
        padding-bottom: 0.15rem;
        padding-left: calc((100vw - min(var(--max-width), 92vw)) / 2);
        padding-right: calc((100vw - min(var(--max-width), 92vw)) / 2);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: none;
        width: 100%;
        z-index: 220;
        background: rgba(15, 26, 42, 0.92) !important;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        transition: padding-top 320ms ease, padding-bottom 320ms ease, background-color 320ms ease,
          backdrop-filter 320ms ease, -webkit-backdrop-filter 320ms ease, border-color 320ms ease,
          box-shadow 320ms ease;
      }

      body.is-scrolled .site-header {
        background: rgba(15, 26, 42, 0.6) !important;
        padding-top: 1.25rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom-color: rgba(220, 231, 246, 0.2);
        box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
      }

      body.is-scrolled .menu-cta {
        background: #53b27f;
        border-color: #53b27f;
      }

      body.is-scrolled .logo {
        top: -5px;
      }

      body.is-scrolled .main-nav {
        top: -4px;
      }

      @supports not ((backdrop-filter: blur(1px))) {
        body.is-scrolled .site-header {
          background: rgba(15, 26, 42, 0.84) !important;
        }
      }

      .logo {
        width: 180px;
        height: auto;
        position: relative;
        top: -12px;
        filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
          drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
        transition: top 320ms ease, margin-top 320ms ease;
      }

      .main-nav {
        display: flex;
        align-items: center;
        margin-left: auto;
        flex-wrap: nowrap;
        gap: 1.3rem;
        position: relative;
        top: -11px;
        z-index: 121;
        transition: top 320ms ease;
      }

      .menu-toggle-input { display: none; }

      .menu-toggle {
        display: none;
        width: 38px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 0.45rem;
        background: transparent;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: top 320ms ease;
      }

      .menu-toggle-bars,
      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        width: 18px;
        height: 2px;
        background: #ffffff;
      }

      .menu-toggle-bars {
        display: block;
        position: relative;
        transition: background 220ms ease;
      }

      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        transition: transform 220ms ease, top 220ms ease;
      }

      .menu-toggle-bars::before { top: -6px; }
      .menu-toggle-bars::after { top: 6px; }

      .menu-list {
        list-style: none;
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        white-space: nowrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
      }

      .menu-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }

      .menu-link:hover { color: #d7e3f5; }

      .menu-link.is-active { color: #d7e3f5; }

      .menu-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: 1px;
        flex: 0 0 auto;
        min-width: 126px;
        color: #ffffff;
        background: #53b27f;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid #53b27f;
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, top 320ms ease;
      }

      .menu-cta:hover {
        background: #3f9568;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
      }

      .menu-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.9);
        outline-offset: 2px;
      }

      .section { padding: 4rem 0; }

      .partner-network {
        padding-top: clamp(7.75rem, 11vw, 9.25rem);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: #3f9568;
        margin-bottom: 0;
      }

      .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      h2 {
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.05;
        margin-top: 1rem;
        color: var(--text-primary);
      }

      h2::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .intro {
        margin-top: 1.2rem;
        color: var(--text-muted);
        width: 100%;
        max-width: none;
        font-size: 1.02rem;
        line-height: 1.6;
      }

      .partners-grid {
        margin-top: 3rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.4rem;
      }

      .partner-card {
        position: relative;
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        padding: 1.9rem 2rem;
        min-height: 260px;
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 1.8rem;
        align-items: center;
        scroll-margin-top: 110px;
        overflow: hidden;
        isolation: isolate;
        box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
        transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
          border-color 360ms ease, box-shadow 360ms ease;
      }

      .partner-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 85% 0%, rgba(83, 178, 127, 0.14), transparent 60%);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: -1;
        pointer-events: none;
      }

      .partner-card::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
        opacity: 0;
        transition: opacity 360ms ease;
      }

      .partner-card:hover {
        transform: translateY(-6px);
        border-color: rgba(83, 178, 127, 0.42);
        box-shadow: 0 26px 48px rgba(15, 26, 42, 0.12),
          0 0 0 1px rgba(83, 178, 127, 0.16) inset;
      }

      .partner-card:hover::before,
      .partner-card:hover::after {
        opacity: 1;
      }

      .partner-logo {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0;
        padding-right: 1.4rem;
        border-right: 1px solid var(--line);
        transition: transform 180ms ease;
      }

      .partner-logo img {
        max-height: 82px;
        max-width: 220px;
        width: auto;
        height: auto;
        transition: transform 180ms ease, filter 180ms ease, opacity 180ms ease;
      }

      .partner-logo-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .partner-logo img.is-morabank {
        filter: brightness(0);
      }

      .partner-logo img.is-marine {
        max-height: 92px;
        max-width: 225px;
      }

      .partner-card:hover .partner-logo {
        transform: translateY(-2px);
      }

      .partner-card:hover .partner-logo img {
        transform: scale(1.03);
        filter: saturate(1.02) contrast(1.03);
        opacity: 0.94;
      }

      .partner-card:hover .partner-logo img.is-morabank {
        filter: brightness(0);
      }

      .partner-role {
        margin-top: 0.25rem;
        color: #33445c;
        font-size: 0.78rem;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .partner-summary {
        margin-top: 0.7rem;
        color: var(--text-muted);
        font-size: 1rem;
        max-width: 68ch;
      }

      .partner-content h3 {
        font-size: 1.35rem;
      }

      .partner-content {
        padding-left: 0.2rem;
      }

      @media (max-width: 980px) {
        
        .partner-card {
          grid-template-columns: 1fr;
          min-height: 0;
          padding: 1.1rem;
          gap: 1rem;
        }

        .partner-logo {
          min-height: 64px;
          border-right: 0;
          border-bottom: 1px solid var(--line);
          padding-right: 0;
          padding-bottom: 0.8rem;
          justify-content: center;
        }

        .partner-content {
          padding-left: 0;
        }
      }

      @media (max-width: 680px) {
        .site-header {
          gap: 0.45rem;
          min-height: 44px;
          padding-bottom: 0.45rem;
        }

        body.is-scrolled .site-header {
          padding-top: 2.15rem;
          padding-bottom: 0.75rem;
        }

        .main-nav { position: static; gap: 0.55rem; }
        .menu-toggle {
          display: inline-flex;
          position: relative;
          top: -7px;
          border: 0;
          box-shadow: none;
        }

        .menu-list {
          position: absolute;
          top: calc(100% + 0.5rem);
          left: 0.8rem;
          right: auto;
          min-width: min(190px, calc(100vw - 2rem));
          flex-direction: column;
          align-items: flex-start;
          gap: 0.55rem;
          padding: 0;
          max-height: 0;
          opacity: 0;
          overflow: hidden;
          transform: translateY(-8px);
          pointer-events: none;
          background: rgba(255, 255, 255, 0.96);
          border: 1px solid #d3ddea;
          border-radius: 0.6rem;
          transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
          z-index: 220;
        }

        .menu-toggle-input:checked ~ .main-nav .menu-list {
          max-height: 320px;
          opacity: 1;
          transform: translateY(0);
          pointer-events: auto;
          padding: 0.7rem;
        }

        .menu-list .menu-link {
          color: #172235;
          text-shadow: none;
        }

        .menu-list .menu-link:hover,
        .menu-list .menu-link.is-active {
          color: #5e7393;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars { background: transparent; }
        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::before {
          top: 0;
          transform: rotate(45deg);
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::after {
          top: 0;
          transform: rotate(-45deg);
        }

        .logo {
          width: min(34vw, 170px);
          height: auto;
          position: static;
          top: auto;
          transform: none;
          margin-left: 0.9rem;
          margin-top: -17px;
        }

        .menu-link { font-size: 0.7rem; }

        .menu-cta {
          display: inline-flex;
          top: -7px;
          min-width: 102px;
          padding: 0.58rem 0.8rem;
          font-size: 0.68rem;
        }


        .partner-logo img {
          max-height: 64px;
          max-width: 180px;
        }

        .partner-logo img.is-marine {
          max-height: 74px;
          max-width: 185px;
        }

        .partner-content h3 {
          font-size: 1.18rem;
        }

        .partner-summary {
          font-size: 0.94rem;
          line-height: 1.55;
        }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader active="partners" menuToggleId="mobile-menu-toggle-partners" offsetFirstSection={false} locale={locale} currentPath={Astro.url.pathname} />

    <section class="section partner-network">
      <div class="container">
        <p class="eyebrow">{content.eyebrow}</p>
        <h2>{content.title}</h2>
        <p class="intro">{content.intro}</p>
        <div class="partners-grid">
          {
            localizedPartners.map((partner) => (
              <article class="partner-card" id={partner.slug}>
                <div class="partner-logo">
                  {partner.name === "Andorra Resident" ? (
                    <a
                      class="partner-logo-link"
                      href="https://andorraresident.com/"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit Andorra Resident"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : partner.name === "DATA Architects" ? (
                    <a
                      class="partner-logo-link"
                      href="https://www.data.ad/"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit DATA Architects"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : partner.name === "Govern d'Andorra" ? (
                    <a
                      class="partner-logo-link"
                      href="https://www.govern.ad/ca/inici"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit Govern d'Andorra"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : partner.name === "MoraBank" ? (
                    <a
                      class="partner-logo-link"
                      href="https://www.morabanc.ad/empreses"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit MoraBanc"
                    >
                      <img
                        src={partner.logo}
                        alt={partner.name}
                        loading="lazy"
                        class="is-morabank"
                      />
                    </a>
                  ) : partner.name === "Hormipresa" ? (
                    <a
                      class="partner-logo-link"
                      href="https://www.hormipresa.com/"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit Hormipresa"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : partner.name === "Heracles" ? (
                    <a
                      class="partner-logo-link"
                      href="https://www.grupheracles.com/en/Home"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit Grup Heracles"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : partner.name === "Pret a Porter Casas" ? (
                    <a
                      class="partner-logo-link"
                      href="https://www.pretaportercasas.com/particulares/?utm_source=google&utm_medium=paid_search&utm_campaign=brand_search&gad_source=1&gad_campaignid=23622315788&gbraid=0AAAAADDqiUI7a2Q51S_qrgdji-hCReG38&gclid=CjwKCAjwg_nNBhAGEiwAiYPYA9XFyt2hjvGQKKm6qdTnjrK-CrztD-jEtyMCSSxQoFHiqL3dxaEEthoC10UQAvD_BwE"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit Pret a Porter Casas"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : partner.name === "Engel & Völkers" ? (
                    <a
                      class="partner-logo-link"
                      href="https://www.engelvoelkers.com/ad/es?utm_source=google&utm_medium=paidsearch&utm_campaign=fr_selleracquisition_andorra_google&utm_content=004_e_engelvolkers&utm_term=engel%20and%20volkers%20andorra&gad_source=1&gad_campaignid=23303698775&gbraid=0AAAAADfu7S5oTJJWVEVkgOZw-KzRz5Wb8&gclid=CjwKCAjwg_nNBhAGEiwAiYPYA1Fsbr2km07a9uFmmUiM7z2m9rvE4WFuVMu1GKPgJCQc9l_AMpSatxoClRwQAvD_BwE"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit Engel and Völkers"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : partner.name === "Emindset Law" ? (
                    <a
                      class="partner-logo-link"
                      href="https://emindsetlaw.com/"
                      target="_blank"
                      rel="noreferrer"
                      aria-label="Visit Emindset Law"
                    >
                      <img src={partner.logo} alt={partner.name} loading="lazy" />
                    </a>
                  ) : (
                    <img
                      src={partner.logo}
                      alt={partner.name}
                      loading="lazy"
                      class={
                        partner.name === "MoraBank"
                          ? "is-morabank"
                          : partner.name === "Mariné Construccions"
                          ? "is-marine"
                          : undefined
                      }
                    />
                  )}
                </div>
                <div class="partner-content">
                  <h3>{partner.name}</h3>
                  <p class="partner-role">{partner.role}</p>
                  <p class="partner-summary">{partner.summary}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <SiteFooter locale={locale} />
    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>
  </body>
</html>
