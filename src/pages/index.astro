      .timeline-v2-col h3 {
        margin: 0.7rem 0 0;
        color: #172235;
        font-size: 1.08rem;
        font-weight: 600;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        line-height: 1.25;
      }

      .timeline-v2-col p {
        margin: 0.65rem auto 0;
        max-width: 19ch;
        color: #5a667a;
        font-size: 0.9rem;
        line-height: 1.4;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
