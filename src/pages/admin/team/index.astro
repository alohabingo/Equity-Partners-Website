---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseServer } from "../../../lib/supabase";

const supabase = supabaseServer(Astro.cookies, Astro.request);
const { data: members } = await supabase
  .from("team_members")
  .select("id, name, photo_url, linkedin_url, sort_order, status, translations")
  .order("sort_order");

const list = members ?? [];
const q = Astro.url.searchParams;
const notice = q.get("saved") ? "Saved ✓" : q.get("removed") ? "Team member removed ✓" : null;
const error = q.get("error") === "name_required" ? "A name is required." : null;

const tr = (m: any, loc: string, field: "role" | "description") =>
  (m?.translations?.[loc]?.[field] ?? "") as string;

const LOCALES = [
  { key: "en", label: "English" },
  { key: "es", label: "Español" },
  { key: "ca", label: "Català" },
];
---

<AdminLayout title="Team" active="team">
  <style>
    .head-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .new-btn {
      font: inherit; font-size: 0.82rem; font-weight: 700; color: #ffffff;
      background: #53b27f; border: 0; border-radius: 8px; padding: 0.6rem 1.1rem; cursor: pointer;
    }
    .new-btn:hover { filter: brightness(1.08); }
    .notice { margin-top: 1.1rem; padding: 0.65rem 0.9rem; border-radius: 8px; font-size: 0.85rem; }
    .notice.ok { background: rgba(83, 178, 127, 0.12); border: 1px solid rgba(83, 178, 127, 0.4); color: #2e7d54; }
    .notice.err { background: rgba(203, 76, 76, 0.1); border: 1px solid rgba(203, 76, 76, 0.35); color: #a33d3d; }
    .empty { margin-top: 2rem; color: #5c6f88; font-size: 0.92rem; }

    .cards { margin-top: 1.4rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }

    .mcard {
      position: relative; cursor: pointer;
      background: #ffffff; border: 1px solid #d7deea; border-radius: 0.9rem;
      padding: 1.2rem 1.2rem 1rem; text-align: center;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
      display: flex; flex-direction: column; align-items: center; gap: 0.45rem;
      overflow: hidden; isolation: isolate;
      transition: border-color 360ms ease, box-shadow 360ms ease, transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1);
    }
    .mcard::after {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
      opacity: 0; transition: opacity 360ms ease;
    }
    .mcard:hover { transform: translateY(-4px); border-color: rgba(83, 178, 127, 0.42); box-shadow: 0 20px 40px rgba(15, 26, 42, 0.1); }
    .mcard:hover::after { opacity: 1; }
    .avatar { width: 96px; height: 96px; border-radius: 999px; object-fit: cover; border: 3px solid rgba(83, 178, 127, 0.25); background: #eef2f7; }
    .avatar-empty { display: grid; place-items: center; color: #93a3b8; font-size: 0.7rem; }
    .m-name { font-size: 1rem; font-weight: 700; color: #16283e; }
    .m-role { font-size: 0.78rem; font-weight: 600; color: #2e7d54; }
    .m-bio { font-size: 0.76rem; color: #5c6f88; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .badges { display: inline-flex; gap: 0.25rem; margin-top: 0.15rem; align-items: center; }
    .lang { font-size: 0.6rem; font-weight: 700; padding: 0.18rem 0.42rem; border-radius: 6px; }
    .lang.has { background: rgba(83, 178, 127, 0.13); color: #2e7d54; }
    .lang.missing { background: rgba(203, 76, 76, 0.08); color: #b98484; border: 1px dashed rgba(203, 76, 76, 0.3); }
    .li-dot { display: inline-flex; color: #3d5a80; }
    .li-dot svg { width: 13px; height: 13px; }
    .draft-tag {
      position: absolute; top: 0.7rem; right: 0.7rem;
      font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
      background: rgba(196, 148, 58, 0.9); color: #fff; padding: 0.2rem 0.5rem; border-radius: 999px;
    }
    .m-foot {
      margin-top: auto; padding-top: 0.7rem; width: 100%;
      display: flex; justify-content: center; align-items: center; gap: 0.7rem;
      border-top: 1px solid #eef2f7;
    }
    .mini { font: inherit; font-size: 0.72rem; font-weight: 700; color: #3d5a80; background: none; border: 0; padding: 0; cursor: pointer; }
    .mini:hover { text-decoration: underline; }
    .mini.danger { color: #a33d3d; }
    .arrows { display: inline-flex; gap: 0.2rem; }
    .arrow {
      font: inherit; font-size: 0.7rem; line-height: 1; color: #5c6f88;
      background: #f4f7fb; border: 1px solid #d5deea; border-radius: 6px;
      padding: 0.25rem 0.4rem; cursor: pointer;
    }
    .arrow:hover:not([disabled]) { border-color: #53b27f; color: #2e7d54; }
    .inline { display: inline; }

    /* ---------- Slide-over drawer ---------- */
    .backdrop {
      position: fixed; inset: 0; background: rgba(9, 17, 28, 0.45);
      opacity: 0; pointer-events: none; transition: opacity 260ms ease; z-index: 40;
      backdrop-filter: blur(2px);
    }
    .backdrop.open { opacity: 1; pointer-events: auto; }
    .drawer {
      position: fixed; top: 0; right: 0; height: 100vh; width: min(480px, 100vw);
      background: #ffffff; border-left: 1px solid #d7deea;
      box-shadow: -18px 0 48px rgba(9, 17, 28, 0.16);
      transform: translateX(100%); transition: transform 320ms cubic-bezier(0.2, 0.7, 0.3, 1);
      z-index: 50; display: flex; flex-direction: column;
    }
    .drawer.open { transform: translateX(0); }
    .drawer-head {
      padding: 1.1rem 1.4rem; border-bottom: 1px solid #eef2f7;
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      background: linear-gradient(180deg, #12233c 0%, #0f2036 100%); color: #ffffff;
    }
    .drawer-head h2 { font-size: 1rem; font-weight: 700; }
    .close-btn {
      font: inherit; font-size: 1.3rem; line-height: 1; color: #9fb0c9;
      background: none; border: 0; cursor: pointer; padding: 0.1rem 0.3rem;
    }
    .close-btn:hover { color: #ffffff; }
    .drawer-body { padding: 1.2rem 1.4rem 1.5rem; overflow-y: auto; flex: 1; }
    .drawer-foot {
      padding: 0.9rem 1.4rem; border-top: 1px solid #eef2f7; background: #fbfcfe;
      display: flex; gap: 0.7rem; align-items: center;
    }
    .photo-row { display: flex; gap: 1rem; align-items: center; }
    .photo-preview {
      width: 84px; height: 84px; flex: none; border-radius: 999px; object-fit: cover;
      border: 3px solid rgba(83, 178, 127, 0.25); background: #eef2f7;
    }
    .upload-btn {
      display: inline-block; font-size: 0.76rem; font-weight: 700; color: #3d5a80;
      border: 1px solid #d5deea; border-radius: 8px; padding: 0.45rem 0.9rem; cursor: pointer; background: #f4f7fb;
    }
    .upload-btn:hover { border-color: #53b27f; color: #2e7d54; }
    .upload-status { font-size: 0.74rem; color: #5c6f88; margin-top: 0.35rem; min-height: 1em; }
    .field { display: grid; gap: 0.35rem; margin-top: 0.9rem; }
    .field span { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #46586f; }
    .field em { font-weight: 400; text-transform: none; letter-spacing: 0; color: #93a3b8; }
    .in {
      font: inherit; font-size: 0.88rem; width: 100%;
      padding: 0.55rem 0.7rem; border: 1px solid #d5deea; border-radius: 8px; background: #fbfcfe;
    }
    .in:focus { outline: none; border-color: #53b27f; }
    .loc-block { border: 1px dashed #e2e8f1; border-radius: 10px; padding: 0.5rem 1rem 1rem; margin-top: 1rem; }
    .loc-block legend { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #5c6f88; padding: 0 0.4rem; }
    .save {
      font: inherit; font-size: 0.88rem; font-weight: 700; color: #ffffff;
      background: #53b27f; border: 0; border-radius: 9px; padding: 0.65rem 1.4rem; cursor: pointer;
    }
    .save:hover { filter: brightness(1.07); }
    .drawer-cancel { font: inherit; font-size: 0.8rem; font-weight: 600; color: #7a8ba1; background: none; border: 0; cursor: pointer; }
    .drawer-delete { margin-left: auto; font: inherit; font-size: 0.78rem; font-weight: 700; color: #a33d3d; background: none; border: 0; cursor: pointer; }
    .drawer-delete:hover { text-decoration: underline; }
  </style>

  <div class="page-head head-row">
    <div>
      <h1>Team</h1>
      <p>Click a team member to edit. Changes go live on the About page immediately.</p>
    </div>
    <button class="new-btn" type="button" id="add-member">+ Add team member</button>
  </div>

  {notice && <p class="notice ok">{notice}</p>}
  {error && <p class="notice err">{error}</p>}

  <div class="cards">
    {list.map((m, i) => (
      <article class="mcard" data-open={m.id} title={`Edit ${m.name}`}>
        {m.status !== "published" && <span class="draft-tag">draft</span>}
        {m.photo_url
          ? <img class="avatar" src={m.photo_url} alt={m.name} loading="lazy" />
          : <div class="avatar avatar-empty">no photo</div>}
        <p class="m-name">{m.name}</p>
        <p class="m-role">{tr(m, "en", "role")}</p>
        <p class="m-bio">{tr(m, "en", "description")}</p>
        <span class="badges">
          {["en", "es", "ca"].map((loc) => (
            <span class={tr(m, loc, "role") ? "lang has" : "lang missing"}>{loc.toUpperCase()}</span>
          ))}
          {m.linkedin_url && (
            <span class="li-dot" title="LinkedIn on file">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.4c0-1.3-.02-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21H9z"/></svg>
            </span>
          )}
        </span>
        <div class="m-foot">
          <span class="arrows">
            <form class="inline" method="post" action="/api/admin/team">
              <input type="hidden" name="action" value="move" />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="dir" value="up" />
              <button class="arrow" type="submit" disabled={i === 0} title="Move up">↑</button>
            </form>
            <form class="inline" method="post" action="/api/admin/team">
              <input type="hidden" name="action" value="move" />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="dir" value="down" />
              <button class="arrow" type="submit" disabled={i === list.length - 1} title="Move down">↓</button>
            </form>
          </span>
          <button class="mini" type="button" data-open={m.id}>Edit</button>
        </div>
      </article>
    ))}
  </div>

  {list.length === 0 && <p class="empty">No team members yet — add the first one.</p>}

  <!-- ---------- Drawer ---------- -->
  <div class="backdrop" id="drawer-backdrop"></div>
  <aside class="drawer" id="drawer" aria-hidden="true">
    <div class="drawer-head">
      <h2 id="drawer-title">Edit team member</h2>
      <button class="close-btn" type="button" id="drawer-close" aria-label="Close">×</button>
    </div>
    <form method="post" action="/api/admin/team" id="member-form" style="display:contents;">
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="id" id="f-id" />
      <div class="drawer-body">
        <div class="photo-row">
          <img class="photo-preview" id="f-preview" src="" alt="" />
          <div>
            <label class="upload-btn">
              Upload photo
              <input type="file" accept="image/*" id="f-photo-input" hidden />
            </label>
            <p class="upload-status" id="f-upload-status"></p>
          </div>
        </div>
        <label class="field">
          <span>Photo URL</span>
          <input class="in" type="text" name="photo_url" id="f-photo-url" />
        </label>
        <label class="field">
          <span>Name</span>
          <input class="in" type="text" name="name" id="f-name" required />
        </label>
        <label class="field">
          <span>LinkedIn <em>(full URL or just the handle)</em></span>
          <input class="in" type="text" name="linkedin_url" id="f-linkedin" placeholder="https://www.linkedin.com/in/…" />
        </label>
        <label class="field">
          <span>Status</span>
          <select class="in" name="status" id="f-status">
            <option value="published">Published</option>
            <option value="draft">Draft (hidden from website)</option>
          </select>
        </label>

        {LOCALES.map((loc) => (
          <fieldset class="loc-block">
            <legend>{loc.label}</legend>
            <label class="field">
              <span>Role</span>
              <input class="in" type="text" name={`role_${loc.key}`} id={`f-role-${loc.key}`} />
            </label>
            <label class="field">
              <span>Bio</span>
              <textarea class="in" name={`bio_${loc.key}`} id={`f-bio-${loc.key}`} rows="4"></textarea>
            </label>
          </fieldset>
        ))}
      </div>
      <div class="drawer-foot">
        <button class="save" type="submit">Save</button>
        <button class="drawer-cancel" type="button" id="drawer-cancel">Cancel</button>
        <button class="drawer-delete" type="submit" name="action" value="delete" id="drawer-delete" formnovalidate>Remove</button>
      </div>
    </form>
  </aside>

  <script type="application/json" id="team-data" set:html={JSON.stringify(list)}></script>

  <script>
    const members = JSON.parse(document.getElementById("team-data")?.textContent || "[]");
    const byId = new Map(members.map((m: any) => [m.id, m]));

    const drawer = document.getElementById("drawer")!;
    const backdrop = document.getElementById("drawer-backdrop")!;
    const title = document.getElementById("drawer-title")!;
    const del = document.getElementById("drawer-delete") as HTMLButtonElement;
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

    const BLANK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 84 84'%3E%3Crect width='84' height='84' fill='%23eef2f7'/%3E%3C/svg%3E";

    function open(id: string | null) {
      const m: any = id ? byId.get(id) : null;
      const t = m?.translations ?? {};
      title.textContent = m ? `Edit ${m.name}` : "New team member";
      $("f-id").value = m?.id ?? "";
      $("f-name").value = m?.name ?? "";
      $("f-photo-url").value = m?.photo_url ?? "";
      $("f-linkedin").value = m?.linkedin_url ?? "";
      ($("f-status") as unknown as HTMLSelectElement).value = m?.status ?? "published";
      (document.getElementById("f-preview") as HTMLImageElement).src = m?.photo_url || BLANK;
      for (const loc of ["en", "es", "ca"]) {
        $(`f-role-${loc}`).value = t[loc]?.role ?? "";
        ($(`f-bio-${loc}`) as unknown as HTMLTextAreaElement).value = t[loc]?.description ?? "";
      }
      del.style.display = m ? "block" : "none";
      del.onclick = (e) => {
        if (!confirm(`Remove ${m?.name} from the team page?`)) e.preventDefault();
      };
      document.getElementById("f-upload-status")!.textContent = "";
      drawer.classList.add("open");
      backdrop.classList.add("open");
      drawer.setAttribute("aria-hidden", "false");
      setTimeout(() => $("f-name").focus(), 320);
    }

    function close() {
      drawer.classList.remove("open");
      backdrop.classList.remove("open");
      drawer.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll("[data-open]").forEach((el) => {
      el.addEventListener("click", (e) => {
        // don't hijack the reorder arrows
        if ((e.target as HTMLElement).closest("form.inline")) return;
        e.preventDefault();
        open(el.getAttribute("data-open"));
      });
    });
    document.getElementById("add-member")?.addEventListener("click", () => open(null));
    document.getElementById("drawer-close")?.addEventListener("click", close);
    document.getElementById("drawer-cancel")?.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

    // Photo upload
    const photoInput = document.getElementById("f-photo-input") as HTMLInputElement;
    photoInput?.addEventListener("change", async () => {
      const file = photoInput.files?.[0];
      if (!file) return;
      const status = document.getElementById("f-upload-status")!;
      status.textContent = "Uploading…";
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || "upload failed");
        $("f-photo-url").value = data.url;
        (document.getElementById("f-preview") as HTMLImageElement).src = data.url;
        status.textContent = "Photo uploaded ✓";
      } catch (err) {
        status.textContent = "Upload failed: " + (err instanceof Error ? err.message : "unknown");
      }
    });
  </script>
</AdminLayout>
