        <div class="row2">
          <label class="field">
            <span>Sidebar name <em>(how it reads in the left menu — leave blank to use "{project.name}")</em></span>
            <input
              class="in"
              type="text"
              name="nav_name"
              maxlength="40"
              value={project.nav_name ?? ""}
              placeholder={project.name}
            />
          </label>
          <span class="field-spacer"></span>
          <label class="field">
            <span>Domain <em>(no https://)</em></span>
            <input class="in" type="text" name="domain" value={project.domain ?? ""} placeholder="nantaalta.com" />
          </label>
          <label class="field">
            <span>Mailbox <em>(filled in automatically when you connect)</em></span>
            <input class="in" type="email" name="mailbox" value={project.mailbox ?? ""} placeholder="sales@nantaalta.com" />
          </label>
        </div>
        <button class="btn" type="submit">Save</button>
        {saved && <p class="saved">Saved ✓</p>}
      </form>

      <section class="card">
        <div class="cardhead">
          <h2 class="sec">Layout</h2>
          <button class="btn top" type="button" data-open-dialog="edit-layout">Edit</button>
        </div>

        {/* Layout messages belong HERE. They were being written to the page's
            one notice line, which is hidden on Settings — so a refusal to
            delete looked exactly like a button that did nothing. */}
        {mailboxMessage && <p class="syncmsg" style="margin-top:0.8rem"><span>{mailboxMessage}</span></p>}

        {buildings.length === 0 && unplacedUnits.length === 0 ? (
          <p class="empty">Nothing recorded yet. Press Edit to describe how this project is laid out.</p>
        ) : (
          <table class="q b-table">
            {/* Structure only. The sales split lives on the Overview and the
                Units tab, and repeating it here made a settings card look like
                a report. */}
            <tr><th>Type</th><th>Name</th><th>Unit type</th><th>Units</th></tr>
            {buildings.map((b) => (
              <tr>
                <td><span class="chip">{b.kind === "project" ? "Project" : "Building"}</span></td>
                <td><b>{b.name}</b></td>
                <td>{unitTypeOf(b.id)}</td>
                <td><b>{unitsInBuilding(b.id).length}</b></td>
              </tr>
            ))}
            {unplacedUnits.length > 0 && (
              <tr>
                <td></td>
                <td><span class="chip">Not placed yet</span></td>
                <td>{unitTypeOf(null)}</td>
                <td><b>{unplacedUnits.length}</b></td>
              </tr>
            )}
          </table>
        )}

        {/* Everything editable lives in here. The card itself is a statement of
            what the project is; changing it is a deliberate act, not something
            that can happen while reading. */}
        <dialog class="enqmodal wide" id="edit-layout">
          <div class="mhead">
            <div>
              <h3>Edit layout</h3>
              <p class="msub">Blocks or phases, and the units in each.</p>
            </div>
            <form method="dialog"><button class="mx" aria-label="Close">×</button></form>
          </div>

          {buildings.length > 0 && (
            <table class="q b-table">
              <tr><th>Type</th><th>Name</th><th>Units</th><th></th></tr>
              {buildings.map((b) => (
                <tr>
                  <td>
                    <form method="post" action="/api/admin/project-buildings">
                      <input type="hidden" name="slug" value={project.slug} />
                      <input type="hidden" name="id" value={b.id} />
                      <input type="hidden" name="action" value="kind" />
                      <select class="in bkind" name="kind" onchange="this.form.submit()">
                        <option value="building" selected={b.kind !== "project"}>Building</option>
                        <option value="project" selected={b.kind === "project"}>Project</option>
                      </select>
                    </form>
                  </td>
                  <td>
                    <form method="post" action="/api/admin/project-buildings" class="inline">
                      <input type="hidden" name="slug" value={project.slug} />
                      <input type="hidden" name="id" value={b.id} />
                      <input type="hidden" name="action" value="rename" />
                      <input class="in bname" type="text" name="name" value={b.name} />
                      <button class="tiny" type="submit">Save</button>
                    </form>
                  </td>
                  <td><b>{unitsInBuilding(b.id).length}</b></td>
                  <td style="text-align:right">
                    {unitsInBuilding(b.id).length === 0 ? (
                      <form method="post" action="/api/admin/project-buildings"
                            onsubmit={`return confirm('Remove ${b.name}?')`}>
                        <input type="hidden" name="slug" value={project.slug} />
                        <input type="hidden" name="id" value={b.id} />
                        <input type="hidden" name="action" value="remove" />
                        <button class="tiny danger" type="submit">Remove</button>
                      </form>
                    ) : (
                      <form method="post" action="/api/admin/project-buildings"
                            onsubmit={`return confirm('Remove ${b.name} and its ${unitsInBuilding(b.id).length} units? This cannot be undone.')`}>
                        <input type="hidden" name="slug" value={project.slug} />
                        <input type="hidden" name="id" value={b.id} />
                        <input type="hidden" name="action" value="remove_all" />
                        {/* Just "Remove". The count stays in the confirmation,
                            which is where it can still stop a mistake without
                            making the button read like a warning label. */}
                        <button class="tiny danger" type="submit">Remove</button>
                      </form>
                    )}
                  </td>
                </tr>
              ))}
            </table>
          )}

          <div class="msep"></div>
          <h4 class="msub-h">Add a building</h4>
          <form method="post" action="/api/admin/project-buildings" class="genform modalform">
            <input type="hidden" name="slug" value={project.slug} />
            <input type="hidden" name="action" value="add" />
            <label class="field">
              <span>Type</span>
              <select class="in" name="kind">
                <option value="building">Building</option>
                <option value="project">Project</option>
              </select>
            </label>
            <label class="field">
              <span>Name</span>
              <input class="in" type="text" name="name" value={nextBlockName} placeholder="Name" required />
            </label>
            <label class="field">
              <span>Units in it <em>(optional)</em></span>
              <input class="in" type="number" name="count" min="0" max="500" placeholder="0" />
            </label>
            <label class="field">
              <span>Unit type</span>
              {/* Follows Type on its own — a building holds apartments, a
                  project of this kind holds villas — but stays a real field,
                  because the rule is a sensible default and not a law. */}
              <select class="in" name="prefix" data-follows-kind>
                <option value="Apartment" selected>Apartment</option>
                <option value="Villa">Villa</option>
              </select>
            </label>
            <button class="btn" type="submit">Add</button>
          </form>
        </dialog>
      </section>

      <section class="card">
        <h2 class="sec">Mailbox</h2>

        {mailboxMessage && <p class="saved" style="margin-top:0">{mailboxMessage}</p>}

        {!oauthReady && (
          <p class="lede">
            The Zoho application isn't configured on this environment yet —
            <b> ZOHO_OAUTH_CLIENT_ID</b> and <b>ZOHO_OAUTH_CLIENT_SECRET</b> need to be set,
            then the server restarted. See <b>zoho-oauth-app-setup.md</b>.
          </p>
        )}

        {oauthReady && !mailboxConnected && (
          <>
            <p class="lede">
              This lets the portal read enquiries arriving in the project's inbox and reply from
              that address. You'll be sent to Zoho to sign in.
            </p>
            <p class="lede">
              <b>Sign in as the project's mailbox</b>{project.mailbox ? ` — ${project.mailbox}` : ""},
              not your own admin account. Whichever mailbox you sign in as is the one that gets
              connected, and its address is filled in here automatically afterwards.
            </p>
            <a class="btn" href={`/api/admin/zoho/connect?slug=${project.slug}`}
               style="display:inline-block;text-decoration:none">Connect mailbox</a>
          </>
        )}

        {mailboxConnected && (
          <>
            <div class="kv" style="margin-top:0.4rem">
              <div><span>Connected</span><code>{project.mailbox}</code></div>
              <div><span>Since</span><code>{new Date(project.mailbox_connected_at).toLocaleString("en-GB")}</code></div>
              <div>
                <span>Last sync</span>
                <code>{project.mailbox_last_sync_at
                  ? new Date(project.mailbox_last_sync_at).toLocaleString("en-GB")
                  : "not yet"}</code>
              </div>
            </div>

            {project.mailbox_last_error && (
              <div class="warn"><b>Last sync failed</b><div>{project.mailbox_last_error}</div></div>
            )}

            <p class="lede" style="margin-top:0.9rem">
              Mail arriving here becomes an enquiry automatically. A sender we already have
              is added to their existing thread; anyone new becomes a new enquiry in
              Needs you. Form notifications are read via their Reply-To, so the buyer is the
              contact rather than the form service.
            </p>

            <div style="display:flex; gap:0.6rem; flex-wrap:wrap; align-items:center">
              <form method="post" action="/api/admin/project-mail-sync">
                <input type="hidden" name="slug" value={project.slug} />
                <button class="btn ghost" type="submit">Sync now</button>
              </form>
              {/* The routine sync reads the newest page of the INBOX only. This
                  one-off walks the whole inbox back to the beginning, then the
                  Sent folder, so replies made in Zoho before the portal existed
                  appear on the threads they belong to. */}
              <form method="post" action="/api/admin/project-mail-sync">
                <input type="hidden" name="slug" value={project.slug} />
                <input type="hidden" name="mode" value="history" />
                <button class="btn ghost" type="submit">Import mail history</button>
              </form>
              <form method="post" action="/api/admin/zoho/disconnect"
                    onsubmit="return confirm('Disconnect this mailbox? Existing enquiries are kept.')">
                <input type="hidden" name="slug" value={project.slug} />
                <button class="btn ghost" type="submit" style="color:#a33d3d;border-color:rgba(203,76,76,.4)">Disconnect</button>
              </form>
            </div>
          </>
        )}
      </section>
      <details class="adv">
        <summary>Advanced — connect the website form directly</summary>
        <p class="lede">
          Not needed once the mailbox is connected: form submissions already reach you
          as email. This exists for a project whose site cannot send email, or if you
          ever want submissions to arrive instantly rather than within ten minutes.
        </p>
      <section class="card">
        <h2 class="sec">Ingest key</h2>
        <p class="lede">
          Authenticates submissions from the project site. Stored as a hash — it can be
          replaced but never read back, so keep the copy you take now.
        </p>

        {freshKey && (
          <div class="keybox">
            <div class="kh">Your new key — copy it now</div>
            <code>{freshKey}</code>
            <p>This is the only time it will be shown. Put it in the project site's
            environment as <b>EP_INGEST_KEY</b>. Generating another key immediately
            invalidates this one.</p>
          </div>
        )}

        <form method="post" action="/api/admin/project-settings">
          <input type="hidden" name="slug" value={project.slug} />
          <input type="hidden" name="action" value="rotate_key" />
          <button class="btn ghost" type="submit">
            {hasKey ? "Generate a new key" : "Generate a key"}
          </button>
        </form>
        {hasKey && !freshKey && <p class="empty">A key is set. Generate a new one only if it has leaked or been lost.</p>}
      </section>

      <section class="card">
        <h2 class="sec">Webhook — give these to whoever runs the site</h2>
        <p class="lede">
          The site's form should POST here when it's submitted. It doesn't matter what the
          site is built with or which form service it uses — anything that can make an HTTP
          request will work.
        </p>
        <div class="kv">
          <div><span>URL</span><code>{webhookUrl}</code></div>
          <div><span>Method</span><code>POST</code></div>
          <div><span>Auth header</span><code>X-Ingest-Key: your-key</code></div>
          <div><span>Required</span><code>name, email</code></div>
          <div><span>Optional</span><code>phone, message, locale, source_page</code></div>
        </div>
        <p class="lede" style="margin-top:0.9rem">
          Field names are matched loosely — <b>Full Name</b>, <b>fullName</b> and <b>name</b>
          all work, as do Spanish and Catalan equivalents. JSON, urlencoded and multipart
          bodies are all accepted. If the form service cannot set headers, the key can go in
          the body as <b>key</b> or on the URL as <b>?key=…</b>, though the header is better
          because URLs end up in server logs.
        </p>
        <p class="lede">
          Anything rejected is logged and shown on the Overview tab with the reason and the
          field names it did receive — so a mismatch is visible rather than silent.
        </p>
      </section>

      <section class="card">
        <h2 class="sec">Example call</h2>
        <p class="lede">
          Store the key as <b>EP_INGEST_KEY</b> in the site's environment variables
          (Vercel → Settings → Environment Variables) and call this from the server, never
          from the browser — a key in page source can be read by anyone.
        </p>
        <pre class="snip">{snippet}</pre>
      </section>
      </details>
    </div>
  )}
</AdminLayout>

<script>
  // Keep the switcher's thumb behind the active tab. The FIRST placement is done
  // by an inline script next to the markup, before paint; these re-runs are for
  // the two things that change the measurement afterwards — the web font
  // finishing loading, and the window being resized.
  function placeThumb(animate) {
    document.querySelectorAll(".seg").forEach((seg) => {
      const thumb = seg.querySelector(".seg-thumb");
      const active = seg.querySelector(".seg-btn.active");
      if (!(thumb instanceof HTMLElement) || !(active instanceof HTMLElement)) return;
      thumb.classList.toggle("no-anim", !animate);
      thumb.style.width = `${active.offsetWidth}px`;
      thumb.style.transform = `translateX(${active.offsetLeft}px)`;
      if (!animate) requestAnimationFrame(() => thumb.classList.remove("no-anim"));
    });
  }
  document.fonts?.ready.then(() => placeThumb(false));
  window.addEventListener("resize", () => placeThumb(false));

  // Dismissing a one-off message. The link already points at the clean URL, so
  // this only has to stop the navigation and do the same thing in place: drop
  // the note, and take the outcome parameters out of the address bar so a
  // refresh doesn't bring it back.
  document.querySelectorAll(".syncmsg .msgx").forEach((x) => {
    x.addEventListener("click", (ev) => {
      ev.preventDefault();
      x.closest(".syncmsg")?.remove();
      const url = new URL(window.location.href);
      ["mailbox", "notice", "sent", "send_error", "units_ok", "units_error"]
        .forEach((k) => url.searchParams.delete(k));
      window.history.replaceState(null, "", url.pathname + url.search);
    });
  });

  // Open the enquiry a "See enquiry" pill belongs to. Native <dialog> gives the
  // backdrop, Esc-to-close and focus handling for free.
  document.querySelectorAll("[data-open-enq]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-open-enq");
      const dlg = id ? document.getElementById("enq-" + id) : null;
      if (dlg instanceof HTMLDialogElement) dlg.showModal();
    });
  });

  // Unit type follows Type: a Building holds apartments, a Project holds villas.
  // It stops following the moment someone sets it themselves — an automatic
  // field that overwrites a deliberate choice is worse than no automation.
  document.querySelectorAll("select[data-follows-kind]").forEach((prefix) => {
    const form = prefix.closest("form");
    const kind = form?.querySelector('select[name="kind"]');
    if (!(kind instanceof HTMLSelectElement) || !(prefix instanceof HTMLSelectElement)) return;

    let chosenByHand = false;
    prefix.addEventListener("change", () => { chosenByHand = true; });
    kind.addEventListener("change", () => {
      if (chosenByHand) return;
      prefix.value = kind.value === "project" ? "Villa" : "Apartment";
    });
  });

  // Any button that names a dialog opens it.
  document.querySelectorAll("[data-open-dialog]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-open-dialog");
      const dlg = id ? document.getElementById(id) : null;
      if (dlg instanceof HTMLDialogElement) dlg.showModal();
    });
  });

  // Clicking the backdrop closes it. A <dialog>'s own box is what receives the
  // click when you hit the content, so comparing target to the dialog itself is
  // what distinguishes "outside" from "inside".
  document.querySelectorAll("dialog.enqmodal").forEach((dlg) => {
    dlg.addEventListener("click", (ev) => {
      if (ev.target === dlg && dlg instanceof HTMLDialogElement) dlg.close();
    });
  });
</script>
