        .main-nav {
          position: static;
          gap: 0.55rem;
        }

        .menu-toggle {
          display: inline-flex;
          position: relative;
          top: -4px;
          border: 0;
          box-shadow: none;
        }

        .menu-list {
          position: absolute;
          top: calc(100% + 0.5rem);
          left: 0.8rem;
          right: auto;
          min-width: min(190px, calc(100vw - 2rem));
          flex-direction: column;
          align-items: flex-start;
          gap: 0.55rem;
          padding: 0;
          max-height: 0;
          opacity: 0;
          overflow: hidden;
          transform: translateY(-8px);
          pointer-events: none;
          background: rgba(255, 255, 255, 0.96);
          border: 1px solid #d3ddea;
          border-radius: 0.6rem;
          transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
          z-index: 220;
        }

        .menu-toggle-input:checked ~ .main-nav .menu-list {
          max-height: 320px;
          opacity: 1;
          transform: translateY(0);
          pointer-events: auto;
          padding: 0.7rem;
        }

        .menu-list .menu-link {
          color: #172235;
          text-shadow: none;
        }

        .menu-list .menu-link:hover,
        .menu-list .menu-link.is-active {
          color: #5e7393;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars {
          background: transparent;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::before {
          top: 0;
          transform: rotate(45deg);
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::after {
          top: 0;
          transform: rotate(-45deg);
        }

        .menu-link {
          font-size: 0.7rem;
        }

        .menu-cta {
          display: inline-flex;
          top: -4px;
          min-width: 102px;
          padding: 0.58rem 0.8rem;
          font-size: 0.68rem;
        }

        .logo {
          width: min(34vw, 170px);
          height: auto;
          position: static;
          top: auto;
          transform: none;
          margin-left: 0.9rem;
          margin-top: -14px;
        }

        .hero {
          min-height: 72vh;
          padding-bottom: 1.55rem;
        }
        .hero-content {
          max-width: 100%;
          padding-top: 5.4rem;
          padding-bottom: 0;
          transform: translateY(2.6rem);
        }

        h1 {
          font-size: clamp(1.75rem, 8.6vw, 2.45rem);
          line-height: 1.06;
        }

        .hero-kicker {
          margin-bottom: 0.8rem;
          font-size: 0.7rem;
          letter-spacing: 0.18em;
        }

        .subline {
