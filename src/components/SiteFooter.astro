---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-top">
    <div class="container footer-grid">
      <div>
        <img
          class="footer-logo"
          src="/images/branding/equity-partners-logo-light%20small.png"
          alt="Equity Partners Andorra Property Group"
        />
        <a class="footer-cta" href="/contact">Explore Opportunities</a>
      </div>

      <div>
        <h3 class="footer-heading">Equity Partners</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href="/#about">About</a></li>
          <li><a class="footer-link" href="/#team">Team</a></li>
          <li><a class="footer-link" href="/partners">Partners</a></li>
          <li><a class="footer-link" href="/#partners">Projects</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">Resources</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href="/blog">Blog</a></li>
          <li><a class="footer-link" href="#">Market Reports</a></li>
          <li><a class="footer-link" href="#">Investment Guides</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">Contact</h3>
        <p class="footer-meta">
          Av. Meritxell 95, AD500 Andorra la Vella<br />
          +376 000 000<br />
          info@equitypartnersandorra.com<br />
          SL Reg. No. L-12345-6
        </p>
      </div>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="footer-bottom">
    <div class="container footer-bottom-row">
      <p class="footer-copy">© {currentYear} EQUITY PARTNERS. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-use">Terms of Use</a>
        <a href="/cookie-policy">Cookies</a>
      </div>
      <div class="footer-social">
        <a class="social-pill" href="#" aria-label="LinkedIn">in</a>
        <a class="social-pill" href="#" aria-label="X">X</a>
        <a class="social-pill" href="#" aria-label="YouTube">▶</a>
        <a class="social-pill" href="#" aria-label="Instagram">IG</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0f1a2a;
    color: #d9e3f2;
    font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
  }

  .container {
    width: min(1120px, 92vw);
    margin: 0 auto;
  }

  .footer-top {
    padding: 3rem 0 2.7rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr repeat(3, minmax(0, 1fr));
    gap: 1.7rem;
    align-items: start;
  }

  .footer-grid > div:not(:first-child) {
    justify-self: start;
    text-transform: uppercase;
  }

  .footer-grid > div:not(:first-child) .footer-list {
    justify-items: start;
  }

  .footer-logo {
    width: 210px;
    max-width: 100%;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  .footer-cta {
    display: inline-flex;
    margin-top: 1.1rem;
    align-items: center;
    justify-content: center;
    color: #132238;
    background: #d8e3f2;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
    border-radius: 0.45rem;
    padding: 0.65rem 0.95rem;
    white-space: nowrap;
    border: 1px solid rgba(216, 227, 242, 0.96);
    transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .footer-cta:hover {
    background: #53b27f;
    border-color: #53b27f;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .footer-cta:focus-visible {
    outline: 2px solid rgba(216, 227, 242, 0.5);
    outline-offset: 3px;
  }

  .footer-heading {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #97a9c4;
    font-weight: 600;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-link {
    color: #f3f7fc;
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .footer-link:hover {
    color: #d8e3f2;
  }

  .footer-meta {
    margin: 0;
    color: #c1cee3;
    font-size: 0.82rem;
    line-height: 1.6;
    text-transform: none;
  }

  .footer-divider {
    border-top: 1px solid rgba(205, 219, 238, 0.2);
  }

  .footer-bottom {
    padding: 1.3rem 0 1.45rem;
  }

  .footer-bottom-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .footer-copy {
    margin: 0;
    color: #aebcd4;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-legal a {
    color: #c1cee3;
    text-decoration: none;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-social {
    display: flex;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .social-pill {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid rgba(220, 231, 246, 0.34);
    color: #e3ebf8;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-grid > div:not(:first-child) {
      justify-self: start;
      text-align: left;
      margin-left: 0;
    }

    .footer-grid > div:not(:first-child) .footer-list {
      justify-items: start;
    }

    .footer-bottom-row {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .footer-legal,
    .footer-social {
      justify-content: flex-start;
    }
  }
</style>
