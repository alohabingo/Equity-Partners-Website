---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import EnquiryPanel from "../../../components/admin/EnquiryPanel.astro";
import UnitRows from "../../../components/admin/UnitRows.astro";
import { supabaseServer } from "../../../lib/supabase";
import { BUYER_STAGES, stageLabel, stageShade, OVERDUE_WORKING_DAYS } from "../../../lib/pipeline";
import { UNIT_STATES, SALES_BAR_ORDER, unitState, summarise, unitStateTheme, euros, type UnitRow } from "../../../lib/units";
import { bucketOf, needsAttention, BUCKET_LABELS, isLive, shortAge, plain, REJECT_REASONS, rejectReasonLabel, LOCALE_OPTIONS, localeChip, localeTitle, type EnquiryRow } from "../../../lib/enquiries";

const { slug } = Astro.params;
const supabase = supabaseServer(Astro.cookies, Astro.request);
const me = Astro.locals.user;

// How the last reply went. The endpoint puts this on the URL because a send
// that failed must not look like one that worked.
const sent = Astro.url.searchParams.get("sent") === "1";
const sendError = Astro.url.searchParams.get("send_error");

const { data: project } = await supabase
  .from("projects").select("*").eq("slug", slug).maybeSingle();
if (!project) return Astro.redirect("/admin/projects");

// Everything the page needs about this project, fetched AT ONCE.
//
// These six were six separate awaits, so the browser waited for each round trip
// before the next was even sent — about half a second of dead time before a
// single byte of HTML went out. That is what made switching tabs feel glitchy:
// the browser holds the old page on screen until the new one is ready, so
// server latency shows up as a frozen page rather than as slowness.
//
// None of them depends on another; they only depend on `project`. So they go
// together, and the page now waits for the slowest one instead of the sum.
const [contentRes, unitRes, buildingRes, enquiryRes, profileRes, rejectionRes] = await Promise.all([
  supabase.from("portfolio_items").select("name, data")
    .eq("slug", slug).eq("kind", "project").eq("locale", "en").maybeSingle(),
  supabase.from("project_units")
    .select("id, code, state, price, inquiry_id, position, building_id")
    .eq("project_id", project.id).order("position"),
  supabase.from("project_buildings").select("id, name, kind, notes, position")
    .eq("project_id", project.id).order("position"),
  supabase.from("enquiry_state").select("*")
    .eq("project_id", project.id).order("last_activity_at", { ascending: false }),
  supabase.from("profiles").select("id, full_name"),
  supabase.from("ingest_log").select("outcome, reason, created_at")
    .eq("project_id", project.id).eq("outcome", "rejected")
    .is("acknowledged_at", null)
    .order("created_at", { ascending: false }).limit(3),
]);

const content = contentRes.data;
const heroImage = typeof content?.data?.image === "string" ? content.data.image : "";
const dealStatus = typeof content?.data?.status === "string" ? content.data.status : "";

// The rail's facts come from the PUBLISHED marketing content, not a second copy
// typed into the operational record. One place to change a figure means the
// portal can't quietly disagree with the website.
const pdata: Record<string, any> = (content?.data ?? {}) as Record<string, any>;
const str = (k: string) => (typeof pdata[k] === "string" && pdata[k].trim() ? pdata[k].trim() : "");
const projectLocation = str("location");
const facts = [
  { k: "Units", v: str("units") },
  { k: "Site", v: str("sqm") },
  { k: "Value", v: str("value") },
  { k: "Completion", v: str("completionDate") },
].filter((f) => f.v);

// A small donut for the rail. The arithmetic is done here rather than in the
// template because an SVG arc is dash lengths along a circumference, and that
// is unreadable inline: each segment is drawn as a gap in a full circle, offset
// by everything before it.
const DONUT = { size: 112, r: 42, w: 15 };
const DONUT_C = 2 * Math.PI * DONUT.r;

const VALID_TABS = ["overview", "units", "inbox", "settings"] as const;
const tabParam = Astro.url.searchParams.get("tab") ?? "overview";
const tab = (VALID_TABS as readonly string[]).includes(tabParam) ? tabParam : "overview";
const saved = Astro.url.searchParams.get("saved") === "1";

// The plaintext ingest key is shown exactly once, right after generation. It
// arrives in a short-lived httpOnly cookie rather than the URL — secrets don't
// belong in browser history, server logs or referrer headers. Reading it here
// also consumes it, so a refresh won't show it again.
const freshKeyCookie = Astro.cookies.get("ep_fresh_ingest_key");
const freshKey = freshKeyCookie?.value ?? "";
if (freshKey) Astro.cookies.delete("ep_fresh_ingest_key", { path: "/admin" });

// ---- units: the project's sellable stock ----
// Every sales figure on this page is COUNTED from these rows. Nothing types a
// total in anywhere, so the figures cannot quietly go stale.
const units = (unitRes.data ?? []) as UnitRow[];
const sales = summarise(units);

// How the project is laid out. A building's unit count is COUNTED here, never
// stored — "3 blocks of 12" typed into a field is a number that can disagree
// with the units actually recorded, and disagreeing numbers are how a portal
// stops being believed.
const buildings = (buildingRes.data ?? []) as { id: string; name: string; kind: string; notes: string | null; position: number }[];

const unitsInBuilding = (id: string | null) =>
  units.filter((u) => (u.building_id ?? null) === id);
const unplacedUnits = unitsInBuilding(null);

// What the "add" form suggests as a name: Block A on an empty project, Block B
// once there is one entry, and so on. It also steps past any letter already in
// use, so it can never suggest a name that is about to be rejected as a
// duplicate.
// There is no stored "unit type" — it is what the units are actually called.
// Deriving it means the card can never claim a building holds apartments while
// its rows all say Villa; the trade is that a mixed building reports "Mixed"
// rather than picking a winner, which is the honest answer.
const unitTypeOf = (buildingId: string | null): string => {
  const kinds = [...new Set(
    unitsInBuilding(buildingId)
      .map((u) => u.code.trim().replace(/\s+\d+$/, "").trim())
      .filter(Boolean),
  )];
  if (kinds.length === 0) return "—";
  return kinds.length === 1 ? kinds[0] : "Mixed";
};

const nextBlockName = (() => {
  const taken = new Set(
    buildings
      .map((b) => b.name.trim().match(/^block\s+([a-z])$/i)?.[1]?.toUpperCase())
      .filter((x): x is string => !!x),
  );
  let i = buildings.length;
  while (i < 26 && taken.has(String.fromCharCode(65 + i))) i += 1;
  return i < 26 ? `Block ${String.fromCharCode(65 + i)}` : "";
})();


let donutAt = 0;
const donutSegments = SALES_BAR_ORDER.map((key) => {
  const full = sales.total > 0 ? (sales[key] / sales.total) * DONUT_C : 0;
  const seg = { key, colour: unitState(key).colour, length: full, offset: donutAt };
  donutAt += full;
  return seg;
}).filter((seg) => seg.length > 0);

// A 2px breath between arcs, so two colours never touch — but only when there
// is more than one, or the single full ring would show a nick in it.
const DONUT_GAP = donutSegments.length > 1 ? 2 : 0;

const unitsError = Astro.url.searchParams.get("units_error");
const unitsOk = Astro.url.searchParams.get("units_ok");

// ---- enquiries, with their derived waiting state ----
const allRows = (enquiryRes.data ?? []) as EnquiryRow[];

// Rejected enquiries are archived, not deleted - so they are held apart here
// and everything downstream works off `enquiries`. Doing it once, at the top,
// is why a rejected enquiry can't reappear in a stage count or a metric: there
// is no list further down that still contains it.
const enquiries = allRows.filter(isLive);
const rejected = allRows.filter((e) => !isLive(e));
// Who a unit can be sold to: this project's real buyers, resolved once rather
// than per row.
const buyerOptions = enquiries
  .filter((e) => e.triage === "converted")
  .map((e) => ({ id: e.id, name: e.name }));

const nameById = new Map((profileRes.data ?? []).map((p: any) => [p.id, p.full_name]));

const now = new Date();
const DAY = 86_400_000;
const since = (d: number) => new Date(now.getTime() - d * DAY);

const toTriage = enquiries.filter((e) => e.triage === "pending");
const newThisWeek = enquiries.filter((e) => new Date(e.created_at) > since(7)).length;
const newLastWeek = enquiries.filter(
  (e) => new Date(e.created_at) <= since(7) && new Date(e.created_at) > since(14),
).length;
// "We owe them something": they replied and we haven't, or we've never replied.
// Untriaged enquiries are excluded: we don't "owe a reply" to something nobody
// has decided is real. They have their own queue and their own count.
const awaitingReply = enquiries.filter(
  (e) => e.triage === "converted" && (e.waiting_on_us === true || e.message_count === 0),
).length;
const stageCount = (key: string) =>
  enquiries.filter((e) => e.triage === "converted" && (e.stage ?? "new") === key).length;

const attention = enquiries.filter((e) => needsAttention(e, now));
const groups = (["triage", "waiting", "overdue"] as const)
  .map((b) => ({ bucket: b, label: BUCKET_LABELS[b], items: attention.filter((e) => bucketOf(e, now) === b) }))
  .filter((g) => g.items.length > 0);

const maxStage = Math.max(1, ...BUYER_STAGES.map((s) => stageCount(s.key)));

// Two cards, not one queue: deciding whether someone is a real buyer and
// chasing someone who already is are different jobs, done at different moments.
// Both still come from the same bucketing, so nothing can appear in both.
const triageItems = groups.find((g) => g.bucket === "triage")?.items ?? [];
const followUpGroups = groups.filter((g) => g.bucket !== "triage");
const followUpCount = followUpGroups.reduce((n, g) => n + g.items.length, 0);

// ---- inbox: segment + selected enquiry ----
const SEGMENTS = [
  { key: "needs", label: "Needs you", rows: attention },
  { key: "triage", label: "To triage", rows: toTriage },
  { key: "all", label: "All", rows: enquiries },
  // Last, and only ever reached deliberately - rejecting is meant to make an
  // enquiry go away, but recoverably.
  { key: "rejected", label: "Rejected", rows: rejected },
];
const segParam = Astro.url.searchParams.get("seg") ?? "needs";
const segment = SEGMENTS.find((s) => s.key === segParam) ?? SEGMENTS[0];
const inboxRows = segment.rows;

const selectedId = Astro.url.searchParams.get("e") ?? inboxRows[0]?.id ?? "";
const selected = allRows.find((e) => e.id === selectedId) ?? null;

let messages: any[] = [];
let notes: any[] = [];
let events: any[] = [];
if (selected) {
  const [m, n, ev] = await Promise.all([
    supabase.from("inquiry_messages").select("direction, subject, body_html, sent_at, sent_by")
      .eq("inquiry_id", selected.id).order("sent_at"),
    supabase.from("enquiry_notes").select("body, created_at, author_id")
      .eq("inquiry_id", selected.id).order("created_at", { ascending: false }),
    supabase.from("enquiry_events").select("kind, detail, created_at, actor_id")
      .eq("inquiry_id", selected.id).order("created_at", { ascending: false }).limit(12),
  ]);
  // The mailbox is shared, so an outbound message says who actually wrote it
  // rather than assuming it was whoever happens to be reading the thread.
  messages = (m.data ?? []).map((x: any) => ({ ...x, sentByName: nameById.get(x.sent_by) ?? null }));
  notes = (n.data ?? []).map((x: any) => ({ ...x, author: nameById.get(x.author_id) ?? "Someone" }));
  events = (ev.data ?? []).map((x: any) => ({ ...x, actor: nameById.get(x.actor_id) ?? "System" }));
}

// ---- setup state ----
const hasDomain = !!project.domain;
const hasKey = !!project.ingest_key_hash;
const receivedAny = enquiries.length > 0;

// The checklist follows the mailbox route, which is how enquiries actually
// arrive: the website form emails the project inbox, and people email it
// directly too. The webhook is an optional extra, so it isn't a step here.
const steps = [
  { done: hasDomain, label: "Add the project domain", hint: "Identifies the site this project belongs to." },
  { done: !!project.mailbox_connected_at, label: "Connect the mailbox",
    hint: "Lets enquiries arrive automatically and replies go out from the project address." },
  { done: receivedAny, label: "First enquiry arrives",
    hint: "Ticks itself once mail from the inbox has been picked up." },
];
const remaining = steps.filter((s) => !s.done && !s.later).length;

// Only rejections nobody has dismissed yet. The rows stay either way — the log
// is the record that a submission was refused, and that remains true after it
// has been read.
const rejections = rejectionRes.data;

const inboxHref = (opts: { seg?: string; e?: string }) => {
  const p = new URLSearchParams({ tab: "inbox", seg: opts.seg ?? segment.key });
  if (opts.e) p.set("e", opts.e);
  return `/admin/projects/${slug}?${p.toString()}`;
};
// Where a form action returns to. Outcome parameters are stripped out first:
// leaving them in would stack "&sent=1" on every send, and would keep showing a
// stale banner over an action that had just gone perfectly well.
const backParams = new URLSearchParams(Astro.url.search);
backParams.delete("sent");
backParams.delete("send_error");
backParams.delete("mailbox");
backParams.delete("notice");
const selfHref = Astro.url.pathname + (backParams.size ? `?${backParams}` : "");

// One line under the tab row for "something just happened": the mailbox sync
// reports through it, and so does anything else that needs to say a word back.
const mailboxMessage =
  Astro.url.searchParams.get("mailbox") ?? Astro.url.searchParams.get("notice") ?? "";
const mailboxConnected = !!project.mailbox_connected_at;
const oauthReady = !!(import.meta.env.ZOHO_OAUTH_CLIENT_ID && import.meta.env.ZOHO_OAUTH_CLIENT_SECRET);

const webhookUrl = `${Astro.url.origin}/api/ingest/inquiry`;

const snippet = `// Example only — any language or form service can do this.
// The endpoint also accepts urlencoded and multipart bodies.
await fetch("${webhookUrl}", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "X-Ingest-Key": process.env.EP_INGEST_KEY,   // never expose this in the browser
  },
  body: JSON.stringify({
    name:    "Marta Puig",
    email:   "marta@example.com",
    phone:   "+376 300 111",       // optional
    message: "Interested in villa 4",
    locale:  "ca",                 // optional: en | es | ca
    source_page: "/vila-4",        // optional
  }),
});`;
---

<AdminLayout title={project.name} active={`project:${slug}`}>
  <style is:global>
    /* Cross-document view transitions: the browser cross-fades the old page into
       the new one and morphs any element the two share a view-transition-name
       for — here, the switcher's thumb, which slides between tabs.
       Global because @view-transition applies to the document, not a selector.
       Unsupported browsers ignore the whole rule and simply navigate. */
    @view-transition { navigation: auto; }

    /* The thumb travels on a slight overshoot, the same easing the switcher
       uses when it moves within a page — so the two are one motion, not two
       different-feeling ones. */
    ::view-transition-group(tab-thumb),
    ::view-transition-group(tab-label) {
      animation-duration: 380ms;
      animation-timing-function: cubic-bezier(0.32, 1.15, 0.44, 1);
    }

    /* The body of the page does not merely cross-fade: the outgoing content
       drops a few pixels as it goes and the incoming rises into place, which is
       what makes a full page load read as a switch rather than a flash. */
    ::view-transition-old(root) {
      animation: 200ms cubic-bezier(0.4, 0, 1, 1) both vt-leave;
    }
    ::view-transition-new(root) {
      animation: 320ms cubic-bezier(0.16, 1, 0.3, 1) both vt-enter;
    }
    @keyframes vt-leave {
      to { opacity: 0; transform: translateY(6px); }
    }
    @keyframes vt-enter {
      from { opacity: 0; transform: translateY(10px); }
    }

    /* Browsers without view transitions get the same feeling by other means:
       the new page's content rises into place on load. Behind @supports so the
       two can never both run and read as a double take. */
    @supports not (view-transition-name: none) {
      @media (prefers-reduced-motion: no-preference) {
        .tabpane { animation: 300ms cubic-bezier(0.16, 1, 0.3, 1) both vt-enter; }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      ::view-transition-group(*),
      ::view-transition-old(*),
      ::view-transition-new(*) { animation: none !important; }
    }

    /* AdminLayout wraps every select on the page and draws one chevron on the
       wrapper. These rules only retune that chevron for the unit pills: smaller,
       tucked closer in, and in the row's own state colour. Written here rather
       than in the scoped block because the wrapper is created by script and so
       has no scope attribute for Astro to match on. The extra class in the
       selector also puts it above the layout's own (0,2,1) rules. */
    .pick .select-wrap select.ep-select {
      padding-right: 1.75rem;
      padding-left: 0.85rem;
      padding-top: 0.34rem;
      padding-bottom: 0.34rem;
    }
    /* Drawn with borders rather than the layout's SVG: an SVG used as a
       background-image is its own document, so currentColor inside it resolves
       to black and never picks up the row's state colour. Two borders on a
       rotated box can. */
    .pick .select-wrap::after {
      right: 0.66rem;
      width: 7px; height: 7px; margin-top: -4px;
      background-image: none;
      border-right: 1.8px solid var(--ink, #93a3b8);
      border-bottom: 1.8px solid var(--ink, #93a3b8);
      transform: rotate(45deg);
    }
    .pick .select-wrap.is-open::after { transform: rotate(225deg); }
  </style>

  <style>
    /* No page title: the project's name is on the rail card, and the browser
       tab carries it too, so a heading above the switcher was saying the same
       thing a third time. The tab row is the first thing on the page. */

    /* ---- Overview: work on the left, the property on the right ---- */
    .ov { display: grid; grid-template-columns: minmax(0, 1fr) 348px; gap: 1rem; align-items: start; margin-top: 1.3rem; }
    .ov .strip { margin-top: 0; }
    /* .card.rail, not .rail: .card sets its own padding further down this
       stylesheet, and on equal specificity the later rule wins - which is what
       left the photo floating inside a white border instead of running to the
       card's edges. The padding moves inside, to .rbody. */
    .card.rail { overflow: hidden; padding: 0; }
    .rail .rphoto { display: block; width: 100%; height: 208px; object-fit: cover; }
    .rail .no-img { width: 100%; height: 208px; background: linear-gradient(120deg, #16283e, #0f2036); }
    .rail .rbody { padding: 1.2rem 1.4rem 1.3rem; }
    .rphoto-wrap { position: relative; }
    /* The status belongs to the photo, not to the name - and off that row the
       project name gets the full width, which is what keeps it on one line. */
    .rpill {
      position: absolute; top: 0.8rem; right: 0.85rem;
      background: rgba(255, 255, 255, 0.94); color: #a35700;
      box-shadow: 0 4px 14px rgba(15, 26, 42, 0.22);
    }
    /* Sits on the switcher's row, at the far end of it — the same height as the
       tabs, so the row reads as one control strip rather than a button parked
       above the content. */
    .tabrow {
      display: flex; align-items: center;
      justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    }
    .syncbtn {
      font: inherit; font-size: 0.78rem; font-weight: 700; color: #ffffff; background: #53b27f;
      border: 0; border-radius: 999px; padding: 0.55rem 1.25rem; cursor: pointer;
      box-shadow: 0 8px 20px rgba(83, 178, 127, 0.3);
      transition: background-color 200ms ease, transform 200ms ease;
    }
    .syncbtn:hover { background: #47a071; }
    .syncbtn:active { transform: translateY(1px); }
    .syncmsg {
      margin-top: 0.8rem; font-size: 0.78rem; line-height: 1.45; color: #2e7d54;
      background: rgba(83, 178, 127, 0.1); border: 1px solid rgba(83, 178, 127, 0.28);
      border-radius: 10px; padding: 0.55rem 0.8rem;
      display: flex; align-items: flex-start; justify-content: space-between; gap: 0.8rem;
    }
    .msgx {
      flex: none; font-size: 1.05rem; line-height: 1; color: #2e7d54; opacity: 0.55;
      text-decoration: none; padding: 0 0.25rem; border-radius: 6px;
      transition: opacity 160ms ease, background-color 160ms ease;
    }
    .msgx:hover { opacity: 1; background: rgba(83, 178, 127, 0.16); }

    .rname {
      font-size: 1.02rem; font-weight: 700; line-height: 1.2;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .rloc { margin-top: 0.15rem; font-size: 0.75rem; color: #5c6f88; }
    .rpill {
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      padding: 0.22rem 0.6rem; border-radius: 999px; white-space: nowrap;
    }
    .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 1rem; }
    .fact .k { font-size: 0.66rem; letter-spacing: 0.05em; text-transform: uppercase; color: #93a3b8; }
    .fact .v { margin-top: 0.1rem; font-size: 0.92rem; font-weight: 700; }
    /* Card B, shrunk to fit the rail: the ring on the left, the three states
       read down the right. Small enough that the counts do the work and the
       ring is the shape of the thing rather than the measurement. */
    .donutrow { display: flex; align-items: center; gap: 1rem; margin-top: 0.8rem; }
    .donut { position: relative; flex: none; }
    .dcen { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
    .dcen b { font-size: 1.45rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
    .dcen span { display: block; margin-top: 0.15rem; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: #93a3b8; }
    .dlist { flex: 1; min-width: 0; display: grid; gap: 0.1rem; }
    .drow {
      display: grid; grid-template-columns: 9px 1fr auto auto; align-items: center; gap: 0.5rem;
      padding: 0.34rem 0; border-bottom: 1px solid #f2f5f9; font-size: 0.76rem;
    }
    .drow:last-child { border-bottom: 0; }
    .drow .dot { width: 9px; height: 9px; border-radius: 3px; }
    .drow .k { color: #5c6f88; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .drow b { font-weight: 700; }
    .drow .p { color: #93a3b8; font-size: 0.7rem; width: 34px; text-align: right; }
    .rnone { margin-top: 0.5rem; font-size: 0.76rem; color: #93a3b8; }

    .rsep { height: 1px; background: #eef2f7; margin: 1.1rem 0 0.8rem; }
    .rkv { display: flex; justify-content: space-between; gap: 0.8rem; font-size: 0.78rem; padding: 0.32rem 0; border-bottom: 1px solid #f2f5f9; }
    .rkv:last-child { border-bottom: 0; }
    .rkv span { color: #93a3b8; }
    .rkv b { font-weight: 700; text-align: right; word-break: break-word; }
    .rkv a { color: #2e7d54; text-decoration: none; font-weight: 700; }

    .cardhead { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
    .cardhead .hint { margin-left: auto; font-size: 0.72rem; color: #93a3b8; }
    /* ---- sales status ---- */
    /* 2px of surface between segments, so two colours never touch. */
    .s-bar { display: flex; gap: 2px; height: 26px; margin-top: 1.1rem; }
    .s-bar i { display: block; height: 100%; min-width: 4px; }
    .s-bar i:first-child { border-radius: 8px 0 0 8px; }
    .s-bar i:last-child { border-radius: 0 8px 8px 0; }
    .s-bar i:only-child { border-radius: 8px; }
    .s-leg { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.1rem; align-items: center; }
    .s-leg .it { display: flex; align-items: center; gap: 0.45rem; }
    .s-leg .dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }
    .s-leg .k { font-size: 0.76rem; color: #5c6f88; }
    .s-leg b { font-size: 0.9rem; font-weight: 700; }
    .s-leg .money { margin-left: auto; font-size: 0.78rem; font-weight: 700; color: #2e7d54; }
