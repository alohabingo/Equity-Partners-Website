  <script>
    // ---------- Drag & drop reordering ----------
    (() => {
      const toast = document.createElement("div");
      toast.className = "sort-saving";
      document.body.appendChild(toast);
      let toastTimer: number | undefined;
      function flash(msg: string, isError = false) {
        toast.textContent = msg;
        toast.classList.toggle("err", isError);
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove("show"), isError ? 4000 : 1400);
      }

      function makeSortable(container: HTMLElement | null, endpoint: string, cardSel: string, horizontal: boolean, groupIds: string[]) {
        if (!container) return;
        let dragging: HTMLElement | null = null;
        let originalOrder: string[] = [];

        container.addEventListener("dragstart", (e) => {
          (window as any).__epDragging = true;
          const card = (e.target as HTMLElement).closest(cardSel) as HTMLElement | null;
          if (!card) return;
          dragging = card;
          originalOrder = groupIds.flatMap((gid) => {
            const box = document.getElementById(gid);
            return box ? [...box.querySelectorAll<HTMLElement>(cardSel)].map((c) => c.dataset.id!) : [];
          });
          container.classList.add("is-sorting");
          // let the browser paint the card before dimming it
          setTimeout(() => card.classList.add("dragging"), 0);
          e.dataTransfer!.effectAllowed = "move";
          e.dataTransfer!.setData("text/plain", card.dataset.id || "");
        });

        container.addEventListener("dragover", (e) => {
          if (!dragging) return;
          e.preventDefault();
          const over = (e.target as HTMLElement).closest(cardSel) as HTMLElement | null;
          if (!over || over === dragging) return;
          const box = over.getBoundingClientRect();
          const before = horizontal
            ? (e as DragEvent).clientX < box.left + box.width / 2
            : (e as DragEvent).clientY < box.top + box.height / 2;
          container.insertBefore(dragging, before ? over : over.nextSibling);
        });

        container.addEventListener("dragend", async () => {
          setTimeout(() => { (window as any).__epDragging = false; }, 60);
          if (!dragging) return;
          dragging.classList.remove("dragging");
          container.classList.remove("is-sorting");
          dragging = null;

          const ids = groupIds.flatMap((gid) => {
            const box = document.getElementById(gid);
            return box ? [...box.querySelectorAll<HTMLElement>(cardSel)].map((c) => c.dataset.id!) : [];
          });
          if (ids.join(",") === originalOrder.join(",")) return; // nothing moved

          flash("Saving order…");
          try {
            const fd = new FormData();
            fd.append("action", "reorder");
            fd.append("ids", ids.join(","));
            const res = await fetch(endpoint, { method: "POST", body: fd, headers: { Accept: "application/json" } });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) throw new Error(data.error || "failed");
            flash("Order saved ✓");
          } catch (err) {
            flash("Could not save the new order — refresh and try again.", true);
          }
        });

        // a plain click still opens the editor; suppress it right after a drag
        container.addEventListener("drop", (e) => e.preventDefault());
      }

      // Visible lists first, then the hidden group — the saved order covers both
      // so sort_order stays consistent across the whole table.
      makeSortable(document.getElementById("team-grid"), "/api/admin/team", ".mcard", true,
        ["team-grid", "team-hidden-grid"]);
      makeSortable(document.getElementById("team-hidden-grid"), "/api/admin/team", ".mcard", true,
        ["team-grid", "team-hidden-grid"]);
      makeSortable(document.getElementById("partner-list"), "/api/admin/partners", ".pcard", false,
        ["partner-list", "partner-hidden-list"]);
      makeSortable(document.getElementById("partner-hidden-list"), "/api/admin/partners", ".pcard", false,
        ["partner-list", "partner-hidden-list"]);
    })();

    // Tidy the URL after a save/remove redirect (no banner is shown).
    (() => {
      const p = new URLSearchParams(location.search);
      if (p.has("saved") || p.has("removed")) {
        p.delete("saved");
        p.delete("removed");
        const q = p.toString();
        history.replaceState({}, "", q ? `/admin/team?${q}` : "/admin/team");
      }
    })();

    // ---------- Smooth Team ⇄ Partners switching (no page reload) ----------
    (() => {
      const views: Record<string, HTMLElement | null> = {
        team: document.getElementById("view-team"),
        partners: document.getElementById("view-partners"),
      };
      const title = document.getElementById("view-title")!;
      const sub = document.getElementById("view-sub")!;
      const addMember = document.getElementById("add-member") as HTMLButtonElement;
      const addPartner = document.getElementById("add-partner") as HTMLButtonElement;
      const COPY: Record<string, [string, string]> = {
        team: ["Team", "Click a team member to edit. Changes go live on the About page immediately."],
        partners: ["Partners", "Click a partner to edit. Visible partners appear on the public Partners page."],
      };

      const thumb = document.getElementById("seg-thumb")!;
      function moveThumb(animate = true) {
        const active = document.querySelector<HTMLElement>(".seg-btn.active");
        if (!active) return;
        thumb.classList.toggle("no-anim", !animate);
        thumb.style.width = `${active.offsetWidth}px`;
        thumb.style.transform = `translateX(${active.offsetLeft}px)`;
        if (!animate) requestAnimationFrame(() => thumb.classList.remove("no-anim"));
      }
      // position on load (fonts can shift widths, so redo once ready)
      moveThumb(false);
      document.fonts?.ready.then(() => moveThumb(false));
      window.addEventListener("resize", () => moveThumb(false));

      function show(next: string, push = true) {
        const current = views.team?.hidden ? "partners" : "team";
        if (next === current) return;
        const from = views[current]!;
        const to = views[next]!;

        from.classList.add("leaving");
        setTimeout(() => {
          from.hidden = true;
          from.classList.remove("leaving");
          to.hidden = false;
          to.classList.add("entering");
          setTimeout(() => to.classList.remove("entering"), 320);
        }, 180);

        document.querySelectorAll<HTMLElement>(".seg-btn").forEach((b) =>
          b.classList.toggle("active", b.dataset.view === next)
        );
        moveThumb();
        const [h, p] = COPY[next];
        title.textContent = h;
        sub.textContent = p;
        addMember.hidden = next === "partners";
        addPartner.hidden = next !== "partners";
        if (push) {
          const url = next === "partners" ? "/admin/team?view=partners" : "/admin/team";
          history.pushState({ view: next }, "", url);
        }
      }

      document.querySelectorAll<HTMLElement>(".seg-btn").forEach((btn) =>
        btn.addEventListener("click", () => show(btn.dataset.view!))
      );
      window.addEventListener("popstate", () => {
        const v = new URLSearchParams(location.search).get("view") === "partners" ? "partners" : "team";
        show(v, false);
      });
    })();

    const members = JSON.parse(document.getElementById("team-data")?.textContent || "[]");
    const byId = new Map(members.map((m: any) => [m.id, m]));

    const drawer = document.getElementById("drawer")!;
    const backdrop = document.getElementById("drawer-backdrop")!;
    const title = document.getElementById("drawer-title")!;
    const del = document.getElementById("drawer-delete") as HTMLButtonElement;
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

    const BLANK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 84 84'%3E%3Crect width='84' height='84' fill='%23eef2f7'/%3E%3C/svg%3E";

    function open(id: string | null) {
      const m: any = id ? byId.get(id) : null;
      const t = m?.translations ?? {};
      title.textContent = m ? `Edit ${m.name}` : "New team member";
      $("f-id").value = m?.id ?? "";
      $("f-name").value = m?.name ?? "";
      $("f-photo-url").value = m?.photo_url ?? "";
      $("f-linkedin").value = m?.linkedin_url ?? "";
      ($("f-status") as unknown as HTMLSelectElement).value = m?.status ?? "published";
      (document.getElementById("f-preview") as HTMLImageElement).src = m?.photo_url || BLANK;
      for (const loc of ["en", "es", "ca"]) {
        $(`f-role-${loc}`).value = t[loc]?.role ?? "";
        ($(`f-bio-${loc}`) as unknown as HTMLTextAreaElement).value = t[loc]?.description ?? "";
      }
      // English opens by default; ES/CA start closed. Flags show whether copy exists.
      document.querySelectorAll<HTMLDetailsElement>("[data-acc]").forEach((acc) => {
        const loc = acc.dataset.acc!;
        acc.open = loc === "en";
        const flag = acc.querySelector<HTMLElement>(".acc-flag")!;
        const filled = Boolean(t[loc]?.role || t[loc]?.description);
        flag.textContent = filled ? "translated" : "empty";
        flag.classList.toggle("filled", filled);
      });
      del.style.display = m ? "block" : "none";
      del.onclick = (e) => {
        if (!confirm(`Remove ${m?.name} from the team page?`)) e.preventDefault();
      };
      const st = document.getElementById("f-upload-status")!;
      st.textContent = "";
      st.className = "upload-status";
      drawer.classList.add("open");
      backdrop.classList.add("open");
      drawer.setAttribute("aria-hidden", "false");
      setTimeout(() => $("f-name").focus(), 320);
    }

    function close() {
      drawer.classList.remove("open");
      backdrop.classList.remove("open");
      drawer.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll("[data-open]").forEach((el) => {
      el.addEventListener("click", (e) => {
        if ((window as any).__epDragging) return;   // just finished a drag
        if ((e.target as HTMLElement).closest("form.inline")) return;
        e.preventDefault();
        open(el.getAttribute("data-open"));
      });
    });
    document.getElementById("add-member")?.addEventListener("click", () => open(null));
    document.getElementById("drawer-close")?.addEventListener("click", close);
    document.getElementById("drawer-cancel")?.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });

    // ---------- Photo upload (button, drag & drop) ----------
    const photoInput = document.getElementById("f-photo-input") as HTMLInputElement;
    const dropzone = document.getElementById("f-dropzone")!;
    const status = () => document.getElementById("f-upload-status")!;

    function setStatus(msg: string, kind: "" | "ok" | "err" = "") {
      const el = status();
      el.textContent = msg;
      el.className = "upload-status" + (kind ? " " + kind : "");
    }

    const ERRORS: Record<string, string> = {
      bad_type: "That file type isn't supported. Please use JPG, PNG, WebP or GIF (iPhone .HEIC photos need exporting as JPG first).",
      too_large: "That image is over 8 MB — please use a smaller file.",
      no_file: "No file was received. Please try again.",
    };

    async function uploadFile(file: File) {
      if (!file) return;
      if (file.size > 8 * 1024 * 1024) return setStatus(ERRORS.too_large, "err");
      setStatus(`Uploading ${file.name}…`);
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(ERRORS[data.error] || data.error || `upload failed (${res.status})`);
        $("f-photo-url").value = data.url;
        (document.getElementById("f-preview") as HTMLImageElement).src = data.url;
        setStatus("Photo uploaded ✓ — remember to Save", "ok");
      } catch (err) {
        setStatus(err instanceof Error ? err.message : "Upload failed", "err");
      }
    }

    photoInput?.addEventListener("change", () => {
      const file = photoInput.files?.[0];
      if (file) uploadFile(file);
    });

    ["dragenter", "dragover"].forEach((ev) =>
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        dropzone.classList.add("dragover");
      })
    );
    ["dragleave", "drop"].forEach((ev) =>
      dropzone.addEventListener(ev, (e) => {
        e.preventDefault();
        dropzone.classList.remove("dragover");
      })
    );
    dropzone.addEventListener("drop", (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) uploadFile(file);
    });

    // ================= PARTNERS =================
    const partners = JSON.parse(document.getElementById("partner-data")?.textContent || "[]");
    const pById = new Map(partners.map((p: any) => [p.id, p]));
    const pdrawer = document.getElementById("pdrawer")!;
    const pTitle = document.getElementById("pdrawer-title")!;
    const pDel = document.getElementById("pdrawer-delete") as HTMLButtonElement;
    const LOGO_BLANK = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E";

    function openPartner(id: string | null) {
      const p: any = id ? pById.get(id) : null;
      const t = p?.translations ?? {};
      pTitle.textContent = p ? `Edit ${p.name}` : "New partner";
      $("p-id").value = p?.id ?? "";
      $("p-name").value = p?.name ?? "";
      $("p-logo-url").value = p?.logo_url ?? "";
      $("p-website").value = p?.website_url ?? "";
      ($("p-status") as unknown as HTMLSelectElement).value = p?.status ?? "published";
      (document.getElementById("p-preview") as HTMLImageElement).src = p?.logo_url || LOGO_BLANK;
      for (const loc of ["en", "es", "ca"]) {
        $(`p-role-${loc}`).value = t[loc]?.role ?? "";
        ($(`p-summary-${loc}`) as unknown as HTMLTextAreaElement).value = t[loc]?.summary ?? "";
      }
      document.querySelectorAll<HTMLDetailsElement>("[data-pacc]").forEach((acc) => {
        const loc = acc.dataset.pacc!;
        acc.open = loc === "en";
        const flag = acc.querySelector<HTMLElement>(".acc-flag")!;
        const filled = Boolean(t[loc]?.role || t[loc]?.summary);
        flag.textContent = filled ? "translated" : "empty";
        flag.classList.toggle("filled", filled);
      });
      pDel.style.display = p ? "block" : "none";
      pDel.onclick = (e) => {
        if (!confirm(`Remove ${p?.name} from the partners page?`)) e.preventDefault();
      };
      const st = document.getElementById("p-upload-status")!;
      st.textContent = "";
      st.className = "upload-status";
      pdrawer.classList.add("open");
      backdrop.classList.add("open");
      pdrawer.setAttribute("aria-hidden", "false");
      setTimeout(() => $("p-name").focus(), 320);
    }

    function closePartner() {
      pdrawer.classList.remove("open");
      backdrop.classList.remove("open");
      pdrawer.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll("[data-open-partner]").forEach((el) => {
      el.addEventListener("click", (e) => {
        if ((window as any).__epDragging) return;   // just finished a drag
        if ((e.target as HTMLElement).closest("form.inline")) return;
        e.preventDefault();
        openPartner(el.getAttribute("data-open-partner"));
      });
    });
    document.getElementById("add-partner")?.addEventListener("click", () => openPartner(null));
    document.getElementById("pdrawer-close")?.addEventListener("click", closePartner);
    document.getElementById("pdrawer-cancel")?.addEventListener("click", closePartner);
    backdrop.addEventListener("click", closePartner);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closePartner(); });

    // Logo upload (button + drag & drop)
    const logoInput = document.getElementById("p-logo-input") as HTMLInputElement;
    const pDropzone = document.getElementById("p-dropzone")!;
    function setPStatus(msg: string, kind: "" | "ok" | "err" = "") {
      const el = document.getElementById("p-upload-status")!;
      el.textContent = msg;
      el.className = "upload-status" + (kind ? " " + kind : "");
    }
    async function uploadLogo(file: File) {
      if (!file) return;
      if (file.size > 8 * 1024 * 1024) return setPStatus(ERRORS.too_large, "err");
      setPStatus(`Uploading ${file.name}…`);
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/admin/upload", { method: "POST", body: fd });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(ERRORS[data.error] || data.error || `upload failed (${res.status})`);
        $("p-logo-url").value = data.url;
        (document.getElementById("p-preview") as HTMLImageElement).src = data.url;
        setPStatus("Logo uploaded ✓ — remember to Save", "ok");
      } catch (err) {
        setPStatus(err instanceof Error ? err.message : "Upload failed", "err");
      }
    }
    logoInput?.addEventListener("change", () => {
      const file = logoInput.files?.[0];
      if (file) uploadLogo(file);
    });
    ["dragenter", "dragover"].forEach((ev) =>
      pDropzone.addEventListener(ev, (e) => { e.preventDefault(); pDropzone.classList.add("dragover"); })
    );
    ["dragleave", "drop"].forEach((ev) =>
      pDropzone.addEventListener(ev, (e) => { e.preventDefault(); pDropzone.classList.remove("dragover"); })
    );
    pDropzone.addEventListener("drop", (e) => {
      const file = (e as DragEvent).dataTransfer?.files?.[0];
      if (file) uploadLogo(file);
    });
  </script>
</AdminLayout>
