---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SiteFooter from "../components/SiteFooter.astro";

const mapEmbedUrl =
  "https://maps.google.com/maps?q=42.506278,1.522801&t=&z=18&ie=UTF8&iwloc=&output=embed";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Contact | Equity Partners</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --text-primary: #1f2835;
        --text-muted: #5a667a;
        --text-light: #e8edf5;
        --accent: #8293ae;
        --line: #dbe1ea;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--text-primary);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.5;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 1.8rem;
        padding-top: 2.15rem;
        padding-bottom: 0.15rem;
        padding-left: calc((100vw - min(var(--max-width), 92vw)) / 2);
        padding-right: calc((100vw - min(var(--max-width), 92vw)) / 2);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: none;
        width: 100%;
        z-index: 220;
        background: rgba(15, 26, 42, 0.92) !important;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        transition: padding-top 320ms ease, padding-bottom 320ms ease, background-color 320ms ease,
          backdrop-filter 320ms ease, -webkit-backdrop-filter 320ms ease, border-color 320ms ease,
          box-shadow 320ms ease;
      }

      body.is-scrolled .site-header {
        background: rgba(15, 26, 42, 0.6) !important;
        padding-top: 1.25rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom-color: rgba(220, 231, 246, 0.2);
        box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
      }

      body.is-scrolled .menu-cta {
        background: #53b27f;
        border-color: #53b27f;
      }

      body.is-scrolled .logo {
        top: -5px;
      }

      body.is-scrolled .main-nav {
        top: -4px;
      }

      @supports not ((backdrop-filter: blur(1px))) {
        body.is-scrolled .site-header {
          background: rgba(15, 26, 42, 0.84) !important;
        }
      }

      .logo {
        width: 180px;
        height: auto;
        position: relative;
        top: -12px;
        filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
          drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
        transition: top 320ms ease, margin-top 320ms ease;
      }

      .main-nav {
        display: flex;
        align-items: center;
        margin-left: auto;
        flex-wrap: nowrap;
        gap: 1.3rem;
        position: relative;
        top: -11px;
        z-index: 121;
        transition: top 320ms ease;
      }

      .menu-toggle-input {
        display: none;
      }

      .menu-toggle {
        display: none;
        width: 38px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 0.45rem;
        background: transparent;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: top 320ms ease;
      }

      .menu-toggle-bars {
        display: block;
        width: 18px;
        height: 2px;
        background: #ffffff;
        position: relative;
        transition: background 220ms ease;
      }

      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        background: #ffffff;
        transition: transform 220ms ease, top 220ms ease;
      }

      .menu-toggle-bars::before {
        top: -6px;
      }

      .menu-toggle-bars::after {
        top: 6px;
      }

      .menu-list {
        list-style: none;
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        white-space: nowrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
      }

      .menu-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }

      .menu-link:hover,
      .menu-link.is-active {
        color: #d7e3f5;
      }

      .menu-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: 1px;
        flex: 0 0 auto;
        min-width: 126px;
        color: #ffffff;
        background: #53b27f;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid #53b27f;
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
      }

      .menu-cta:hover {
        background: #3f9568;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
      }

      .menu-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.9);
        outline-offset: 2px;
      }

      .hero-content {
        margin-top: auto;
        max-width: 38rem;
        padding-top: 4.6rem;
      }

      .hero-kicker {
        margin-bottom: 1rem;
        font-size: 0.78rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: #b2c0d4;
      }

      h1 {
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(1.9rem, 4.3vw, 3rem);
        line-height: 1.08;
      }

      .subline {
        margin-top: 0.9rem;
        color: #cad4e4;
        font-size: clamp(0.98rem, 1.6vw, 1.15rem);
      }

      .section {
        padding: 4rem 0;
      }

      .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.85rem;
      }

      h2 {
        font-size: clamp(1.55rem, 3vw, 2.3rem);
        line-height: 1.12;
      }

      .intro {
        margin-top: 0.9rem;
        color: var(--text-muted);
      }

      .contact-grid {
        margin-top: 1.9rem;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 1rem;
      }

      .contact-card {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.3rem;
      }

      .contact-form {
        display: grid;
        gap: 0.85rem;
      }

      .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
      }

      .input,
      .textarea {
        width: 100%;
        border: 1px solid #cfd9e7;
        border-radius: 0.55rem;
        background: #f9fbff;
        padding: 0.72rem 0.8rem;
        font-size: 0.92rem;
        color: #1a2433;
        outline: none;
        font-family: inherit;
      }

      .input:focus,
      .textarea:focus {
        border-color: #9eb0ca;
        box-shadow: 0 0 0 2px rgba(130, 147, 174, 0.18);
      }

      .textarea {
        min-height: 130px;
        resize: vertical;
      }

      .submit {
        width: fit-content;
        height: 42px;
        border: 1px solid rgba(14, 24, 39, 0.18);
        background: #1b2a3f;
        color: #eaf1fb;
        border-radius: 0.55rem;
        padding: 0 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 600;
        cursor: pointer;
      }

      .contact-list {
        list-style: none;
        margin: 1rem 0 0;
        padding: 0;
        display: grid;
        gap: 0.8rem;
      }

      .contact-list li {
        color: var(--text-muted);
        display: grid;
        grid-template-columns: 16px 1fr;
        align-items: start;
        gap: 0.6rem;
      }

      .contact-list-icon {
        width: 16px;
        min-width: 16px;
        height: 16px;
        min-height: 16px;
        color: #53b27f;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 0.08rem;
        flex: 0 0 16px;
      }

      .contact-list-icon svg {
        width: 16px;
        height: 16px;
        display: block;
        flex: 0 0 16px;
      }

      .newsletter {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 2.5rem 0;
      }

      .newsletter-wrap {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 1.4rem;
        align-items: center;
        background: #ffffff;
        border: 1px solid #d7deea;
        border-radius: 1rem;
        padding: 1.5rem;
      }

      .newsletter-copy p {
        margin-top: 0.7rem;
        color: var(--text-muted);
        max-width: 34rem;
      }

      .newsletter-copy h2 {
        font-size: clamp(1.55rem, 3vw, 2.45rem);
        line-height: 1.12;
      }

      .newsletter-form {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        justify-content: flex-end;
      }

      .newsletter-input {
        width: min(360px, 100%);
        height: 44px;
        border-radius: 0.55rem;
        border: 1px solid #cfd9e7;
        background: #f9fbff;
        padding: 0 0.85rem;
        font-size: 0.92rem;
        color: #1a2433;
        outline: none;
        font-family: inherit;
      }

      .newsletter-input:focus {
        border-color: #9eb0ca;
        box-shadow: 0 0 0 2px rgba(130, 147, 174, 0.18);
      }

      .newsletter-button {
        height: 44px;
        border: 1px solid #53b27f;
        background: #53b27f;
        color: #ffffff;
        border-radius: 0.55rem;
        padding: 0 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 180ms ease, transform 180ms ease, border-color 180ms ease;
      }

      .newsletter-button:hover {
        background: #3f9568;
        border-color: #3f9568;
        transform: translateY(-1px);
      }

      .newsletter-note {
        margin-top: 0.5rem;
        color: #7a889e;
        font-size: 0.72rem;
      }

      .map-comparison {
        background: transparent;
        border-top: 1px solid var(--line);
      }

      .map-options {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .map-option {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.1rem;
        display: grid;
        align-content: start;
        gap: 0.9rem;
      }

      .map-option-label {
        color: var(--accent);
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .map-option h3 {
        font-size: 1.15rem;
        line-height: 1.2;
        color: var(--text-primary);
      }

      .map-option-copy {
        color: var(--text-muted);
        font-size: 0.92rem;
        line-height: 1.55;
      }

      .map-shell {
        overflow: hidden;
        border-radius: 0.9rem;
        border: 1px solid #d8e2ef;
        background: #edf2f9;
        min-height: 28rem;
      }

      .map-shell iframe {
        width: 100%;
        height: 100%;
        min-height: 28rem;
        border: 0;
        display: block;
      }

      @media (max-width: 980px) {
        .contact-grid,
        .newsletter-wrap,
        .map-options {
          grid-template-columns: 1fr;
        }

        .field-row {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 680px) {
        .site-header {
          gap: 0.45rem;
          min-height: 44px;
        }

        body.is-scrolled .site-header {
          padding-top: 2.15rem;
          padding-bottom: 0.65rem;
        }

        .main-nav {
          position: static;
          gap: 0.55rem;
        }

        .menu-toggle {
          display: inline-flex;
          position: relative;
          top: -4px;
          border: 0;
          box-shadow: none;
        }

        .menu-list {
          position: absolute;
          top: calc(100% + 0.5rem);
          left: 0.8rem;
          right: auto;
          min-width: min(190px, calc(100vw - 2rem));
          flex-direction: column;
          align-items: flex-start;
          gap: 0.55rem;
          padding: 0;
          max-height: 0;
          opacity: 0;
          overflow: hidden;
          transform: translateY(-8px);
          pointer-events: none;
          background: rgba(255, 255, 255, 0.96);
          border: 1px solid #d3ddea;
          border-radius: 0.6rem;
          transition: max-height 240ms ease, opacity 240ms ease, transform 240ms ease, padding 240ms ease;
          z-index: 220;
        }

        .menu-toggle-input:checked ~ .main-nav .menu-list {
          max-height: 320px;
          opacity: 1;
          transform: translateY(0);
          pointer-events: auto;
          padding: 0.7rem;
        }

        .menu-list .menu-link {
          color: #172235;
          text-shadow: none;
        }

        .menu-list .menu-link:hover,
        .menu-list .menu-link.is-active {
          color: #5e7393;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars {
          background: transparent;
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::before {
          top: 0;
          transform: rotate(45deg);
        }

        .menu-toggle-input:checked ~ .menu-toggle .menu-toggle-bars::after {
          top: 0;
          transform: rotate(-45deg);
        }

        .logo {
          width: min(34vw, 170px);
          height: auto;
          position: static;
          top: auto;
          transform: none;
          margin-left: 0.9rem;
          margin-top: -14px;
        }

        .menu-link {
          font-size: 0.7rem;
        }

        .menu-cta {
          display: inline-flex;
          top: -4px;
          min-width: 102px;
          padding: 0.58rem 0.8rem;
          font-size: 0.68rem;
        }

        .newsletter-form {
          flex-direction: column;
          align-items: stretch;
        }

        .input,
        .textarea,
        .newsletter-input {
          font-size: 16px;
        }

        .newsletter-input {
          width: 100%;
        }

        .newsletter-button {
          width: 100%;
        }

        .map-option {
          padding: 1rem;
        }

        .map-shell iframe,
        .map-shell {
          min-height: 19rem;
        }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader menuToggleId="mobile-menu-toggle-contact" />

    <section class="section">
      <div class="container">
        <p class="eyebrow">Investor Inquiry</p>
        <h2>Discuss your Andorra investment options</h2>
        <p class="intro">
          Reach out to our team to answer any Andorra investment options you may have, or for any additional information you may require.
        </p>
        <div class="contact-grid">
          <article class="contact-card">
            <form class="contact-form" name="contact-inquiry" data-netlify="true" method="post" action="#">
              <input type="hidden" name="form-name" value="contact-inquiry" />
              <div class="field-row">
                <input class="input" type="text" name="first_name" placeholder="First name" required />
                <input class="input" type="text" name="last_name" placeholder="Last name" required />
              </div>
              <div class="field-row">
                <input class="input" type="email" name="email" placeholder="Email address" required />
                <input class="input" type="text" name="company" placeholder="Company" />
              </div>
              <textarea class="textarea" name="message" placeholder="Share your investment focus and timeline" required></textarea>
              <button class="submit" type="submit">Send Enquiry</button>
            </form>
          </article>

          <article class="contact-card">
            <p class="eyebrow">Contact Us</p>
            <h3>Equity Partners</h3>
            <ul class="contact-list">
              <li>
                <span class="contact-list-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"></path>
                    <path d="m22 6-10 7L2 6"></path>
                  </svg>
                </span>
                <span>info@equitypartnersandorra.com</span>
              </li>
              <li>
                <span class="contact-list-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.79.61 2.64a2 2 0 0 1-.45 2.11L8 9.99a16 16 0 0 0 6 6l1.52-1.27a2 2 0 0 1 2.11-.45c.85.28 1.74.49 2.64.61A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </span>
                <span>+376 000 000</span>
              </li>
              <li>
                <span class="contact-list-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10.5c0 6-9 12-9 12s-9-6-9-12a9 9 0 1 1 18 0Z"></path>
                    <circle cx="12" cy="10.5" r="3"></circle>
                  </svg>
                </span>
                <span>
                  Carrer Prat de la Creu 59-65,<br />
                  Edificio Prat de la Creu, Bloc A, 4 1ª,<br />
                  AD500 Andorra la Vella
                </span>
              </li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section map-comparison">
      <div class="container">
        <div class="map-options">
          <article class="map-option">
            <p class="map-option-label">Come By Our Office</p>
            <div class="map-shell">
              <iframe
                title="Equity Partners office map option 1"
                src={mapEmbedUrl}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </article>
        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId="newsletter-email-contact" />

    <SiteFooter />
    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>
  </body>
</html>
