                <input type="hidden" name="form-name" value="investor-inquiry" />
                <div class="field-row">
                  <input class="input" type="text" name="first_name" placeholder={content.form.firstName} required />
                  <input class="input" type="text" name="last_name" placeholder={content.form.lastName} required />
                </div>
                <div class="field-row">
                  <input class="input" type="email" name="email" placeholder={content.form.email} required />
