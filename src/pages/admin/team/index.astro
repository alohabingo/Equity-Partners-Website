---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseServer } from "../../../lib/supabase";

const supabase = supabaseServer(Astro.cookies, Astro.request);
const q = Astro.url.searchParams;
const view = q.get("view") === "partners" ? "partners" : "team";

const [{ data: members }, { data: partnerRows }] = await Promise.all([
  supabase
    .from("team_members")
    .select("id, name, photo_url, linkedin_url, sort_order, status, translations")
    .order("sort_order"),
  supabase
    .from("partners")
    .select("id, name, logo_url, website_url, sort_order, status, translations")
    .order("sort_order"),
]);

const allMembers = members ?? [];
const allPartners = partnerRows ?? [];
const list = allMembers.filter((m) => m.status === "published");
const hiddenMembers = allMembers.filter((m) => m.status !== "published");
const partners = allPartners.filter((p) => p.status === "published");
const hiddenPartners = allPartners.filter((p) => p.status !== "published");

const error = q.get("error") === "name_required" ? "A name is required." : null;

const tr = (m: any, loc: string, field: "role" | "description" | "summary") =>
  (m?.translations?.[loc]?.[field] ?? "") as string;

const LOCALES = [
  { key: "en", label: "English" },
  { key: "es", label: "Español" },
  { key: "ca", label: "Català" },
];
---

<AdminLayout title="Team" active="team">
  <style>
    .head-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .new-btn {
      font: inherit; font-size: 0.82rem; font-weight: 700; color: #ffffff;
      background: #53b27f; border: 0; border-radius: 8px; padding: 0.6rem 1.1rem; cursor: pointer;
    }
    .new-btn:hover { filter: brightness(1.08); }
    .notice { margin-top: 1.1rem; padding: 0.65rem 0.9rem; border-radius: 8px; font-size: 0.85rem; }
    .notice.err { background: rgba(203, 76, 76, 0.1); border: 1px solid rgba(203, 76, 76, 0.35); color: #a33d3d; }
    .empty { margin-top: 2rem; color: #5c6f88; font-size: 0.92rem; }

    /* Four per row, mirroring the public "Meet the team" grid */
    .cards { margin-top: 1.4rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
    @media (max-width: 1280px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 980px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 640px) { .cards { grid-template-columns: 1fr; } }

    .mcard {
      position: relative; cursor: pointer;
      background: #ffffff; border: 1px solid #d7deea; border-radius: 0.9rem;
      padding: 1.2rem 1.2rem 1rem; text-align: center;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
      display: flex; flex-direction: column; align-items: center; gap: 0.45rem;
      overflow: hidden; isolation: isolate;
      transition: border-color 360ms ease, box-shadow 360ms ease, transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1);
    }
    .mcard::after {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px;
      background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
      opacity: 0; transition: opacity 360ms ease;
    }
    .mcard:hover { transform: translateY(-4px); border-color: rgba(83, 178, 127, 0.42); box-shadow: 0 20px 40px rgba(15, 26, 42, 0.1); }
    .mcard:hover::after { opacity: 1; }
    .avatar { width: 96px; height: 96px; border-radius: 999px; object-fit: cover; border: 3px solid rgba(83, 178, 127, 0.25); background: #eef2f7; }
    .avatar-empty { display: grid; place-items: center; color: #93a3b8; font-size: 0.7rem; }
    .m-name { font-size: 1rem; font-weight: 700; color: #16283e; }
    .m-role { font-size: 0.78rem; font-weight: 600; color: #2e7d54; }
    .m-bio { font-size: 0.76rem; color: #5c6f88; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .badges { display: inline-flex; gap: 0.25rem; margin-top: 0.15rem; align-items: center; }
    .lang { font-size: 0.6rem; font-weight: 700; padding: 0.18rem 0.42rem; border-radius: 6px; }
    .lang.has { background: rgba(83, 178, 127, 0.13); color: #2e7d54; }
    .lang.missing { background: rgba(203, 76, 76, 0.08); color: #b98484; border: 1px dashed rgba(203, 76, 76, 0.3); }
    /* LinkedIn shortcut, top-right of a team card */
    .li-link {
      position: absolute; top: 0.7rem; right: 0.7rem; z-index: 3;
      width: 30px; height: 30px; border-radius: 8px;
      display: grid; place-items: center;
      color: #7a8ba1; background: #f4f7fb; border: 1px solid #e2e8f1;
      /* colour-only transition — transforms made the glyph shimmer */
      transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .li-link svg { width: 16px; height: 16px; display: block; }
    .li-link:hover { background: #0a66c2; border-color: #0a66c2; color: #ffffff; }
    .li-link:active { background: #084e96; border-color: #084e96; }
    .draft-tag {
      position: absolute; top: 0.75rem; left: 0.75rem;
      font-size: 0.66rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      background: rgba(196, 148, 58, 0.92); color: #fff;
      padding: 0.3rem 0.7rem; border-radius: 999px;
    }
    .m-foot {
      margin-top: auto; padding-top: 0.7rem; width: 100%;
      display: flex; justify-content: center; align-items: center; gap: 0.7rem;
      border-top: 1px solid #eef2f7;
    }
    .mini { font: inherit; font-size: 0.72rem; font-weight: 700; color: #3d5a80; background: none; border: 0; padding: 0; cursor: pointer; }
    .mini:hover { text-decoration: underline; }
    .mini.danger { color: #a33d3d; }
    .inline { display: inline; }

    /* ---------- Drag to reorder ---------- */
    .mcard, .pcard { cursor: grab; }
    .mcard:active, .pcard:active { cursor: grabbing; }
    .mcard.dragging, .pcard.dragging {
      opacity: 0.45;
      transform: scale(0.98);
      border-color: rgba(83, 178, 127, 0.6);
      box-shadow: 0 18px 40px rgba(15, 26, 42, 0.18);
    }
    .cards.is-sorting .mcard:not(.dragging),
    .pcards.is-sorting .pcard:not(.dragging) {
      transition: transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    .cards.is-sorting .mcard:hover, .pcards.is-sorting .pcard:hover { transform: none; }
    .sort-saving {
      position: fixed; right: 1.4rem; bottom: 1.4rem; z-index: 60;
      font-size: 0.76rem; font-weight: 700; color: #ffffff;
      background: rgba(22, 40, 62, 0.92); border-radius: 999px;
      padding: 0.5rem 1rem; box-shadow: 0 10px 26px rgba(9, 17, 28, 0.28);
      opacity: 0; transform: translateY(8px); pointer-events: none;
      transition: opacity 220ms ease, transform 220ms ease;
    }
    .sort-saving.show { opacity: 1; transform: none; }
    .sort-saving.err { background: rgba(163, 61, 61, 0.95); }

    /* ---------- Hidden items group ---------- */
    .hidden-group {
      margin-top: 1.8rem;
      border: 1px solid #d7deea;
      border-radius: 12px;
      background: #ffffff;
      overflow: hidden;
    }
    .hidden-group summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.8rem 1.1rem;
      font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: #7a8ba1;
      transition: background-color 200ms ease, color 200ms ease;
    }
    .hidden-group summary::-webkit-details-marker { display: none; }
    .hidden-group summary:hover { background: rgba(22, 40, 62, 0.03); color: #46586f; }
    .hidden-group .chev { width: 14px; height: 14px; flex: none; transition: transform 260ms ease; }
    .hidden-group[open] .chev { transform: rotate(90deg); }
    .hidden-group .hcount {
      margin-left: auto; font-size: 0.64rem; font-weight: 700;
      background: rgba(196, 148, 58, 0.16); color: #8a6420;
      padding: 0.2rem 0.55rem; border-radius: 999px;
    }
    .hidden-group .hidden-body { padding: 0 1.1rem 1.1rem; }
    .hidden-group[open] .hidden-body { animation: hidIn 240ms ease; }
    @keyframes hidIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
    .hidden-group .cards, .hidden-group .pcards { margin-top: 0.6rem; }
    .hidden-group .mcard, .hidden-group .pcard { opacity: 0.75; }
    .hidden-group .mcard:hover, .hidden-group .pcard:hover { opacity: 1; }

    /* ---------- Slide-over drawer ---------- */
    .backdrop {
      position: fixed; inset: 0; background: rgba(9, 17, 28, 0.45);
      opacity: 0; pointer-events: none; transition: opacity 260ms ease; z-index: 40;
      backdrop-filter: blur(2px);
    }
    .backdrop.open { opacity: 1; pointer-events: auto; }
    .drawer {
      position: fixed; top: 0; right: 0; height: 100vh; width: min(480px, 100vw);
      background: #ffffff; border-left: 1px solid #d7deea;
      box-shadow: -18px 0 48px rgba(9, 17, 28, 0.16);
      transform: translateX(100%); transition: transform 320ms cubic-bezier(0.2, 0.7, 0.3, 1);
      z-index: 50; display: flex; flex-direction: column;
    }
    .drawer.open { transform: translateX(0); }
    .drawer-head {
      padding: 1.1rem 1.4rem; border-bottom: 1px solid #eef2f7;
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      background: linear-gradient(180deg, #12233c 0%, #0f2036 100%); color: #ffffff;
    }
    .drawer-head h2 { font-size: 1rem; font-weight: 700; }
    .close-btn {
      width: 38px; height: 38px; flex: none;
      display: grid; place-items: center;
      color: #c1cee3; background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(193, 206, 227, 0.22); border-radius: 999px;
      cursor: pointer; padding: 0;
      transition: background-color 260ms ease, border-color 260ms ease,
        color 260ms ease, transform 380ms cubic-bezier(0.34, 1.4, 0.5, 1);
    }
    .close-btn svg { width: 18px; height: 18px; }
    .close-btn:hover {
      color: #ffffff;
      background: rgba(83, 178, 127, 0.28);
      border-color: rgba(83, 178, 127, 0.7);
      transform: rotate(90deg) scale(1.08);
    }
    .close-btn:active { transform: rotate(90deg) scale(0.94); }

    /* ---------- Language accordions ---------- */
    .loc-acc {
      margin-top: 0.8rem; border: 1px solid #e2e8f1; border-radius: 10px;
      background: #fbfcfe; overflow: hidden;
    }
    .loc-acc summary {
      list-style: none; cursor: pointer;
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.7rem 0.9rem;
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: #46586f;
      transition: background-color 200ms ease, color 200ms ease;
    }
    .loc-acc summary::-webkit-details-marker { display: none; }
    .loc-acc summary:hover { background: rgba(83, 178, 127, 0.07); color: #2e7d54; }
    .loc-acc .chev { width: 14px; height: 14px; flex: none; transition: transform 260ms ease; }
    .loc-acc[open] .chev { transform: rotate(90deg); }
    .loc-acc[open] summary { border-bottom: 1px solid #eef2f7; }
    .acc-flag {
      margin-left: auto; font-size: 0.62rem; font-weight: 700;
      padding: 0.18rem 0.45rem; border-radius: 6px;
      background: rgba(122, 139, 161, 0.14); color: #7a8ba1;
    }
    .acc-flag.filled { background: rgba(83, 178, 127, 0.14); color: #2e7d54; }
    .acc-body { padding: 0.2rem 0.9rem 0.9rem; }
    .loc-acc[open] .acc-body { animation: accIn 240ms ease; }
    @keyframes accIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
    .drawer-body { padding: 1.2rem 1.4rem 1.5rem; overflow-y: auto; flex: 1; }
    .drawer-foot {
      padding: 0.9rem 1.4rem; border-top: 1px solid #eef2f7; background: #fbfcfe;
      display: flex; gap: 0.7rem; align-items: center;
    }
    .photo-row { display: flex; gap: 1rem; align-items: center; }
    .photo-preview {
      width: 84px; height: 84px; flex: none; border-radius: 999px; object-fit: cover;
      border: 3px solid rgba(83, 178, 127, 0.25); background: #eef2f7;
    }
    .upload-btn {
      font: inherit; display: inline-block; font-size: 0.76rem; font-weight: 700; color: #3d5a80;
      border: 1px solid #d5deea; border-radius: 8px; padding: 0.45rem 0.9rem; cursor: pointer; background: #f4f7fb;
    }
    .upload-wrap:hover .upload-btn { border-color: #53b27f; color: #2e7d54; }
    /* The real file input sits invisibly on top of the button, so the click
       lands directly on it — browsers only open the picker for genuine clicks. */
    .upload-wrap { position: relative; display: inline-block; }
    .file-overlay {
      position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; cursor: pointer; font-size: 0;
    }
    .upload-status { font-size: 0.74rem; color: #5c6f88; margin-top: 0.25rem; min-height: 1em; }
    .upload-status.err { color: #a33d3d; font-weight: 600; }
    .upload-status.ok { color: #2e7d54; font-weight: 600; }
    .photo-row.dragover {
      outline: 2px dashed rgba(83, 178, 127, 0.6); outline-offset: 6px; border-radius: 12px;
      background: rgba(83, 178, 127, 0.05);
    }
    .field { display: grid; gap: 0.35rem; margin-top: 0.9rem; }
    .field span { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #46586f; }
    .field em { font-weight: 400; text-transform: none; letter-spacing: 0; color: #93a3b8; }
    .in {
      font: inherit; font-size: 0.88rem; width: 100%;
      padding: 0.55rem 0.7rem; border: 1px solid #d5deea; border-radius: 8px; background: #fbfcfe;
    }
    .in:focus { outline: none; border-color: #53b27f; }
    .loc-block { border: 1px dashed #e2e8f1; border-radius: 10px; padding: 0.5rem 1rem 1rem; margin-top: 1rem; }
    .loc-block legend { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #5c6f88; padding: 0 0.4rem; }
    .save {
      font: inherit; font-size: 0.88rem; font-weight: 700; color: #ffffff;
      background: #53b27f; border: 0; border-radius: 9px; padding: 0.65rem 1.4rem; cursor: pointer;
    }
    .save:hover { filter: brightness(1.07); }
    .drawer-cancel { font: inherit; font-size: 0.8rem; font-weight: 600; color: #7a8ba1; background: none; border: 0; cursor: pointer; }
    .drawer-delete { margin-left: auto; font: inherit; font-size: 0.78rem; font-weight: 700; color: #a33d3d; background: none; border: 0; cursor: pointer; }
    .drawer-delete:hover { text-decoration: underline; }

    /* ---------- View switcher (sliding thumb) ---------- */
    .seg {
      position: relative;
      display: inline-flex;
      background: #ffffff;
      border: 1px solid #d5deea;
      border-radius: 999px;
      padding: 0.3rem;
      margin-top: 1.4rem;
      box-shadow: 0 6px 18px rgba(15, 26, 42, 0.06);
      isolation: isolate;
    }
    /* the gliding pill */
    .seg-thumb {
      position: absolute;
      top: 0.3rem;
      bottom: 0.3rem;
      left: 0;
      width: 0;
      border-radius: 999px;
      background: linear-gradient(180deg, #16283e 0%, #0f2036 100%);
      box-shadow: 0 6px 16px rgba(15, 26, 42, 0.28);
      transition: transform 420ms cubic-bezier(0.32, 1.3, 0.44, 1), width 420ms cubic-bezier(0.32, 1.3, 0.44, 1);
      z-index: -1;
    }
    .seg-thumb.no-anim { transition: none; }
    .seg-btn {
      font: inherit;
      font-size: 0.84rem;
      font-weight: 700;
      color: #46586f;
      background: none;
      border: 0;
      cursor: pointer;
      padding: 0.5rem 1.4rem;
      border-radius: 999px;
      white-space: nowrap;
      transition: color 300ms ease;
    }
    .seg-btn:focus { outline: none; }
    .seg-btn:focus-visible { box-shadow: 0 0 0 3px rgba(83, 178, 127, 0.35); }
    .seg-btn:hover:not(.active) { color: #2e7d54; }
    .seg-btn.active { color: #ffffff; }
    .seg-btn .count { opacity: 0.6; font-weight: 600; margin-left: 0.3rem; font-size: 0.85em; }

    /* ---------- Partner cards: same spec as the public Partners page ---------- */
    .pcards { margin-top: 1.4rem; display: grid; gap: 1.4rem; }
    .pcard {
      position: relative; cursor: grab;
      background: #ffffff;
      border: 1px solid #dbe1ea;
      border-radius: 1.2rem;
      padding: 1.9rem 2rem;
      min-height: 260px;
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 1.8rem;
      align-items: center;
      overflow: hidden;
      isolation: isolate;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
      transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
        border-color 360ms ease, box-shadow 360ms ease;
    }
    .pcard:hover {
      transform: translateY(-6px);
      border-color: rgba(83, 178, 127, 0.42);
      box-shadow: 0 26px 48px rgba(15, 26, 42, 0.12),
        0 0 0 1px rgba(83, 178, 127, 0.16) inset;
    }
    .logo-box {
      height: 100%;
      display: flex; align-items: center; justify-content: center;
      padding-right: 1.4rem;
      border-right: 1px solid #dbe1ea;
    }
    .logo-box img { max-height: 82px; max-width: 220px; width: auto; height: auto; }
    .logo-box .no-logo { color: #93a3b8; font-size: 0.8rem; }
    .p-body { padding-left: 0.2rem; min-width: 0; }
    .p-name { font-size: 1.35rem; font-weight: 700; color: #1f2835; line-height: 1.25; }
    .p-role {
      margin-top: 0.25rem; color: #33445c;
      font-size: 0.78rem; letter-spacing: 0.11em; text-transform: uppercase;
    }
    .p-summary { margin-top: 0.7rem; color: #5a667a; font-size: 1rem; line-height: 1.5; max-width: 68ch; }
    .p-foot { margin-top: 1.1rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .p-site {
      display: inline-flex; align-items: center; gap: 0.42rem;
      font-size: 0.74rem; font-weight: 700; letter-spacing: 0.02em;
      color: #2e7d54; text-decoration: none;
      background: rgba(83, 178, 127, 0.09);
      border: 1px solid rgba(83, 178, 127, 0.38);
      border-radius: 999px; padding: 0.42rem 0.95rem;
      transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease, transform 220ms ease;
    }
    .p-site svg { width: 14px; height: 14px; }
    .p-site:hover {
      background: #53b27f; border-color: #53b27f; color: #ffffff;
      transform: translateY(-1px);
    }
    .status-pill {
      position: absolute; top: 1.15rem; right: 1.3rem;
      display: inline-flex; align-items: center; gap: 0.35rem;
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;
      padding: 0.38rem 0.85rem; border-radius: 999px;
    }
    .status-pill::before {
      content: ""; width: 6px; height: 6px; border-radius: 999px; background: currentColor;
    }
    .status-pill.live { background: rgba(83, 178, 127, 0.15); color: #2e7d54; }
    .status-pill.hidden { background: rgba(196, 148, 58, 0.9); color: #ffffff; }
    @media (max-width: 980px) {
      .pcard { grid-template-columns: 1fr; min-height: 0; padding: 1.4rem 1.5rem; }
      .logo-box { border-right: 0; border-bottom: 1px solid #dbe1ea; padding: 0 0 1.2rem; }
      .p-name { font-size: 1.18rem; }
      .p-summary { font-size: 0.94rem; line-height: 1.55; }
    }

    /* ---------- Smooth view switching ---------- */
    .view { transition: opacity 260ms ease, transform 260ms ease; }
    .view[hidden] { display: none; }
    .view.leaving { opacity: 0; transform: translateY(6px); }
    .view.entering { animation: viewIn 300ms cubic-bezier(0.2, 0.7, 0.3, 1); }
    @keyframes viewIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  </style>

  <div class="page-head head-row">
    <div>
      <h1 id="view-title">{view === "partners" ? "Partners" : "Team"}</h1>
      <p id="view-sub">
        {view === "partners"
          ? "Click a partner to edit. Visible partners appear on the public Partners page."
          : "Click a team member to edit. Changes go live on the About page immediately."}
      </p>
    </div>
    <button class="new-btn" type="button" id="add-member" hidden={view === "partners"}>+ Add team member</button>
    <button class="new-btn" type="button" id="add-partner" hidden={view !== "partners"}>+ Add partner</button>
  </div>

  <div class="seg" id="view-seg">
    <span class="seg-thumb no-anim" id="seg-thumb"></span>
    <button class={view === "team" ? "seg-btn active" : "seg-btn"} type="button" data-view="team">
      Team <span class="count">{list.length}</span>
    </button>
    <button class={view === "partners" ? "seg-btn active" : "seg-btn"} type="button" data-view="partners">
      Partners <span class="count">{partners.length}</span>
    </button>
  </div>

  {error && <p class="notice err">{error}</p>}

  <section class="view" id="view-partners" hidden={view !== "partners"}>
    <div class="pcards" id="partner-list">
      {partners.map((p, i) => (
        <article class="pcard" draggable="true" data-id={p.id} data-open-partner={p.id} title={`Edit ${p.name}`}>
          <span class={p.status === "published" ? "status-pill live" : "status-pill hidden"}>
            {p.status === "published" ? "visible" : "hidden"}
          </span>
          <div class="logo-box">
            {p.logo_url ? <img src={p.logo_url} alt={p.name} loading="lazy" /> : <span class="no-logo">no logo</span>}
          </div>
          <div class="p-body">
            <p class="p-name">{p.name}</p>
            <p class="p-role">{tr(p, "en", "role")}</p>
            <p class="p-summary">{tr(p, "en", "summary")}</p>
            <div class="p-foot">
              <span class="badges">
                {["en", "es", "ca"].map((loc) => (
