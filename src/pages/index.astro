    <section class="timeline-v2">
      <div class="container" data-animate>
        <div class="section-header">
          <p class="eyebrow">Timeline</p>
          <h2>The Investment Roadmap</h2>
          <p class="intro">A streamlined onboarding process designed to move you from initial inquiry to active capital deployment.</p>
        </div>
        <div class="timeline-v2-card">
          <div class="timeline-v2-col">
            <span class="timeline-v2-step-num">Step 01</span>
