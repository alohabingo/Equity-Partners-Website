---
import type { Locale } from "../lib/i18n";
import { getContentTranslations } from "../i18n/content";

interface Props {
  emailInputId?: string;
  locale?: Locale;
}

const { emailInputId = "newsletter-email", locale = "en" } = Astro.props;
const newsletterFormId = `${emailInputId}-form`;
const newsletterMessageId = `${emailInputId}-message`;
const content = getContentTranslations(locale).newsletter;
const newsletterFormName = "newsletter-signup";
---

<section class="newsletter" id="newsletter">
  <div class="container">
    <div class="newsletter-wrap">
      <div class="newsletter-copy">
        <p class="eyebrow">{content.eyebrow}</p>
        <h2>{content.title}</h2>
      </div>
      <div class="newsletter-form-group">
        <form
          class="newsletter-form"
          id={newsletterFormId}
          novalidate
          data-locale={locale}
          data-msg-id={newsletterMessageId}
          data-validation-error={content.validationError}
          data-submitting={content.submitting}
          data-success={content.success}
          data-error={content.error}
        >
          <label class="sr-only" for={emailInputId}>{content.emailLabel}</label>
          <input
            class="newsletter-input"
            id={emailInputId}
            name="email"
            type="email"
            placeholder={content.emailPlaceholder}
            autocomplete="email"
            required
          />
          <button class="newsletter-button" type="submit">{content.submit}</button>
        </form>
        <p class="newsletter-status" id={newsletterMessageId} aria-live="polite"></p>
      </div>
    </div>
    <p class="newsletter-note">{content.note}</p>
  </div>
</section>

<script is:inline>
  document.querySelectorAll(".newsletter-form").forEach(function (form) {
    form.addEventListener("submit", async function (event) {
      event.preventDefault();

      var msgId = form.dataset.msgId;
      var message = document.getElementById(msgId);
      var submitButton = form.querySelector('button[type="submit"]');
      var emailInput = form.querySelector('input[name="email"]');
      var emailValue = emailInput ? emailInput.value.trim() : "";

      if (!emailInput || !emailValue || !emailInput.checkValidity()) {
        if (message) { message.textContent = form.dataset.validationError; message.dataset.state = "error"; }
        return;
      }

      if (submitButton) submitButton.setAttribute("disabled", "true");
      if (message) { message.textContent = form.dataset.submitting; message.dataset.state = "pending"; }

      try {
        var response = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: emailValue,
            locale: form.dataset.locale || "en",
            source_page: window.location.pathname,
          }),
        });

        var data = await response.json();
        if (!response.ok || !data.ok) throw new Error("status " + response.status);

        form.reset();
        if (message) { message.textContent = form.dataset.success; message.dataset.state = "success"; }
      } catch (err) {
        console.error("Newsletter subscription error:", err);
        if (message) { message.textContent = form.dataset.error; message.dataset.state = "error"; }
      } finally {
        if (submitButton) submitButton.removeAttribute("disabled");
      }
    });
  });
</script>

<style>
  .newsletter,
  .newsletter *,
  .newsletter *::before,
  .newsletter *::after {
    box-sizing: border-box;
  }

  .newsletter {
    background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
    border-top: 1px solid #dbe1ea;
    border-bottom: 1px solid #dbe1ea;
    padding: 4rem 0;
  }

  .container {
    width: min(1120px, 92vw);
    margin: 0 auto;
  }

  .newsletter-copy .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 0.7rem;
    font-size: 0.74rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 600;
    color: #3f9568;
  }

  .newsletter-copy .eyebrow::before {
    content: "";
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #53b27f);
    display: inline-block;
  }

  .newsletter-wrap {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.8rem;
    align-items: center;
    width: 100%;
    max-width: 100%;
    background: #ffffff;
    border: 1px solid #d7deea;
    border-radius: 1.2rem;
    padding: 1.5rem 2rem 2rem;
    box-shadow: 0 18px 40px rgba(15, 26, 42, 0.07);
    transition: border-color 360ms ease, box-shadow 360ms ease;
  }

  .newsletter-form-group {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: stretch;
  }

  .newsletter-wrap:hover {
    border-color: rgba(83, 178, 127, 0.42);
    box-shadow: 0 26px 48px rgba(15, 26, 42, 0.12),
      0 0 0 1px rgba(83, 178, 127, 0.16) inset;
  }

  .newsletter-copy h2 {
    margin: 0;
    color: #1f2835;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.1;
  }

  .newsletter-copy h2::after {
    content: none;
  }

  .newsletter-copy p {
    margin: 0.7rem 0 0;
    color: #5a667a;
    max-width: 34rem;
  }

  .newsletter-form {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    justify-content: flex-end;
    width: 100%;
    min-width: 0;
  }

  .newsletter-input {
    flex: none;
    /* Bigger on desktop, scaling down smoothly as the viewport narrows. */
    width: clamp(280px, 24vw, 340px);
    max-width: 100%;
    min-width: 0;
    height: 44px;
    border-radius: 0.55rem;
    border: 1px solid #cfd9e7;
    background: #f9fbff;
    padding: 0 0.85rem;
    font-size: 0.92rem;
    color: #1a2433;
    outline: none;
    font-family: inherit;
    box-sizing: border-box;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .newsletter-input:focus {
    border-color: #53b27f;
    box-shadow: 0 0 0 3px rgba(83, 178, 127, 0.22);
  }

  .newsletter-button {
    flex: 0 0 auto;
    height: 44px;
    border: 1px solid #53b27f;
    background: #53b27f;
    color: #ffffff;
    border-radius: 0.55rem;
    padding: 0 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease, transform 180ms ease, border-color 180ms ease;
  }

  .newsletter-button:hover {
    background: #3f9568;
    border-color: #3f9568;
    transform: translateY(-1px);
  }

  .newsletter-button[disabled] {
    opacity: 0.72;
    cursor: wait;
    transform: none;
  }

  .newsletter-status {
    width: min(360px, 100%);
    margin: 0.35rem 0 0 auto;
    color: #7a889e;
    font-size: 0.78rem;
    min-height: 0;
    text-align: left;
  }

  .newsletter-status[data-state="success"] {
    color: #3f9568;
  }

  .newsletter-status[data-state="error"] {
    color: #b33a3a;
  }

  .newsletter-note {
    margin: 0.5rem 0 0;
    color: #7a889e;
    font-size: 0.72rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 980px) {
    .newsletter-wrap {
      grid-template-columns: 1fr;
    }

    .newsletter-status {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (max-width: 680px) {
    .newsletter {
      padding-top: 2.3rem;
    }

    .container {
      width: 100%;
      max-width: none;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .newsletter-form {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .newsletter-input {
      flex-basis: auto;
      width: 100%;
      font-size: 16px;
    }

    .newsletter-button {
      width: 100%;
    }
  }
</style>
