---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-top">
    <div class="container footer-grid">
      <div class="footer-brand">
        <img
          class="footer-logo"
          src="/images/branding/equity-partners-logo-light%20small.png"
          alt="Equity Partners Andorra Property Group"
        />
        <a class="footer-cta" href="/contact">Explore Opportunities</a>
      </div>

      <div>
        <h3 class="footer-heading">Equity Partners</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href="/#about">About</a></li>
          <li><a class="footer-link" href="/about#team">Team</a></li>
          <li><a class="footer-link" href="/partners">Partners</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">Resources</h3>
        <ul class="footer-list">
          <li><a class="footer-link" href="/#partners">Projects</a></li>
          <li><a class="footer-link" href="/blog">Blog</a></li>
          <li><a class="footer-link" href="#">Market Reports</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">Contact</h3>
        <div class="footer-meta">
          <div class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"></path>
                <path d="m22 6-10 7L2 6"></path>
              </svg>
            </span>
            <span>info@equitypartnersandorra.com</span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.79.61 2.64a2 2 0 0 1-.45 2.11L8 9.99a16 16 0 0 0 6 6l1.52-1.27a2 2 0 0 1 2.11-.45c.85.28 1.74.49 2.64.61A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <span>+376 000 000</span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10.5c0 6-9 12-9 12s-9-6-9-12a9 9 0 1 1 18 0Z"></path>
                <circle cx="12" cy="10.5" r="3"></circle>
              </svg>
            </span>
            <span>Av. Prat de la Creu 59-65, AD500 <span class="footer-address-city">Andorra</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-divider"></div>

  <div class="footer-bottom">
    <div class="container footer-bottom-row">
      <p class="footer-copy">© {currentYear} EQUITY PARTNERS. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-use">Terms of Use</a>
        <a href="/cookie-policy">Cookies</a>
      </div>
      <div class="footer-social">
        <a class="social-pill" href="#" aria-label="LinkedIn">in</a>
        <a class="social-pill" href="#" aria-label="X">X</a>
        <a class="social-pill" href="#" aria-label="YouTube">▶</a>
        <a class="social-pill" href="#" aria-label="Instagram">IG</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0f1a2a;
    color: #d9e3f2;
    font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
  }

  .container {
    width: min(1120px, 92vw);
    margin: 0 auto;
  }

  .footer-top {
    padding: 3rem 0 2.7rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr repeat(3, minmax(0, 1fr));
    gap: 1.7rem;
    align-items: start;
  }

  .footer-grid > div:not(:first-child) {
    justify-self: start;
    text-transform: uppercase;
  }

  .footer-grid > div:not(:first-child) .footer-list {
    justify-items: start;
  }

  .footer-logo {
    width: 100%;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  .footer-brand {
    width: 220px;
    max-width: 100%;
  }

  .footer-cta {
    display: inline-flex;
    width: auto;
    margin-top: 1.1rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: #53b27f;
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 600;
    line-height: 1;
    border-radius: 0.45rem;
    padding: 0.65rem 0.95rem;
    white-space: nowrap;
    border: 1px solid #53b27f;
    transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .footer-cta:hover {
    background: #3f9568;
    border-color: #3f9568;
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(12, 24, 18, 0.22);
  }

  .footer-cta:focus-visible {
    outline: 2px solid rgba(216, 227, 242, 0.5);
    outline-offset: 3px;
  }

  .footer-heading {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: #97a9c4;
    font-weight: 600;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-link {
    color: #f3f7fc;
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .footer-link:hover {
    color: #d8e3f2;
  }

  .footer-meta {
    margin: 0;
    color: #f3f7fc;
    font-size: 0.82rem;
    line-height: 1.6;
    text-transform: none;
    display: grid;
    gap: 0.7rem;
  }

  .footer-contact-item {
    display: grid;
    grid-template-columns: 16px 1fr;
    align-items: start;
    gap: 0.6rem;
  }

  .footer-contact-icon {
    width: 16px;
    height: 16px;
    color: #53b27f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.08rem;
  }

  .footer-contact-icon svg {
    width: 100%;
    height: 100%;
  }

  .footer-address-city {
    white-space: nowrap;
  }

  .footer-divider {
    border-top: 1px solid rgba(205, 219, 238, 0.2);
  }

  .footer-bottom {
    padding: 1.3rem 0 1.45rem;
  }

  .footer-bottom-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .footer-copy {
    margin: 0;
    color: #aebcd4;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-legal a {
    color: #c1cee3;
    text-decoration: none;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-social {
    display: flex;
    justify-content: flex-end;
    gap: 0.45rem;
  }

  .social-pill {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid rgba(220, 231, 246, 0.34);
    color: #e3ebf8;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-grid > div:not(:first-child) {
      justify-self: start;
      text-align: left;
      margin-left: 0;
    }

    .footer-grid > div:not(:first-child) .footer-list {
      justify-items: start;
    }

    .footer-bottom-row {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .footer-legal,
    .footer-social {
      justify-content: flex-start;
    }
  }
</style>
