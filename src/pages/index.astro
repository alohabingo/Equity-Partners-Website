      /* ── Timeline V2 ── */
      .timeline-v2 {
        background: #f2f5fa;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 5rem 0 4.5rem;
      }

      .timeline-v2 .section-header {
        max-width: none;
        width: 100%;
        margin-bottom: 2.5rem;
      }

      .timeline-v2 .eyebrow {
        color: var(--accent);
      }

      .timeline-v2 h2 {
        color: var(--text-primary);
      }

      .timeline-v2 .intro {
        color: #5a667a;
      }

      .timeline-v2-card {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        border: 1px solid #d7deea;
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 8px 32px rgba(15, 26, 42, 0.06);
      }

      .timeline-v2-col {
        padding: 2.2rem 1.6rem;
        border-right: 1px solid #e4eaf3;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0;
        transition: background 200ms ease;
      }

      .timeline-v2-col:last-child {
        border-right: none;
      }

      .timeline-v2-col:hover {
        background: #f6f9fd;
      }

      .timeline-v2-col:hover .timeline-v2-step-icon {
        background: #e6f7f0;
        border-color: #2e8a59;
      }

      .timeline-v2-col:hover .timeline-v2-step-icon svg {
        stroke: #2e8a59;
      }

      .timeline-v2-step-num {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #53b27f;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        margin-bottom: 0.9rem;
      }

      .timeline-v2-step-icon {
        width: 5.2rem;
        height: 5.2rem;
        border-radius: 1.3rem;
        background: #53b27f;
        border: 1px solid transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background 220ms ease, border-color 220ms ease;
        margin-bottom: 1.1rem;
        box-shadow: 0 20px 40px rgba(15, 26, 42, 0.08), 0 4px 12px rgba(15, 26, 42, 0.04);
      }

      .timeline-v2-step-icon svg {
        width: 2rem;
        height: 2rem;
        stroke: #ffffff;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: stroke 220ms ease;
      }

      .timeline-v2-col h3 {
        margin: 0.7rem 0 0;
        color: #172235;
        font-size: 1.08rem;
        font-weight: 600;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        line-height: 1.25;
      }

      .timeline-v2-col p {
        margin: 0.65rem auto 0;
        max-width: 19ch;
        color: #5a667a;
        font-size: 0.9rem;
        line-height: 1.4;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      @media (max-width: 980px) {
        .timeline-v2-card {
          grid-template-columns: 1fr;
          border-radius: 0;
          border-left: none;
          border-right: none;
          box-shadow: none;
          background: transparent;
        }

        .timeline-v2-col {
          display: grid;
          grid-template-columns: 4.4rem 1fr;
          grid-template-rows: auto auto auto;
          column-gap: 1.2rem;
          align-items: start;
          text-align: left;
          align-items: center;
          background: transparent;
          border: none;
          border-right: none;
          border-bottom: 1px solid #e4eaf3;
          border-radius: 0;
          box-shadow: none;
          padding: 1.5rem 0;
        }

        .timeline-v2-col:last-child {
          border-bottom: none;
        }

        .timeline-v2-step-icon {
          width: 4.4rem;
          height: 4.4rem;
          grid-column: 1;
          grid-row: 1 / 4;
          margin: 0;
          align-self: center;
          box-shadow: none;
        }

        .timeline-v2-step-num {
          grid-column: 2;
          grid-row: 1;
          margin: 0;
          text-align: left;
        }

        .timeline-v2-col h3 {
          grid-column: 2;
          grid-row: 2;
          margin-top: 0.3rem;
          text-align: left;
        }

        .timeline-v2-col p {
          grid-column: 2;
          grid-row: 3;
          max-width: none;
          margin: 0.4rem 0 0;
