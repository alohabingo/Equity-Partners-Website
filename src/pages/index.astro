    <section class="section projects" id="partners">
      <div class="container" data-animate>
        <div class="section-header">
          <p class="eyebrow">Featured Developments</p>
          <h2>View our properties under development</h2>
          <p class="intro">Balanced proof architecture: demonstrated execution plus visible momentum.</p>
        </div>
        <div class="project-grid">
          {
            projects.map((project) => (
              <article class="project-card">
                <img src={project.image} alt={project.name} />
                <div class="project-meta">
                  <h3>{project.name}</h3>
                  <div class="metrics">
                    <span class="pill">Value: {project.value}</span>
                    <span class="pill">Status: {project.status}</span>
                    <span class="pill">Sector: {project.sector}</span>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <div class="project-carousel-dots" aria-label="Project carousel navigation">
          {projects.map((project, index) => (
            <button
              class:list={["project-carousel-dot", index === 0 && "is-active"]}
              type="button"
              aria-label={`Go to project ${index + 1}: ${project.name}`}
              data-project-dot={index}
            ></button>
          ))}
        </div>
        <a class="cta-link" href={buildLocalizedPath("/projects", locale)}>View All Projects</a>
      </div>
    </section>

    {homepageSuggestedPosts.length > 0 && (
      <section class="section home-suggested-reads">
        <div class="container">
          <div class="section-header">
            <p class="eyebrow">Suggested Reads</p>
            <h2>Continue exploring the Andorran market.</h2>
          </div>
          <div class="home-suggested-grid">
            {homepageSuggestedPosts.map((entry) => (
              <article class="home-suggested-card">
                <a class="home-suggested-link" href={`/blog/${entry.slug}`}>
                  <img src={entry.image} alt={entry.title} loading="lazy" />
                  <div class="home-suggested-meta">
                    <div class="home-suggested-metrics">
                      <span class="home-suggested-pill">{entry.date}</span>
                      <span class="home-suggested-pill">{entry.category}</span>
                    </div>
                    <h3>{entry.title}</h3>
                    <p class="home-suggested-excerpt">{entry.excerpt}</p>
                  </div>
                </a>
              </article>
            ))}
