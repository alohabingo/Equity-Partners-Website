---
export const prerender = false;

import AdminLayout from "../../../../../layouts/AdminLayout.astro";
import EnquiryPanel from "../../../../../components/admin/EnquiryPanel.astro";
import EnquirySide from "../../../../../components/admin/EnquirySide.astro";
import { supabaseServer } from "../../../../../lib/supabase";
import type { EnquiryRow } from "../../../../../lib/enquiries";
import { TEMPLATE_COLUMNS, type ReplyTemplate } from "../../../../../lib/replyTemplates";
import type { ProjectDocument } from "../../../../../lib/projectDocuments";

const { slug, id } = Astro.params;
const supabase = supabaseServer(Astro.cookies, Astro.request);
const me = Astro.locals.user;

// How the last reply went. The endpoint puts this on the URL because a send
// that failed must not look like one that worked.
const sent = Astro.url.searchParams.get("sent") === "1";
const sendError = Astro.url.searchParams.get("send_error");
const sentDocs = Number(Astro.url.searchParams.get("docs") ?? 0) || 0;

const { data: project } = await supabase
  .from("projects").select("id, slug, name, mailbox, templates_seeded_at").eq("slug", slug).maybeSingle();
if (!project) return Astro.redirect("/admin/projects");

const { data: enquiryRow } = await supabase
  .from("enquiry_state").select("*").eq("id", id).maybeSingle();
if (!enquiryRow) return Astro.redirect(`/admin/projects/${slug}`);
const enquiry = enquiryRow as EnquiryRow;

const { data: profiles } = await supabase.from("profiles").select("id, full_name");
const nameById = new Map((profiles ?? []).map((p: any) => [p.id, p.full_name]));

const [m, n, ev, tpl, docs, sentLinks] = await Promise.all([
  supabase.from("inquiry_messages").select("direction, subject, body_html, sent_at, sent_by")
    .eq("inquiry_id", id).order("sent_at"),
  supabase.from("enquiry_notes").select("body, created_at, author_id")
    .eq("inquiry_id", id).order("created_at", { ascending: false }),
  supabase.from("enquiry_events").select("kind, detail, created_at, actor_id")
    .eq("inquiry_id", id).order("created_at", { ascending: false }).limit(20),
  // Fetched by the page, not by the composer: a component querying Supabase
  // does it after the response has begun, and the client's cookie write then
  // throws ResponseSentError and takes the session with it.
  supabase.from("reply_templates").select(TEMPLATE_COLUMNS)
    .eq("project_id", project.id).order("position").order("created_at"),
  supabase.from("documents").select("id, title, category, storage_path, mime_type, file_size, created_at")
    .eq("project_id", project.id).order("category").order("title"),
  // What this buyer was actually sent, and whether they opened it.
  supabase.from("document_links").select("id, view_count").eq("inquiry_id", id),
]);

// The mailbox is shared, so an outbound message says who actually wrote it
// rather than assuming it was whoever happens to be reading the thread.
const messages = (m.data ?? []).map((x: any) => ({ ...x, sentByName: nameById.get(x.sent_by) ?? null }));
const notes = (n.data ?? []).map((x: any) => ({ ...x, author: nameById.get(x.author_id) ?? "Someone" }));
const events = (ev.data ?? []).map((x: any) => ({ ...x, actor: nameById.get(x.actor_id) ?? "System" }));

let templates = (tpl.data ?? []) as ReplyTemplate[];
const documents = (docs.data ?? []) as ProjectDocument[];
const linkViews = Object.fromEntries((sentLinks.data ?? []).map((l: any) => [l.id, l.view_count ?? 0]));

// An enquiry can be opened before anyone has visited the project's Templates
// tab, so the starter kit is copied in here too. seed_project_templates claims
// the right to do it atomically, so this and the project page cannot both.
if (!project.templates_seeded_at) {
  await supabase.rpc("seed_project_templates", { p_project: project.id });
  // Re-read rather than trusting the count: another tab may have won the claim,
  // in which case this call copies nothing and the templates are there anyway.
  const { data: seeded } = await supabase
    .from("reply_templates").select(TEMPLATE_COLUMNS)
    .eq("project_id", project.id).order("position").order("created_at");
  templates = (seeded ?? []) as ReplyTemplate[];
}

const selfHref = Astro.url.pathname;
---

<AdminLayout title={enquiry.name} active={`project:${slug}`}>
  <style>
    .back { display: inline-block; margin-top: 0.4rem; font-size: 0.82rem; font-weight: 600; color: #2e7d54; text-decoration: none; }
    .back:hover { text-decoration: underline; }
    /* Two cards, not one card in two columns: the left is the exchange with the
       buyer, the right is what the team did about it. They are different kinds
       of thing, so they get different cards. */
    .cols {
      margin-top: 1.1rem; display: grid; gap: 1.1rem; align-items: start;
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      max-width: 1220px;
    }
    .panel, .sidecard {
      background: #fff; border: 1px solid #d7deea; border-radius: 1.2rem;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
    }
    .panel { padding: 1.6rem 1.8rem; }
    .sidecard { padding: 1.2rem 1.3rem; position: sticky; top: 1rem; }

    @media (max-width: 1080px) {
      .cols { display: block; max-width: 900px; }
      .sidecard { position: static; margin-top: 1.1rem; }
    }
  </style>

  <a class="back" href={`/admin/projects/${slug}?tab=inbox`}>← {project.name} inbox</a>

  <div class="cols">
    <div class="panel">
      <EnquiryPanel
        enquiry={enquiry}
        messages={messages}
        notes={notes}
        events={events}
        project={{ slug: project.slug, name: project.name, mailbox: project.mailbox }}
        currentUserName={me?.fullName ?? "You"}
        back={selfHref}
        sent={sent}
        sendError={sendError}
        showSide={false}
        templates={templates}
        documents={documents}
        sentDocs={sentDocs}
        linkViews={linkViews}
      />
    </div>

    <aside class="sidecard">
      <EnquirySide enquiryId={enquiry.id} notes={notes} events={events} back={selfHref} linkViews={linkViews} />
    </aside>
  </div>
</AdminLayout>
