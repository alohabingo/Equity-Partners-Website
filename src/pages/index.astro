      /* ── Timeline V2 ── */
      .timeline-v2 {
        background: #f2f5fa;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 5rem 0 4.5rem;
      }

      .timeline-v2 .section-header {
        max-width: none;
        width: 100%;
        margin-bottom: 2.5rem;
      }

      .timeline-v2 .eyebrow {
        color: var(--accent);
      }

      .timeline-v2 h2 {
        color: var(--text-primary);
      }

      .timeline-v2 .intro {
        color: #5a667a;
      }

      .timeline-v2-card {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        border: 1px solid #d7deea;
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 8px 32px rgba(15, 26, 42, 0.06);
