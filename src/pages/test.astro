---
import SiteFooter from "../components/SiteFooter.astro";

const advantages = [
  {
    title: "Local Network",
    description:
      "Direct relationships with landowners, advisors, and Andorran operators unlock faster access to qualified opportunities.",
  },
  {
    title: "Regulatory Expertise",
    description:
      "We navigate planning, approvals, and compliance in the Principality with disciplined local execution.",
  },
  {
    title: "Lifecycle Management",
    description:
      "From sourcing through delivery, we manage project decisions end-to-end with investor clarity at every stage.",
  },
];

const teamMembers = [
  {
    name: "Bing Voorham",
    role: "CEO & Co-founder",
    image: "/images/Team/Bing Sr EP.png",
    description:
      "International investor with over 30 years of experience in sales and marketing real estate projects across Europe, providing strategic capital and access to high-net-worth networks",
  },
  {
    name: "Oriol Giro",
    role: "Lawyer & co-founder",
    image: "/images/Team/Oriol Giro EP.jpg",
    description:
      "Expert in investment structuring and projects financing. Oriol leads the project legal and financing strategy, as well as overseeing transaction structuring, financial modeling and investor relations.",
  },
  {
    name: "Carlos Ayete",
    role: "Technical Architect",
    image: "/images/Team/Calors EP.jpg",
    description:
      "With over 25 years of extensive expertise in real estate investment, land acquisition and strategic development. Carlos combines his deep knowledge of the Andorrean maket with a strong internatinoal outlook.",
  },
  {
    name: "Bing Jr",
    role: "Partnerships & Sales",
    image: "/images/Team/Bing Jr EP.png",
    description:
      "With a Master degree in Digital Business from the University of Amsterdam and 4 years of experience at Salesforce, Bing's international past and results-oriented mindset brings deep knowledge of digital acquisition.",
  },
  {
    name: "Tekke Voorham",
    role: "Ditigal Marketing",
    image: "/images/Team/Tekke EP.png",
    description:
      "Maintains local institutional and commercial relationships that accelerate sourcing and execution certainty.",
  },
];

const whyAndorraCards = [
  {
    title: "Fiscal Advantages",
    icon: "calculator",
    points: [
      "Max 10% personal income tax (IRPF)",
      "0% wealth and inheritance tax",
      "Exceptionally low VAT (4.5% IGI)",
    ],
  },
  {
    title: "Safety & Quality",
    icon: "shield",
    points: [
      "Safest country in Europe",
      "High-quality healthcare and education",
      "Easy access to Spain and France",
    ],
  },
  {
    title: "Mountain Lifestyle",
    icon: "mountain",
    points: [
      "90% of territory is natural park",
      "World-class skiing and mountain sports",
      "Luxury chalets, spas, and relaxed lifestyle",
    ],
  },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Test Sections | Equity Partners</title>
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Open+Sans:wght@700&display=swap");

      :root {
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --text-primary: #1f2835;
        --text-muted: #5a667a;
        --text-light: #e8edf5;
        --accent: #8293ae;
        --line: #dbe1ea;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
        color: var(--text-primary);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.5;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        gap: 1.8rem;
        padding-top: 2.15rem;
        padding-bottom: 0.15rem;
        padding-left: calc((100vw - min(var(--max-width), 92vw)) / 2);
        padding-right: calc((100vw - min(var(--max-width), 92vw)) / 2);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        transform: none;
        width: 100%;
        z-index: 220;
        background: rgba(15, 26, 42, 0.92) !important;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        transition: padding-top 320ms ease, padding-bottom 320ms ease, background-color 320ms ease,
          backdrop-filter 320ms ease, -webkit-backdrop-filter 320ms ease, border-color 320ms ease,
          box-shadow 320ms ease;
      }

      body.is-scrolled .site-header {
        background: rgba(15, 26, 42, 0.6) !important;
        padding-top: 1.25rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom-color: rgba(220, 231, 246, 0.2);
        box-shadow: 0 8px 20px rgba(6, 10, 18, 0.18);
      }

      body.is-scrolled .menu-cta {
        background: rgba(255, 255, 255, 0.96);
        border-color: rgba(255, 255, 255, 0.95);
      }

      body.is-scrolled .logo {
        top: -5px;
      }

      body.is-scrolled .main-nav {
        top: -4px;
      }

      @supports not ((backdrop-filter: blur(1px))) {
        body.is-scrolled .site-header {
          background: rgba(15, 26, 42, 0.84) !important;
        }
      }

      .logo {
        width: 180px;
        height: auto;
        position: relative;
        top: -12px;
        filter: brightness(0) invert(1) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.5))
          drop-shadow(0 0 10px rgba(8, 14, 23, 0.35));
        transition: top 320ms ease, margin-top 320ms ease;
      }

      .main-nav {
        display: flex;
        align-items: center;
        margin-left: auto;
        flex-wrap: nowrap;
        gap: 1.3rem;
        position: relative;
        top: -11px;
        z-index: 121;
        transition: top 320ms ease;
      }

      .menu-toggle-input {
        display: none;
      }

      .menu-toggle {
        display: none;
        width: 38px;
        height: 34px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 0.45rem;
        background: transparent;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: top 320ms ease;
      }

      .menu-toggle-bars {
        display: block;
        width: 18px;
        height: 2px;
        background: #ffffff;
        position: relative;
        transition: background 220ms ease;
      }

      .menu-toggle-bars::before,
      .menu-toggle-bars::after {
        content: "";
        position: absolute;
        left: 0;
        width: 18px;
        height: 2px;
        background: #ffffff;
        transition: transform 220ms ease, top 220ms ease;
      }

      .menu-toggle-bars::before {
        top: -6px;
      }

      .menu-toggle-bars::after {
        top: 6px;
      }

      .menu-list {
        list-style: none;
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        white-space: nowrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
      }

      .menu-link {
        display: inline-flex;
        align-items: center;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
      }

      .menu-link.is-active {
        color: #d7e3f5;
      }

      .menu-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        top: 1px;
        flex: 0 0 auto;
        min-width: 126px;
        color: #172235;
        background: rgba(255, 255, 255, 0.96);
        text-decoration: none;
        font-size: 0.72rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        border-radius: 0.45rem;
        padding: 0.65rem 0.95rem;
        font-weight: 600;
        line-height: 1;
        border: 1px solid rgba(255, 255, 255, 0.95);
        white-space: nowrap;
        transition: background-color 180ms ease, transform 180ms ease, color 180ms ease, top 320ms ease;
      }

      .menu-cta:hover {
        background: rgba(224, 233, 246, 0.96);
        color: #101b2c;
        transform: translateY(-1px);
      }

      .menu-cta:focus-visible {
        outline: 2px solid rgba(234, 241, 252, 0.9);
        outline-offset: 2px;
      }

      .hero-content {
        margin-top: auto;
        max-width: 40rem;
        padding-top: 4.5rem;
      }

      .hero-kicker {
        margin-bottom: 1rem;
        font-size: 0.78rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: #b2c0d4;
      }

      h1 {
        font-family: "Open Sans", "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(1.9rem, 4.3vw, 3rem);
        line-height: 1.08;
      }

      .subline {
        margin-top: 0.9rem;
        color: #cad4e4;
        font-size: clamp(0.98rem, 1.6vw, 1.15rem);
      }

      .section {
        padding: 4rem 0;
      }

      .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.85rem;
      }

      h2 {
        font-size: clamp(1.55rem, 3vw, 2.3rem);
        line-height: 1.12;
      }

      .intro {
        margin-top: 0.9rem;
        width: 100%;
        max-width: none;
        color: var(--text-muted);
      }

      .test-section-a {
        background: linear-gradient(180deg, #f4f6fa, #edf1f7);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        margin-top: 4.5rem;
      }

      .test-cards {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .test-card {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.2rem;
      }

      .test-card h3 {
        font-size: 1.1rem;
      }

      .test-card p {
        margin-top: 0.6rem;
        color: var(--text-muted);
      }

      .why-andorra {
        background: #f2f5fa;
        border-top: 1px solid #dce3ee;
        border-bottom: 1px solid #dce3ee;
      }

      .why-andorra-head {
        max-width: none;
        width: 100%;
        margin: 0 auto;
        text-align: center;
      }

      .why-andorra-head h2 {
        color: #1f2b3c;
      }

      .why-andorra-head p {
        margin-top: 0.9rem;
        color: var(--text-muted);
      }

      .why-andorra-head.is-left {
        max-width: none;
        margin: 0;
        text-align: left;
      }

      .why-andorra-grid {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      .why-andorra-card {
        background: var(--bg-white);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.25rem;
      }

      .why-andorra-card-head {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.2rem;
      }

      .why-andorra-icon {
        width: 3.1rem;
        height: 3.1rem;
        border-radius: 0.95rem;
        background: #eef3f9;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #1f2b3c;
        flex: 0 0 auto;
      }

      .why-andorra-icon svg {
        width: 1.6rem;
        height: 1.6rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.1;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .why-andorra-card h3 {
        font-size: 1.15rem;
        line-height: 1.12;
        color: #1f2b3c;
      }

      .why-andorra-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .why-andorra-list li {
        display: grid;
        grid-template-columns: 1.5rem 1fr;
        gap: 0.7rem;
        align-items: start;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.46;
      }

      .why-andorra-check {
        width: 1.5rem;
        height: 1.5rem;
        color: #48a86f;
        margin-top: 0.04rem;
      }

      .why-andorra-check svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.15;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .advantage-home {
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .advantage-home-grid {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.85rem;
        width: 100%;
        align-items: stretch;
      }

      .advantage-home-card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.3rem;
        height: 100%;
      }

      .advantage-home-icon {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
      }

      .advantage-home-icon img {
        width: 46px;
        height: 46px;
        object-fit: contain;
        display: block;
      }

      .advantage-home-card h3 {
        margin-top: 0.45rem;
        color: #1f2b3c;
        font-size: 1.15rem;
      }

      .advantage-home-card p {
        margin-top: 0.6rem;
        color: var(--text-muted);
      }

      .advantage-home .focus-intro {
        max-width: none;
        width: 100%;
      }

      .focus-label.is-partners-title {
        font-family: "Avenir Next", "Segoe UI", Arial, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        font-weight: 400;
        color: var(--accent);
        margin-bottom: 0.85rem;
      }

      .advantage-home-list {
        list-style: none;
        margin: 0.75rem 0 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .advantage-home-list li {
        display: grid;
        grid-template-columns: 1.5rem 1fr;
        gap: 0.7rem;
        align-items: start;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.46;
      }

      .advantage-home-check {
        width: 1.5rem;
        height: 1.5rem;
        color: #48a86f;
        margin-top: 0.04rem;
      }

      .advantage-home-check svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.15;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .advantage-home-grid.is-test .advantage-home-card-head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.45rem;
      }

      .advantage-home-grid.is-test .advantage-home-icon {
        width: 3.6rem;
        height: 3.6rem;
        border-radius: 1.1rem;
        background: #eef3f9;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
      }

      .advantage-home-grid.is-test .advantage-home-icon img {
        width: 1.8rem;
        height: 1.8rem;
      }

      .advantage-home-grid.is-test .advantage-home-card h3,
      .advantage-home-grid.is-test .advantage-home-card p {
        margin-top: 0;
      }

      .advantage-home.is-dark-cards {
        background: #0f1a2a;
        border-top: 1px solid rgba(220, 228, 240, 0.15);
        border-bottom: 1px solid rgba(220, 228, 240, 0.15);
      }

      .advantage-home.is-dark-cards .focus-label,
      .advantage-home.is-dark-cards .focus-title {
        color: #f3f7fc;
      }

      .advantage-home.is-dark-cards .focus-intro {
        color: rgba(230, 238, 247, 0.78);
      }

      .advantage-home.is-dark-cards .advantage-home-card {
        background: #eef2f8;
        border: 1px solid rgba(18, 33, 56, 0.28);
        box-shadow: 0 16px 30px rgba(10, 18, 31, 0.08);
      }

      .advantage-home.is-dark-cards .advantage-home-card h3 {
        color: #172235;
      }

      .advantage-home.is-dark-cards .advantage-home-card p {
        color: #5a667a;
      }

      .advantage-home.is-dark-cards .advantage-home-grid.is-test .advantage-home-icon {
        background: #53b27f;
      }

      .advantage-home.is-dark-cards .advantage-home-grid.is-test .advantage-home-icon img {
        filter: brightness(0) invert(1);
      }

      .cta-link {
        display: inline-flex;
        margin-top: 1.4rem;
        font-size: 0.84rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-primary);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
        padding-bottom: 0.2rem;
      }

      .advantage-home.is-dark-cards .cta-link {
        color: #ffffff;
      }

      .test-section-b {
        background: #0f1a2a;
        color: #e8edf6;
        border-top: 1px solid rgba(220, 228, 240, 0.15);
      }

      .workflow-section {
        padding: 2.3rem 0 2.8rem;
        background: linear-gradient(180deg, #f4f6fa, #edf1f7);
      }

      .workflow-head {
        margin-bottom: 1rem;
      }

      .workflow-card {
        background: #eef2f7;
        border: 1px solid #d8e0eb;
        border-radius: 1rem;
        padding: 1.55rem;
      }

      .workflow-list {
        margin: 1.35rem 0 0;
        padding: 0;
        list-style: none;
      }

      .workflow-step {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) minmax(180px, 0.55fr);
        gap: 0.9rem;
        align-items: baseline;
        padding: 1rem 0;
        border-top: 1px solid #d8e0eb;
      }

      .workflow-step:first-child {
        border-top: 0;
      }

      .workflow-index {
        font-size: 0.7rem;
        letter-spacing: 0.09em;
        color: #8b98ad;
        min-width: 1.4rem;
      }

      .workflow-step-title {
        font-size: 1.18rem;
        line-height: 1.2;
        color: #1f2b3c;
      }

      .workflow-step-note {
        font-size: 0.73rem;
        line-height: 1.35;
        color: #7b8799;
        text-align: right;
      }

      .focus-section {
        padding: 2.4rem 0 3rem;
        background: #f2f5fa;
        border-top: 1px solid #dce3ee;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-layout {
        display: grid;
        grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.25fr);
        gap: 2.6rem;
        align-items: start;
      }

      .focus-layout-stacked {
        grid-template-columns: 1fr;
        gap: 1.35rem;
      }

      .focus-layout-stacked .focus-head-wide {
        width: 100%;
      }

      .focus-layout-stacked .focus-head-wide .focus-intro {
        max-width: none;
      }

      .focus-label {
        margin: 0;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #8a99ae;
      }

      .focus-title {
        margin-top: 0;
        font-size: clamp(1.9rem, 3.3vw, 3rem);
        line-height: 1.06;
        color: #1f2b3c;
      }

      .focus-intro {
        margin-top: 0.9rem;
        width: 100%;
        max-width: none;
        color: #5e6c82;
      }

      .focus-list {
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid #dce3ee;
      }

      .focus-item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        column-gap: 0.95rem;
        row-gap: 0.35rem;
        padding: 1.18rem 0 1.24rem;
        border-bottom: 1px solid #dce3ee;
      }

      .focus-index {
        font-size: 0.73rem;
        letter-spacing: 0.09em;
        color: #8f9db1;
        margin-top: 0.2rem;
      }

      .focus-item-title {
        font-size: 1.18rem;
        line-height: 1.22;
        color: #24344c;
      }

      .focus-item-copy {
        grid-column: 2;
        margin: 0;
        color: #66758a;
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .focus-variant {
        padding: 3.2rem 0;
      }

      .focus-variant + .focus-variant {
        border-top: 1px solid #dbe3ee;
      }

      .focus-variant-a {
        background: #ffffff;
      }

      .focus-a-shell {
        border: 1px solid #d8e0ec;
        border-radius: 1rem;
        background: linear-gradient(180deg, #f9fbff, #f3f7fd);
        padding: 1.2rem;
      }

      .focus-a-head {
        max-width: 42rem;
      }

      .focus-a-accordion {
        margin-top: 1rem;
        display: grid;
        gap: 0.6rem;
      }

      .focus-a-item {
        border: 1px solid #d9e2ee;
        border-radius: 0.75rem;
        overflow: hidden;
        background: #ffffff;
      }

      .focus-a-item summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.95rem 1rem;
        cursor: pointer;
      }

      .focus-a-item summary::-webkit-details-marker {
        display: none;
      }

      .focus-a-index {
        color: #8f9db1;
        font-size: 0.72rem;
        letter-spacing: 0.11em;
      }

      .focus-a-item h3 {
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.2;
        color: #24344c;
      }

      .focus-a-item p {
        margin: 0;
        padding: 0 1rem 0.95rem 3.3rem;
        font-size: 0.9rem;
        color: #65758d;
      }

      .focus-variant-b {
        background: linear-gradient(180deg, #f4f6fa, #edf1f7);
      }

      .focus-b-head {
        max-width: 46rem;
