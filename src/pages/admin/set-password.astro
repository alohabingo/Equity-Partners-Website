---
export const prerender = false;

import { isSupabaseConfigured } from "../../lib/supabase";

/**
 * Where an invitation lands.
 *
 * Deliberately outside the admin guard (see middleware): the person arriving
 * here has an account but has never signed in, so a page that demanded a
 * session would send them to a login they cannot pass.
 *
 * The work happens in the browser rather than on the server because the
 * credential in the link is only ever handed to the browser. Supabase sends it
 * in one of two shapes depending on how the project is configured — tokens in
 * the URL fragment, or a `token_hash` in the query — and the fragment is never
 * transmitted to a server at all. Handling both here means this page works
 * whichever way the project is set up, now or later.
 *
 * Once the password is set, the page signs in through the portal's ordinary
 * sign-in endpoint. That is what mints the session cookie the rest of the admin
 * reads, so an invited colleague ends up in exactly the same state as anyone
 * who logged in normally, rather than in a special one.
 */
const configured = isSupabaseConfigured();
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Choose your password · Equity Partners</title>
  </head>
  <body>
    <main class="shell">
      <div class="card" data-sb-url={SUPABASE_URL} data-sb-key={SUPABASE_ANON_KEY}>
        <p class="eyebrow">Equity Partners</p>
        <h1>Choose your password</h1>

        {!configured ? (
          <p class="msg err">This portal isn't configured yet. Ask whoever invited you.</p>
        ) : (
          <>
            <p class="lede" data-intro>Checking your invitation…</p>

            <form id="pwform" hidden>
              <label>
                <span>Your email</span>
                <input type="email" name="email" data-email readonly />
              </label>
              <label>
                <span>New password</span>
                {/* Nine is the portal's floor. The counter below is the honest
                    part: a length rule alone does not make a good password, and
                    saying so is more use than a green tick. */}
                <input type="password" name="password" data-pw minlength="9" required
                       autocomplete="new-password" />
              </label>
              <label>
                <span>Type it again</span>
                <input type="password" name="confirm" data-pw2 minlength="9" required
                       autocomplete="new-password" />
              </label>
              <p class="hint">At least 9 characters. Longer is better than complicated — a few
                unrelated words beats a short one with symbols in it.</p>
              <p class="msg err" data-error hidden></p>
              <button type="submit" data-submit>Set password and sign in</button>
            </form>

            <p class="msg err" data-dead hidden>
              This invitation link has expired or has already been used.
              Ask whoever invited you to send a new one.
            </p>
          </>
        )}
      </div>
    </main>

    <form id="signin" method="post" action="/api/auth/signin" hidden>
      <input type="hidden" name="email" data-si-email />
      <input type="hidden" name="password" data-si-pw />
    </form>

    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100dvh; color: #16283e;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        background:
          radial-gradient(ellipse at 30% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          radial-gradient(circle at 10% -10%, #eef2f8 0, #f2f5f9 50%), #f2f5f9;
      }
      .shell { min-height: 100dvh; display: grid; place-items: center; padding: 2rem 1.2rem; }
      .card {
        width: min(26rem, 100%); background: #fff; border-radius: 18px;
        padding: 1.8rem 1.8rem 2rem; box-shadow: 0 24px 60px rgba(15, 26, 42, 0.14);
      }
      .eyebrow {
        margin: 0 0 0.5rem; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.18em;
        text-transform: uppercase; color: #2e7d54;
      }
      h1 { margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; }
      .lede { margin: 0.7rem 0 0; font-size: 0.85rem; color: #5c6f88; line-height: 1.6; }
      form { margin-top: 1.4rem; display: grid; gap: 0.9rem; }
      label { display: grid; gap: 0.3rem; }
      label span {
        font-size: 0.62rem; font-weight: 800; letter-spacing: 0.08em;
        text-transform: uppercase; color: #93a3b8;
      }
      input {
        font: inherit; font-size: 0.9rem; padding: 0.7rem 0.8rem; color: #16283e;
        border: 1px solid #d5deea; border-radius: 10px; background: #fbfcfe; width: 100%;
      }
      input:focus { outline: none; border-color: #53b27f; background: #fff; }
      input[readonly] { color: #5c6f88; }
      .hint { margin: 0; font-size: 0.74rem; color: #93a3b8; line-height: 1.5; }
      button {
        font: inherit; font-size: 0.85rem; font-weight: 700; cursor: pointer; color: #fff;
        background: #53b27f; border: 0; border-radius: 999px; padding: 0.75rem 1.2rem;
        transition: background-color 160ms ease;
      }
      button:hover:not(:disabled) { background: #3f9568; }
      button:disabled { background: #c3cfe0; cursor: not-allowed; }
      .msg { margin: 0; font-size: 0.8rem; line-height: 1.55; }
      .msg.err { color: #b3261e; font-weight: 600; }
      [hidden] { display: none !important; }
    </style>

    {/* A bundled module, NOT an inline script pulling the library off a public
        CDN. This page handles a password: code loaded from a third party would
        mean a compromise there could read it, and the library is already a
        dependency of this project. `define:vars` was what forced the inline
        form, so the two values travel on a data attribute instead — both are
        public keys that ship in the page either way. */}
    <script>
      import { createClient } from "@supabase/supabase-js";

      const card = document.querySelector<HTMLElement>("[data-sb-url]");
      if (card) {
        const $ = (sel: string) => document.querySelector<HTMLElement>(sel);
        const intro = $("[data-intro]");
        const form = $("#pwform") as HTMLFormElement | null;
        const dead = $("[data-dead]");
        const errBox = $("[data-error]");

        const fail = () => { if (intro) intro.hidden = true; if (dead) dead.hidden = false; };

        (async () => {
          try {
            const sb = createClient(card.dataset.sbUrl!, card.dataset.sbKey!, {
              auth: { detectSessionInUrl: true, persistSession: true, flowType: "implicit" },
            });

            // Shape two: a token_hash in the query string. Redeem it explicitly;
            // detectSessionInUrl only understands the fragment form.
            const params = new URLSearchParams(location.search);
            const tokenHash = params.get("token_hash");
            const type = params.get("type") || "invite";
            if (tokenHash) {
              const { error } = await sb.auth.verifyOtp({ type, token_hash: tokenHash });
              if (error) return fail();
            }

            const { data: { user } } = await sb.auth.getUser();
            if (!user) return fail();

            // The address is shown, not typed: it is the one the invitation was
            // sent to, and letting it be edited here would only create a way to
            // sign in as the wrong person.
            ($("[data-email]") as HTMLInputElement).value = user.email ?? "";
            intro!.textContent = "Pick a password for the Equity Partners portal. You'll use it to sign in from now on.";
            form!.hidden = false;
            $("[data-pw]")!.focus();

            form!.addEventListener("submit", async (ev) => {
              ev.preventDefault();
              errBox!.hidden = true;
              const pw = ($("[data-pw]") as HTMLInputElement).value;
              const pw2 = ($("[data-pw2]") as HTMLInputElement).value;

              if (pw.length < 9) {
                errBox!.textContent = "Use at least 9 characters.";
                errBox!.hidden = false; return;
              }
              if (pw !== pw2) {
                errBox!.textContent = "The two passwords don't match.";
                errBox!.hidden = false; return;
              }

              const btn = $("[data-submit]") as HTMLButtonElement;
              btn.disabled = true;
              btn.textContent = "Setting it…";

              const { error } = await sb.auth.updateUser({ password: pw });
              if (error) {
                errBox!.textContent = error.message || "That didn't work — try again.";
                errBox!.hidden = false;
                btn.disabled = false;
                btn.textContent = "Set password and sign in";
                return;
              }

              // Sign in through the portal's normal endpoint, so the session
              // cookie is minted the same way it is for everyone else.
              ($("[data-si-email]") as HTMLInputElement).value = user.email ?? "";
              ($("[data-si-pw]") as HTMLInputElement).value = pw;
              ($("#signin") as HTMLFormElement).submit();
            });
          } catch {
            fail();
          }
        })();
      }
    </script>
  </body>
</html>
