---
/**
 * The record of what has happened to an enquiry - internal notes and the
 * history - as its own card, to sit BESIDE the conversation.
 *
 * Split out of EnquiryPanel rather than being a column inside it: at the bottom
 * of a long thread nobody scrolls far enough to see either one, and a column
 * inside the conversation's own card still reads as part of the conversation.
 * Two cards say what they are - one is the exchange with the buyer, the other
 * is what the team did about it.
 */
interface Props {
  enquiryId: string;
  notes: { body: string; created_at: string; author: string }[];
  events: { kind: string; detail: any; created_at: string; actor: string }[];
  /** Where the note form sends the browser back to. */
  back: string;
}
const { enquiryId, notes, events, back } = Astro.props;

const EVENT_LABELS: Record<string, string> = {
  received: "Enquiry received",
  converted: "Converted to a lead",
  rejected: "Rejected",
  untriaged: "Put back for triage",
  locale_changed: "Language set",
  claimed: "Claimed (before ownership was removed)",
  released: "Released (before ownership was removed)",
  stage_changed: "Stage changed",
  note_added: "Note added",
  document_sent: "Document sent",
  reply_sent: "Reply sent",
  anonymised: "Personal data anonymised",
};

const shortDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
---

<style>
  .notes { background: #fffdf5; border: 1px solid #eadfbf; border-radius: 0.9rem; padding: 0.9rem 1rem; }
  .notes .nh { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: #8a6420; }
  .nrow { font-size: 0.79rem; line-height: 1.55; margin: 0.55rem 0 0; color: #4a4128; }
  .nrow em { font-style: normal; color: #9a8a5f; font-size: 0.7rem; display: block; margin-top: 0.1rem; }
  .notes textarea {
    font: inherit; width: 100%; margin-top: 0.7rem; border: 1px solid #eadfbf; border-radius: 8px;
    padding: 0.55rem 0.7rem; font-size: 0.79rem; min-height: 54px; resize: vertical; background: #fff;
  }
  .notes .add {
    font: inherit; font-size: 0.72rem; font-weight: 700; margin-top: 0.5rem; border-radius: 8px;
    border: 1px solid #eadfbf; background: #fff; color: #8a6420; padding: 0.35rem 0.8rem; cursor: pointer;
  }

  .hist { margin-top: 1.1rem; }
  .hist h3 { margin: 0; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #5c6f88; }
  .hrow {
    font-size: 0.76rem; color: #5c6f88; padding: 0.35rem 0; border-bottom: 1px solid #f2f5f9;
    display: flex; justify-content: space-between; gap: 0.7rem;
  }
  .hrow:last-child { border-bottom: 0; }
  .hrow .who { color: #93a3b8; white-space: nowrap; }
  .empty { margin: 0.5rem 0 0; font-size: 0.76rem; color: #93a3b8; }
</style>

<div class="notes">
  <div class="nh">Internal notes · visible to the team, never sent</div>
  {notes.length === 0 && <p class="nrow" style="color:#9a8a5f">No notes yet.</p>}
  {notes.map((n) => (
    <p class="nrow">{n.body}<em>{n.author} · {shortDate(n.created_at)}</em></p>
  ))}
  <form method="post" action="/api/admin/enquiry">
    <input type="hidden" name="id" value={enquiryId} />
    <input type="hidden" name="action" value="note" />
    <input type="hidden" name="back" value={back} />
    <textarea name="body" placeholder="Add a note for the team…" required></textarea>
    <button class="add" type="submit">Add note</button>
  </form>
</div>

<div class="hist">
  <h3>History</h3>
  {events.length === 0 && <p class="empty">Nothing has happened to this enquiry yet.</p>}
  {events.map((ev) => (
    <div class="hrow">
      <span>
        {EVENT_LABELS[ev.kind] ?? ev.kind}
        {(ev.kind === "stage_changed" || ev.kind === "locale_changed") && ev.detail?.label
          ? ` → ${ev.detail.label}` : ""}
        {ev.kind === "rejected" && ev.detail?.label ? ` · ${ev.detail.label}` : ""}
      </span>
      <span class="who">{ev.actor} · {shortDate(ev.created_at)}</span>
    </div>
  ))}
</div>
