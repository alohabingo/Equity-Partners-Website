      .timeline-v2.is-spotlight .timeline-v2-col:hover .timeline-v2-step-icon svg {
        stroke: #ffffff;
      }

      .timeline-v2.is-spotlight .timeline-v2-col h3 {
        position: relative;
        z-index: 1;
        color: var(--text-primary);
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.005em;
        line-height: 1.25;
        margin: 0;
      }

      .timeline-v2.is-spotlight .timeline-v2-col p {
        position: relative;
        z-index: 1;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0.7rem auto 0;
        max-width: 22ch;
      }

      .timeline-v2.is-spotlight .timeline-v2-cta {
        margin-top: 2.4rem;
        padding: 0;
        position: relative;
        z-index: 1;
      }

      .timeline-v2.is-spotlight .timeline-v2-cta .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: auto;
        color: #3f9568;
        background: rgba(83, 178, 127, 0.08);
        border: 1px solid rgba(83, 178, 127, 0.55);
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 0.85rem 1.4rem;
        border-radius: 0.55rem;
        transition: background 220ms ease, border-color 220ms ease,
          transform 220ms ease, color 220ms ease, box-shadow 220ms ease;
      }

      .timeline-v2.is-spotlight .timeline-v2-cta .button:hover {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.28);
      }

      @media (max-width: 980px) {
        .timeline-v2.is-spotlight .timeline-v2-card {
          grid-template-columns: 1fr;
          gap: 0;
        }

        .timeline-v2.is-spotlight .timeline-v2-col {
          display: grid;
          grid-template-columns: 3.4rem 1fr;
          grid-template-rows: auto auto auto;
          column-gap: 1.2rem;
          align-items: center;
          text-align: left;
          padding: 1.6rem 1.4rem;
          border-right: none;
          border-bottom: 1px solid var(--line);
        }

        .timeline-v2.is-spotlight .timeline-v2-col:last-child {
          border-bottom: none;
        }

        .timeline-v2.is-spotlight .timeline-v2-step-icon {
          grid-column: 1;
          grid-row: 1 / 4;
          margin: 0;
          align-self: center;
          width: 3.4rem;
          height: 3.4rem;
        }

        .timeline-v2.is-spotlight .timeline-v2-step-num {
          grid-column: 2;
          grid-row: 1;
          margin-bottom: 0.3rem;
        }

        .timeline-v2.is-spotlight .timeline-v2-col h3 {
          grid-column: 2;
          grid-row: 2;
        }

        .timeline-v2.is-spotlight .timeline-v2-col p {
          grid-column: 2;
          grid-row: 3;
          margin: 0.5rem 0 0;
          max-width: none;
        }
      }

      @media (max-width: 680px) {
        .timeline-v2.is-spotlight {
          padding: 4rem 0 3.5rem;
        }

        .timeline-v2.is-spotlight h2 {
          white-space: normal;
        }
      }

      /* ── What We Offer ── */
      .what-we-offer {
        background: #0f1a2a;
        border-top: 1px solid rgba(214, 225, 244, 0.15);
        border-bottom: 1px solid rgba(214, 225, 244, 0.15);
        padding: 5rem 0;
      }

      .what-we-offer-header {
        margin-bottom: 3rem;
      }

      .what-we-offer-header .eyebrow {
        color: #9fb4d2;
      }

      .what-we-offer-header .focus-title {
        color: #ffffff;
        margin-bottom: 0.6rem;
      }

      .what-we-offer-header .focus-intro {
        color: #d6e0ef;
        max-width: none;
      }

      /* Top row: two prominent cards */
      .what-we-offer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .wwo-card {
        background: #13202f;
        border: 1px solid rgba(214, 225, 244, 0.14);
        border-radius: 1.1rem;
        padding: 2rem 2rem 1.85rem;
        display: flex;
        flex-direction: column;
        position: relative;
        transition: border-color 220ms ease, transform 180ms ease, box-shadow 180ms ease;
      }

      .wwo-card:hover {
        transform: translateY(-2px);
      }

      .wwo-card.is-featured {
        background: linear-gradient(180deg, rgba(83, 178, 127, 0.05) 0%, #13202f 55%);
        border-color: rgba(83, 178, 127, 0.30);
      }

      .wwo-card.is-featured:hover {
        border-color: rgba(83, 178, 127, 0.55);
      }

      /* Most popular badge */
      .wwo-badge-popular {
        position: absolute;
        top: -0.7rem;
        right: 2rem;
        background: #53b27f;
        color: #ffffff;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        line-height: 1;
      }

      /* Role pill */
      .wwo-role {
        display: inline-flex;
        align-items: center;
        margin-bottom: 1.5rem;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        background: rgba(214, 225, 244, 0.1);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: #9fb4d2;
        width: fit-content;
      }

      .wwo-card.is-featured .wwo-role {
        background: rgba(83, 178, 127, 0.18);
        color: #53b27f;
      }

      /* Title block */
      .wwo-title {
        color: #f4f8ff;
        font-size: 1.55rem;
        font-weight: 700;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        line-height: 1.2;
        margin: 0 0 0.35rem;
      }

      .wwo-subtitle {
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #9fb4d2;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        margin: 0 0 0.85rem;
      }

      /* Fading divider — matches advantage-home-card-divider on Why Equity section */
      .wwo-divider {
        height: 1px;
        background: linear-gradient(
          90deg,
          rgba(83, 178, 127, 0.5),
          rgba(83, 178, 127, 0.05)
        );
        margin: 0.65rem 0 1.25rem;
      }

      .wwo-desc {
        color: #d6e0ef;
        font-size: 0.95rem;
        line-height: 1.6;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        margin: 0 0 1.75rem;
      }

      /* Returns box — iconified data card with leading icon column */
      .wwo-returns {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        align-items: center;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(214, 225, 244, 0.08);
        border-radius: 0.85rem;
        padding: 1.05rem 1.15rem;
        margin-bottom: 1.75rem;
      }

      .wwo-card.is-featured .wwo-returns {
        background: rgba(83, 178, 127, 0.08);
        border-color: rgba(83, 178, 127, 0.30);
      }

      .wwo-returns-icon {
        width: 3.4rem;
        height: 3.4rem;
        border-radius: 0.7rem;
        background: rgba(214, 225, 244, 0.08);
        border: 1px solid rgba(214, 225, 244, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9fb4d2;
        flex-shrink: 0;
      }

      .wwo-card.is-featured .wwo-returns-icon {
        background: rgba(83, 178, 127, 0.18);
        border-color: rgba(83, 178, 127, 0.30);
        color: #53b27f;
      }

      .wwo-returns-icon svg {
        width: 1.5rem;
        height: 1.5rem;
      }

      .wwo-returns-label {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #9fb4d2;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        margin: 0 0 0.4rem;
      }

      .wwo-returns-value {
        font-size: 1.05rem;
        font-weight: 700;
        color: #f4f8ff;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        line-height: 1.3;
        margin: 0 0 0.3rem;
      }

      .wwo-card.is-featured .wwo-returns-value {
        color: #53b27f;
      }

      .wwo-returns-sub {
        font-size: 0.78rem;
        color: #9fb4d2;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        margin: 0;
        line-height: 1.4;
      }

      /* Feature list */
      .wwo-features {
        list-style: none;
        margin: 0 0 2rem;
        padding: 0;
        display: grid;
        gap: 0.75rem;
      }

      .wwo-features li {
        display: grid;
        grid-template-columns: 1.1rem 1fr;
        gap: 0.65rem;
        align-items: start;
        color: #d6e0ef;
        font-size: 0.9rem;
        line-height: 1.5;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      .wwo-check {
        width: 1.05rem;
        height: 1.05rem;
        margin-top: 0.15rem;
        color: #53b27f;
        flex-shrink: 0;
      }

      .wwo-check svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* CTA */
      .wwo-cta {
        margin-top: auto;
        padding-top: 0.5rem;
      }

      .wwo-cta a {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.85rem 1.4rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(214, 225, 244, 0.14);
        border-radius: 0.55rem;
        color: #f4f8ff;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        transition: background 180ms ease, border-color 180ms ease;
      }

      .wwo-cta a:hover {
        background: rgba(255, 255, 255, 0.07);
        border-color: rgba(214, 225, 244, 0.25);
      }

      .wwo-card.is-featured .wwo-cta a {
        background: #53b27f;
        border-color: #53b27f;
        color: #ffffff;
      }

      .wwo-card.is-featured .wwo-cta a:hover {
        background: #5fc189;
        border-color: #5fc189;
      }

      .wwo-cta-arrow {
        transition: transform 180ms ease;
      }

      .wwo-cta a:hover .wwo-cta-arrow {
        transform: translateX(3px);
      }

      /* Equity compact strip */
      .wwo-equity-strip {
        background: #13202f;
        border: 1px solid rgba(214, 225, 244, 0.14);
        border-radius: 1.1rem;
        padding: 1.5rem 1.75rem;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 1.75rem;
        align-items: center;
        transition: border-color 220ms ease;
      }

      .wwo-equity-strip:hover {
        border-color: rgba(83, 178, 127, 0.30);
      }

      .wwo-equity-left {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 11rem;
      }

      .wwo-equity-role {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        background: rgba(83, 178, 127, 0.18);
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: #53b27f;
        width: fit-content;
        margin-bottom: 0.3rem;
      }

      .wwo-equity-title {
        color: #f4f8ff;
        font-size: 1.25rem;
        font-weight: 700;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        line-height: 1.2;
        margin: 0;
      }

      .wwo-equity-sub {
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #9fb4d2;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        margin: 0;
      }

      .wwo-equity-desc {
        color: #d6e0ef;
        font-size: 0.9rem;
        line-height: 1.55;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        margin: 0;
        border-left: 1px solid rgba(214, 225, 244, 0.14);
        padding-left: 1.5rem;
      }

      .wwo-equity-cta a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.1rem;
        background: transparent;
        border: 1px solid rgba(83, 178, 127, 0.30);
        border-radius: 0.55rem;
        color: #53b27f;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        transition: background 180ms ease, border-color 180ms ease;
      }

      .wwo-equity-cta a:hover {
        background: rgba(83, 178, 127, 0.08);
        border-color: rgba(83, 178, 127, 0.55);
      }

      @media (max-width: 920px) {
        .what-we-offer-grid {
          grid-template-columns: 1fr;
        }
        .wwo-card {
          padding: 1.75rem;
        }
        .wwo-equity-strip {
          grid-template-columns: 1fr;
          gap: 1.1rem;
        }
        .wwo-equity-desc {
          border-left: 0;
          border-top: 1px solid rgba(214, 225, 244, 0.14);
          padding-left: 0;
          padding-top: 1.1rem;
        }
      }

      /* ── Andorra Advantage V2 ── */
      .andorra-adv-v2 {
        background: #f2f5fa;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 5rem 0 4.5rem;
      }

      .andorra-adv-v2-header {
        margin-bottom: 3rem;
      }

      .andorra-adv-v2-header .eyebrow {
        color: var(--accent);
      }

      .andorra-adv-v2-header .focus-title {
        color: #0f1a2a;
        margin-bottom: 0.6rem;
      }

      .andorra-adv-v2-header .focus-intro {
        color: #5a667a;
        max-width: none;
      }

      .andorra-adv-v2-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        border: 1px solid #d7deea;
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
      }

      .andorra-adv-v2-item {
        padding: 2.4rem 2.2rem;
        border-right: 1px solid #e4eaf3;
        border-bottom: 1px solid #e4eaf3;
        transition: background 200ms ease;
      }

      .andorra-adv-v2-item:nth-child(even) {
        border-right: none;
      }

      .andorra-adv-v2-item:nth-child(3),
      .andorra-adv-v2-item:nth-child(4) {
        border-bottom: none;
      }

      .andorra-adv-v2-item:hover {
        background: #f6f9fd;
      }

      .andorra-adv-v2-num {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #53b27f;
        margin-bottom: 0.85rem;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      .andorra-adv-v2-flag {
        width: 1.2rem;
        height: 1.2rem;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        display: block;
      }

      .andorra-adv-v2-item h3 {
        color: #0f1a2a;
        font-size: 1.1rem;
        margin: 0 0 0.6rem;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-weight: 600;
      }

      .andorra-adv-v2-item p {
        color: #5a667a;
        font-size: 0.93rem;
        line-height: 1.6;
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      @media (max-width: 640px) {
        .andorra-adv-v2-grid {
          grid-template-columns: 1fr;
        }

        .andorra-adv-v2-item {
          border-right: none;
          border-bottom: 1px solid #e4eaf3;
        }

        .andorra-adv-v2-item:last-child {
          border-bottom: none;
        }

        .andorra-adv-v2-item:nth-child(3) {
          border-bottom: 1px solid #e4eaf3;
        }
      }

      /* ────────────────────────────────────────────────────────────
         "The Andorra Advantage" — Spotlight treatment (light)
         Mirrors .advantage-home.is-spotlight and .why-equity-home.is-spotlight
         so all three home sections share one visual language.
         ──────────────────────────────────────────────────────────── */
      .andorra-adv-v2.is-spotlight {
        position: relative;
        padding: 5.5rem 0 4.5rem;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .andorra-adv-v2.is-spotlight::before,
      .andorra-adv-v2.is-spotlight::after {
        content: none;
      }

      .andorra-adv-v2.is-spotlight .container {
        position: relative;
        z-index: 1;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-header {
        margin-bottom: 3rem;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-header .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: #3f9568;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 0;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-header .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-header .focus-title {
        color: var(--text-primary);
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.05;
        margin-top: 1rem;
        margin-bottom: 0;
        max-width: none;
        white-space: nowrap;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-header .focus-title::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-header .focus-intro {
        color: var(--text-muted);
        max-width: none;
        width: 100%;
        margin-top: 1.2rem;
        font-size: 1.02rem;
        line-height: 1.6;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-item {
        position: relative;
        background: transparent;
        border: none;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        border-radius: 0;
        padding: 2.2rem 1.8rem 1.9rem;
        overflow: hidden;
        isolation: isolate;
        box-shadow: none;
        transition: background 320ms ease;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-item:nth-child(2n) {
        border-right: none;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-item:nth-last-child(-n + 2) {
        border-bottom: none;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-item::before {
        content: none;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-item::after {
        content: none;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-item:hover {
        background: rgba(83, 178, 127, 0.05);
        transform: none;
        border-color: var(--line);
        box-shadow: none;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-number {
        position: absolute;
        top: 1.2rem;
        right: 1.5rem;
        font-size: 3.2rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        color: rgba(31, 40, 53, 0.07);
        line-height: 1;
        z-index: 0;
        font-feature-settings: "tnum";
        transition: color 360ms ease, transform 360ms ease;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-item:hover .andorra-adv-v2-number {
        color: rgba(83, 178, 127, 0.32);
        transform: translateY(-2px);
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-num {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: #3f9568;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      .andorra-adv-v2.is-spotlight .andorra-adv-v2-flag {
