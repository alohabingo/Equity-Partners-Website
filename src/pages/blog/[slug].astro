          margin-top: 0.7rem;
          font-size: 0.95rem;
          line-height: 1.5;
        }

        .footer-grid {
          grid-template-columns: 1fr;
          gap: 1.2rem;
        }

        .footer-grid > div:not(:first-child) {
          justify-self: start;
          text-align: left;
          margin-left: 0;
        }

        .footer-grid > div:not(:first-child) .footer-list {
          justify-items: start;
        }

        .footer-bottom-row {
          grid-template-columns: 1fr;
          text-align: left;
        }

        .footer-legal {
          justify-content: flex-start;
        }

        .footer-social {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body style={`--hero-image: url('${post.image}')`}>
    <header class="site-header" id="home">
      <input class="menu-toggle-input" type="checkbox" id="mobile-menu-toggle-blog-article" />
      <label class="menu-toggle" for="mobile-menu-toggle-blog-article" aria-label="Toggle navigation menu">
        <span class="menu-toggle-bars"></span>
      </label>
      <a href="/" aria-label="Go to homepage">
        <img
          class="logo"
          src="/images/branding/equity-partners-logo-light%20small.png"
          alt="Equity Partners logo"
        />
      </a>
      <nav class="main-nav" aria-label="Primary">
        <ul class="menu-list">
          <li><a class="menu-link" href="/">Home</a></li>
          <li><a class="menu-link" href="/#team">Services</a></li>
              <li><a class="menu-link" href="/about">About</a></li>
          <li><a class="menu-link" href="/partners">Partners</a></li>
          <li><a class="menu-link is-active" href="/blog">Blog</a></li>
          <li><a class="menu-link" href="/test">Test</a></li>
        </ul>
        <a class="menu-cta" href="/contact">Contact Us</a>
      </nav>
    </header>

    <main class="article-wrap">
      <div class="container">
        <a class="breadcrumbs" href="/blog">Blog / Back to Insights</a>

        <article class="article-shell">
          <header class="article-hero">
            <div>
              <div class="article-meta">
                <span class="pill">{post.date}</span>
                <span class="pill">{post.category}</span>
                <span class="pill">{post.readTime}</span>
              </div>
              <h1>{post.title}</h1>
              <p class="subtitle">{post.excerpt}</p>
            </div>
          </header>

          <div class="article-body">
            <div class="article-content">
              {
                post.sections.map((section) => (
                  <section class="article-section">
                    <h2>{section.heading}</h2>
                    {section.paragraphs.map((paragraph) => (<p>{paragraph}</p>))}
                    {section.table && (
                      <div class="article-table-wrap">
                        <div class="article-table-row">
                          {section.table.headers.map((header) => (
                            <p class="article-table-head">{header}</p>
                          ))}
                        </div>
                        {section.table.rows.map((row) => (
                          <div class="article-table-row">
                            {row.map((cell, index) => (
                              index === 0 ? (
                                <p class="article-table-cell-primary">{cell}</p>
                              ) : index === row.length - 1 && row.length > 2 ? (
                                <p class="article-table-cell"><span class="article-table-badge">{cell}</span></p>
                              ) : (
                                <p class="article-table-cell">{cell}</p>
                              )
                            ))}
                          </div>
                        ))}
                      </div>
                    )}
                  </section>
                ))
              }
            </div>

            <aside class="article-aside">
              <p class="aside-kicker">What We Do</p>
              <p class="aside-label">Equity Partners</p>
              <p class="aside-copy">
                Equity Partners helps investors access Andorra’s most compelling real estate opportunities through our
                trusted local network, regulatory expertise, and full-cycle project development execution; if you are
                exploring investment opportunities in Andorras high potential real estate markets, our team would be
                pleased to speak with you.
              </p>
              <a class="aside-cta" href="/contact">Contact Us</a>
              {post.sources && post.sources.length > 0 && (
                <section class="article-sources">
                  <h2>Sources</h2>
                  <ul class="sources-list">
                    {post.sources.map((source) => (
                      <li>
                        <a class="source-link" href={source.href} target="_blank" rel="noreferrer">
                          {source.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </aside>
          </div>
        </article>

        {suggestedPosts.length > 0 && (
          <section class="suggested-reads">
            <p class="eyebrow">Suggested Reads</p>
            <h2>Continue exploring the Andorran market.</h2>
            <div class="blog-grid">
              {suggestedPosts.map((entry) => (
                <article class="blog-card">
                  <a class="blog-card-link" href={`/blog/${entry.slug}`}>
                    <img src={entry.image} alt={entry.title} loading="lazy" />
                    <div class="blog-meta">
                      <div class="metrics">
                        <span class="pill">{entry.date}</span>
                        <span class="pill">{entry.category}</span>
                      </div>
                      <h3>{entry.title}</h3>
                      <p class="excerpt">{entry.excerpt}</p>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </section>
        )}
      </div>
    </main>

    <footer class="footer">
      <div class="footer-top">
        <div class="container footer-grid">
          <div>
            <img
              class="footer-logo"
              src="/images/branding/equity-partners-logo-light%20small.png"
              alt="Equity Partners Andorra Property Group"
            />
            <a class="footer-cta" href="/contact">Explore Opportunities</a>
          </div>

          <div>
            <h3 class="footer-heading">Equity Partners</h3>
            <ul class="footer-list">
              <li><a class="footer-link" href="/#about">About</a></li>
              <li><a class="footer-link" href="/#team">Team</a></li>
              <li><a class="footer-link" href="/partners">Partners</a></li>
              <li><a class="footer-link" href="/#partners">Projects</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer-heading">Resources</h3>
            <ul class="footer-list">
              <li><a class="footer-link" href="/blog">Blog</a></li>
              <li><a class="footer-link" href="#">Market Reports</a></li>
              <li><a class="footer-link" href="#">Investment Guides</a></li>
            </ul>
          </div>

          <div>
            <h3 class="footer-heading">Contact</h3>
            <p class="footer-meta">
              Av. Meritxell 95, AD500 Andorra la Vella<br />
              +376 000 000<br />
              info@equitypartnersandorra.com<br />
              SL Reg. No. L-12345-6
            </p>
          </div>
        </div>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-bottom">
        <div class="container footer-bottom-row">
          <p class="footer-copy">© {currentYear} EQUITY PARTNERS. All rights reserved.</p>
          <div class="footer-legal">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Use</a>
            <a href="#">Disclaimer</a>
          </div>
          <div class="footer-social">
            <a class="social-pill" href="#" aria-label="LinkedIn">in</a>
            <a class="social-pill" href="#" aria-label="X">X</a>
            <a class="social-pill" href="#" aria-label="YouTube">▶</a>
            <a class="social-pill" href="#" aria-label="Instagram">IG</a>
          </div>
        </div>
      </div>
    </footer>

    <script type="module">
      const root = document.body;
      const syncHeaderState = () => {
        root.classList.toggle("is-scrolled", window.scrollY > 10);
      };

      syncHeaderState();
      window.addEventListener("scroll", syncHeaderState, { passive: true });
    </script>
  </body>
</html>
