---
import { PARKING_STATES, parkingPrice, parkingState } from "../../lib/parking";
import { ITEM_COLUMNS } from "../../lib/tableColumns";
import InterestCell from "./InterestCell.astro";

/**
 * The parking table on the Units tab.
 *
 * Built as the twin of UnitRows: the same columns in the same order, the same
 * widths (ITEM_COLUMNS), and the same pill controls at the same size, so moving
 * between a building's card and this one nothing shifts. A space's notes sit
 * under its code rather than in a column of their own — a sixth column is the
 * one thing that would stop the two tables lining up.
 *
 * The price is shown, not edited: spaces are priced under Settings, where
 * they are created. State, Interested and Buyer are changed here, because this
 * is where a space is sold.
 */
interface Props {
  slug: string;
  parking: { id: string; code: string; price: number | null; state: string; notes: string | null; inquiry_id: string | null }[];
  buyers: { id: string; name: string }[];
  /** Who is interested in each space, by space id. */
  interested?: Record<string, { id: string; name: string }[]>;
}
const { slug, parking, buyers, interested = {} } = Astro.props;

const back = `/admin/projects/${slug}?tab=units&show=parking`;
const candidatesFor = (p: Props["parking"][number]) => {
  const listed = new Set((interested[p.id] ?? []).map((x) => x.id));
  return buyers.filter((b) => b.id !== p.inquiry_id && !listed.has(b.id));
};
---

<style>
  /* Kept identical to UnitRows. */
  table.q { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 0.8rem; table-layout: fixed; }
  table.q th {
    text-align: left; font-size: 0.62rem; letter-spacing: 0.07em; text-transform: uppercase;
    color: #93a3b8; font-weight: 800; padding: 0.45rem 0.5rem; border-bottom: 1px solid #d7deea;
  }
  table.q td { padding: 0.7rem 0.5rem; border-bottom: 1px solid #eef2f7; vertical-align: middle; }
  table.q tr:last-child td { border-bottom: 0; }
  .pnote { display: block; margin-top: 0.15rem; font-size: 0.7rem; color: #93a3b8; line-height: 1.3; overflow-wrap: anywhere; }
  .pprice { color: #16283e; }
  .pprice.none { color: #b0bccb; }

  .pick { position: relative; display: inline-flex; }
  .pick select {
    font: inherit; font-size: 0.76rem; font-weight: 700;
    color: var(--ink, #5c6f88); background: var(--bg, #f2f5f9);
    border: 1px solid var(--bd, transparent); border-radius: 999px;
    cursor: pointer; min-width: 128px;
    padding-top: 0.45rem; padding-bottom: 0.45rem; padding-left: 0.95rem;
    line-height: 1.25;
    transition: filter 180ms ease, box-shadow 180ms ease;
  }
  .pick select:hover { filter: brightness(0.96); }
  .pick select:focus { outline: none; }
  .pick select:focus-visible { box-shadow: 0 0 0 3px rgba(83, 178, 127, 0.32); }
  .pick.quiet select { min-width: 150px; background: #fff; border-color: #d5deea; color: #16283e; }
  .pick.quiet.empty select { background: #f8fafc; color: #93a3b8; font-weight: 600; }
  .pick.quiet.empty { --ink: #93a3b8; }
</style>

<table class="q">
  <colgroup>{ITEM_COLUMNS.map((c) => <col style={`width:${c.width}`} />)}</colgroup>
  <tr><th>Space</th><th>State</th><th>Price</th><th>Interested</th><th>Buyer</th></tr>
  {parking.map((p) => (
    <tr>
      <td>
        <b>{p.code}</b>
        {p.notes && <span class="pnote">{p.notes}</span>}
      </td>

      <td>
        <form method="post" action="/api/admin/project-parking">
          <input type="hidden" name="slug" value={slug} />
          <input type="hidden" name="id" value={p.id} />
          <input type="hidden" name="action" value="state" />
          <span class="pick" style={`--ink:${parkingState(p.state).ink};--bg:${parkingState(p.state).tint};--bd:${parkingState(p.state).edge}`}>
            <select name="state" onchange="this.form.submit()" aria-label={`State for ${p.code}`}>
              {PARKING_STATES.map((st) => (
                <option value={st.key} selected={st.key === p.state}>{st.label}</option>
              ))}
            </select>
          </span>
        </form>
      </td>

      <td><span class:list={["pprice", { none: p.price == null }]}>{parkingPrice(p.price)}</span></td>

      <td>
        <InterestCell kind="parking" itemId={p.id} itemCode={p.code}
                      people={interested[p.id] ?? []} candidates={candidatesFor(p)} back={back} />
      </td>

      <td>
        {/* Who is buying it. Setting someone here moves them out of
            Interested, and shows the space on their contact card. */}
        <form method="post" action="/api/admin/project-parking">
          <input type="hidden" name="slug" value={slug} />
          <input type="hidden" name="id" value={p.id} />
          <input type="hidden" name="action" value="buyer" />
          <span class:list={["pick", "quiet", { empty: !p.inquiry_id }]}>
            <select name="inquiry_id" onchange="this.form.submit()" aria-label={`Buyer of ${p.code}`}>
              <option value="" selected={!p.inquiry_id}>Nobody yet</option>
              {buyers.map((b) => (
                <option value={b.id} selected={p.inquiry_id === b.id}>{b.name}</option>
              ))}
            </select>
          </span>
        </form>
      </td>
    </tr>
  ))}
</table>
