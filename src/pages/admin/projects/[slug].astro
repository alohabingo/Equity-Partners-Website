    .genform { display: flex; align-items: flex-end; gap: 0.9rem; flex-wrap: wrap; margin-top: 1rem; }
    /* Four equal columns and the button on the end. Equal rather than sized to
       their contents: the fields are a set of four choices about one building,
       and giving one of them the leftover width made the row read as three
       fields and an afterthought. */
    .modalform {
      display: grid; gap: 0.9rem;
      grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
