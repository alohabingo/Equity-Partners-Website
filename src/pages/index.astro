---
import { blogPosts } from "../data/blogPosts";
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/SEO.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../lib/i18n";
import { getContentTranslations } from "../i18n/content";
import { getPageTitle } from "../i18n/ui";

const advantages = [
  {
    title: "Local Network",
    description:
      "Direct relationships with landowners, advisors, and Andorran operators unlock faster access to qualified opportunities.",
  },
  {
    title: "Regulatory Expertise",
    description:
      "We navigate planning, approvals, and compliance in the Principality with disciplined local execution.",
  },
  {
    title: "Lifecycle Management",
    description:
      "From sourcing through delivery, we manage project decisions end-to-end with investor clarity at every stage.",
  },
];

const projects = [
  {
    name: "Nanta Alta Luxury Villas",
    status: "Under Construction",
    value: "€50M",
    sector: "Luxury Residential",
    image: "/04c%20copy.jpg",
  },
  {
    name: "Ordino Prestige",
    status: "Under development",
    value: "€35M",
    sector: "Luxury Residential",
    image: "/ordino%20heights.jpg",
  },
  {
    name: "Funicamp Ski Residencies",
    status: "Under development",
    value: "€55M",
    sector: "Luxury Residential",
    image: "/funicamp%20ski.jpg",
  },
];

const localPartners = [
  { name: "AR Team", logo: "/images/partners/AR%20Logo%20EP.png" },
  { name: "DATA", logo: "/images/partners/DATA LOGO.png" },
  { name: "Emindset Law", logo: "/images/partners/Emindset LAW LOGO.png" },
  { name: "Govern d'Andorra", logo: "/images/partners/Govern d'Andorra logo.png" },
  { name: "Engel & Volkers", logo: "/images/partners/engel volkers logo.png" },
  { name: "Heracles", logo: "/images/partners/heracles%20logo.png" },
  { name: "Pret a Porter Casas", logo: "/images/partners/pret%20a%20porter%20casas%20logo.svg" },
  { name: "Hormipresa", logo: "/images/partners/hormipresa%20.webp" },
  { name: "MoraBank", logo: "/images/partners/mora%20bank.png" },
  { name: "Mariné Construccions", logo: "/images/partners/marine.png" },
];

const localPartnersLoop = [...localPartners, ...localPartners, ...localPartners, ...localPartners];
const homepageSuggestedPosts = blogPosts.slice(0, 3);
const locale = getLocaleFromUrl(Astro.url);
const content = getContentTranslations(locale).home;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SEO
      title={getPageTitle(locale, "home")}
      description={content.hero.subline}
      locale={locale}
      path={Astro.url.pathname}
      isHome={true}
    />
    <link rel="icon" type="image/png" href="/EP%20favicon.png" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap");

      :root {
        --bg-night: #06080c;
        --bg-paper: #f3f5f9;
        --bg-white: #ffffff;
        --text-primary: #1f2835;
        --text-muted: #5a667a;
        --text-light: #e8edf5;
        --accent: #8293ae;
        --line: #dbe1ea;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        color: var(--text-primary);
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, var(--bg-paper) 50%);
        line-height: 1.5;
        overflow-x: hidden;
      }

      .container {
        width: min(var(--max-width), 92vw);
        margin: 0 auto;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* ── Transparent header on homepage (before scroll) ── */
      body:not(.is-scrolled) .site-header {
        background: transparent !important;
        box-shadow: none !important;
        border-bottom-color: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }

      .hero {
        min-height: 82vh;
        padding: 2rem 0 2.1rem;
        background: linear-gradient(
            to bottom,
            rgba(6, 8, 12, 0.4) 0%,
            rgba(6, 8, 12, 0.26) 18%,
            rgba(6, 8, 12, 0.18) 34%,
            rgba(6, 8, 12, 0.3) 100%
          ),
          url("/hero-andorra-R2PtlkD-.jpg")
            center top / cover no-repeat;
        color: var(--text-light);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .hero-content {
        max-width: 50rem;
        padding-top: 7rem;
        padding-bottom: 3rem;
        transform: translateY(4.5rem);
        animation: rise 900ms 120ms ease both;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1 {
        margin: 0;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: clamp(2rem, 5vw, 4rem);
        letter-spacing: -0.012em;
        line-height: 1.05;
      }

      h1::after {
        content: "";
        display: block;
        width: 72px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.3rem;
        border-radius: 2px;
      }

      .subline {
        margin-top: 1.1rem;
        max-width: 42rem;
        color: #ffffff;
        font-size: clamp(1rem, 1.8vw, 1.2rem);
        line-height: 1.55;
        text-shadow: 0 1px 8px rgba(8, 14, 23, 0.45);
      }

      .hero-actions {
        margin-top: 1.8rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.85rem;
      }

      .hero-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        color: #ffffff;
        background: #53b27f;
        text-decoration: none;
        font-size: 0.78rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 600;
        line-height: 1;
        border-radius: 0.55rem;
        padding: 0.95rem 1.5rem;
        border: 1px solid #53b27f;
        white-space: nowrap;
        box-shadow: 0 10px 24px rgba(15, 60, 35, 0.28);
        transition: background-color 220ms ease, transform 220ms ease, color 220ms ease,
          border-color 220ms ease, box-shadow 220ms ease;
      }

      .hero-button:hover {
        background: #3f9568;
        border-color: #3f9568;
        transform: translateY(-2px);
        box-shadow: 0 16px 32px rgba(12, 24, 18, 0.34);
      }

      /* ─────────────────────────────────────────────────────────────
         Secondary hero button — frosted-glass / glossy treatment.
         The white text needs to read cleanly over the hero image, so:
         (1) the gradient background must stay above ~0.20 opacity,
         (2) brightness in the backdrop-filter must stay <= 0.78, and
         (3) the text-shadow stays — it carries the legibility.
         Do not weaken these values without testing on a light image.
         ───────────────────────────────────────────────────────────── */
      .hero-button.is-secondary {
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0.26) 100%);
        border: 1px solid rgba(255, 255, 255, 0.6);
        color: #ffffff;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.65),
          inset 0 -1px 0 rgba(255, 255, 255, 0.1),
          0 10px 28px rgba(0, 0, 0, 0.32);
        backdrop-filter: blur(22px) saturate(170%) brightness(0.7) contrast(1.1);
        -webkit-backdrop-filter: blur(22px) saturate(170%) brightness(0.7) contrast(1.1);
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85);
      }

      .hero-button.is-secondary:hover {
        background: #0f1a2a;
        border-color: rgba(255, 255, 255, 0.85);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 16px 32px rgba(10, 20, 34, 0.38);
      }

      /* On mobile the hero CTAs stack — size both to the wider button
         (kept compact, not full width) so their lengths match. */
      @media (max-width: 680px) {
        .hero-actions {
          display: grid;
          grid-template-columns: max-content;
          justify-content: start;
        }

        .hero-button {
          width: auto;
        }
      }

      .hero-kicker {
        margin-top: 0;
        margin-bottom: 1.3rem;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 1rem;
        border-radius: 0.5rem;
        background: rgba(15, 26, 42, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 10px 24px rgba(7, 12, 20, 0.22);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        color: #9be0b9;
      }

      .hero-kicker::before {
        content: "";
        width: 28px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #6ec595);
        display: inline-block;
      }

      .section {
        padding: 4rem 0;
      }

      .partners-wrap {
        background: #ffffff;
        border-bottom: 1px solid var(--line);
        padding: 2.4rem 0 2.2rem;
        overflow: hidden;
      }

      .partners-link {
        display: block;
        color: inherit;
        text-decoration: none;
      }

      .partners-link:focus-visible {
        outline: 2px solid rgba(130, 147, 174, 0.45);
        outline-offset: 3px;
      }

      .partners-title {
        margin: 0 0 1.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        width: 100%;
        justify-content: center;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #3f9568;
        font-weight: 600;
        text-decoration: none;
      }

      .partners-title::before,
      .partners-title::after {
        content: "";
        display: inline-block;
        width: 32px;
        height: 1px;
      }

      .partners-title::before {
        background: linear-gradient(90deg, transparent, #53b27f);
      }

      .partners-title::after {
        background: linear-gradient(90deg, #53b27f, transparent);
      }

      .partners-divider {
        width: 110px;
        height: 1px;
        margin: 0.85rem auto 1.3rem;
        background: #d8dee9;
      }

      .partners-marquee {
        position: relative;
        overflow: hidden;
        width: 100%;
        -webkit-mask-image: linear-gradient(
          90deg,
          transparent 0%,
          #000 8%,
          #000 92%,
          transparent 100%
        );
        mask-image: linear-gradient(
          90deg,
          transparent 0%,
          #000 8%,
          #000 92%,
          transparent 100%
        );
      }

      .partners-track {
        display: flex;
        width: max-content;
        gap: 3rem;
        animation: partners-scroll 46s linear infinite;
      }

      .partner-logo-box {
        flex: 0 0 auto;
        width: 145px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.2rem 0.45rem;
      }

      .partner-logo-box img {
        width: 100%;
        height: 48px;
        display: block;
        object-fit: contain;
        object-position: center;
        filter: grayscale(100%) brightness(0.88);
        opacity: 0.9;
        transition: filter 200ms ease, opacity 200ms ease, transform 200ms ease;
      }

      .partner-logo-box img.is-morabanc {
        filter: grayscale(100%) brightness(0.34) contrast(1.18);
        opacity: 1;
      }

      .partner-logo-box:hover img {
        filter: grayscale(0%) brightness(0.98);
        opacity: 1;
        transform: translateY(-1px);
      }

      .partner-logo-box:hover img.is-morabanc {
        filter: grayscale(100%) brightness(0.34) contrast(1.18);
      }

      .advantage-home {
        padding-bottom: 3rem;
        background: linear-gradient(180deg, #f4f6fa, #eef2f8);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .advantage-home-grid {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2.8rem;
        width: 100%;
        align-items: stretch;
      }

      .advantage-home-card {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.4rem 1.5rem;
        height: 100%;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
        transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      }

      .advantage-home-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 20px 40px rgba(15, 26, 42, 0.1);
        border-color: #cfdae7;
      }

      .advantage-home-icon {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
      }

      .advantage-home-icon img {
        width: 46px;
        height: 46px;
        object-fit: contain;
        display: block;
      }

      .advantage-home-card h3 {
        margin-top: 0.45rem;
        color: var(--text-strong);
        font-size: 1.15rem;
      }

      .advantage-home-kicker {
        margin-top: 0.7rem;
        color: #5a667a;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .advantage-home-card p {
        margin-top: 0.6rem;
        color: var(--text-muted);
      }

      .advantage-home-list {
        list-style: none;
        margin: 1.7rem 0 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      .advantage-home-list li {
        display: grid;
        grid-template-columns: 1.5rem 1fr;
        gap: 0.7rem;
        align-items: start;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.46;
      }

      .advantage-home-check {
        width: 1.5rem;
        height: 1.5rem;
        color: #48a86f;
        margin-top: 0.04rem;
      }

      .advantage-home-check svg {
        width: 100%;
        height: 100%;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.15;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .advantage-home-grid.is-test .advantage-home-card-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.8rem;
      }

      .advantage-home-grid.is-test .advantage-home-icon {
        width: 3.75rem;
        height: 3.75rem;
        border-radius: 1.1rem;
        background: #eef3f9;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
      }

      .advantage-home-grid.is-test .advantage-home-icon img {
        width: 1.85rem;
        height: 1.85rem;
      }

      .advantage-home-grid.is-test .advantage-home-icon {
        background: #53b27f;
        transition: background 220ms ease;
      }

      .advantage-home-grid.is-test .advantage-home-icon svg {
        width: 1.85rem;
        height: 1.85rem;
        display: block;
        stroke: #ffffff;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: stroke 220ms ease;
      }

      .advantage-home-grid.is-test .advantage-home-card:hover .advantage-home-icon {
        background: #e6f7f0;
      }

      .advantage-home-grid.is-test .advantage-home-card:hover .advantage-home-icon svg {
        stroke: #2e8a59;
      }

      .advantage-home-grid.is-test .advantage-home-icon img {
        filter: brightness(0) invert(1);
      }

      .advantage-home-grid.is-test .advantage-home-card h3 {
        margin-top: 0;
      }

      .advantage-home-grid.is-test .advantage-home-card p {
        margin-top: 0;
      }

      .advantage-home .focus-intro {
        max-width: none;
        width: 100%;
        font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      .advantage-home.is-dark-cards .advantage-home-card {
        background: #eef2f8;
        border: 1px solid rgba(18, 33, 56, 0.28);
        box-shadow: 0 16px 30px rgba(10, 18, 31, 0.08);
      }

      .advantage-home.is-dark-cards {
        background: #0f1a2a;
        border-top: 1px solid rgba(220, 228, 240, 0.15);
        border-bottom: 1px solid rgba(220, 228, 240, 0.15);
      }

      .advantage-home.is-dark-cards .eyebrow,
      .advantage-home.is-dark-cards .focus-title {
        color: #f3f7fc;
      }

      .advantage-home.is-dark-cards .eyebrow {
        color: #9fb4d2;
      }

      .advantage-home.is-dark-cards .focus-intro {
        color: rgba(230, 238, 247, 0.78);
      }

      .advantage-home.is-dark-cards .advantage-home-card h3 {
        color: #172235;
      }

      .advantage-home.is-dark-cards .advantage-home-card p {
        color: #5a667a;
      }

      .advantage-home.is-dark-cards .advantage-home-grid.is-test .advantage-home-icon {
        background: #53b27f;
      }

      .advantage-home.is-dark-cards .advantage-home-grid.is-test .advantage-home-icon img {
        filter: brightness(0) invert(1);
      }

      .advantage-home.is-dark-cards .cta-link {
        color: #f3f7fc;
      }

      /* ────────────────────────────────────────────────────────────
         "What we do" — Spotlight treatment (light)
         Light backdrop with soft tinted glows, white cards,
         editorial numerals and a green accent rule on hover.
         Scoped to .advantage-home.is-spotlight so it only affects
         this section and nothing else on the page.
         ──────────────────────────────────────────────────────────── */
      .advantage-home.is-spotlight {
        position: relative;
        padding: 5.5rem 0 4.5rem;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
      }

      .advantage-home.is-spotlight::before,
      .advantage-home.is-spotlight::after {
        content: none;
      }

      .advantage-home.is-spotlight .container {
        position: relative;
        z-index: 1;
      }

      .advantage-home.is-spotlight .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: #3f9568;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
      }

      .advantage-home.is-spotlight .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #53b27f);
        display: inline-block;
      }

      .advantage-home.is-spotlight .focus-title {
        color: var(--text-primary);
        font-size: clamp(2rem, 4.4vw, 3.1rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.05;
        margin-top: 1rem;
        max-width: 30rem;
      }

      .advantage-home.is-spotlight .focus-title::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, #53b27f, rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .advantage-home.is-spotlight .focus-intro {
        color: var(--text-muted);
        max-width: none;
        width: 100%;
        margin-top: 1.2rem;
        font-size: 1.02rem;
        line-height: 1.6;
      }

      .advantage-home.is-spotlight .advantage-home-grid {
        margin-top: 3.2rem;
        gap: 1.4rem;
      }

      .advantage-home.is-spotlight .advantage-home-card {
        position: relative;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        padding: 2.2rem 1.7rem 1.8rem;
        overflow: hidden;
        isolation: isolate;
        box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
        transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
          border-color 360ms ease, box-shadow 360ms ease;
      }

      .advantage-home.is-spotlight .advantage-home-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 85% 0%, rgba(83, 178, 127, 0.14), transparent 60%);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: -1;
        pointer-events: none;
      }

      .advantage-home.is-spotlight .advantage-home-card::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
        opacity: 0;
        transition: opacity 360ms ease;
      }

      .advantage-home.is-spotlight .advantage-home-card:hover {
        transform: translateY(-6px);
        border-color: rgba(83, 178, 127, 0.42);
        box-shadow: 0 26px 48px rgba(15, 26, 42, 0.12),
          0 0 0 1px rgba(83, 178, 127, 0.16) inset;
      }

      .advantage-home.is-spotlight .advantage-home-card:hover::before,
      .advantage-home.is-spotlight .advantage-home-card:hover::after {
        opacity: 1;
      }

      .advantage-home.is-spotlight .advantage-home-card-number {
        position: absolute;
        top: 1.2rem;
        right: 1.5rem;
        font-size: 3.2rem;
        font-weight: 700;
        letter-spacing: -0.04em;
        color: rgba(31, 40, 53, 0.07);
        line-height: 1;
        z-index: 0;
        font-feature-settings: "tnum";
        transition: color 360ms ease, transform 360ms ease;
      }

      .advantage-home.is-spotlight .advantage-home-card:hover .advantage-home-card-number {
        color: rgba(83, 178, 127, 0.32);
        transform: translateY(-2px);
      }

      .advantage-home.is-spotlight .advantage-home-grid.is-test .advantage-home-card-head {
        margin-bottom: 1.4rem;
        position: relative;
        z-index: 1;
      }

      .advantage-home.is-spotlight .advantage-home-grid.is-test .advantage-home-icon {
        width: 3.1rem;
        height: 3.1rem;
        border-radius: 0.85rem;
        background: linear-gradient(135deg, #53b27f 0%, #3f9568 100%);
