---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import { supabaseServer } from "../../../lib/supabase";
import { statusColour } from "../../../data/projects";
import { opportunityStatusColour } from "../../../data/opportunities";

const supabase = supabaseServer(Astro.cookies, Astro.request);

const kindFilter = Astro.url.searchParams.get("kind") === "opportunity" ? "opportunity" : "project";
const VALID_STAGES = ["prospective", "current", "past"] as const;
type Stage = (typeof VALID_STAGES)[number];
const stageParam = Astro.url.searchParams.get("stage") ?? "current";
const stageFilter: Stage = (VALID_STAGES as readonly string[]).includes(stageParam) ? (stageParam as Stage) : "current";

// Fetch every item (both kinds) so switching filters is instant, client-side.
const { data: rows } = await supabase
  .from("portfolio_items")
  .select("id, kind, slug, locale, status, sort_order, name, data")
  .order("sort_order");

// Projects that have been starred into the Command Centre. Only projects can be
// starred: opportunities are investor-facing and handled by the Leads section.
const { data: starredRows } = await supabase
  .from("projects")
  .select("slug")
  .eq("status", "active");
const starred = new Set((starredRows ?? []).map((r) => r.slug));

/** Derive the lifecycle stage from the item's deal status text. */
function stageOf(dealStatus: string | undefined): Stage {
  const s = (dealStatus ?? "").toLowerCase();
  if (/completed|closed$|fully subscribed/.test(s)) return "past";
  if (/pipeline|waitlist/.test(s)) return "prospective";
  return "current";
}

// One card per kind+slug: EN is canonical, other locales become edit links.
type Item = NonNullable<typeof rows>[number];
const bySlug = new Map<string, Item[]>();
for (const r of rows ?? []) {
  const key = `${r.kind}:${r.slug}`;
  const arr = bySlug.get(key) ?? [];
  arr.push(r);
  bySlug.set(key, arr);
}

const LOCALES = ["en", "es", "ca"];
const cards = [...bySlug.values()]
  .map((variants) => {
    const canonical = variants.find((v) => v.locale === "en") ?? variants[0];
    const d = (canonical.data ?? {}) as Record<string, any>;
    return {
      id: canonical.id,
      slug: canonical.slug,
      name: canonical.name,
      kind: canonical.kind,
      published: canonical.status === "published",
      sortOrder: canonical.sort_order,
      stage: stageOf(d.status),
      dealStatus: d.status ?? "—",
      image: d.image ?? "",
      tagline: d.tagline ?? "",
      location: d.location ?? d.parish ?? "",
      sector: d.sector ?? "",
      value: d.value ?? d.totalProjectValue ?? "",
      completion: d.completionDate ?? "",
      units: d.units ?? "",
      sqm: d.sqm ?? "",
      fundingProgress: typeof d.fundingProgress === "number" ? d.fundingProgress : null,
      minInvestment: d.minInvestment ?? "",
      variants: LOCALES.map((loc) => ({
        locale: loc,
        item: variants.find((v) => v.locale === loc) ?? null,
      })),
    };
  })
  .sort((a, b) => a.sortOrder - b.sortOrder);

// Counts per kind + stage, so the pills can relabel themselves client-side.
const counts: Record<string, Record<Stage, number>> = {
  project: { prospective: 0, current: 0, past: 0 },
  opportunity: { prospective: 0, current: 0, past: 0 },
};
for (const c of cards) counts[c.kind][c.stage] += 1;
const kindCounts = {
  project: cards.filter((c) => c.kind === "project").length,
  opportunity: cards.filter((c) => c.kind === "opportunity").length,
};

const publicPath = (c: { kind: string; slug: string }) =>
  `/${c.kind === "project" ? "projects" : "opportunities"}/${c.slug}`;

/** Same status colours the public project / opportunity cards use. */
const badgeColour = (kind: string, status: string) =>
  (kind === "project" ? statusColour[status] : opportunityStatusColour[status]) ?? "#8494a9";

const STAGES: Array<{ key: Stage; label: string }> = [
  { key: "prospective", label: "Prospective" },
  { key: "current", label: "Current" },
  { key: "past", label: "Past" },
];
---

<AdminLayout title="Portfolio" active="portfolio">
  <style>
    .head-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
    .new-btns { display: flex; gap: 0.5rem; }
    .new-btn {
      font-size: 0.8rem; font-weight: 700; color: #ffffff; text-decoration: none;
      background: #53b27f; border-radius: 8px; padding: 0.6rem 1rem;
    }
    .new-btn.alt { background: #16283e; }
    .new-btn:hover { filter: brightness(1.1); }
    .filters { margin-top: 1.4rem; display: flex; gap: 0.7rem; flex-wrap: wrap; }
    /* Sliding-thumb switchers (same as Team / Partners) */
    .seg {
      position: relative;
      display: inline-flex;
      background: #ffffff;
      border: 1px solid #d5deea;
      border-radius: 999px;
      padding: 0.3rem;
      box-shadow: 0 6px 18px rgba(15, 26, 42, 0.06);
      isolation: isolate;
    }
    .seg-thumb {
      position: absolute;
      top: 0.3rem;
      bottom: 0.3rem;
      left: 0;
      width: 0;
      border-radius: 999px;
      background: linear-gradient(180deg, #16283e 0%, #0f2036 100%);
      box-shadow: 0 6px 16px rgba(15, 26, 42, 0.28);
      transition: transform 420ms cubic-bezier(0.32, 1.3, 0.44, 1), width 420ms cubic-bezier(0.32, 1.3, 0.44, 1);
      z-index: -1;
    }
    .seg-thumb.no-anim { transition: none; }
    .seg-btn {
      font: inherit; font-size: 0.84rem; font-weight: 700; color: #46586f;
      background: none; border: 0; cursor: pointer; white-space: nowrap;
      padding: 0.5rem 1.4rem; border-radius: 999px;
      transition: color 300ms ease;
    }
    .seg-btn:focus { outline: none; }
    .seg-btn:focus-visible { box-shadow: 0 0 0 3px rgba(83, 178, 127, 0.35); }
    .seg-btn:hover:not(.active) { color: #2e7d54; }
    .seg-btn.active { color: #ffffff; }
    .count { opacity: 0.6; font-weight: 600; margin-left: 0.3rem; font-size: 0.85em; }
    .empty { margin-top: 2rem; color: #5c6f88; font-size: 0.92rem; }
    .empty[hidden] { display: none; }

    /* Card filtering transition */
    .pcard { transition: opacity 260ms ease, transform 260ms ease; cursor: pointer; }
    .pcard.is-hidden { display: none; }
    .cards.swapping .pcard { opacity: 0; transform: translateY(6px); }

    .cards {
      margin-top: 1.4rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }
    /* ---- Card: identical spec to .project-card-v2 on the live site ---- */
    .pcard {
      position: relative;
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #dbe1ea;
      border-radius: 1.2rem;
      overflow: hidden;
      isolation: isolate;
      box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
      transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
        box-shadow 360ms ease, border-color 360ms ease;
    }
    .pcard::before {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
      opacity: 0; transition: opacity 360ms ease; z-index: 2;
    }
    .pcard:hover {
      transform: translateY(-6px);
      border-color: rgba(83, 178, 127, 0.42);
      box-shadow: 0 30px 60px rgba(15, 26, 42, 0.14), 0 0 0 1px rgba(83, 178, 127, 0.16) inset;
    }
    .pcard:hover::before { opacity: 1; }

    .pcard-media { position: relative; width: 100%; aspect-ratio: 16/10; overflow: hidden; background: #eef2f7; }
    .pcard-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 400ms ease; }
    .pcard:hover .pcard-media img { transform: scale(1.04); }
    .no-img { height: 100%; display: grid; place-items: center; color: #93a3b8; font-size: 0.8rem; }
    /* The star adds a project to the Command Centre. Deliberately NOT a
       "feature on the website" control — hence the explicit tooltip, since a
       star on a CMS card usually means exactly that. */
    .pcard-star {
      position: absolute; top: 0.8rem; right: 0.8rem; z-index: 2;
      width: 30px; height: 30px; border-radius: 50%;
      display: grid; place-items: center; cursor: pointer;
      background: rgba(9, 21, 36, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      backdrop-filter: blur(3px);
      transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
    }
    .pcard-star svg { fill: none; }
    .pcard-star:hover { background: rgba(9, 21, 36, 0.75); transform: scale(1.07); }
    .pcard-star.on { background: #f0b429; border-color: #f0b429; color: #422f00; }
    .pcard-star.on svg { fill: currentColor; }
    .pcard-star.busy { opacity: 0.5; pointer-events: none; }
    .pcard-status {
      position: absolute; top: 0.9rem; left: 0.9rem;
      font-size: 0.6rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
      color: #ffffff; padding: 0.3rem 0.7rem; border-radius: 999px; line-height: 1;
    }
    .draft-badge {
      position: absolute; right: 0.9rem; top: 0.9rem;
      font-size: 0.6rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
      background: rgba(196, 148, 58, 0.95); color: #ffffff;
      padding: 0.3rem 0.7rem; border-radius: 999px; line-height: 1;
    }

    .pcard-body {
      position: relative; flex: 1; display: flex; flex-direction: column;
      padding: 1.9rem 1.8rem 1.7rem;
      isolation: isolate; overflow: hidden;
    }
    .pcard-body::before {
      content: ""; position: absolute; inset: 0;
      background: radial-gradient(circle at 85% 0%, rgba(83, 178, 127, 0.14), transparent 60%);
      opacity: 0; transition: opacity 360ms ease; z-index: -1; pointer-events: none;
    }
    .pcard:hover .pcard-body::before { opacity: 1; }

    .pcard-location {
      font-size: 0.65rem; font-weight: 600; letter-spacing: 0.12em;
      text-transform: uppercase; color: #5a667a; margin: 0 0 0.5rem;
    }
    .pcard-name {
      font-size: 1.15rem; font-weight: 700; color: #1f2835;
      margin: 0 0 0.6rem; line-height: 1.25;
    }
    .pcard-tagline {
      font-size: 0.83rem; color: #5a667a; line-height: 1.55; margin: 0 0 1.4rem;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .pcard-metrics {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem;
      padding: 1.1rem 0;
      border-top: 1px solid #dbe1ea; border-bottom: 1px solid #dbe1ea;
      margin-bottom: 1.2rem;
    }
    .pcard-metric { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
    .pcard-metric-value { font-size: 1.1rem; font-weight: 800; color: #1f2835; line-height: 1.15; }
    .pcard-metric-value.is-green { color: #53b27f; }
    .pcard-metric-label {
      font-size: 0.6rem; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: #5a667a;
    }
    .pcard-footer {
      margin-top: auto; display: flex; align-items: center;
      justify-content: space-between; gap: 0.5rem;
    }
    .pcard-sector {
      font-size: 0.65rem; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: #5a667a;
      background: #f0f4fa; padding: 0.3rem 0.7rem; border-radius: 999px;
    }

    .langs { display: inline-flex; gap: 0.25rem; }
    .lang {
      font-size: 0.62rem; font-weight: 700; text-decoration: none;
      padding: 0.2rem 0.45rem; border-radius: 6px;
    }
    .lang.has { background: rgba(83, 178, 127, 0.13); color: #2e7d54; }
    .lang.has:hover { background: rgba(83, 178, 127, 0.25); }
    .lang.missing { background: rgba(203, 76, 76, 0.08); color: #b98484; border: 1px dashed rgba(203, 76, 76, 0.3); }
    .actions { display: inline-flex; gap: 0.7rem; }
    .mini-link { font-size: 0.72rem; font-weight: 700; color: #3d5a80; text-decoration: none; }
    .mini-link:hover { text-decoration: underline; }
  </style>

  <div class="page-head head-row">
    <div>
      <h1>Portfolio</h1>
      <p>Investment opportunities and development projects — live on save.</p>
    </div>
    <div class="new-btns">
      <a class="new-btn alt" href="/admin/portfolio/new?kind=opportunity">+ New opportunity</a>
      <a class="new-btn" href="/admin/portfolio/new?kind=project">+ New project</a>
    </div>
  </div>

  <div class="filters">
    <div class="seg" data-seg="kind">
      <span class="seg-thumb no-anim"></span>
      {[["project", "Projects"], ["opportunity", "Opportunities"]].map(([k, label]) => (
        <button class={kindFilter === k ? "seg-btn active" : "seg-btn"} type="button" data-kind={k}>
          {label} <span class="count" data-kind-count={k}>{kindCounts[k as "project" | "opportunity"]}</span>
        </button>
      ))}
    </div>
    <div class="seg" data-seg="stage">
      <span class="seg-thumb no-anim"></span>
      {STAGES.map((s) => (
        <button class={stageFilter === s.key ? "seg-btn active" : "seg-btn"} type="button" data-stage={s.key}>
          {s.label} <span class="count" data-stage-count={s.key}>{counts[kindFilter][s.key]}</span>
        </button>
      ))}
    </div>
  </div>

  <p class="empty" id="empty-msg" hidden>Nothing here for this filter.</p>

  <div class="cards" id="cards">
    {cards.map((c) => (
      <article
        class:list={["pcard", { "is-hidden": c.kind !== kindFilter || c.stage !== stageFilter }]}
        data-card-kind={c.kind}
        data-card-stage={c.stage}
        data-href={`/admin/portfolio/${c.id}`}
        title={`Edit ${c.name}`}
      >
        <div class="pcard-media">
          {c.image
            ? <img src={c.image} alt={c.name} loading="lazy" />
            : <div class="no-img">No image</div>}
          <span class="pcard-status" style={`background:${badgeColour(c.kind, c.dealStatus)}`}>{c.dealStatus}</span>
          {!c.published && <span class="draft-badge">draft</span>}
          {c.kind === "project" && (
            <button
              class:list={["pcard-star", { on: starred.has(c.slug) }]}
              type="button"
              data-slug={c.slug}
              data-name={c.name}
              aria-pressed={starred.has(c.slug) ? "true" : "false"}
              title={starred.has(c.slug)
                ? "In the Command Centre — click to remove"
                : "Add to Command Centre"}
            >
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2.9 2.85 5.78 6.38.93-4.61 4.5 1.09 6.35L12 17.46l-5.71 2.99 1.09-6.35-4.61-4.5 6.38-.93L12 2.9Z"/></svg>
            </button>
          )}
        </div>

        <div class="pcard-body">
          {(c.location || c.sector) && <p class="pcard-location">{c.location || c.sector}</p>}
          <h2 class="pcard-name">{c.name}</h2>
          {c.tagline && <p class="pcard-tagline">{c.tagline}</p>}

          <div class="pcard-metrics">
            <div class="pcard-metric">
              <span class="pcard-metric-value is-green">{c.value || "—"}</span>
              <span class="pcard-metric-label">{c.kind === "project" ? "Project value" : "Total value"}</span>
            </div>
            <div class="pcard-metric">
              <span class="pcard-metric-value">{c.units || c.minInvestment || "—"}</span>
              <span class="pcard-metric-label">{c.units ? "Number of units" : "Min. investment"}</span>
            </div>
            <div class="pcard-metric">
              <span class="pcard-metric-value">{c.sqm || "—"}</span>
              <span class="pcard-metric-label">Total area</span>
            </div>
            <div class="pcard-metric">
              <span class="pcard-metric-value">{c.completion || "—"}</span>
              <span class="pcard-metric-label">Est. completion</span>
            </div>
          </div>

          <div class="pcard-footer">
            {c.sector ? <span class="pcard-sector">{c.sector}</span> : <span></span>}
            <span class="langs">
              {c.variants.map((v) =>
                v.item
                  ? <a class="lang has" href={`/admin/portfolio/${v.item.id}`} title={`Edit ${v.locale.toUpperCase()}`}>{v.locale.toUpperCase()}</a>
                  : <a class="lang missing" href={`/admin/portfolio/new?kind=${c.kind}&from=${c.id}`} title={`Missing ${v.locale.toUpperCase()} — duplicate to translate`}>{v.locale.toUpperCase()}</a>
              )}
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>

  <script is:inline define:vars={{ counts }}>
    (() => {
      const params = new URLSearchParams(location.search);
      let kind = params.get("kind") === "opportunity" ? "opportunity" : "project";
      let stage = ["prospective", "current", "past"].includes(params.get("stage"))
        ? params.get("stage")
        : "current";

      const cardsWrap = document.getElementById("cards");
      const emptyMsg = document.getElementById("empty-msg");

      function moveThumb(seg, animate = true) {
        const thumb = seg.querySelector(".seg-thumb");
        const active = seg.querySelector(".seg-btn.active");
        if (!thumb || !active) return;
        thumb.classList.toggle("no-anim", !animate);
        thumb.style.width = `${active.offsetWidth}px`;
        thumb.style.transform = `translateX(${active.offsetLeft}px)`;
        if (!animate) requestAnimationFrame(() => thumb.classList.remove("no-anim"));
      }
      function placeThumbs(animate = false) {
        document.querySelectorAll(".seg").forEach((s) => moveThumb(s, animate));
      }
      placeThumbs(false);
      document.fonts?.ready.then(() => placeThumbs(false));
      window.addEventListener("resize", () => placeThumbs(false));

      function apply(push = true) {
        // fade out, re-filter, fade in
        cardsWrap.classList.add("swapping");
        setTimeout(() => {
          let visible = 0;
          cardsWrap.querySelectorAll(".pcard").forEach((card) => {
            const match = card.dataset.cardKind === kind && card.dataset.cardStage === stage;
            card.classList.toggle("is-hidden", !match);
            if (match) visible++;
          });
          emptyMsg.hidden = visible > 0;
          emptyMsg.textContent = `No ${stage} ${kind === "project" ? "projects" : "opportunities"}.`;
          cardsWrap.classList.remove("swapping");
        }, 170);

        // stage counts depend on the selected kind
        for (const s of ["prospective", "current", "past"]) {
          const el = document.querySelector(`[data-stage-count="${s}"]`);
          if (el) el.textContent = counts[kind][s];
        }
        document.querySelectorAll("[data-kind]").forEach((b) =>
          b.classList.toggle("active", b.dataset.kind === kind)
        );
        document.querySelectorAll("[data-stage]").forEach((b) =>
          b.classList.toggle("active", b.dataset.stage === stage)
        );
        placeThumbs(true);

        if (push) {
          const p = new URLSearchParams();
          if (kind === "opportunity") p.set("kind", kind);
          if (stage !== "current") p.set("stage", stage);
          const q = p.toString();
          history.pushState({ kind, stage }, "", q ? `/admin/portfolio?${q}` : "/admin/portfolio");
        }
      }

      document.querySelectorAll("[data-kind]").forEach((btn) =>
        btn.addEventListener("click", () => {
          if (kind === btn.dataset.kind) return;
          kind = btn.dataset.kind;
          apply();
        })
      );
      document.querySelectorAll("[data-stage]").forEach((btn) =>
        btn.addEventListener("click", () => {
          if (stage === btn.dataset.stage) return;
          stage = btn.dataset.stage;
          apply();
        })
      );
      window.addEventListener("popstate", () => {
        const p = new URLSearchParams(location.search);
        kind = p.get("kind") === "opportunity" ? "opportunity" : "project";
        stage = ["prospective", "current", "past"].includes(p.get("stage")) ? p.get("stage") : "current";
        apply(false);
      });

      // Clicking a card opens its editor; the language chips and the star button
      // keep their own behaviour.
      document.querySelectorAll(".pcard[data-href]").forEach((card) => {
        card.addEventListener("click", (e) => {
          if (e.target.closest("a, button")) return;
          window.location.href = card.dataset.href;
        });
      });

      // Star = add this project to the Command Centre. Un-starring ARCHIVES the
      // project rather than deleting it, so its enquiries and history survive.
      // The page reloads afterwards so the sidebar reflects the change.
      document.querySelectorAll(".pcard-star").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
          e.stopPropagation();
          const wasOn = btn.classList.contains("on");
          btn.classList.add("busy");
          try {
            const res = await fetch("/api/admin/project-star", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                slug: btn.dataset.slug,
                name: btn.dataset.name,
                starred: !wasOn,
              }),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.ok) throw new Error(data.error || `failed (${res.status})`);
            btn.classList.toggle("on", !wasOn);
            setTimeout(() => window.location.reload(), 220);
          } catch (err) {
            btn.classList.remove("busy");
            alert("Couldn't update the Command Centre: " + err.message);
          }
        });
      });

      // set the initial empty-state message correctly
      apply(false);
    })();
  </script>
</AdminLayout>
