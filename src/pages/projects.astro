---
import InnerSiteHeader from "../components/InnerSiteHeader.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/SEO.astro";
import { buildLocalizedPath, getLocaleFromUrl } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { projects as projectsEn, statusColour } from "../data/projects";
import { projects as projectsEs } from "../data/projectsEs";
import { projects as projectsCa } from "../data/projectsCa";

const locale = getLocaleFromUrl(Astro.url) ?? "en";

const projectsByLocale: Record<Locale, typeof projectsEn> = {
  en: projectsEn,
  es: projectsEs,
  ca: projectsCa,
};
const projects = projectsByLocale[locale];

const copyByLocale = {
  en: {
    seoTitle: "Projects | Equity Partners",
    seoDescription:
      "Explore Equity Partners' current real estate development projects in Andorra. View investment details, returns, timelines and project status.",
    heroEyebrow: "Our Current Portfolio",
    heroTitle: "Projects Under Development",
    heroIntro:
      "An overview of the active real estate developments Equity Partners is delivering across the Principality of Andorra.",
    statActiveProjects: "Active projects",
    statCombinedValue: "Combined project value",
    statTotalArea: "Total area under development",
    cardProjectValue: "Project value",
    cardUnits: "Number of units",
    cardTotalArea: "Total area",
    cardCompletion: "Est. completion",
    viewProject: "View project",
    ctaEyebrow: "Property purchase",
    ctaTitle: "Investment by property purchase",
    ctaText:
      "Property prices in Andorra's most sought-after areas appreciate around 8% a year — a strong long-term hold. Talk to our team to explore what's available.",
    ctaBtn: "Contact our team",
    panelTitle: "Our team can help with",
    panelItems: [
      "Current availability & pricing",
      "The purchase process & timeline",
      "Residency & tax considerations",
    ],
    statusLabels: {
      "Under Construction": "Under Construction",
      "Under development": "Under development",
      "Pipeline": "Pipeline",
      "Financing Open": "Financing Open",
      "Completed": "Completed",
    } as Record<string, string>,
    numberLocale: "en-US",
  },
  es: {
    seoTitle: "Proyectos | Equity Partners",
    seoDescription:
      "Descubra los proyectos de desarrollo inmobiliario que Equity Partners impulsa actualmente en Andorra. Consulte detalles de inversión, rentabilidades, plazos y estado de cada proyecto.",
    heroEyebrow: "Nuestra cartera actual",
    heroTitle: "Proyectos en desarrollo",
    heroIntro:
      "Una visión general de los desarrollos inmobiliarios activos que Equity Partners está ejecutando en el Principado de Andorra.",
    statActiveProjects: "Proyectos activos",
    statCombinedValue: "Valor conjunto de los proyectos",
    statTotalArea: "Superficie total en desarrollo",
    cardProjectValue: "Valor del proyecto",
    cardUnits: "Número de unidades",
    cardTotalArea: "Superficie total",
    cardCompletion: "Finalización prevista",
    viewProject: "Ver proyecto",
    ctaEyebrow: "Compra de propiedad",
    ctaTitle: "Inversión mediante compra de propiedad",
    ctaText:
      "Los precios de la vivienda en las zonas más cotizadas de Andorra se revalorizan en torno a un 8% anual: una sólida inversión a largo plazo. Hable con nuestro equipo para conocer la oferta disponible.",
    ctaBtn: "Contactar con el equipo",
    panelTitle: "Nuestro equipo puede ayudarle con",
    panelItems: [
      "Disponibilidad actual y precios",
      "El proceso de compra y los plazos",
      "Residencia y consideraciones fiscales",
    ],
    statusLabels: {
      "Under Construction": "En construcción",
      "Under development": "En desarrollo",
      "Pipeline": "En cartera",
      "Financing Open": "Financiación abierta",
      "Completed": "Completado",
    } as Record<string, string>,
    numberLocale: "es-ES",
  },
  ca: {
    seoTitle: "Projectes | Equity Partners",
    seoDescription:
      "Descobreixi els projectes de desenvolupament immobiliari que Equity Partners impulsa actualment a Andorra. Consulti detalls d'inversió, rendibilitats, terminis i estat de cada projecte.",
    heroEyebrow: "La nostra cartera actual",
    heroTitle: "Projectes en desenvolupament",
    heroIntro:
      "Una visió general dels desenvolupaments immobiliaris actius que Equity Partners està executant al Principat d'Andorra.",
    statActiveProjects: "Projectes actius",
    statCombinedValue: "Valor conjunt dels projectes",
    statTotalArea: "Superfície total en desenvolupament",
    cardProjectValue: "Valor del projecte",
    cardUnits: "Nombre d'unitats",
    cardTotalArea: "Superfície total",
    cardCompletion: "Finalització prevista",
    viewProject: "Veure projecte",
    ctaEyebrow: "Compra de propietat",
    ctaTitle: "Inversió mitjançant compra de propietat",
    ctaText:
      "Els preus de l'habitatge a les zones més cotitzades d'Andorra es revaloren al voltant d'un 8% anual: una sòlida inversió a llarg termini. Parli amb el nostre equip per conèixer l'oferta disponible.",
    ctaBtn: "Contacta amb l'equip",
    panelTitle: "El nostre equip pot ajudar-lo amb",
    panelItems: [
      "Disponibilitat actual i preus",
      "El procés de compra i els terminis",
      "Residència i consideracions fiscals",
    ],
    statusLabels: {
      "Under Construction": "En construcció",
      "Under development": "En desenvolupament",
      "Pipeline": "En cartera",
      "Financing Open": "Finançament obert",
      "Completed": "Completat",
    } as Record<string, string>,
    numberLocale: "ca-ES",
  },
} satisfies Record<Locale, unknown>;

const copy = copyByLocale[locale];

// Sum the square metres of every project currently being built or developed,
// so the stats strip stays accurate even as projects move through the pipeline.
const totalAreaUnderDevelopment = projects
  .filter((p) => p.status === "Under Construction" || p.status === "Under development")
  .reduce((sum, p) => {
    const num = parseInt(p.sqm.replace(/[^\d]/g, ""), 10);
    return sum + (Number.isNaN(num) ? 0 : num);
  }, 0);
const totalAreaUnderDevelopmentLabel =
  totalAreaUnderDevelopment.toLocaleString(copy.numberLocale) + " m²";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={copy.seoTitle}
      description={copy.seoDescription}
      locale={locale}
      path={Astro.url.pathname}
    />
    <link rel="icon" type="image/png" href="/EP favicon.png" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --navy: #0f1a2a;
        --green: #53b27f;
        --green-dark: #3f9568;
        --line: #dce3ee;
        --text: #172235;
        --muted: #5a667a;
        --font: "Montserrat", "Segoe UI", Arial, sans-serif;
      }

      body {
        margin: 0;
        font-family: var(--font);
        background: #ffffff;
        color: var(--text);
        -webkit-font-smoothing: antialiased;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
      }

      /* ── Page Hero (Dark spotlight) ── */
      .projects-hero {
        position: relative;
        padding: 9rem 0 5rem;
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          radial-gradient(ellipse at 88% 100%, rgba(130, 147, 174, 0.16), transparent 60%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        overflow: hidden;
      }

      .projects-hero::before,
      .projects-hero::after {
        content: "";
        position: absolute;
        width: 620px;
        height: 620px;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.55;
      }

      .projects-hero::before {
        top: -180px;
        right: -160px;
        background: radial-gradient(circle, rgba(83, 178, 127, 0.18), transparent 70%);
      }

      .projects-hero::after {
        bottom: -220px;
        left: -160px;
        background: radial-gradient(circle, rgba(130, 147, 174, 0.18), transparent 70%);
      }

      .projects-hero .container {
        position: relative;
        z-index: 1;
      }

      .projects-hero-inner {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .projects-hero .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: #6ec595;
        font-size: 0.74rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        font-weight: 600;
        margin: 0;
      }

      .projects-hero .eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--green));
        display: inline-block;
      }

      .projects-hero h1 {
        font-size: clamp(2rem, 4.4vw, 3.2rem);
        font-weight: 700;
        color: #f3f7fc;
        margin: 0;
        line-height: 1.05;
        letter-spacing: -0.012em;
      }

      .projects-hero h1::after {
        content: "";
        display: block;
        width: 64px;
        height: 3px;
        background: linear-gradient(90deg, var(--green), rgba(83, 178, 127, 0));
        margin-top: 1.1rem;
        border-radius: 2px;
      }

      .projects-hero p {
        font-size: 1.02rem;
        color: rgba(220, 230, 245, 0.72);
        margin: 0;
        max-width: 42rem;
        line-height: 1.6;
      }

      /* ── Stats strip (unified card with dividers) ── */
      .projects-stats {
        position: relative;
        padding: 2.2rem 0;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        overflow: hidden;
      }

      .projects-stats .container {
        position: relative;
        z-index: 1;
      }

      .projects-stats-inner {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(15, 26, 42, 0.07);
      }

      .projects-stat {
        padding: 1.4rem 1.6rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        text-align: center;
        border-right: 1px solid var(--line);
        transition: background 320ms ease;
      }

      .projects-stat:last-child {
        border-right: none;
      }

      .projects-stat:hover {
        background: rgba(83, 178, 127, 0.05);
      }

      .projects-stat-value {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--navy);
        letter-spacing: -0.012em;
        line-height: 1;
      }

      .projects-stat-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ── Grid (matches About page top section) ── */
      .projects-grid-section {
        position: relative;
        padding: 3rem 0 6rem;
        background: radial-gradient(circle at 10% -10%, #eef2f8 0, #f4f6fa 50%);
        overflow: hidden;
      }

      .projects-grid-section .container {
        position: relative;
        z-index: 1;
      }

      .projects-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.4rem;
      }

      /* ── Project Card ── */
      .project-card-v2 {
        position: relative;
        display: flex;
        flex-direction: column;
        border: 1px solid var(--line);
        border-radius: 1.2rem;
        overflow: hidden;
        background: #ffffff;
        text-decoration: none;
        color: inherit;
        isolation: isolate;
        box-shadow: 0 10px 30px rgba(15, 26, 42, 0.06);
        transition: transform 360ms cubic-bezier(0.2, 0.65, 0.35, 1),
          box-shadow 360ms ease, border-color 360ms ease;
      }

      .project-card-v2::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(83, 178, 127, 0.55), transparent);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: 2;
      }

      .project-card-v2:hover {
        transform: translateY(-6px);
        box-shadow: 0 30px 60px rgba(15, 26, 42, 0.14),
          0 0 0 1px rgba(83, 178, 127, 0.16) inset;
        border-color: rgba(83, 178, 127, 0.42);
      }

      .project-card-v2:hover::before {
        opacity: 1;
      }

      .project-card-v2-image {
        position: relative;
        width: 100%;
        aspect-ratio: 16/10;
        overflow: hidden;
      }

      .project-card-v2-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 400ms ease;
      }

      .project-card-v2:hover .project-card-v2-image img {
        transform: scale(1.04);
      }

      .project-card-v2-status {
        position: absolute;
        top: 0.9rem;
        left: 0.9rem;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: #ffffff;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        line-height: 1;
      }

      .project-card-v2-body {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 1.6rem 1.5rem 1.5rem;
        isolation: isolate;
        overflow: hidden;
      }

      .project-card-v2-body::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 85% 0%, rgba(83, 178, 127, 0.14), transparent 60%);
        opacity: 0;
        transition: opacity 360ms ease;
        z-index: -1;
        pointer-events: none;
      }

      .project-card-v2:hover .project-card-v2-body::before {
        opacity: 1;
      }

      .project-card-v2-location {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 0.5rem;
      }

      .project-card-v2-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--navy);
        margin: 0 0 0.6rem;
        line-height: 1.25;
      }

      .project-card-v2-tagline {
        font-size: 0.83rem;
        color: var(--muted);
        line-height: 1.55;
        margin: 0 0 1.4rem;
      }

      .project-card-v2-metrics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        padding: 1.1rem 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        margin-bottom: 1.2rem;
      }

      .project-card-v2-metric {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .project-card-v2-metric-value {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--navy);
        line-height: 1;
      }

      .project-card-v2-metric-label {
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .project-card-v2-metric-value.is-green {
        color: var(--green);
      }

      .project-card-v2-footer {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }

      .project-card-v2-sector {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        background: #f0f4fa;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
      }

      .project-card-v2-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green);
        transition: gap 180ms ease;
      }

      .project-card-v2:hover .project-card-v2-link {
        gap: 0.65rem;
      }

      .project-card-v2-link svg {
        width: 0.8rem;
        height: 0.8rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── CTA Banner (Dark spotlight) ── */
      .projects-cta-banner {
        position: relative;
        padding: 5rem 0 4.5rem;
        background:
          radial-gradient(ellipse at 18% 0%, rgba(83, 178, 127, 0.14), transparent 55%),
          radial-gradient(ellipse at 88% 100%, rgba(130, 147, 174, 0.16), transparent 60%),
          linear-gradient(160deg, #0a1422 0%, #101e34 50%, #0a1422 100%);
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        overflow: hidden;
      }

      .projects-cta-banner::before,
      .projects-cta-banner::after {
        content: "";
        position: absolute;
        width: 620px;
        height: 620px;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.55;
      }

      .projects-cta-banner::before {
        top: -180px;
        right: -160px;
        background: radial-gradient(circle, rgba(83, 178, 127, 0.18), transparent 70%);
      }

      .projects-cta-banner::after {
        bottom: -220px;
        left: -160px;
        background: radial-gradient(circle, rgba(130, 147, 174, 0.18), transparent 70%);
      }

      .projects-cta-banner .container {
        position: relative;
        z-index: 1;
      }

      .projects-cta-header {
        margin-bottom: 1.4rem;
      }

      .projects-cta-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0;
        color: #6ec595;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.28em;
        text-transform: uppercase;
      }

      .projects-cta-eyebrow::before {
        content: "";
        width: 32px;
        height: 1px;
        display: inline-block;
        background: linear-gradient(90deg, transparent, var(--green));
      }

      .projects-cta-card {
        border: 1px solid rgba(255, 255, 255, 0.09);
        background: rgba(255, 255, 255, 0.03);
        border-radius: 14px;
        padding: 2rem;
      }

      .projects-cta-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 2rem;
        align-items: center;
      }

      .projects-cta-headline-row {
        display: flex;
        align-items: center;
        gap: 0.95rem;
      }

      .projects-cta-icon {
        width: 3rem;
        height: 3rem;
        flex-shrink: 0;
        border-radius: 0.8rem;
        background: rgba(83, 178, 127, 0.16);
        border: 1px solid rgba(83, 178, 127, 0.4);
        color: #7bd6a2;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .projects-cta-icon svg {
        width: 1.35rem;
        height: 1.35rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .projects-cta-grid h2 {
        margin: 0;
        color: #f3f7fc;
        font-size: clamp(1.4rem, 3vw, 1.7rem);
        font-weight: 700;
        letter-spacing: -0.012em;
        line-height: 1.15;
      }

      .projects-cta-text {
        margin: 0.9rem 0 0;
        font-size: 1rem;
        color: rgba(220, 230, 245, 0.72);
        line-height: 1.6;
        max-width: 36rem;
      }

      .projects-cta-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        margin-top: 1.4rem;
        padding: 0.9rem 1.5rem;
        background: var(--green);
        border: 1px solid var(--green);
        color: #ffffff;
        border-radius: 0.55rem;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        transition: background 220ms ease, border-color 220ms ease,
          transform 220ms ease, color 220ms ease, box-shadow 220ms ease;
      }

      .projects-cta-btn:hover {
        background: #5fc189;
        border-color: #5fc189;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(83, 178, 127, 0.32);
      }

      .projects-cta-btn svg {
        width: 0.85rem;
        height: 0.85rem;
        stroke: currentColor;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .projects-cta-panel {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 0.9rem;
        padding: 1.4rem 1.5rem;
      }

      .projects-cta-panel-title {
        margin: 0 0 0.9rem;
        color: #7bd6a2;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .projects-cta-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }

      .projects-cta-list li {
        display: flex;
        gap: 0.6rem;
        align-items: flex-start;
        color: #e7eef7;
        font-size: 0.95rem;
        line-height: 1.4;
      }

      .projects-cta-list svg {
        width: 1.1rem;
        height: 1.1rem;
        flex-shrink: 0;
        margin-top: 0.05rem;
        stroke: #7bd6a2;
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      /* ── Animations ── */
      [data-animate] {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 600ms ease, transform 600ms ease;
      }
      [data-animate].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      @media (max-width: 860px) {
        .projects-grid { grid-template-columns: 1fr 1fr; }
        .projects-stats-inner { grid-template-columns: 1fr; }
        .projects-stat {
          border-right: none;
          border-bottom: 1px solid var(--line);
        }
        .projects-stat:last-child {
          border-bottom: none;
        }
        .projects-cta-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 560px) {
        .projects-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <InnerSiteHeader menuToggleId="mobile-menu-toggle" offsetFirstSection={false} locale={locale} currentPath={Astro.url.pathname} />

    <!-- Hero -->
    <section class="projects-hero">
      <div class="container">
        <div class="projects-hero-inner" data-animate>
          <p class="eyebrow">{copy.heroEyebrow}</p>
          <h1>{copy.heroTitle}</h1>
          <p>{copy.heroIntro}</p>
        </div>
      </div>
    </section>

    <!-- Stats strip -->
    <div class="projects-stats">
      <div class="container">
        <div class="projects-stats-inner" data-animate>
          <div class="projects-stat">
            <span class="projects-stat-value">3</span>
            <span class="projects-stat-label">{copy.statActiveProjects}</span>
          </div>
          <div class="projects-stat">
            <span class="projects-stat-value">€140M</span>
            <span class="projects-stat-label">{copy.statCombinedValue}</span>
          </div>
          <div class="projects-stat">
            <span class="projects-stat-value">{totalAreaUnderDevelopmentLabel}</span>
            <span class="projects-stat-label">{copy.statTotalArea}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Project grid -->
    <section class="projects-grid-section">
      <div class="container">
        <div class="projects-grid" data-animate>
          {projects.map((project) => (
            <a class="project-card-v2" href={buildLocalizedPath(`/projects/${project.slug}`, locale)}>
              <div class="project-card-v2-image">
                <img src={project.image} alt={project.name} loading="lazy" />
                <span
                  class="project-card-v2-status"
                  style={`background: ${statusColour[project.status]}`}
                >
                  {copy.statusLabels[project.status]}
                </span>
              </div>
              <div class="project-card-v2-body">
                <p class="project-card-v2-location">{project.parish} · Andorra</p>
                <h2 class="project-card-v2-name">{project.name}</h2>
                <p class="project-card-v2-tagline">{project.tagline}</p>
                <div class="project-card-v2-metrics">
                  <div class="project-card-v2-metric">
                    <span class="project-card-v2-metric-value is-green">{project.value}</span>
                    <span class="project-card-v2-metric-label">{copy.cardProjectValue}</span>
                  </div>
                  <div class="project-card-v2-metric">
                    <span class="project-card-v2-metric-value">{project.units}</span>
                    <span class="project-card-v2-metric-label">{copy.cardUnits}</span>
                  </div>
                  <div class="project-card-v2-metric">
                    <span class="project-card-v2-metric-value">{project.sqm}</span>
                    <span class="project-card-v2-metric-label">{copy.cardTotalArea}</span>
                  </div>
                  <div class="project-card-v2-metric">
                    <span class="project-card-v2-metric-value">{project.completionDate}</span>
                    <span class="project-card-v2-metric-label">{copy.cardCompletion}</span>
                  </div>
                </div>
                <div class="project-card-v2-footer">
                  <span class="project-card-v2-sector">{project.sector}</span>
                  <span class="project-card-v2-link">
                    {copy.viewProject}
                    <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Banner -->
    <section class="projects-cta-banner">
      <div class="container">
        <div class="projects-cta-header" data-animate>
          <p class="projects-cta-eyebrow">{copy.ctaEyebrow}</p>
        </div>

        <div class="projects-cta-card" data-animate>
          <div class="projects-cta-grid">
            <div class="projects-cta-main">
              <div class="projects-cta-headline-row">
                <span class="projects-cta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                </span>
                <h2>{copy.ctaTitle}</h2>
              </div>
              <p class="projects-cta-text">
                {copy.ctaText}
              </p>
              <a class="projects-cta-btn" href={buildLocalizedPath("/contact", locale)}>
                {copy.ctaBtn}
                <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
            <div class="projects-cta-panel">
              <p class="projects-cta-panel-title">{copy.panelTitle}</p>
              <ul class="projects-cta-list">
                {copy.panelItems.map((item) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.7 12.2 2.1 2.2 4.5-5"/></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <NewsletterSignup emailInputId="newsletter-email-projects" locale={locale} />
    <SiteFooter locale={locale} />

    <script type="module">
      const targets = document.querySelectorAll("[data-animate]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08 }
      );
      targets.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
